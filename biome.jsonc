{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "root": true,
  // Repo-local GritQL lint rules from @beep/lint-rules. Biome resolves plugin paths
  // relative to this config file, so they are listed repo-root-relative. These ship
  // advisory (severity "warn" inside each .grit) and run inside the single lint pass.
  // `no-native-error` is registered via `overrides` (tooling source only), not here.
  "plugins": [
    "./packages/tooling/policy-pack/lint-rules/rules/no-file-url-pathname.grit",
    "./packages/tooling/policy-pack/lint-rules/rules/no-empty-named-blocks.grit",
    "./packages/tooling/policy-pack/lint-rules/rules/prefer-array-flat-map.grit",
    "./packages/tooling/policy-pack/lint-rules/rules/prefer-identity-annote-pipe.grit",
    "./packages/tooling/policy-pack/lint-rules/rules/no-hand-built-identity-annotation.grit",
    "./packages/tooling/policy-pack/lint-rules/rules/prefer-exact-optional-key.grit"
  ],
  "files": {
    "includes": [
      "**",
      "!.beep",
      "!**/.beep",
      "!.agents",
      "!.repos",
      "!.codex",
      "!.claude/worktrees",
      // Vendored skills (every `vendored` entry in skills-lock.json) must stay
      // byte-exact upstream so the lock can pin them pristine (design B23);
      // `.agents` is excluded above, and the skills-command test fails when a
      // vendored target is missing here. `skills-lock.json` is written only by
      // `beep skills`, whose rendering is the canonical byte form.
      "!.claude/skills/grill-me",
      "!.claude/skills/portless",
      "!.claude/skills/shadcn",
      "!.claude/skills/teach",
      "!.claude/skills/turborepo",
      "!skills-lock.json",
      "!.grok",
      "!specs",
      "!**/.tsup",
      "!**/.turbo",
      "!**/public",
      "!**/build",
      "!**/.next",
      "!.tsbuildinfo",
      "!**/__snapshots__",
      "!./package.json",
      "!**/vendor",
      "!infra/ci-runners/sdks",
      "!**/certificates",
      "!**/generated",
      "!**/node_modules",
      "!**/out",
      "!**/*.gen.*",
      "!**/.cache",
      "!**/bun.lock",
      "!**/dist",
      "!standards/fallow.boundaries.generated.jsonc",
      "!hold-ledger/syncpack-held.generated.json",
      "!standards/instrumentation-catalog",
      "!standards/schema-catalog",
      "!standards/fallow.dead-code.regression-baseline.jsonc",
      "!standards/repo-exports.catalog.jsonc",
      // Only the CI knowledge mint writes the sealed baseline bytes.
      "!goals/knowledge-doctor.baseline.jsonc",
      "!**/fixtures/f1/documents",
      // Retained archive inputs and generator-owned KPI bytes keep their original
      // serialization; consumer regression/digest checks own these exact files.
      "!packages/law-practice/server/test/fixtures/claim-element/positive-sampling.json",
      "!packages/law-practice/server/test/fixtures/claim-element/allowed-sampling.json",
      "!packages/law-practice/server/test/fixtures/claim-element/reference-freeze.json",
      "!packages/law-practice/server/test/fixtures/claim-element/implementation-freeze.json",
      "!packages/law-practice/server/test/fixtures/claim-element/positive-source-freeze.json",
      "!apps/labs/ciops/test/fixtures/retained-evidence/kpi-reading.json",
      // Captured certainty corpora replayed byte-for-byte by ci-certainty.test.ts.
      "!packages/tooling/tool/cli/test/fixtures/ci-certainty/*.json",
      // Canonical Python payload bytes are hash-bound and deliberately retain
      // upstream text. ops/check-operations.ts validates this generated corpus.
      "!packages/law-practice/use-cases/test/fixtures/eyecite/operation-cases.json",
      // Sealed generated diff corpus; dedicated schema/hash verification owns its bytes.
      "!packages/law-practice/use-cases/test/fixtures/eyecite/diff-kernel.json",
      // Complete compact source rows, sealed by ops/verify-builtin-diff.py (removed, goal python-free-repo).
      "!packages/law-practice/use-cases/test/fixtures/eyecite/builtin-diff.json",
      // Complete source traces; ops/check-cleaner-pipeline.ts seals their bytes.
      "!packages/law-practice/use-cases/test/fixtures/eyecite/cleaner-pipeline.json",
      // Complete byte-source outcomes; CitationHtmlBytes.test.ts pins their digest.
      "!packages/law-practice/use-cases/test/fixtures/eyecite/html-bytes.json",
      // Complete source identity relations, sealed by ops/verify-cleaner-identities.py (removed, goal python-free-repo).
      "!packages/law-practice/use-cases/test/fixtures/eyecite/cleaner-identities.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/unicode-dictionary.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/python-hashes.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/cleaner-unicode.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/assertion-cases.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/python-repr-cases.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/builtin-dump-cases.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/token-equality.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/source-inventory.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/canonical-cases.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/regex-inventory.json",
      // Python-owned descriptor bytes; the fixed native qualifier authenticates
      // the file and every source instance binding. Preserve producer formatting.
      "!packages/law-practice/use-cases/test/fixtures/eyecite/regex-program-facts.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/regex-match-witnesses.json",
      // Keep one authenticated source dispatch vector per line for review.
      "!packages/law-practice/use-cases/test/fixtures/eyecite/token-dispatch.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/token-context.json",
      // Source process traces are hash-authenticated by CitationCaseNameProcess.fixtures.ts.
      "!packages/law-practice/use-cases/test/fixtures/eyecite/case-name-process.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/typescript-extensions.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/vocabulary-mapping.json",
      "!packages/law-practice/use-cases/test/fixtures/eyecite/regex-adversarial-corpus.json",
      "!scratchpad",
      // beep-ci-operational-ontology §4b: digest-locked run evidence. The
      // adapter engine bytes are pinned by a sha256 sidecar and the archived
      // run manifest, and the runs/ tree (manifest, observations, vendored
      // judging engine incl. JSON contract bytes) is captured provenance —
      // a format sweep rewriting any of it falsifies the recorded run
      // (PR #865 reformatted the adapter and broke its engine check).
      "!explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/adapters",
      "!explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/runs",
      "!explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/corpus/run3-fleet",
      "!explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/corpus/run3-checkout-identity",
      "!explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/corpus/run3b-fleet",
      "!explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/corpus/run3b-synthetic",
      "!explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/corpus/run4-fleet",
      "!explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/corpus/run4-ledger",
      // ciops lab: the gate-order handoff fixture is pinned by sha256 (goal ciops-ontology-pipeline P2 Ruling 2).
      "!apps/labs/ciops/test/fixtures",
      "!**/modeling/html/data",
      // @beep/sbom: the CycloneDX JSON schema is an upstream byte copy pinned by
      // sha256 in test/fixtures/VENDORED.md; reformatting it breaks that pin.
      "!packages/foundation/modeling/sbom/test/fixtures/*.schema.json"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "trailingCommas": "none",
      "lineWidth": 80
    },
    "parser": {
      "allowComments": true
    }
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2,
    "formatWithErrors": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "jsxQuoteStyle": "double",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": {
          // biome 2.5.1 made `level` a required field on assist actions. This action was
          // previously configured with options only (no level), which biome <=2.5.0 treated
          // as disabled — repo JSON files are unsorted and lint was green. Keep it explicitly
          // off to preserve that behavior; enabling key-sort enforcement is a separate change.
          "level": "off",
          "options": {
            "sortOrder": "natural"
          }
        },
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [{ "type": false }, { "type": true }]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "turborepo": "recommended"
    },
    "rules": {
      "security": {
        "noDangerouslySetInnerHtml": "warn",
        "noGlobalEval": "error"
      },
      "a11y": {
        "useFocusableInteractive": "off",
        "useAriaPropsForRole": "off",
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        // Effect style alignment. Kept advisory: the flagged constructors carry typed
        // parameters / DI shape that are not safely removable (see STYLE.md).
        "noUselessConstructor": "warn",
        "noUselessFragments": "off",
        "noThisInStatic": "off",
        "noForEach": "off",
        "noStaticOnlyClass": "off",
        "noArguments": "off",
        "noCommaOperator": "off",
        "noUselessUndefinedInitialization": "off",
        "useLiteralKeys": {
          "fix": "unsafe",
          "level": "error",
          "options": {}
        }
      },
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": {
          "level": "error",
          "fix": "none",
          "options": {}
        },
        "noUnusedVariables": "off",
        "useUniqueElementIds": "off",
        "useYield": "off",
        "noChildrenProp": "off",
        "noSwitchDeclarations": "off",
        "noUndeclaredVariables": "off",
        "useExhaustiveDependencies": "off",
        "noUnusedFunctionParameters": "off",
        "useHookAtTopLevel": "off"
      },
      "performance": {
        "noDelete": "off",
        "noAccumulatingSpread": "off"
      },
      "suspicious": {
        // Project-domain rule: enabling it here makes every `biome check .` scan the
        // whole repository (1.8 s / ~75 CPU-s per package, for ~0.1 s of linting; 188
        // packages per Turbo lint run). It runs once at the root instead, as the
        // cached `lint:deprecated-imports` task inside `beep lint policy`.
        "noDeprecatedImports": "off",
        // Effect style alignment. noVar is mandatory (P2, 0 violations). noConsole stays
        // advisory: enforcing it repo-wide is a large, separate effort and much console
        // use is legitimate (see STYLE.md).
        "noConsole": "warn",
        "noVar": "error",
        // Biome reads only turbo's legacy top-level `globalEnv`/`globalPassThroughEnv`
        // keys. This repo runs `futureFlags.globalConfiguration`, so those declarations
        // live under `global.env`/`global.passThroughEnv` and Biome cannot see them.
        // Every name below IS declared there; list them one by one rather than allowing
        // a `BEEP_.*` pattern, so a genuinely undeclared variable still warns.
        "noUndeclaredEnvVars": {
          "level": "warn",
          "options": {
            "allowedEnvVars": [
              "BEEP_NODE_BIN",
              "BEEP_YEET_ADMISSION_LEASE_ID",
              "BEEP_YEET_ADMISSION_WORKLOAD_PATH"
            ]
          }
        },
        "noControlCharactersInRegex": "off",
        "noSelfCompare": "off",
        "noUnsafeDeclarationMerging": "off",
        "useAdjacentOverloadSignatures": "off",
        "noDoubleEquals": "off",
        "noPrototypeBuiltins": "off",
        "noDebugger": "error",
        "noRedeclare": "off",
        "noConfusingVoidType": "off",
        "noShadowRestrictedNames": "off",
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "warn",
        "useIterableCallbackReturn": "off",
        "noTemplateCurlyInString": "off",
        "noThenProperty": "off",
        "noDuplicateObjectKeys": "off",
        "noCommentText": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "noUnusedTemplateLiteral": "off",
        "noParameterAssign": "off",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "useNumberNamespace": "error",
        "useConsistentArrowReturn": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "uuid": "Use the effect/crypto services: SecureRandom.uuidV4, SecureRandom.uuidV7, or Digest for name-based ids. uuid is not a repository dependency."
            },
            "patterns": [
              {
                "group": ["uuid/**"],
                "message": "Use the effect/crypto services: SecureRandom.uuidV4, SecureRandom.uuidV7, or Digest for name-based ids. uuid is not a repository dependency."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/law-practice/server/src/internal/Citation/**"],
      "plugins": [
        "./packages/tooling/policy-pack/lint-rules/rules/no-citation-optional-invocation.grit"
      ]
    },
    {
      // Qualification evidence references exact file bytes. Format changes would
      // invalidate accepted historical receipts without changing their meaning.
      // The ciops KPI reading and adoption table are rendered by the lab, pinned by
      // sha256 and compared byte-for-byte by its check-by-default scripts and tests.
      "includes": [
        "goals/turborepo-task-qualification/research/**/*.json",
        // Claim references and prior rounds are byte-bound to critic/attorney receipts.
        "packages/law-practice/domain/test/fixtures/claim-element/positive/**/*.json",
        "packages/epistemic/server/test/fixtures/retention-calibration/protocol-v1.json",
        "packages/epistemic/server/test/fixtures/retention-calibration/fixture-v1.json",
        "goals/ciops-ontology-pipeline/research/kpi-reading.json",
        "goals/ciops-ontology-pipeline/research/kpi-adoption-table.json",
        "standards/cache-qualification.json",
        "standards/cache-qualification-baseline.json",
        // Sealed knowledge-doctor mint: `verify-mint` compares the exact
        // JSON.stringify(..., 2) bytes, which Biome collapses.
        "goals/knowledge-doctor.baseline.jsonc"
      ],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["standards/cache-qualification-baseline.json"],
      "files": { "maxSize": 8388608 }
    },
    {
      "includes": ["standards/coverage.regression-baseline.jsonc"],
      "files": { "maxSize": 2097152 }
    },
    {
      "includes": [
        "packages/foundation/ui-system/editor/test/fixtures/capability-atlas.json"
      ],
      "files": { "maxSize": 2097152 }
    },
    {
      // @beep/lint-rules no-native-error: replaces `beep lint tooling-tagged-errors`,
      // scoped to tooling source roots only (advisory "warn"; flips to error in P2).
      "includes": ["packages/tooling/**/src/**"],
      "plugins": [
        "./packages/tooling/policy-pack/lint-rules/rules/no-native-error.grit"
      ]
    },
    {
      // no-bigint-literals: scope to source roots only. The repo uses bigint literals
      // legitimately as test/`LiteralKit` data (P0 counted 446 hits, ~423 in tests);
      // enforcing in `**/src/**` keeps the advisory signal on real source (~23).
      "includes": ["**/src/**", "infra/**"],
      "plugins": [
        "./packages/tooling/policy-pack/lint-rules/rules/no-bigint-literals.grit"
      ]
    },
    {
      // no-hand-rolled-canonical-json (goals/canonical-digest-owner): source roots
      // only, since tests build JSON, YAML and glob text on purpose. @beep/jsonc owns
      // the canonical encoder and is exempt. Census rows that keep an encoder carry
      // an in-source biome-ignore naming the row.
      "includes": ["**/src/**", "!packages/foundation/modeling/jsonc/**"],
      "plugins": [
        "./packages/tooling/policy-pack/lint-rules/rules/no-hand-rolled-canonical-json.grit"
      ]
    },
    {
      // no-hand-rolled-git-gh-spawn (goals/repo-cli-gh-git-consolidation, D-23):
      // repo-cli and ai-metrics source run git and gh through @beep/git,
      // @beep/github and @beep/commands. A spawn that stays hand-rolled carries an
      // in-source `biome-ignore ...: KEEP (D-nn): <reason>`.
      "includes": [
        "packages/tooling/tool/cli/src/**",
        "packages/tooling/library/ai-metrics/src/**"
      ],
      "plugins": [
        "./packages/tooling/policy-pack/lint-rules/rules/no-hand-rolled-git-gh-spawn.grit"
      ]
    },
    {
      // no-unrecorded-spawner-double (D-14, D-23): repo-cli and ai-metrics tests
      // script child processes with @beep/commands ScriptedSpawner; a hand-rolled
      // double carries an in-source `biome-ignore ...: Own double: <reason>`.
      "includes": [
        "packages/tooling/tool/cli/test/**",
        "packages/tooling/library/ai-metrics/test/**"
      ],
      "plugins": [
        "./packages/tooling/policy-pack/lint-rules/rules/no-unrecorded-spawner-double.grit"
      ]
    },
    {
      // noConsole allowlist: tests, examples, stories, scripts, seeds, CLI bins, and
      // exploration research regenerators (evidence scripts under research/) legitimately
      // use console. Keeps the advisory signal focused on runtime source.
      "includes": [
        "explorations/**/research/**",
        "**/test/**",
        "**/__tests__/**",
        "**/*.test.*",
        "**/*.spec.*",
        "**/examples/**",
        "**/*.stories.*",
        "**/stories/**",
        "**/scripts/**",
        "**/*.bench.*",
        "**/seed/**",
        "**/seeds/**",
        "**/bin.ts",
        "**/bin-main.ts"
      ],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
