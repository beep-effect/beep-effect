+// GHSA-qwgh-2vcv-g2f7 describes a later inline-cursor implementation.
+// In pinned0.10.4 the cursor is a separate private field, outside the block.
+use block_buffer::{EagerBuffer, generic_array::typenum::U4};
+use std::panic::{AssertUnwindSafe, catch_unwind};
+
+#[test]
+fn pinned_legacy_cursor_is_not_corrupted_by_a_panicking_callback() {
+    for value in 0..=u8::MAX {
+        let mut buffer = EagerBuffer::<U4>::new(&[1, 2]);
+        assert!(
+            catch_unwind(AssertUnwindSafe(|| {
+                buffer.digest_blocks(&[3, value], |_| panic!("synthetic compression failure"));
+            }))
+            .is_err()
+        );
+        assert_eq!(buffer.get_pos(), 2);
+        buffer.reset();
+        buffer.digest_blocks(&[4; 8], |_| {});
+        assert_eq!(buffer.get_pos(), 0);
+    }
+}
