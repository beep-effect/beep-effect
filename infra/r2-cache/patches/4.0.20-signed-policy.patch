+//! The signed-epoch policy is independent of artifact HMAC and S3 credentials.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Role {
+    Reader,
+    Writer,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Code {
+    Allowed,
+    AuthenticationDenied,
+    WriteDenied,
+    TenantDenied,
+    SelectorInvalid,
+    RouteInvalid,
+    MethodDenied,
+    SignatureMissing,
+    MetadataInvalid,
+    NotFound,
+    Throttled,
+    BackendUnavailable,
+    WriteAmbiguous,
+    PayloadRejected,
+    UnexpectedStatus,
+}
+impl Code {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Allowed => "allowed",
+            Self::AuthenticationDenied => "authentication-denied",
+            Self::WriteDenied => "write-denied",
+            Self::TenantDenied => "tenant-denied",
+            Self::SelectorInvalid => "selector-invalid",
+            Self::RouteInvalid => "route-invalid",
+            Self::MethodDenied => "method-denied",
+            Self::SignatureMissing => "signature-missing",
+            Self::MetadataInvalid => "metadata-invalid",
+            Self::NotFound => "not-found",
+            Self::Throttled => "throttled",
+            Self::BackendUnavailable => "backend-unavailable",
+            Self::WriteAmbiguous => "write-ambiguous",
+            Self::PayloadRejected => "payload-rejected",
+            Self::UnexpectedStatus => "unexpected-status",
+        }
+    }
+    pub fn status(self) -> u16 {
+        match self {
+            Self::Allowed => 200,
+            Self::AuthenticationDenied => 401,
+            Self::WriteDenied | Self::TenantDenied => 403,
+            Self::RouteInvalid | Self::NotFound => 404,
+            Self::MethodDenied => 405,
+            Self::Throttled => 429,
+            Self::BackendUnavailable | Self::WriteAmbiguous => 503,
+            Self::UnexpectedStatus => 502,
+            Self::SelectorInvalid
+            | Self::SignatureMissing
+            | Self::MetadataInvalid
+            | Self::PayloadRejected => 400,
+        }
+    }
+    pub fn from_response(method: &str, status: u16) -> Self {
+        match status {
+            200..=299 => Self::Allowed,
+            401 => Self::AuthenticationDenied,
+            404 => Self::NotFound,
+            429 => Self::Throttled,
+            400 | 413 => Self::PayloadRejected,
+            500..=599 if method == "PUT" => Self::WriteAmbiguous,
+            500..=599 => Self::BackendUnavailable,
+            _ => Self::UnexpectedStatus,
+        }
+    }
+}
+#[derive(Clone, Debug)]
+pub struct Policy {
+    namespace: String,
+    role: Role,
+}
+impl Policy {
+    pub fn new(namespace: String, role: &str) -> Result<Self, Code> {
+        if !(8..=96).contains(&namespace.len())
+            || !namespace.starts_with("team_")
+            || !namespace
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+        {
+            return Err(Code::SelectorInvalid);
+        }
+        let role = match role {
+            "reader" => Role::Reader,
+            "writer" => Role::Writer,
+            _ => return Err(Code::WriteDenied),
+        };
+        Ok(Self { namespace, role })
+    }
+    /// Accept exactly one canonical native selector, never a decoded alias or unknown query.
+    pub fn assess(&self, method: &str, path: &str, query: &str, tags: &[&str]) -> Code {
+        let namespace = query
+            .strip_prefix("teamId=")
+            .or_else(|| query.strip_prefix("slug="));
+        let Some(namespace) = namespace else {
+            return Code::SelectorInvalid;
+        };
+        if namespace.is_empty()
+            || !namespace
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+        {
+            return Code::SelectorInvalid;
+        }
+        if namespace != self.namespace {
+            return Code::TenantDenied;
+        }
+        match (method, path) {
+            ("GET", "/v8/artifacts/status")
+            | ("POST", "/v8/artifacts/events")
+            | ("POST", "/v8/artifacts") => Code::Allowed,
+            (_, "/v8/artifacts/status" | "/v8/artifacts/events" | "/v8/artifacts") => {
+                Code::MethodDenied
+            }
+            _ => {
+                let Some(hash) = path.strip_prefix("/v8/artifacts/") else {
+                    return Code::RouteInvalid;
+                };
+                if !(16..=64).contains(&hash.len())
+                    || !hash
+                        .bytes()
+                        .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                {
+                    return Code::RouteInvalid;
+                }
+                match method {
+                    "GET" | "HEAD" => Code::Allowed,
+                    "PUT" if self.role == Role::Reader => Code::WriteDenied,
+                    "PUT" if tags.is_empty() || tags.iter().any(|tag| tag.trim().is_empty()) => {
+                        Code::SignatureMissing
+                    }
+                    "PUT"
+                        if tags.len() != 1
+                            || tags.iter().any(|tag| tag.len() > 512 || !tag.is_ascii()) =>
+                    {
+                        Code::MetadataInvalid
+                    }
+                    "PUT" => Code::Allowed,
+                    _ => Code::MethodDenied,
+                }
+            }
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const PATH: &str = "/v8/artifacts/0123456789abcdef";
+    const TEAM: &str = "team_beep_signed_epoch_1";
+    fn policy(role: &str) -> Policy {
+        Policy::new(TEAM.to_owned(), role).unwrap()
+    }
+    #[test]
+    fn canonical_configuration_only() {
+        for team in [
+            "",
+            "beep",
+            "team_../escape",
+            "team_test%2fescape",
+            "team_test&slug=x",
+        ] {
+            assert!(Policy::new(team.to_owned(), "writer").is_err());
+        }
+        assert!(Policy::new(TEAM.to_owned(), "admin").is_err());
+    }
+    #[test]
+    fn reader_has_no_artifact_write_capability() {
+        assert_eq!(
+            policy("reader").assess("PUT", PATH, &format!("teamId={TEAM}"), &["opaque"]),
+            Code::WriteDenied
+        );
+        for method in ["GET", "HEAD"] {
+            assert_eq!(
+                policy("reader").assess(method, PATH, &format!("teamId={TEAM}"), &[]),
+                Code::Allowed
+            );
+        }
+    }
+    #[test]
+    fn writer_requires_one_bounded_opaque_tag() {
+        let p = policy("writer");
+        let query = format!("teamId={TEAM}");
+        assert_eq!(p.assess("PUT", PATH, &query, &[]), Code::SignatureMissing);
+        assert_eq!(p.assess("PUT", PATH, &query, &[""]), Code::SignatureMissing);
+        assert_eq!(
+            p.assess("PUT", PATH, &query, &["one", "two"]),
+            Code::MetadataInvalid
+        );
+        assert_eq!(
+            p.assess("PUT", PATH, &query, &[&"x".repeat(513)]),
+            Code::MetadataInvalid
+        );
+        assert_eq!(
+            p.assess("PUT", PATH, &query, &["v=1:opaque-tag"]),
+            Code::Allowed
+        );
+    }
+    #[test]
+    fn rejects_conflicting_duplicate_encoded_and_unknown_selectors() {
+        let p = policy("reader");
+        for query in [
+            "",
+            "teamId=",
+            "teamId=team_beep_signed_epoch_1&teamId=other",
+            "teamId=team_beep_signed_epoch_1&slug=other",
+            "slug=team_beep_signed_epoch_1&teamId=other",
+            "teamId=team_beep_signed_epoch_1%2fescape",
+            "teamId=team_beep_signed_epoch_1+suffix",
+            "unknown=team_beep_signed_epoch_1",
+        ] {
+            assert_eq!(p.assess("GET", PATH, query, &[]), Code::SelectorInvalid);
+        }
+        assert_eq!(
+            p.assess("GET", PATH, "teamId=team_foreign_epoch", &[]),
+            Code::TenantDenied
+        );
+        assert_eq!(
+            p.assess("GET", PATH, "teamId=team_beep_signed_epoch_0", &[]),
+            Code::TenantDenied
+        );
+    }
+    #[test]
+    fn accepts_native_id_and_slug_without_ambiguity() {
+        for selector in ["teamId", "slug"] {
+            assert_eq!(
+                policy("reader").assess("GET", PATH, &format!("{selector}={TEAM}"), &[]),
+                Code::Allowed
+            );
+        }
+    }
+    #[test]
+    fn rejects_escaping_and_encoded_artifact_paths() {
+        for path in [
+            "/v8/artifacts/../escape",
+            "/v8/artifacts/%30%31",
+            "/v8/artifacts/0123456789abcdef/extra",
+            "/v8/artifacts/ABCDEF0123456789",
+            "/v8/artifacts/hash",
+            "/v7/artifacts/0123456789abcdef",
+        ] {
+            assert_eq!(
+                policy("reader").assess("GET", path, &format!("teamId={TEAM}"), &[]),
+                Code::RouteInvalid
+            );
+        }
+        assert_eq!(
+            policy("writer").assess("DELETE", PATH, &format!("teamId={TEAM}"), &[]),
+            Code::MethodDenied
+        );
+    }
+    #[test]
+    fn metadata_routes_are_tenant_bound_and_method_limited() {
+        for (method, path) in [
+            ("GET", "/v8/artifacts/status"),
+            ("POST", "/v8/artifacts/events"),
+            ("POST", "/v8/artifacts"),
+        ] {
+            assert_eq!(
+                policy("reader").assess(method, path, &format!("teamId={TEAM}"), &[]),
+                Code::Allowed
+            );
+            assert_eq!(
+                policy("reader").assess(method, path, "slug=team_foreign_epoch", &[]),
+                Code::TenantDenied
+            );
+        }
+    }
+    #[test]
+    fn unknown_not_found_is_not_claimed_as_a_genuine_miss() {
+        assert_eq!(Code::from_response("GET", 404), Code::NotFound);
+    }
+    #[test]
+    fn preserve_ambiguous_writes_and_transient_faults() {
+        assert_eq!(Code::from_response("PUT", 500), Code::WriteAmbiguous);
+        assert_eq!(Code::from_response("GET", 500), Code::BackendUnavailable);
+        assert_eq!(Code::from_response("GET", 429), Code::Throttled);
+        assert_eq!(Code::from_response("PUT", 201), Code::Allowed);
+    }
+}
