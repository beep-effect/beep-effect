+/// A bounded machine-readable result, with no request-derived detail or raw cause.
+fn policy_denied(req: ServiceRequest, code: Code) -> ServiceResponse {
+    let status =
+        actix_web::http::StatusCode::from_u16(code.status()).expect("Policy status is valid");
+    let mut response = HttpResponse::build(status);
+    response.insert_header(("x-beep-cache-result", code.label()));
+    if code == Code::AuthenticationDenied {
+        response.insert_header((header::WWW_AUTHENTICATE, "Bearer"));
+    }
+    req.into_response(response.json(AuthError {
+        error: code.label(),
+    }))
+}
