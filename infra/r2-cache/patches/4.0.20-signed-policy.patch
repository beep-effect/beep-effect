+#[actix_web::test]
+async fn signed_policy_denials_never_reach_the_backend_and_never_reflect_input() {
+    for role in ["reader", "writer"] {
+        let mut settings = get_settings();
+        settings.turbo_token = Some("synthetic-bound-bearer".into());
+        settings.cache_policy = Some(Policy::new("team_beep_epoch_1".to_owned(), role).unwrap());
+        let calls = Arc::new(AtomicUsize::new(0));
+        let observed = Arc::clone(&calls);
+        let app = test::init_service(
+            App::new()
+                .app_data(web::Data::new(settings))
+                .wrap(from_fn(validate_turbo_token))
+                .default_service(web::to(move || {
+                    observed.fetch_add(1, Ordering::SeqCst);
+                    async { HttpResponse::Created().finish() }
+                })),
+        )
+        .await;
+        let path = "/v8/artifacts/0123456789abcdef?teamId=team_beep_epoch_1";
+        let role_write = if role == "reader" {
+            (403, "write-denied")
+        } else {
+            (201, "allowed")
+        };
+        for (method, url, auth, tag, status, code) in [
+            (Method::GET, path, false, None, 401, "authentication-denied"),
+            (
+                Method::GET,
+                "/v8/artifacts/0123456789abcdef?teamId=team_private_selector",
+                true,
+                None,
+                403,
+                "tenant-denied",
+            ),
+            (
+                Method::GET,
+                "/v8/artifacts/0123456789abcdef?teamId=team_beep_epoch_1&slug=private_query_secret",
+                true,
+                None,
+                400,
+                "selector-invalid",
+            ),
+            (
+                Method::GET,
+                "/v8/artifacts/0123456789abcdef?teamId=team_beep_epoch_1%2fescape",
+                true,
+                None,
+                400,
+                "selector-invalid",
+            ),
+            (
+                Method::GET,
+                "/v8/artifacts/%30%31?teamId=team_beep_epoch_1",
+                true,
+                None,
+                404,
+                "route-invalid",
+            ),
+            (
+                Method::PUT,
+                path,
+                true,
+                Some("synthetic-private-opaque-tag"),
+                role_write.0,
+                role_write.1,
+            ),
+            (Method::GET, path, true, None, 201, "allowed"),
+        ] {
+            let before = calls.load(Ordering::SeqCst);
+            let mut request = test::TestRequest::default().method(method).uri(url);
+            if auth {
+                request = request.insert_header(("Authorization", "Bearer synthetic-bound-bearer"));
+            }
+            if let Some(tag) = tag {
+                request = request.insert_header(("x-artifact-tag", tag));
+            }
+            let response = test::call_service(&app, request.to_request()).await;
+            assert_eq!(response.status().as_u16(), status);
+            assert_eq!(response.headers().get("x-beep-cache-result").unwrap(), code);
+            let body = test::read_body(response).await;
+            let body = std::str::from_utf8(&body).unwrap();
+            for secret in [
+                "synthetic-bound-bearer",
+                "team_private_selector",
+                "private_query_secret",
+                "synthetic-private-opaque-tag",
+            ] {
+                assert!(!body.contains(secret));
+            }
+            assert_eq!(
+                calls.load(Ordering::SeqCst) - before,
+                usize::from(status < 400)
+            );
+        }
+    }
+}
+
+#[actix_web::test]
+async fn writer_tag_rejection_precedes_backend_io() {
+    let mut settings = get_settings();
+    settings.turbo_token = Some("synthetic-bound-bearer".into());
+    settings.cache_policy = Some(Policy::new("team_beep_epoch_1".to_owned(), "writer").unwrap());
+    let app = test::init_service(
+        App::new()
+            .app_data(web::Data::new(settings))
+            .wrap(from_fn(validate_turbo_token))
+            .default_service(web::to(|| async {
+                panic!("Denied upload reached backend");
+                HttpResponse::Ok().finish()
+            })),
+    )
+    .await;
+    for tags in [vec![], vec![""], vec!["one", "two"]] {
+        let mut request = test::TestRequest::put()
+            .uri("/v8/artifacts/0123456789abcdef?teamId=team_beep_epoch_1")
+            .insert_header(("Authorization", "Bearer synthetic-bound-bearer"));
+        for tag in &tags {
+            request = request.append_header(("x-artifact-tag", *tag));
+        }
+        let response = test::call_service(&app, request.to_request()).await;
+        assert_eq!(response.status().as_u16(), 400);
+    }
+}
