import * as Cloudflare from "@alchemy.run/cloudflare";
import * as Alchemy from "alchemy";
import * as Config from "effect/Config";
import * as DateTime from "effect/DateTime";
import * as Effect from "effect/Effect";
import * as Duration from "effect/Duration";
import * as S from "effect/Schema";

// This stack owns tokens only. The bucket remains owned by BeepTurboR2Pilot.
export default Alchemy.Stack(
  "BeepTurboR2SignedCredentials",
  {
    providers: Cloudflare.providers(),
    state: Alchemy.localState(),
  },
  Effect.gen(function* () {
    const { accountId } = yield* yield* Cloudflare.CloudflareEnvironment;
    const bucketName = yield* Config.String("R2_PILOT_BUCKET_NAME").pipe(
      Config.withDefault("beep-turbo-r2-pilot"),
      Effect.flatMap(S.decodeUnknownEffect(S.String.check(S.isPattern(/^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$/))))
    );
    const expires = yield* Config.String("R2_SIGNED_TRIAL_EXPIRES_ON").pipe(
      Effect.flatMap(S.decodeUnknownEffect(S.DateTimeUtcFromString))
    );
    const now = yield* DateTime.now;
    yield* S.decodeUnknownEffect(
      S.Number.check(S.isBetween({ minimum: 1, maximum: Duration.toMillis(Duration.days(30)) }))
    )(DateTime.toEpochMillis(expires) - DateTime.toEpochMillis(now));
    const expiresOn = DateTime.formatIso(expires);
    const scopedPolicies = (
      permissionGroups: Cloudflare.ApiToken.PermissionGroupRef[]
    ): Cloudflare.ApiToken.Policy[] => [
      {
        effect: "allow",
        permissionGroups,
        resources: { [`com.cloudflare.edge.r2.bucket.${accountId}_default_${bucketName}`]: "*" },
      },
    ];
    // Same bucket-scoped groups as the provider's S3Credentials binding, which requires a Worker.
    // Host/CI storage tokens never contain the artifact HMAC key.
    yield* Cloudflare.ApiToken.AccountApiToken("SignedTrialReader", {
      name: "beep-turbo-signed-trial-reader",
      accountId,
      expiresOn,
      policies: scopedPolicies(["Workers R2 Storage Bucket Item Read"]),
    });
    yield* Cloudflare.ApiToken.AccountApiToken("SignedTrialWriter", {
      name: "beep-turbo-signed-trial-writer",
      accountId,
      expiresOn,
      policies: scopedPolicies(["Workers R2 Storage Bucket Item Read", "Workers R2 Storage Bucket Item Write"]),
    });
    // The approved secret lane owns token-value handoff; outputs remain nonsecret.
    return { bucketName, expiresOn };
  })
);
