{
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree prune:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(bun run beep yeet status:*)",
      "Bash(bun run beep yeet verify:*)",
      "Bash(bun run beep quality dev:*)",
      "Bash(bun run docgen:local:*)",
      "Bash(bunx turbo ls:*)",
      "Bash(bunx --bun vitest run:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git stash push:*)",
      "Bash(git stash show:*)",
      "Bash(git stash list:*)",
      "Bash(git stash drop:*)",
      "Bash(git worktree remove:*)",
      "Bash(git update-ref refs/archive/:*)",
      "Bash(bun run beep yeet sweep:*)",
      "Bash(bun run beep yeet repair:*)",
      "Bash(bun run beep yeet publish:*)",
      "Bash(bun run beep yeet monitor:*)",
      "Bash(bun run beep yeet closeout:*)",
      "Bash(bun run beep worktree new:*)",
      "Bash(bun run beep worktree doctor:*)",
      "Bash(bun run beep worktree remove:*)",
      "Bash(bun run beep goals:*)",
      "Bash(bun run beep lint:*)",
      "Bash(bun run beep laws:*)",
      "Bash(rm -rf .beep/fallow)",
      "Bash(bunx commitlint:*)",
      "Bash(bun install:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash pop:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(bun run beep worktree remove --force:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- .)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh repo delete:*)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/docs/_internal/**)",
      "Edit(**/.claude/settings.json)"
    ],
    "defaultMode": "default"
  },
  "enabledMcpjsonServers": ["phoenix-docs"],
  "disabledMcpjsonServers": [
    "chrome-devtools",
    "phoenix",
    "serena",
    "webstorm"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/yeet-inbox.sh claude",
            "timeout": 2,
            "statusMessage": "Checking Yeet inbox"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/law-pulse.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/yeet-inbox.sh claude",
            "timeout": 2,
            "statusMessage": "Reading Yeet inbox"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/packet-projections.sh",
            "timeout": 30,
            "statusMessage": "Refreshing packet projections"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/yeet-inbox.sh claude",
            "timeout": 2,
            "statusMessage": "Reading Yeet inbox"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/yeet-inbox.sh claude",
            "timeout": 2,
            "statusMessage": "Checking Yeet inbox"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/hook-pulse.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": false,
    "serena@claude-plugins-official": false,
    "compound-engineering@compound-engineering-plugin": false
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      }
    }
  },
  "autoMemoryDirectory": "~/.claude/memory/beep-effect"
}
