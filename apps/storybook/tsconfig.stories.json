{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "vitest.storybook.config.ts",
    "vitest.storybook.setup.ts",
    "../../packages/foundation/ui-system/*/stories/**/*.ts",
    "../../packages/foundation/ui-system/*/stories/**/*.tsx",
    "../../packages/drivers/graph-3d/stories/**/*.ts",
    "../../packages/drivers/graph-3d/stories/**/*.tsx"
  ],
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "rootDir": "../..",
    "sourceMap": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.stories.tsbuildinfo",
    "types": ["node", "vite/client"],
    "paths": {
      "@beep/editor": [
        "../../packages/foundation/ui-system/editor/src/index.ts"
      ],
      "@beep/editor/*": ["../../packages/foundation/ui-system/editor/src/*"],
      "@beep/graph-3d": ["../../packages/drivers/graph-3d/src/index.ts"],
      "@beep/graph-3d/browser": [
        "../../packages/drivers/graph-3d/src/browser.ts"
      ],
      "@beep/graph-3d/react": ["../../packages/drivers/graph-3d/src/react.ts"],
      "@beep/lexical-schema": [
        "../../packages/foundation/modeling/lexical/src/index.ts"
      ],
      "@beep/lexical-schema/*": [
        "../../packages/foundation/modeling/lexical/src/*"
      ],
      "@beep/md": ["../../packages/foundation/modeling/md/src/index.ts"],
      "@beep/md/*": ["../../packages/foundation/modeling/md/src/*"],
      "@beep/ui": ["../../packages/foundation/ui-system/ui/src/index.ts"],
      "@beep/ui/*": ["../../packages/foundation/ui-system/ui/src/*"]
    }
  }
}
