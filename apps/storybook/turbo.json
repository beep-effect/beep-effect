{
  "$schema": "https://v2-11-11.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "check": {
      "dependsOn": ["^build", "@beep/dock-react#check", "@beep/editor#check"]
    },
    "storybook": {
      "passThroughEnv": ["PORTLESS", "PORTLESS_URL"]
    },
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/stories/**"
      ]
    }
  }
}
