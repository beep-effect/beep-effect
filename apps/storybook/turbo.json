{
  "$schema": "https://v2-10-13.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "check": {
      "dependsOn": [
        "$TURBO_EXTENDS$",
        "@beep/dock-react#check",
        "@beep/editor#check"
      ]
    },
    "storybook": {
      "passThroughEnv": ["PORTLESS", "PORTLESS_URL"]
    },
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/stories/**"
      ]
    }
  }
}
