# Environment of the practice mail-tagging job. Every value here is a
# placeholder. Keep the real file outside the repository with mode 0600; it is
# the same file the docket-intake service reads. Quote, in double quotes, any
# value that contains a space or a backslash: the file is read both by
# systemd's EnvironmentFile= and by `set -a; . file`.

# --- App settings -----------------------------------------------------------
# Ledgers, checkpoint, and contacts overlay. Default: $HOME/.local/state/beep/practice-mail-tagging
# PRACTICE_MAIL_TAGGING_STATE_DIRECTORY=
# Mailbox the job tags. Default: CLOUD_M365_DOCKET_MAILBOX
# PRACTICE_MAIL_TAGGING_MAILBOX_USER_ID=attorney@example.test
# Required: directory of the practice knowledge-graph bundle (holds practice.duckdb).
PRACTICE_MAIL_TAGGING_KG_BUNDLE_DIRECTORY=/REPLACE/practice-kg-bundle
# Required: matter folder-id map written by the Box onboarding run (JSON).
PRACTICE_MAIL_TAGGING_FOLDER_MAP_PATH=/REPLACE/matter-folders.json
# Required: index of files already in Box (JSONL).
PRACTICE_MAIL_TAGGING_KNOWN_DOCUMENTS_PATH=/REPLACE/box-files.jsonl
# Required: shared Box API-call ledger (JSONL); one line is appended per pass that calls Box.
PRACTICE_MAIL_TAGGING_BOX_CALL_LEDGER_PATH=/REPLACE/box-api-calls.jsonl
# Optional: extra mail folder ids to skip, comma separated. Deleted Items and Junk are always skipped.
# PRACTICE_MAIL_TAGGING_EXCLUDED_FOLDER_IDS=
# Optional: prefix of each pass's label in the Box call ledger. Default: practice-mail-tagging
# PRACTICE_MAIL_TAGGING_RUN_LABEL=practice-mail-tagging
# Optional: messages per mailbox page. Default: 50
# PRACTICE_MAIL_TAGGING_PAGE_SIZE=50
# Optional: where the backfill starts when no checkpoint exists. Default: 2026-07-01T00:00:00Z
# PRACTICE_MAIL_TAGGING_SINCE=2026-07-01T00:00:00Z
# Optional: pause between watch passes; never shorter than 1 minute. Default: 5 minutes
# PRACTICE_MAIL_TAGGING_POLL_INTERVAL="5 minutes"
# Optional: longest pause after consecutive failed watch passes; never shorter than the
# poll interval. Default: 1 hour
# PRACTICE_MAIL_TAGGING_MAX_BACKOFF="1 hour"
# Optional: contact evidence. "off" matches on application, patent, and docket numbers
# only. "kg" also uses the addresses the practice knowledge graph resolves uniquely to one
# matter, plus the optional matter-contacts.json overlay. Keep "off" until the attorney has
# spot-checked a "kg" dry run. Default: off
# PRACTICE_MAIL_TAGGING_CONTACT_EVIDENCE=off

# --- Microsoft 365 app-only credential (shared with docket-intake) ----------
# See docs/runbooks/docket-intake-entra-registration.md for where these come from.
CLOUD_M365_DOCKET_TENANT_ID=00000000-0000-0000-0000-000000000000
CLOUD_M365_DOCKET_CLIENT_ID=00000000-0000-0000-0000-000000000000
CLOUD_M365_DOCKET_CERT_THUMBPRINT_SHA256=REPLACE_WITH_THUMBPRINT
# The PEM private key on one line, with each line break written as \n.
# The double quotes are REQUIRED. Unquoted, systemd's EnvironmentFile= drops the
# backslashes (\n becomes n) and `set -a; . file` splits the value at its spaces.
# Inside double quotes both keep \n literally, and the job turns it back into a line break.
CLOUD_M365_DOCKET_CERT_PRIVATE_KEY="REPLACE_WITH_PEM_HEADER_LINE\nREPLACE_WITH_KEY_LINE\nREPLACE_WITH_PEM_FOOTER_LINE\n"
CLOUD_M365_DOCKET_MAILBOX=attorney@example.test

# --- Box credential ---------------------------------------------------------
# Preferred for watch: the client credentials grant, which refreshes itself.
# Set the client pair and exactly one subject.
DMS_BOX_CLIENT_ID=REPLACE_WITH_CLIENT_ID
DMS_BOX_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
DMS_BOX_ENTERPRISE_ID=REPLACE_WITH_ENTERPRISE_ID
# DMS_BOX_USER_ID=
# Fallback for a single attended run: a developer token, valid for about an hour.
# CLOUD_BOX_TOKEN=
