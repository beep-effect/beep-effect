{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!LICENSE",
        "!.beep/**",
        "!.fallow/**",
        "$TURBO_ROOT$/tools/tsgo-shim/tsgo.js",
        "$TURBO_ROOT$/tools/tsgo-shim/package.json",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vite.shared.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        ".env*"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "APP_ADMINS_EMAILS",
        "ALLOWED_EMAILS",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "EMAIL_*",
        "AUTH_*",
        "OPENAI_*",
        "SECURITY_*",
        "OAUTH_*",
        "NEXT_PUBLIC_*",
        "LIVEBLOCKS_*",
        "RESEND_*"
      ]
    }
  }
}
