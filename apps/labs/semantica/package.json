{
  "name": "@beep/semantica",
  "version": "0.0.0",
  "description": "Semantica port canary: headless Document→KG→eval chain over F1 + W1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/apps/labs/semantica",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "apps/labs/semantica"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "lint": "bun run beep:lint",
    "lint:deprecated-apis": "beep-cli lint deprecated-apis --package .",
    "lint:fix": "bun run beep:lint:fix",
    "lint:laws": "beep-cli lint laws --package .",
    "package-test-typecheck": "beep-cli quality test-tsgo-package",
    "test": "bun run beep:test",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "vite build",
    "beep:check": "tsgo -p tsconfig.check.json",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "canary": "bun run server/main.ts",
    "dev": "portless semantica.labs.beep sh -c 'vite --host 127.0.0.1 --port \"${PORT:-1420}\" --strictPort'",
    "dev:tauri": "tauri dev",
    "fixtures:f1:index": "bun run scripts/generate-f1-index.ts",
    "fixtures:f1:pdfs": "bun run scripts/generate-f1-pdfs.ts",
    "fixtures:f1:text": "bun run scripts/generate-f1-text.ts"
  },
  "dependencies": {
    "@beep/anthropic": "workspace:^",
    "@beep/doc-text": "workspace:^",
    "@beep/duckdb": "workspace:^",
    "@beep/epistemic-domain": "workspace:^",
    "@beep/file-processing": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/langextract": "workspace:^",
    "@beep/nlp": "workspace:^",
    "@beep/nlp-processing": "workspace:^",
    "@beep/openai": "workspace:^",
    "@beep/oxigraph": "workspace:^",
    "@beep/pglite": "workspace:^",
    "@beep/provenance": "workspace:^",
    "@beep/rdf": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/semantic-web": "workspace:^",
    "@beep/wink": "workspace:^",
    "@beep/xai": "workspace:^",
    "@effect/platform-bun": "catalog:",
    "@noble/hashes": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "unpdf": "catalog:"
  },
  "devDependencies": {
    "@tauri-apps/cli": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eyereasoner": "catalog:",
    "jsdom": "catalog:",
    "pdf-lib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
