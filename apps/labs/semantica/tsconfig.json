{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "include": [
    "src",
    "server",
    "scripts",
    "test",
    "vite.config.ts",
    "vitest.config.ts",
    "../../../vitest.shared.ts",
    "../../../vitest.aliases.generated.json"
  ],
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "types": ["node", "bun", "vite/client"],
    "allowJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "dist",
    "rootDir": "../../.."
  },
  "references": [
    {
      "path": "../../../packages/drivers/anthropic/tsconfig.json"
    },
    {
      "path": "../../../packages/drivers/doc-text/tsconfig.json"
    },
    {
      "path": "../../../packages/drivers/duckdb/tsconfig.json"
    },
    {
      "path": "../../../packages/drivers/openai/tsconfig.json"
    },
    {
      "path": "../../../packages/drivers/oxigraph/tsconfig.json"
    },
    {
      "path": "../../../packages/drivers/pglite/tsconfig.json"
    },
    {
      "path": "../../../packages/drivers/wink/tsconfig.json"
    },
    {
      "path": "../../../packages/drivers/xai/tsconfig.json"
    },
    {
      "path": "../../../packages/epistemic/domain/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/capability/file-processing/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/capability/langextract/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/capability/nlp-processing/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/capability/semantic-web/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/modeling/identity/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/modeling/nlp/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/modeling/provenance/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/modeling/rdf/tsconfig.json"
    },
    {
      "path": "../../../packages/foundation/modeling/schema/tsconfig.json"
    }
  ]
}
