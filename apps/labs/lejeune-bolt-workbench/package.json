{
  "name": "@beep/lejeune-bolt-workbench",
  "version": "0.0.0",
  "description": "Deterministic LeJeune Knowledge Desk demo workbench",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/apps/labs/lejeune-bolt-workbench",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "apps/labs/lejeune-bolt-workbench"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "vite build",
    "beep:check": "tsgo -p tsconfig.check.json && tsc -p tsconfig.json --noEmit",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "build": "bun run beep:build",
    "bundle:build": "bun run server/build-bundle.ts",
    "check": "bun run beep:check",
    "codegen": "echo 'no codegen needed'",
    "dev": "portless lejeune-bolt-workbench.labs.beep sh -c 'vite --host 127.0.0.1 --port \"${PORT:-5173}\" --strictPort'",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "provider:smoke": "bun run server/provider-smoke.ts",
    "test": "bun run beep:test",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "dependencies": {
    "@beep/anthropic": "workspace:^",
    "@beep/doc-text": "workspace:^",
    "@beep/duckdb": "workspace:^",
    "@beep/file-processing": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/langextract": "workspace:^",
    "@beep/nlp": "workspace:^",
    "@beep/oxigraph": "workspace:^",
    "@beep/pglite": "workspace:^",
    "@beep/provenance": "workspace:^",
    "@beep/rdf": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/semantic-web": "workspace:^",
    "@beep/ui": "workspace:^",
    "@beep/venice-ai": "workspace:^",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "fflate": "catalog:",
    "pdf-lib": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
