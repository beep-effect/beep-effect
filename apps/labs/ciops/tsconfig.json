{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "include": ["src", "test", "vitest.config.ts", "../../../vitest.shared.ts"],
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node"],
    "allowJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "dist",
    "rootDir": "../../.."
  },
  "references": [
    {
      "path": "../../../packages/foundation/modeling/identity/tsconfig.json"
    },
    {
      "path": "../../../packages/tooling/test-kit/test-utils/tsconfig.json"
    }
  ]
}
