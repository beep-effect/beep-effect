{
  "$schema": "https://v2-11-13.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!CHANGELOG.md",
        "!LICENSE",
        "!.beep/**",
        "!.fallow/**",
        "$TURBO_ROOT$/tools/tsgo-shim/tsgo.js",
        "$TURBO_ROOT$/tools/tsgo-shim/package.json",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vite.shared.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json"
      ]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/goals/time-to-certainty/research/gate-order-handoff.json",
        "$TURBO_ROOT$/explorations/beep-ci-operational-ontology/ontology/extraction/s6/graphs/abox.ttl",
        "$TURBO_ROOT$/explorations/beep-ci-operational-ontology/ontology/extraction/s6/snapshot/raw/journal.ndjson",
        "$TURBO_ROOT$/explorations/beep-ci-operational-ontology/ontology/extraction/s4/beep-ci-ops/corpus/run4-fleet/**",
        "$TURBO_ROOT$/explorations/beep-ci-operational-ontology/research/control-interventions.yaml",
        "$TURBO_ROOT$/explorations/beep-ci-operational-ontology/research/evidence/journal-snapshot-2026-10-01/journal.redacted.ndjson",
        "$TURBO_ROOT$/explorations/beep-ci-operational-ontology/ontology/docs/competency-questions.yaml"
      ]
    }
  }
}
