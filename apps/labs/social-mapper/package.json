{
  "name": "@beep/social-mapper",
  "version": "0.0.0",
  "description": "Maps, keeps and downloads social profiles through a signed-in browser",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/apps/labs/social-mapper",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "apps/labs/social-mapper"
  },
  "scripts": {
    "build": "bun run beep:build",
    "check": "beep-cli gate run check",
    "coverage": "bun run beep:coverage",
    "doctest": "bun run beep:doctest",
    "lint": "bun run beep:lint",
    "lint:deprecated-apis": "beep-cli lint deprecated-apis --package .",
    "lint:fix": "bun run beep:lint:fix",
    "lint:laws": "beep-cli lint laws --package .",
    "package-test-typecheck": "beep-cli quality test-tsgo-package",
    "test": "bun run beep:test",
    "beep:build": "vite build",
    "beep:check": "tsrs -p tsconfig.check.json",
    "beep:coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "beep:doctest": "BEEP_VITEST_DOCTEST=1 bunx vitest run",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "dev": "portless social-mapper.labs.beep sh -c 'vite --host 127.0.0.1 --port \"${PORT:-1420}\" --strictPort'",
    "dev:tauri": "tauri dev",
    "server": "bun run server/main.ts",
    "standin": "bun run server/standin.main.ts",
    "dev:all": "SOCIAL_MAPPER_TOKEN=\"${SOCIAL_MAPPER_TOKEN:-$(openssl rand -hex 24)}\" sh -c 'trap \"kill 0\" EXIT; bun run server & bun run dev'"
  },
  "dependencies": {
    "@beep/brand": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/ui": "workspace:^",
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@tauri-apps/api": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
