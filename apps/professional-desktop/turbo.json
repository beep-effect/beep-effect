{
  "$schema": "https://v2-10-13.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "check": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/stories/**",
        "$TURBO_ROOT$/packages/_internal/db-admin/drizzle/**"
      ]
    },
    "build": {
      "inputs": ["$TURBO_EXTENDS$", ".env*"],
      "env": ["$TURBO_EXTENDS$", "TAURI_*"]
    }
  }
}
