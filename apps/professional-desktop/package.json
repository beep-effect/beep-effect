{
  "name": "@beep/professional-desktop",
  "version": "0.0.3",
  "description": "Minimal Tauri and React shell for the Agentic Professional Runtime desktop app.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/apps/professional-desktop",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "apps/professional-desktop"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "codegen": "bun run scripts/sync-migration-bundle.ts --write",
    "codegen:check": "bun run scripts/sync-migration-bundle.ts --check",
    "dev": "portless professional-desktop.beep sh -c 'vite --host 127.0.0.1 --port \"${PORT:-1421}\" --strictPort'",
    "dev:sidecar": "CHAT_AGENT=fixture bun run sidecar",
    "sidecar": "workspace=\"$(git rev-parse --show-toplevel)/.beep/professional-desktop/ontology-workspace\" && test ! -L \"$workspace\" && mkdir -p \"$workspace\" && test ! -L \"$workspace\" && chmod 700 \"$workspace\" && ONTOLOGY_WORKSPACE_ROOT=\"$workspace\" bun run server/main.ts",
    "build:sidecar": "bun run scripts/build-sidecar.ts",
    "dev:tauri": "tauri dev",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "vite build",
    "beep:check": "tsgo -p tsconfig.check.json && tsc -p tsconfig.json --noEmit && tsgo -p tsconfig.scripts.json --noEmit && bun run codegen:check",
    "beep:lint": "biome check package.json postcss.config.mjs tsconfig.json vite.config.ts vitest.config.ts vitest.coverage.config.ts vitest.integration.config.ts index.html public src server scripts test src-tauri/tauri.conf.json src-tauri/capabilities/default.json",
    "beep:lint:fix": "biome check package.json postcss.config.mjs tsconfig.json vite.config.ts vitest.config.ts vitest.coverage.config.ts vitest.integration.config.ts index.html public src server scripts test src-tauri/tauri.conf.json src-tauri/capabilities/default.json --write",
    "beep:test": "bunx --bun vitest run --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run --config vitest.integration.config.ts --passWithNoTests",
    "beep:test:integration:ipc": "bun run build:sidecar && BEEP_TEST_SIDECAR_IPC=1 bunx --bun vitest run --config vitest.integration.config.ts test/integration/sidecar-ipc-stdio.test.ts",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --config vitest.coverage.config.ts --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "test:integration": "bun run beep:test:integration",
    "test:integration:parallel": "bun run beep:test:integration",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "dependencies": {
    "@beep/agents-client": "workspace:^",
    "@beep/agents-domain": "workspace:^",
    "@beep/agents-server": "workspace:^",
    "@beep/agents-use-cases": "workspace:^",
    "@beep/anthropic": "workspace:^",
    "@beep/cosmos": "workspace:^",
    "@beep/doc-text": "workspace:^",
    "@beep/dock": "workspace:^",
    "@beep/dock-react": "workspace:^",
    "@beep/documents-domain": "workspace:^",
    "@beep/documents-server": "workspace:^",
    "@beep/documents-use-cases": "workspace:^",
    "@beep/editor": "workspace:^",
    "@beep/epistemic-client": "workspace:^",
    "@beep/epistemic-config": "workspace:^",
    "@beep/epistemic-domain": "workspace:^",
    "@beep/epistemic-server": "workspace:^",
    "@beep/epistemic-tables": "workspace:^",
    "@beep/epistemic-ui": "workspace:^",
    "@beep/epistemic-use-cases": "workspace:^",
    "@beep/file-processing": "workspace:^",
    "@beep/graph-3d": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/lexical-schema": "workspace:^",
    "@beep/mcp-kit": "workspace:^",
    "@beep/md": "workspace:^",
    "@beep/observability": "workspace:^",
    "@beep/ontology-client": "workspace:^",
    "@beep/ontology-config": "workspace:^",
    "@beep/ontology-domain": "workspace:^",
    "@beep/ontology-server": "workspace:^",
    "@beep/ontology-ui": "workspace:^",
    "@beep/ontology-use-cases": "workspace:^",
    "@beep/pglite": "workspace:^",
    "@beep/postgres": "workspace:^",
    "@beep/provenance": "workspace:^",
    "@beep/rdf": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "@beep/ui": "workspace:^",
    "@beep/utils": "workspace:^",
    "@beep/workspace-domain": "workspace:^",
    "@beep/workspace-server": "workspace:^",
    "@beep/workspace-use-cases": "workspace:^",
    "@effect/atom-react": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@lexical/react": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-opener": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-legacy-046": "npm:@electric-sql/pglite@0.4.6",
    "@tauri-apps/cli": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "decode-named-character-reference": "catalog:",
    "gl-bench": "catalog:",
    "jsdom": "catalog:",
    "lexical": "catalog:",
    "react-grab": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
