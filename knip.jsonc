{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/**": {
      // Library packages publish their whole top-level src surface via `"./*": "./src/*.ts"`,
      // so treat every src/*.ts as an entry (src/index.ts is already covered by the exports map).
      "entry": ["src/*.ts"]
    },
    "infra": {
      // Pulumi stack entrypoints (src/internal/*-entry.ts) are referenced from Pulumi.yaml,
      // not via TS imports, so knip can't see them — register them as explicit entries.
      // (src/index.ts is already covered by the package's exports map.)
      "entry": ["src/internal/*-entry.ts"]
    },
    "apps/oip-web": {
      // src/app/sw.ts: the PWA service worker entry, compiled by `@serwist/webpack-plugin`
      // (see the file's own header comment) — not reachable via TS imports, and excluded from
      // the app's tsgo project (WebWorker lib conflicts with the app's DOM lib).
      // src/components/MattersCarousel.tsx: temporarily unmounted from OipHomePage pending
      // review-gate sign-off (see the file's own header comment + its `fallow-ignore-file
      // unused-file` marker) — deliberately retained for re-enable, not dead code.
      "entry": ["src/app/sw.ts", "src/components/MattersCarousel.tsx"],
      // src/content/OipContent.model.ts: ExternalLink, SiteAsset, HeroClip, HeroContent,
      // ContactContent are documented public content-model components composing OipContent
      // (e.g. `hero: HeroContent` / `contact: ContactContent` fields, HeroContent -> HeroClip ->
      // SiteAsset, MatterItem/ClientLogo/PressItem -> ExternalLink/SiteAsset) — each individually
      // consumed via a compiling @example import in its own JSDoc AND relied on by several
      // sibling classes' own compiling @example blocks (verified: un-exporting any one breaks
      // other classes' real, currently-compiling constructor examples in the same file). No
      // external module imports them by name; they're only reachable via the composite
      // OipSiteContent schema, so knip's cross-file export check can't see the usage.
      "ignoreExportsUsedInFile": true
    },
    "apps/storybook": {
      // vitest.storybook.config.ts is invoked via `vitest run --config vitest.storybook.config.ts`
      // from scripts/run-storybook-tests.mjs (a CLI flag knip can't trace); it in turn references
      // vitest.storybook.setup.ts (setupFiles) and .storybook/utils-browser.ts (resolve.alias) by
      // string path, not a static import, so both need their own explicit entry too.
      "entry": [
        "vitest.storybook.config.ts",
        "vitest.storybook.setup.ts",
        ".storybook/utils-browser.ts"
      ]
    }
  },
  // Type-tests (tstyche .tst.ts), ops scripts, scratch, test fixtures, runnable examples, and
  // build configs are not part of the analyzable source graph.
  "ignore": [
    "**/dtslint/**",
    "goals/**",
    // explorations/ is the fuzzy front end of the goals/ pipeline (capture -> graduate, see
    // explorations/CLAUDE.md); prototype code there (e.g. identity-as-iri/assets/ontology-prototype)
    // is not a workspace member and isn't part of the analyzable source graph, same as goals/**.
    "explorations/**",
    "scratchpad/**",
    "**/test/fixtures/**",
    "**/examples/**",
    "**/postcss.config.*",
    // tools/skillopt is a uv-managed Python project; its tests/fixtures contain
    // TS files used as SkillOpt eval-task fixtures, not workspace source.
    "tools/skillopt/**",
    // architecture proof barrels: read BY FILE PATH by beep architecture OperationPlan (see repo-cli test architecture-operation-plan.test.ts) — not import-referenced, knip cannot see the usage
    "packages/architecture-lab/*/src/entities/index.ts"
  ],
  // @effect/vitest is imported across virtually every package's tests; knip's vitest plugin
  // doesn't activate per-workspace in this layout, so it would otherwise read as unused everywhere.
  // @effect/language-service is a TypeScript LSP plugin referenced from tsconfig `plugins`
  // (editor-only, best-effort); it is not an importable runtime/build dependency.
  // cspell (cspell.json) and markdownlint-cli2 (.markdownlint-cli2.jsonc) are driven by root
  // config files knip's plugins don't auto-detect here — both configs verified present.
  // babel-plugin-annotate-pure-calls is invoked via the `babel --plugins annotate-pure-calls`
  // CLI flag in every package's build script, which knip can't trace.
  // tsgo: a policy-pack test references the node_modules/.bin/tsgo binary via a path string,
  // which knip misreads as a dependency import (the binary comes from @typescript/native-preview).
  // oxlint (devDependency on @beep/lint-rules): test/oxlint-harness.ts spawns it via
  // `Bun.spawnSync(["bunx", "oxlint", ...])`, a subprocess call knip can't trace as usage.
  // babel/* + babel-plugin-transform-next-use-client: build-toolchain babel plugins driven by the
  // build pipeline (not statically importable); removing them would break `bun run build`.
  // @typescript-eslint/parser + eslint-plugin-jsdoc/tsdoc: imported by the repo-configs ESLint
  // builder (src/eslint/DocsESLintConfig.ts), run via the lefthook jsdoc hook at repo root.
  // tailwindcss + @tailwindcss/postcss: driven by postcss/tailwind configs (postcss.config.* is
  // ignored above), so their usage isn't visible in the import graph.
  // ws + @types/ws: genuinely imported by @beep/xai (src/XAi.service.ts) — knip misses the
  // `import WebSocket from "ws"` default import; @types/ws supplies its types.
  // @beep/repo-utils is referenced from app docgen.json files knip doesn't parse.
  // @beep/form: apps/storybook's `main.ts` stories glob pulls in
  // packages/foundation/ui-system/form/stories/**, which import `@beep/form` — a sibling
  // workspace's story files, invisible to knip's per-workspace import scan of apps/storybook.
  // emojibase-data: referenced by path string in apps/storybook/.storybook/main.ts `staticDirs`,
  // not a static import.
  // inspeffct: intentionally exposed as a root developer CLI via `bun run inspeffct*` scripts;
  // knip sees the package script command as binary usage but does not count that as satisfying
  // the root devDependency.
  // @microsoft/microsoft-graph-types + @lexical/code, @lexical/link, @lexical/list,
  // @lexical/rich-text, lexical: dtslint (packages/drivers/m365/dtslint/M365.tst.ts,
  // packages/foundation/modeling/lexical/dtslint/Lexical.tst.ts) is a wired `type-test` turbo
  // task, but "**/dtslint/**" is excluded from knip's source graph above, so devDependencies
  // used only there read as unused.
  "ignoreDependencies": [
    "@effect/vitest",
    "@effect/language-service",
    "cspell",
    "markdownlint-cli2",
    "babel-plugin-annotate-pure-calls",
    "babel-plugin-transform-next-use-client",
    "@babel/plugin-transform-export-namespace-from",
    "@babel/plugin-transform-modules-commonjs",
    "@typescript-eslint/parser",
    "eslint-plugin-jsdoc",
    "eslint-plugin-tsdoc",
    "tailwindcss",
    "@tailwindcss/postcss",
    "tsgo",
    "oxlint",
    "ws",
    "@types/ws",
    "@beep/repo-utils",
    "@beep/test-utils",
    "@microsoft/microsoft-graph-types",
    "@lexical/code",
    "@lexical/link",
    "@lexical/list",
    "@lexical/rich-text",
    "lexical",
    "@beep/form",
    "emojibase-data",
    "inspeffct",
    // Mirrored from .fallowrc.jsonc (goals/fallow-zero-dead-code): MUI runtime
    // peers, type-only themeAugmentation imports, shared-Next-config plugin
    // loads, and scratchpad-only usage.
    "@emotion/react",
    "@emotion/styled",
    "@mui/x-data-grid",
    "@mui/x-date-pickers",
    "@mui/x-date-pickers-pro",
    "@mui/x-tree-view",
    "@mdx-js/loader",
    "babel-plugin-react-compiler",
    "@faker-js/faker"
  ],
  // op = 1Password CLI, beep-cli = repo CLI bin, portless = dev proxy invoked from app scripts —
  // binaries not provided as a resolvable dependency import. readlink is a POSIX/coreutils
  // system binary (root `instructions:drift` script), never an npm-installable dependency.
  // rustc is the Rust toolchain compiler, invoked via subprocess (`$`rustc -vV``) by
  // apps/professional-desktop/scripts/build-sidecar.ts to read the host target triple —
  // a system toolchain binary, not an npm-installable dependency.
  "ignoreBinaries": [
    "op",
    "beep-cli",
    "portless",
    "readlink",
    "rustc",
    "inspeffct"
  ],
  // Scratchpad is a private experiment workspace kept in the root install graph
  // for dependency/TS trials but excluded from Knip's package graph. Scaffolded
  // test fixtures are likewise deliberately outside dependency-drift review.
  "ignoreWorkspaces": ["scratchpad", "**/test/fixtures/mock-monorepo"],
  "rules": {
    // Duplicate exports here are intentional conventions: Schema/<DomainName> dual-naming on
    // schema modules, Overridable/Overrideable upstream-compat aliases, and named/default React
    // component exports. None are accidental.
    "duplicates": "off",
    // The bun catalog is a curated version-pin registry; entries are intentionally pre-provisioned
    // for planned features, so unused-catalog-entry reports are noise here.
    "catalog": "off"
  }
}
