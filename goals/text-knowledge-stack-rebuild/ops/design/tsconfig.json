{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Effect-diagnostics check for the P0 design module (decision
  // 2026-11-19-p0-design-module-home-and-effect-version). goals/tsconfig.ops.json sets
  // "plugins": [] for frozen ops scripts; this config holds ops/design to the package bar
  // instead. It sets no "plugins" key, so the @effect/language-service block of
  // tsconfig.base.json (via tsconfig.configs.json) applies unchanged, exactly as it does
  // for every package tsconfig. Run: bunx tsrs -p goals/text-knowledge-stack-rebuild/ops/design/tsconfig.json --noEmit
  "extends": "../../../../tsconfig.configs.json",
  "include": ["*.ts"],
  // tsconfig.configs.json excludes goals/**; this project re-includes only this directory.
  "exclude": ["**/node_modules/**", "**/dist/**"],
  "compilerOptions": {
    "rootDir": "../../../..",
    "lib": ["ESNext"]
  }
}
