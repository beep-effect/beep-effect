{
  "schemaVersion": "phase-2-starter-stack/v0",
  "servers": [
    {
      "id": "practice-kg-mcp",
      "required": true,
      "egress": "denied",
      "artifact": "practice-kg-mcp-windows-x64.mcpb",
      "configFields": [
        {
          "id": "bundle_dir",
          "type": "directory",
          "required": true,
          "env": "BUNDLE_DIR"
        },
        {
          "id": "corpus_root",
          "type": "directory",
          "required": false,
          "env": "PRACTICE_KG_CORPUS_ROOT"
        }
      ]
    },
    {
      "id": "uspto-mcp",
      "required": false,
      "egress": "public-uspto-only",
      "artifact": "uspto-mcp.exe",
      "configFields": [
        {
          "id": "uspto_api_key",
          "type": "secret",
          "required": true,
          "env": "USPTO_API_KEY"
        }
      ]
    }
  ],
  "artifacts": [
    {
      "id": "practice-kg-data",
      "kind": "directory",
      "installMode": "copy-and-replace",
      "shippedInsideMcpb": false
    }
  ],
  "skills": {
    "status": "placeholder",
    "installMode": "manual-zip",
    "items": []
  }
}
