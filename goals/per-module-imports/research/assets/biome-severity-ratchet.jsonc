{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "style": {
        "noRestrictedImports": {
          "level": "warn",
          "options": {
            "paths": {
              "effect": "Use per-module imports."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/family-green/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "error"
          }
        }
      }
    }
  ]
}
