{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Library packages intentionally expose top-level src modules through package exports.
  // App workspaces are rooted at their framework entrypoints (Next App Router special
  // files, Vite/Tauri main.tsx, proof-app index.ts, Storybook config) so app code is
  // reachable instead of invisible (goals/fallow-zero-dead-code).
  "entry": [
    "packages/**/src/*.ts",
    "packages/**/src/*/index.ts",
    "infra/src/internal/*-entry.ts",
    "apps/*/src/main.tsx",
    "apps/*/src/index.ts",
    "apps/*/next.config.ts",
    "apps/*/vite.config.ts",
    "apps/*/src/app/layout.tsx",
    "apps/*/src/app/page.tsx",
    "apps/*/src/app/**/layout.tsx",
    "apps/*/src/app/**/page.tsx",
    "apps/*/src/app/**/route.ts",
    "apps/*/src/app/**/loading.tsx",
    "apps/*/src/app/**/error.tsx",
    "apps/*/src/app/**/not-found.tsx",
    "apps/*/src/app/**/global-error.tsx",
    "apps/*/src/app/manifest.ts",
    "apps/*/src/app/robots.ts",
    "apps/*/src/app/sitemap.ts",
    "apps/*/src/mdx-components.tsx",
    "apps/*/src/middleware.ts",
    "apps/*/src/proxy.ts",
    "apps/*/src/instrumentation.ts",
    "apps/storybook/.storybook/main.ts",
    "apps/storybook/.storybook/manager.ts",
    "apps/storybook/.storybook/preview.tsx",
    // Story files are tool-loaded roots: the Storybook host discovers them via
    // the stories glob in apps/storybook/.storybook/main.ts.
    "packages/foundation/ui-system/*/stories/**/*.stories.tsx",
    "packages/drivers/graph-3d/stories/**/*.stories.tsx",
    // Tool-loaded roots: syncpack auto-loads its config, eslint.config.mjs is
    // profile-selected by the Lint command, Changesets loads its changelog
    // module from config, and global-cleanup.ts is the vitest globalSetup for
    // @beep/repo-cli.
    "syncpack.config.ts",
    "eslint.config.mjs",
    "scripts/changeset-changelog.cjs",
    "packages/tooling/tool/cli/test/global-cleanup.ts",
    // Fallow 3.6.0 resolves an explicit `.ts` suffix exactly and does not yet
    // apply TypeScript's `.ts` -> `.tsx` source fallback. Keep the affected TSX
    // modules reachable without making every TSX file an entry point; the
    // matching specifiers are documented under ignoreUnresolvedImports below.
    "packages/foundation/ui-system/ui/src/components/blocks/editor-00/plugins.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.changelog.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.document.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.explorer.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.graph.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.inspector.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.metrics.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.source.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.sparql.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.validation.tsx",
    "packages/ontology/ui/src/aggregates/Session/Session.workbench.tsx"
  ],
  // Approximates dead-code path suppression; Knip remains authoritative for unmigrated workspace/binary policy.
  "ignorePatterns": [
    "goals/**",
    "scratchpad/**",
    "**/test/fixtures/**",
    "**/examples/**",
    "**/postcss.config.*",
    // tools/tsgo-shim provides the repo `tsgo` bin (consumed via node_modules/.bin,
    // never imported), executing the Effect-patched @typescript/native compiler.
    "tools/tsgo-shim/**",
    "packages/canvas/client/**",
    "packages/canvas/ui/**",
    "**/test/fixtures/mock-monorepo/**",
    // Identity-as-IRI exploration prototype assets are packet evidence, not
    // package/app entrypoints in the production dead-code graph.
    "explorations/identity-as-iri/assets/ontology-prototype/**",
    // @beep/html: generated AST (one TaggedClass per HTML element) is intentionally
    // repetitive; the codegen script and vendored spec data are tooling, not
    // hand-authored source subject to dead-code/duplication/complexity review.
    "packages/foundation/modeling/html/src/Html.model.ts",
    "packages/foundation/modeling/html/src/Html.meta.ts",
    "packages/foundation/modeling/html/scripts/**",
    "packages/foundation/modeling/html/data/**",
    // @beep/data: generator-emitted registry modules (sync-data-to-ts) are intentionally
    // repetitive tuple/table output, not hand-authored source subject to
    // dead-code/duplication/complexity review.
    "packages/foundation/primitive/data/src/generated/**",
    // @beep/acp: generator-emitted OpenAPI schema modules (one S.Struct per upstream
    // schema) are intentionally repetitive, not hand-authored source subject to
    // dead-code/duplication/complexity review; the acp resync regeneration surfaced
    // 27 self-clone findings inside the single generated file.
    "packages/drivers/acp/src/_generated/**"
  ],
  // Exact compatibility list for authored `.ts` specifiers whose source file
  // is TSX. Do not broaden this to `**/*.ts`: real unresolved imports must keep
  // failing Fallow. Remove these entries when Fallow supports the TS fallback.
  "ignoreUnresolvedImports": [
    "**/content-editable.ts",
    "**/App.ts",
    "**/Session.changelog.ts",
    "**/Session.document.ts",
    "**/Session.explorer.ts",
    "**/Session.graph.ts",
    "**/Session.inspector.ts",
    "**/Session.metrics.ts",
    "**/Session.source.ts",
    "**/Session.sparql.ts",
    "**/Session.validation.ts",
    "**/Session.workbench.ts",
    "**/plugins.ts"
  ],
  "ignoreDependencies": [
    // brace-expansion, fast-uri, hono: root `dependencies` entries that exist solely to back
    // the security-pin `overrides` in package.json; nothing imports them at root.
    "brace-expansion",
    "fast-uri",
    "hono",
    "@effect/vitest",
    "@effect/language-service",
    "babel-plugin-annotate-pure-calls",
    "babel-plugin-transform-next-use-client",
    "@babel/plugin-transform-export-namespace-from",
    "@babel/plugin-transform-modules-commonjs",
    "@typescript-eslint/parser",
    // tsgo >= 0.18 native TypeScript backend: consumed by the effect-tsgo patch
    // step at install time, never imported from source.
    "@typescript/native",
    // Repo-local `tsgo` bin shim over the patched @typescript/native backend;
    // consumed via node_modules/.bin, never imported from source.
    "@beep/tsgo-shim",
    "eslint-plugin-jsdoc",
    "eslint-plugin-tsdoc",
    "tailwindcss",
    "@tailwindcss/postcss",
    "tsgo",
    "ws",
    "@types/ws",
    "@beep/repo-utils",
    "@beep/test-utils",
    // @beep/ui: MUI's runtime styling engine; required peers of @mui/material even
    // without direct imports (goals/fallow-zero-dead-code/research/triage.md).
    "@emotion/react",
    "@emotion/styled",
    // @beep/ui: consumed via type-only `import type {} from "@mui/x-*/themeAugmentation"`
    // in src/themes/components; empty type imports are invisible to fallow.
    "@mui/x-data-grid",
    "@mui/x-date-pickers",
    "@mui/x-date-pickers-pro",
    "@mui/x-tree-view",
    // Next apps: loaded by @next/mdx inside @beep/repo-configs SharedNextConfig.
    "@mdx-js/loader",
    // Next apps: runtime peer for @next/mdx and mdx-components.tsx; loaded by
    // the framework rather than imported directly from app source.
    "@mdx-js/react",
    // Next apps: loaded by Next when SharedNextConfig defaults reactCompiler: true.
    "babel-plugin-react-compiler",
    // Root: used by git-tracked scratchpad tests; scratchpad/** is ignored above.
    "@faker-js/faker",
    // @beep/lexical-schema: unit tests exercise these Lexical dependencies.
    "lexical",
    "@lexical/list",
    // @beep/storybook: package stories are discovered by Storybook's external
    // stories glob; the host app declares @beep/form so Vite can resolve the
    // workspace package while fallow attributes the imports to the package that
    // owns the stories.
    "@beep/form",
    // @beep/storybook: same stories-glob arrangement for the graph-3d driver
    // stories (goal graph-3d-view).
    "@beep/graph-3d",
    // @beep/storybook: mounted through Storybook staticDirs so frimousse can
    // load the self-hosted emojibase dataset at runtime.
    "emojibase-data",
    // @beep/observability: OTel deps staged 2026-06-12 for in-flight tracing
    // work; remove from this list when the wiring lands.
    "@opentelemetry/resources",
    "@opentelemetry/sdk-trace-node",
    "@opentelemetry/sdk-trace-web",
    // @beep/html: used only by the codegen script (scripts/**, ignored above for
    // analysis), so fallow can't see the import and reads it as unused.
    "@effect/platform-node"
  ],
  // Root overrides below intentionally pin transitive packages. The @effect/tsgo
  // entries cover optional platform binaries; the remaining entries retain the
  // dependency-update security floors. They therefore have no direct manifest
  // declaration for Fallow to associate with the override.
  "ignoreDependencyOverrides": [
    { "package": "@effect/tsgo-darwin-arm64", "source": "package.json" },
    { "package": "@effect/tsgo-darwin-x64", "source": "package.json" },
    { "package": "@effect/tsgo-linux-arm", "source": "package.json" },
    { "package": "@effect/tsgo-linux-arm64", "source": "package.json" },
    { "package": "@effect/tsgo-linux-x64", "source": "package.json" },
    { "package": "@effect/tsgo-win32-arm64", "source": "package.json" },
    { "package": "@effect/tsgo-win32-x64", "source": "package.json" },
    { "package": "@hono/node-server", "source": "package.json" },
    { "package": "@opentelemetry/propagator-jaeger", "source": "package.json" },
    { "package": "brace-expansion", "source": "package.json" },
    { "package": "detailed-xml-validator", "source": "package.json" },
    { "package": "fast-uri", "source": "package.json" },
    { "package": "hono", "source": "package.json" },
    { "package": "js-yaml", "source": "package.json" },
    { "package": "minimatch", "source": "package.json" },
    { "package": "postcss", "source": "package.json" }
  ],
  // `instant` is a Next.js framework config export (blocking-prerender opt-out,
  // see nextjs.org/docs/messages/blocking-prerender-dynamic). The framework
  // consumes it from layout/page modules; fallow's Next plugin does not yet
  // recognize it, and deleting it breaks `next build` (proven 2026-06-11 in
  // goals/fallow-zero-dead-code).
  "ignoreExports": [
    // @beep/canvas command bridge: documented request/schema values kept as
    // public bridge contracts for typed host integrations.
    {
      "file": "apps/canvas/src/commandBridge.ts",
      "exports": ["CanvasSceneNode", "SceneSaveRequest", "SceneLoadRequest"]
    },
    // @beep/oip-web/content: schema-first content contracts are exported for
    // barrel consumers even when current app rendering can keep them internal.
    {
      "file": "apps/oip-web/src/content/OipContent.model.ts",
      "exports": [
        "ReviewGate",
        "ExternalLink",
        "SocialPlatform",
        "SocialLink",
        "SiteAsset",
        "SiteMetadataContent",
        "NavItem",
        "HeroContent",
        "AboutPanel",
        "PracticeArea",
        "MatterItem",
        "ClientLogo",
        "PressItem",
        "ContactContent"
      ]
    },
    // @beep/oip-web/contact: public HttpApi contract symbols kept for
    // compatibility even though the current app route only imports their types.
    {
      "file": "apps/oip-web/src/contact/ContactSubmission.http.ts",
      "exports": ["ContactSubmissionPayload", "OipContactHttpApiGroup"]
    },
    // @beep/oip-web/contact: documented JSON response helper remains part of
    // the public contact module surface.
    {
      "file": "apps/oip-web/src/contact/ContactSubmission.service.ts",
      "exports": ["contactResponseBody"]
    },
    { "file": "apps/*/src/app/*.tsx", "exports": ["instant"] },
    { "file": "apps/*/src/app/**/*.tsx", "exports": ["instant"] }
  ],
  "health": {
    // Complexity ceilings — ratified 2026-07-30 (law in standards/effect-laws-v1.md;
    // mechanism in standards/architecture/DECISIONS.md). Only maxCognitive tightens vs
    // fallow defaults; the rest are pinned so the effective gate is explicit in-repo.
    // Calibration: p99 cognitive = 6 across 41,469 functions; a judged marginal-band
    // panel put every honest best-version ceiling at <=8 (two outliers, override
    // material). Revisit 6 after goals/complexity-ceiling-burn-down clears the >15 tail.
    "maxCognitive": 8,
    "maxCyclomatic": 20,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "thresholdOverrides": [
      {
        "files": [
          "packages/ontology/ui/src/aggregates/Session/Session.inspector.tsx"
        ],
        "functions": ["TripleValidationMessages"],
        "maxCrap": 73,
        "reason": "Pre-existing function unchanged by the import-extension migration; Fallow audit attributes its CRAP finding as introduced when the file's import suffix changes. Review by 2026-10-30: attribution artifact, not a budget — re-verify and drop if audit no longer misattributes."
      },
      {
        "files": [
          "packages/ontology/ui/src/aggregates/Session/Session.sparql.tsx"
        ],
        "functions": ["sparqlResultPreview", "runSparqlFromKeyboard"],
        "maxCrap": 57,
        "reason": "Pre-existing functions unchanged by the import-extension migration; Fallow audit attributes their CRAP findings as introduced when the file's import suffix changes. Review by 2026-10-30: attribution artifact, not a budget — re-verify and drop if audit no longer misattributes."
      },
      {
        "files": [
          "packages/tooling/library/repo-utils/src/schemas/JSDocCategories.ts"
        ],
        "functions": ["normalizeJSDocCategoryKey"],
        "maxCognitive": 12,
        "reason": "Pre-existing slug normalizer body unchanged by the jsdoc-carrier migration; Fallow audit attributes its cognitive finding as introduced when only the JSDoc carrier grammar changes. Review by 2026-11-30: attribution artifact, not a budget — re-verify and drop if audit no longer misattributes."
      }
    ]
  },
  "audit": {
    "gate": "new-only"
  },
  "rules": {
    "duplicate-exports": "off",
    "unused-catalog-entries": "off",
    "empty-catalog-groups": "off",
    "boundary-violation": "error",
    // Suppression hygiene: every fallow-ignore-* marker must carry `-- <reason>`.
    // Enabled 2026-07-30 with the cognitive-ceiling law; legacy bare pragmas were
    // backfilled in the same change.
    "require-suppression-reason": "error"
  }
}
