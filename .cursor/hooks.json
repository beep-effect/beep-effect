{
  "version": 1,
  "hooks": {
    "preToolUse": [{ "command": ".cursor/hooks/hook-pulse.sh", "timeout": 5 }],
    "postToolUse": [{ "command": ".cursor/hooks/hook-pulse.sh", "timeout": 5 }],
    "postToolUseFailure": [
      { "command": ".cursor/hooks/hook-pulse.sh", "timeout": 5 }
    ],
    "beforeSubmitPrompt": [
      { "command": ".cursor/hooks/hook-pulse.sh", "timeout": 5 }
    ],
    "stop": [{ "command": ".cursor/hooks/hook-pulse.sh", "timeout": 5 }],
    "sessionEnd": [{ "command": ".cursor/hooks/hook-pulse.sh", "timeout": 5 }]
  }
}
