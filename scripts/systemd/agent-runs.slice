# Install:
#   cp scripts/systemd/agent-runs.slice ~/.config/systemd/user/
#   mkdir -p ~/.config/systemd/user/agent-runs.slice.d
#   cp scripts/systemd/agent-runs.slice.d/50-oomd.conf ~/.config/systemd/user/agent-runs.slice.d/
#   systemctl --user daemon-reload

[Unit]
Description=beep agent run-lease slice

[Slice]
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksAccounting=yes
# Preserve the workstation's heavy budget adopted from the operator-built
# 50-heavy-budget.conf drop-in. Re-rendering these sources changes no live unit;
# the owner re-syncs installed units separately after merge.
MemoryHigh=48G
MemoryMax=60G
MemorySwapMax=8G
