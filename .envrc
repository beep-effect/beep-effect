# Human-shell convenience layer only. Agent lanes, detached proofs and systemd
# units do not load this file, so anything a tool needs must live in tracked
# config the tool reads itself (bunfig.toml, turbo flags, .mise.toml).
use flake

# Share one local Turbo cache across every sibling checkout (standards/turbo-remote-cache.md).
export TURBO_CACHE_DIR="${TURBO_CACHE_DIR:-$HOME/.cache/beep/turbo}"

# Per-developer overrides, never tracked.
source_env_if_exists .envrc.local
