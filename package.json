    "test:storybook": "bunx turbo run test:storybook --filter=@beep/storybook",
    "topo-sort": "bun run beep topo-sort",
    "ui-add": "bunx --bun shadcn@latest add --cwd packages/foundation/ui-system/ui",
    "version-sync": "bun run beep version-sync",
    "lint:package-scripts": "bun run beep lint package-scripts --check",
    "knowledge:semantic-delta": "bun run beep knowledge semantic-delta",
    "knowledge:refs-check": "bun run beep knowledge refs --check",
    "lint:schema-first": "bun run beep lint schema-first",
    "lint:identity-registry": "bun run beep lint identity-registry",
    "lint:effect-imports": "bun run beep laws effect-imports --check",
    "lint:tsgo-rules": "bun run beep quality tsgo-rules",
    "lint:allowlist": "bun run beep laws allowlist-check",
    "lint:jsdoc-module-tags": "bun run beep quality jsdoc-module-tags",
