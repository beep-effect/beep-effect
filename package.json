    "lint:roadmap-refs": "bun run beep lint roadmap-refs",
    "lint:judge-rubric": "bun run beep lint judge-rubric",
    "lint:typos": "typos",
    "fallow:audit:check": "bun run beep quality fallow audit --check --base \"$BEEP_PROOF_BASE\" --out .beep/fallow/audit.check.json --quiet",
    "fallow:health:check": "bun run beep quality fallow health --check --base \"$BEEP_PROOF_BASE\" --out .beep/fallow/health.check.json --quiet",
