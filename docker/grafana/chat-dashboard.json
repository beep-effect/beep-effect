{
  "uid": "professional-desktop-chat",
  "title": "Professional Desktop QA",
  "description": "Connected logs, metrics, and traces for Professional Desktop QA. Empty panels are expected until the corresponding surface emits telemetry.",
  "tags": ["effect", "grafana", "loki", "professional-desktop", "qa", "tempo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "24h", "2d"]
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "compass",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Explore telemetry",
      "type": "link",
      "url": "/explore"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "metricsDatasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      },
      {
        "name": "logsDatasource",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "loki" }
      },
      {
        "name": "tracesDatasource",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": { "text": "Tempo", "value": "tempo" }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
        "query": { "query": "label_values(service_name)", "refId": "service" },
        "definition": "label_values(service_name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
        "query": {
          "query": "label_values(deployment_environment)",
          "refId": "environment"
        },
        "definition": "label_values(deployment_environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "build",
        "label": "Build / version",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
        "query": { "query": "label_values(build_commit)", "refId": "build" },
        "definition": "label_values(build_commit)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "launch",
        "label": "Launch",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
        "query": { "query": "label_values(launch_id)", "refId": "launch" },
        "definition": "label_values(launch_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "session",
        "label": "QA session",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
        "query": { "query": "label_values(session_id)", "refId": "session" },
        "definition": "label_values(session_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      },
      {
        "name": "transport",
        "label": "Transport",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
        "query": { "query": "label_values(transport)", "refId": "transport" },
        "definition": "label_values(transport)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "QA lifecycle and logs",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "text",
      "title": "QA correlation guide",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 6 },
      "options": {
        "mode": "markdown",
        "content": "Start with the launch and session filters, then follow a log's **View trace** link or open a trace row. Info records show lifecycle transitions; Warn records show degraded or recoverable paths; Error records show terminal failures. Build, launch, session, and transport filters become populated when those bounded resource/metric attributes are emitted."
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lifecycle logs in range",
      "description": "Info, Warn, and Error/Fatal records from the selected Professional Desktop services.",
      "gridPos": { "x": 8, "y": 1, "w": 16, "h": 6 },
      "datasource": { "type": "loki", "uid": "${logsDatasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\"} | detected_level=\"info\" [$__range])) or vector(0)",
          "legendFormat": "Info",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\"} | detected_level=\"warn\" [$__range])) or vector(0)",
          "legendFormat": "Warn",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\"} | detected_level=~\"error|fatal\" [$__range])) or vector(0)",
          "legendFormat": "Error / Fatal",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Connected application log stream",
      "description": "Structured Effect logs. Expand a record to inspect annotations and use the Tempo derived field when a trace ID is present.",
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${logsDatasource}" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"${service:regex}\"} | detected_level=~\"info|warn|error|fatal\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Trace search and failure analysis",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent traces",
      "description": "Tempo trace search. Select a row for the full waterfall, then jump to correlated Loki logs through the datasource trace-to-logs link.",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 9 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Error traces",
      "description": "Terminal Effect failures and defects represented by error-status spans. Interrupted spans are intentionally not treated as errors by Effect's OTLP tracer.",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 9 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && status = error }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Chat and editor metrics",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Assistant turns per minute",
      "gridPos": { "x": 0, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
      "fieldConfig": {
        "defaults": { "unit": "opm", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(agents_chat_turns_total{service_name=~\"${service:regex}\",deployment_environment=~\"${environment:regex}\",build_commit=~\"${build:regex}\",launch_id=~\"${launch:regex}\",session_id=~\"${session:regex}\",transport=~\"${transport:regex}\"}[5m])) * 60",
          "legendFormat": "{{kind}} turns"
        },
        {
          "refId": "B",
          "expr": "sum by (kind, phase) (rate(agents_chat_turn_failures_total{service_name=~\"${service:regex}\",deployment_environment=~\"${environment:regex}\",build_commit=~\"${build:regex}\",launch_id=~\"${launch:regex}\",session_id=~\"${session:regex}\",transport=~\"${transport:regex}\"}[5m])) * 60",
          "legendFormat": "{{kind}} / {{phase}} failures"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Server turn duration (p50 / p95)",
      "gridPos": { "x": 8, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, kind) (rate(agents_chat_turn_duration_milliseconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"${environment:regex}\",build_commit=~\"${build:regex}\",launch_id=~\"${launch:regex}\",session_id=~\"${session:regex}\",transport=~\"${transport:regex}\"}[5m])))",
          "legendFormat": "p50 {{kind}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(agents_chat_turn_duration_milliseconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"${environment:regex}\",build_commit=~\"${build:regex}\",launch_id=~\"${launch:regex}\",session_id=~\"${session:regex}\",transport=~\"${transport:regex}\"}[5m])))",
          "legendFormat": "p95 {{kind}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Web perceived latency (p50 / p95)",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, turn) (rate(ui_turn_perceived_latency_milliseconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"${environment:regex}\",build_commit=~\"${build:regex}\",launch_id=~\"${launch:regex}\",session_id=~\"${session:regex}\",transport=~\"${transport:regex}\"}[5m])))",
          "legendFormat": "p50 {{turn}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, turn) (rate(ui_turn_perceived_latency_milliseconds_bucket{service_name=~\"${service:regex}\",deployment_environment=~\"${environment:regex}\",build_commit=~\"${build:regex}\",launch_id=~\"${launch:regex}\",session_id=~\"${session:regex}\",transport=~\"${transport:regex}\"}[5m])))",
          "legendFormat": "p95 {{turn}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Blocks streamed / decode failures",
      "gridPos": { "x": 0, "y": 36, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agents_chat_blocks_streamed_total{service_name=~\"${service:regex}\"}[$__range])) or vector(0)",
          "legendFormat": "blocks"
        },
        {
          "refId": "B",
          "expr": "sum(increase(ui_editor_decode_failures_total{service_name=~\"${service:regex}\"}[$__range])) or vector(0)",
          "legendFormat": "decode failures"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Chat trace search",
      "gridPos": { "x": 8, "y": 36, "w": 16, "h": 6 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && name =~ \"agents\\.chat\\..*|UsageRecordSink\\..*\" }",
          "limit": 30,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "RPC, IPC, runtime, database, intake, sync, and ontology traces",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 15,
      "type": "table",
      "title": "RPC / IPC transport",
      "description": "Named sendFrame spans plus RPC-related spans when the transport runtime exports them.",
      "gridPos": { "x": 0, "y": 43, "w": 8, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && name =~ \"sendFrame|.*[Rr]pc.*|.*[Ii]pc.*|.*transport.*\" }",
          "limit": 40,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Runtime / exporter",
      "description": "Runtime, observability, DevTools, and OTLP spans if emitted; collector exporter health is charted below.",
      "gridPos": { "x": 8, "y": 43, "w": 8, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && name =~ \".*Runtime.*|.*Observability.*|.*Otlp.*|.*DevTools.*|ProfessionalDesktop\\.Migrations\\..*\" }",
          "limit": 40,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 17,
      "type": "table",
      "title": "Database / persistence",
      "gridPos": { "x": 16, "y": 43, "w": 8, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && name =~ \"UsageRecordSink\\.appendDrizzle|ProfessionalDesktop\\.Pglite\\..*|.*Drizzle.*|.*drizzle.*|.*Database.*|.*database.*\" }",
          "limit": 40,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "Document intake",
      "gridPos": { "x": 0, "y": 51, "w": 8, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && name =~ \"IntakeDroppedFile|intakeDroppedDocument|configure.*Vault|pickVaultDirectory|pickWith\" }",
          "limit": 40,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 19,
      "type": "table",
      "title": "Vault sync",
      "gridPos": { "x": 8, "y": 51, "w": 8, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && name =~ \"TriggerVaultSync|triggerVaultSync|markVaultSyncConflictReviewed|.*[Ss]ync.*\" }",
          "limit": 40,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 20,
      "type": "table",
      "title": "Ontology operations",
      "gridPos": { "x": 16, "y": 51, "w": 8, "h": 8 },
      "datasource": { "type": "tempo", "uid": "${tracesDatasource}" },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && name =~ \"ontology\\..*|Ontology\\..*\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 21,
      "type": "row",
      "title": "Effect runtime and collector health",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 59, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Effect child fibers",
      "description": "Visible after Metric.enableRuntimeMetricsLayer is provided. Empty is valid when runtime metrics remain disabled.",
      "gridPos": { "x": 0, "y": 60, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(child_fibers_active{service_name=~\"${service:regex}\"}) or vector(0)",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "sum(rate(child_fibers_started_total{service_name=~\"${service:regex}\"}[5m])) or vector(0)",
          "legendFormat": "started / sec"
        },
        {
          "refId": "C",
          "expr": "sum(rate(child_fiber_failures_total{service_name=~\"${service:regex}\"}[5m])) or vector(0)",
          "legendFormat": "failed / sec"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Collector accepted vs sent",
      "description": "Collector self-metrics scraped on port 8888. A widening accepted/sent gap indicates buffering or export trouble.",
      "gridPos": { "x": 8, "y": 60, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans[5m])) or vector(0)",
          "legendFormat": "accepted traces"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_accepted_log_records[5m])) or vector(0)",
          "legendFormat": "accepted logs"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points[5m])) or vector(0)",
          "legendFormat": "accepted metrics"
        },
        {
          "refId": "D",
          "expr": "sum(rate(otelcol_exporter_sent_spans[5m])) or vector(0)",
          "legendFormat": "sent traces"
        },
        {
          "refId": "E",
          "expr": "sum(rate(otelcol_exporter_sent_log_records[5m])) or vector(0)",
          "legendFormat": "sent logs"
        },
        {
          "refId": "F",
          "expr": "sum(rate(otelcol_exporter_sent_metric_points[5m])) or vector(0)",
          "legendFormat": "sent metrics"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Collector export failures and queue",
      "gridPos": { "x": 16, "y": 60, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_send_failed_spans[5m])) or vector(0)",
          "legendFormat": "failed traces / sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_send_failed_log_records[5m])) or vector(0)",
          "legendFormat": "failed logs / sec"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points[5m])) or vector(0)",
          "legendFormat": "failed metrics / sec"
        },
        {
          "refId": "D",
          "expr": "sum by (exporter) (otelcol_exporter_queue_size) or vector(0)",
          "legendFormat": "{{exporter}} queue"
        }
      ]
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Collector uptime / refused telemetry",
      "gridPos": { "x": 0, "y": 68, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "${metricsDatasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
