{
  "config": {
    // Disable line length (docs have long code blocks)
    "MD013": false,
    // Allow inline HTML (used in markdown tables and badges)
    "MD033": false,
    // Don't require first line to be h1 (many files have frontmatter)
    "MD041": false,
    // Allow multiple top-level headings (generated docs use this)
    "MD025": false,
    // Allow emphasis as heading (generated docs use *Example* / *Signature*)
    "MD036": false,
    // Disable table column style (compact tables are fine)
    "MD060": false,
    // Allow mixed heading styles (atx preferred, setext in some generated files)
    "MD003": false
  },
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    ".repos/**",
    ".next/**",
    ".sst/**",
    "dist/**",
    "coverage/**",
    "storybook-static/**",
    "tmp/**",
    ".beep/**",
    ".aiassistant/**",
    ".playwright-cli/**",
    "scratchpad/**",
    "**/docs/**",
    ".agents/**",
    ".claude/**",
    "specs/**",
    "**/AGENTS.md",
    "**/CLAUDE.md",
    // adopted historical artifact (June-29 generated synthesis) — reformatting
    // would destroy provenance and break audit line references
    "explorations/academia-corpus-mining/research/prior-synthesis-legal-ontologies.md",
    "QA*.md",
    "QA_*.md"
  ]
}
