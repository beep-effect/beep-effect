{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "filterUsingTasks": true,
    "globalConfiguration": true
  },
  "global": {
    "ui": "tui",
    "inputs": [
      ".bun-version",
      ".nvmrc",
      "package.json",
      "tsconfig.json",
      "tsconfig.base.json",
      "tsconfig.packages.json"
    ],
    "env": ["BEEP_ESLINT_PROFILE", "VITE_COSMOS_SPIKE", "REGEN_GOLDENS"],
    "passThroughEnv": [
      "BEEP_AGENT_SESSION_ID",
      "BEEP_NODE_BIN",
      "BEEP_DOCGEN_CONCURRENCY",
      "BEEP_QUALITY_CHECK_CONCURRENCY",
      "BEEP_YEET_ADMISSION_LEASE_ID",
      "BEEP_YEET_ADMISSION_WORKLOAD_PATH",
      "BEEP_YEET_LANE_PROOF_MODE",
      "BEEP_YEET_PROOF_BASE",
      "BEEP_YEET_PUSH_REFSPEC",
      "BEEP_YEET_STATE_ROOT",
      "CLAUDE_CODE_CHILD_SESSION",
      "CLAUDE_CODE_ENTRYPOINT",
      "CLAUDE_CODE_HOST_SESSION_ID",
      "CLAUDE_CODE_SESSION_ID",
      "CLAUDE_PID",
      "CLAUDE_SESSION_ID",
      "CODEX_COMPANION_TRANSCRIPT_PATH",
      "CODEX_SESSION_ID",
      "CODEX_THREAD_ID",
      "GITHUB_ACTIONS",
      "TURBO_CACHE",
      "TURBO_FORCE",
      "TURBO_TOKEN",
      "TURBO_TEAM",
      "XDG_RUNTIME_DIR",
      "NODE_TLS_REJECT_UNAUTHORIZED",
      "CHAT_TRANSPORT",
      "EPISTEMIC_EGRESS_DESTINATION_ALLOWLIST",
      "EPISTEMIC_POLICY_REVISION",
      "ONTOLOGY_MCP_MUTATIONS_ENABLED",
      "ONTOLOGY_WORKSPACE_ROOT",
      "PORTLESS_*",
      "AWS_*",
      "SST_*"
    ]
  },
  "tasks": {
    "doctest": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["^transit", "@beep/utils#transit"],
      "env": ["BEEP_VITEST_DOCTEST"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig*.json",
        "vitest*.config.ts",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        "$TURBO_ROOT$/packages/foundation/modeling/utils/src/**",
        "!node_modules/**",
        "$TURBO_ROOT$/packages/tooling/tool/cli/test/global-cleanup.ts",
        ".env",
        ".env.*"
      ]
    },
    "lint:deprecated-apis": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["^transit", "//#lint:policy-fingerprint"],
      "env": ["NODE_OPTIONS"],
      "inputs": [
        "**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "package.json",
        "tsconfig*.json",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/package.json",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/src/eslint/**",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/src/internal/eslint/**",
        "$TURBO_ROOT$/packages/**/tsconfig*.json",
        "$TURBO_ROOT$/apps/**/tsconfig*.json",
        "$TURBO_ROOT$/infra/**/tsconfig*.json",
        "$TURBO_ROOT$/packages/**/package.json",
        "$TURBO_ROOT$/apps/**/package.json",
        "$TURBO_ROOT$/infra/package.json",
        "!node_modules/**",
        "!.beep/**",
        "!.fallow/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/docs/**",
        "!**/.next/**",
        "!**/coverage/**",
        "!**/.turbo/**",
        "!**/.cache/**",
        "!**/generated/**",
        "!**/vendor/**",
        "!$TURBO_ROOT$/**/node_modules/**/package.json",
        "!$TURBO_ROOT$/**/dist/**/package.json",
        "!$TURBO_ROOT$/**/build/**/package.json",
        "!$TURBO_ROOT$/**/.next/**/package.json",
        "!$TURBO_ROOT$/**/coverage/**/package.json",
        "!$TURBO_ROOT$/**/storybook-static/**/package.json",
        "!$TURBO_ROOT$/**/.turbo/**/package.json",
        "!$TURBO_ROOT$/**/.beep/**/package.json",
        ".env",
        ".env.*"
      ]
    },
    "lint:jsdoc": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["//#lint:policy-fingerprint"],
      "inputs": [
        "**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "package.json",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/tsdoc.json",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/package.json",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/src/eslint/**",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/src/internal/eslint/**",
        "!node_modules/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/docs/**",
        "!**/.next/**",
        "!**/coverage/**",
        "!**/storybook-static/**",
        "!**/.turbo/**",
        "!**/src-tauri/target/**",
        "!$TURBO_ROOT$/**/node_modules/**/package.json",
        "!$TURBO_ROOT$/**/dist/**/package.json",
        "!$TURBO_ROOT$/**/build/**/package.json",
        "!$TURBO_ROOT$/**/.next/**/package.json",
        "!$TURBO_ROOT$/**/coverage/**/package.json",
        "!$TURBO_ROOT$/**/storybook-static/**/package.json",
        "!$TURBO_ROOT$/**/.turbo/**/package.json",
        "!$TURBO_ROOT$/**/.beep/**/package.json",
        ".env",
        ".env.*"
      ]
    },
    "//#lint:jsdoc:root": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["//#lint:policy-fingerprint"],
      "inputs": [
        "apps/**/*.{ts,tsx}",
        "packages/**/*.{ts,tsx}",
        "infra/**/*.ts",
        "!apps/labs/**/*.{ts,tsx}",
        "!**/.context/**/*.{ts,tsx}",
        "!**/node_modules/**",
        "eslint.config.mjs",
        "tsdoc.json",
        "packages/tooling/policy-pack/repo-configs/src/eslint/**",
        "packages/tooling/policy-pack/repo-configs/src/internal/eslint/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/.next/**",
        "!**/storybook-static/**",
        "!**/src-tauri/target/**",
        "!docs/generated/**",
        "!docs/_internal/**",
        "!{apps,packages,infra}/**/docs/**",
        "**/package.json",
        "!**/.beep/**/package.json",
        "!**/build/**/package.json"
      ]
    },
    "//#lint:policy-fingerprint": {
      "cache": true,
      "outputs": [],
      "inputs": [
        ".fallowrc.jsonc",
        ".oxlintrc.json",
        "_typos.toml",
        "biome.jsonc",
        "eslint.config.mjs",
        "knip.jsonc",
        "package.json",
        "packages/drivers/duckdb/package.json",
        "packages/drivers/duckdb/src/**",
        "packages/drivers/exiftool/package.json",
        "packages/drivers/exiftool/src/**",
        "packages/drivers/face-detection/package.json",
        "packages/drivers/face-detection/src/**",
        "packages/drivers/ffmpeg/package.json",
        "packages/drivers/ffmpeg/src/**",
        "packages/drivers/firecrawl/package.json",
        "packages/drivers/firecrawl/src/**",
        "packages/drivers/libpff/package.json",
        "packages/drivers/libpff/src/**",
        "packages/drivers/obs/package.json",
        "packages/drivers/obs/src/**",
        "packages/drivers/phoenix/package.json",
        "packages/drivers/phoenix/src/**",
        "packages/drivers/runpod/package.json",
        "packages/drivers/runpod/src/**",
        "packages/drivers/tika/package.json",
        "packages/drivers/tika/src/**",
        "packages/drivers/uspto/package.json",
        "packages/drivers/uspto/src/**",
        "packages/foundation/capability/chalk/package.json",
        "packages/foundation/capability/chalk/src/**",
        "packages/foundation/capability/colors/package.json",
        "packages/foundation/capability/colors/src/**",
        "packages/foundation/capability/file-processing/package.json",
        "packages/foundation/capability/file-processing/src/**",
        "packages/foundation/capability/observability/package.json",
        "packages/foundation/capability/observability/src/**",
        "packages/foundation/modeling/html/package.json",
        "packages/foundation/modeling/html/src/**",
        "packages/foundation/modeling/identity/package.json",
        "packages/foundation/modeling/identity/src/**",
        "packages/foundation/modeling/md/package.json",
        "packages/foundation/modeling/md/src/**",
        "packages/foundation/modeling/provenance/package.json",
        "packages/foundation/modeling/provenance/src/**",
        "packages/foundation/modeling/schema/package.json",
        "packages/foundation/modeling/schema/src/**",
        "packages/foundation/modeling/skill-contract/package.json",
        "packages/foundation/modeling/skill-contract/src/**",
        "packages/foundation/modeling/utils/package.json",
        "packages/foundation/modeling/utils/src/**",
        "packages/foundation/primitive/data/package.json",
        "packages/foundation/primitive/data/src/**",
        "packages/tooling/library/ai-metrics/package.json",
        "packages/tooling/library/ai-metrics/src/**",
        "packages/tooling/library/qa-capture/package.json",
        "packages/tooling/library/qa-capture/src/**",
        "packages/tooling/library/repo-utils/package.json",
        "packages/tooling/library/repo-utils/src/**",
        "packages/tooling/policy-pack/repo-configs/package.json",
        "packages/tooling/policy-pack/repo-configs/src/**",
        "packages/tooling/test-kit/fc-runs/package.json",
        "packages/tooling/test-kit/fc-runs/src/**",
        "packages/tooling/test-kit/test-runner/package.json",
        "packages/tooling/test-kit/test-runner/src/**",
        "packages/tooling/test-kit/test-utils/package.json",
        "packages/tooling/test-kit/test-utils/src/**",
        "packages/tooling/tool/cli/package.json",
        "packages/tooling/tool/cli/src/**",
        "packages/tooling/tool/docgen/package.json",
        "packages/tooling/tool/docgen/src/**",
        "standards/lint-policy.sweeps.jsonc",
        "standards/policy-tools.fingerprint.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "tsdoc.json"
      ]
    },
    "build": {
      "persistent": false,
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.beep/**",
        "!.fallow/**",
        "$TURBO_ROOT$/tools/tsgo-shim/tsgo.js",
        "$TURBO_ROOT$/tools/tsgo-shim/package.json",
        ".env",
        ".env.*"
      ],
      "env": [
        "APP_ADMINS_EMAILS",
        "ALLOWED_EMAILS",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "EMAIL_*",
        "AUTH_*",
        "OPENAI_*",
        "SECURITY_*",
        "OAUTH_*",
        "NEXT_PUBLIC_*",
        "LIVEBLOCKS_*",
        "RESEND_*"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "next-env.d.ts",
        ".expo/**",
        "_next/**",
        ".output/**",
        ".vercel/output/**",
        "storybook-static/**",
        "**/node_modules/.tmp/*.tsbuildinfo",
        "!**/.turbo/**",
        "!.next/cache/**"
      ]
    },
    "@beep/api-docs#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.beep/**",
        "!.fallow/**",
        ".env",
        ".env.*"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.beep/**",
        "!.fallow/**",
        "$TURBO_ROOT$/biome.jsonc",
        "$TURBO_ROOT$/packages/tooling/policy-pack/lint-rules/rules/**",
        "$TURBO_ROOT$/packages/tooling/policy-pack/lint-rules/configs/**",
        "!$TURBO_ROOT$/tsconfig*.json",
        "!.beep/**",
        "!.fallow/**",
        ".env",
        ".env.*"
      ]
    },
    "lint:fix": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.jsonc",
        "!$TURBO_ROOT$/tsconfig*.json",
        "!.beep/**",
        "!.fallow/**"
      ]
    },
    "check": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.beep/**",
        "!.fallow/**",
        "$TURBO_ROOT$/tools/tsgo-shim/tsgo.js",
        "$TURBO_ROOT$/tools/tsgo-shim/package.json",
        ".env",
        ".env.*"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^transit", "@beep/utils#transit"],
      "passThroughEnv": [
        "GITHUB_STEP_SUMMARY",
        "BEEP_CREATE_PACKAGE_BUN_ARGS_FILE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        "!.beep/**",
        "!.fallow/**",
        ".env",
        ".env.*"
      ],
      "env": ["BEEP_FC_NUM_RUNS", "BEEP_FC_SEED"]
    },
    "package-test-typecheck": {
      "cache": false,
      "dependsOn": ["^transit"],
      "inputs": [
        "package.json",
        "scripts/**",
        "server/**",
        "src/**",
        "src-tauri/**",
        "test/**",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/tooling/tool/cli/src/commands/Quality/Quality.command.ts",
        "$TURBO_ROOT$/packages/tooling/tool/cli/src/commands/Quality/internal/TestTsgoSyntheticConfig.ts"
      ],
      "outputs": [".turbo/package-test-typecheck-result.json"]
    },
    "test:property": {
      "dependsOn": ["^transit", "@beep/utils#transit"],
      "env": ["BEEP_FC_NUM_RUNS", "BEEP_FC_SEED"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        "!.beep/**",
        "!.fallow/**",
        ".env",
        ".env.*"
      ]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "AI_VENICE_API_KEY",
        "BEEP_TEST_*",
        "BEEP_TIKA_*",
        "CLOUD_BOX_TOKEN",
        "FIRECRAWL_API_KEY"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        "!.beep/**",
        "!.fallow/**"
      ]
    },
    "test:integration:parallel": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "AI_VENICE_API_KEY",
        "BEEP_TEST_*",
        "BEEP_TIKA_*",
        "CLOUD_BOX_TOKEN",
        "FIRECRAWL_API_KEY"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        "!.beep/**",
        "!.fallow/**"
      ]
    },
    "test:integration:serial": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["BEEP_TEST_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        "!.beep/**",
        "!.fallow/**"
      ]
    },
    "coverage": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "BEEP_FC_SEED",
        "NODE_OPTIONS",
        "VITEST_COVERAGE_REPORT_ONLY",
        "VITEST_COVERAGE_RATCHET"
      ],
      "inputs": [
        "package.json",
        "server/**",
        "src/**",
        "src-tauri/**",
        "test/**",
        "tsconfig*.json",
        "vitest.config.ts",
        "vitest.coverage.config.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "codegen": {
      "cache": false,
      "dependsOn": ["^codegen"],
      "inputs": ["$TURBO_DEFAULT$", "!.beep/**", "!.fallow/**"]
    },
    "audit": {
      "cache": false,
      "dependsOn": ["^audit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.jsonc",
        "$TURBO_ROOT$/vitest.shared.ts",
        "!.beep/**",
        "!.fallow/**"
      ],
      "env": [
        "APP_ADMINS_EMAILS",
        "ALLOWED_EMAILS",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "EMAIL_*",
        "AUTH_*",
        "OPENAI_*",
        "SECURITY_*",
        "OAUTH_*",
        "NEXT_PUBLIC_*",
        "LIVEBLOCKS_*",
        "RESEND_*",
        "BEEP_TEST_*",
        "BEEP_TIKA_*"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "next-env.d.ts",
        ".expo/**",
        "_next/**",
        ".output/**",
        ".vercel/output/**",
        "docs/**",
        "**/node_modules/.tmp/*.tsbuildinfo",
        "!**/.turbo/**",
        "!.next/cache/**"
      ],
      "outputLogs": "new-only"
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "docgen": {
      "cache": true,
      "dependsOn": ["transit", "@beep/repo-docgen#transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.beep/**",
        "!.fallow/**",
        ".env",
        ".env.*"
      ],
      "outputs": ["docs/**", ".beep/docgen/**", ".jsdoc-loop/generated-docs/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^build"]
    },
    "storybook": {
      "persistent": true,
      "cache": false
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.beep/**",
        "!.fallow/**",
        "$TURBO_ROOT$/apps/storybook/.storybook/**",
        "$TURBO_ROOT$/apps/storybook/vitest.storybook.config.ts",
        "$TURBO_ROOT$/apps/storybook/vitest.storybook.setup.ts",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/src/**",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/stories/**",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/assets/**",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/styles/**",
        "$TURBO_ROOT$/packages/drivers/graph-3d/src/**",
        "$TURBO_ROOT$/packages/drivers/graph-3d/stories/**",
        ".env",
        ".env.*"
      ],
      "outputs": ["storybook-static/**"]
    },
    "storybook:start": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["storybook:build"]
    },
    "test:storybook": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.beep/**",
        "!.fallow/**",
        "$TURBO_ROOT$/apps/storybook/.storybook/**",
        "$TURBO_ROOT$/apps/storybook/vitest.storybook.config.ts",
        "$TURBO_ROOT$/apps/storybook/vitest.storybook.setup.ts",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/src/**",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/stories/**",
        "$TURBO_ROOT$/packages/drivers/graph-3d/src/**",
        "$TURBO_ROOT$/packages/drivers/graph-3d/stories/**"
      ]
    },
    "lint:laws": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["//#lint:policy-fingerprint"],
      "inputs": [
        "**/*.{ts,tsx}",
        "package.json",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/packages/**/package.json",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/src/eslint/EffectLawsAllowlist.ts",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/src/eslint/NoNativeRuntimeHotspots.ts",
        "$TURBO_ROOT$/packages/tooling/policy-pack/repo-configs/src/internal/eslint/generated/EffectLawsAllowlistSnapshot.ts",
        "$TURBO_ROOT$/standards/effect-laws.allowlist.jsonc",
        "!node_modules/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/.turbo/**",
        "!**/coverage/**",
        "!$TURBO_ROOT$/**/node_modules/**/package.json",
        "!$TURBO_ROOT$/**/dist/**/package.json",
        "!$TURBO_ROOT$/**/build/**/package.json",
        "!$TURBO_ROOT$/**/.next/**/package.json",
        "!$TURBO_ROOT$/**/coverage/**/package.json",
        "!$TURBO_ROOT$/**/storybook-static/**/package.json",
        "!$TURBO_ROOT$/**/.turbo/**/package.json",
        "!$TURBO_ROOT$/**/.beep/**/package.json",
        ".env",
        ".env.*"
      ]
    },
    "//#lint:native-runtime:roots": {
      "cache": true,
      "outputs": [],
      "dependsOn": ["//#lint:policy-fingerprint"],
      "inputs": [
        "scratchpad/**/*.{ts,tsx}",
        "packages/_internal/db-admin/effect-ontology/**/*.{ts,tsx}",
        "packages/tooling/policy-pack/repo-configs/src/eslint/EffectLawsAllowlist.ts",
        "packages/tooling/policy-pack/repo-configs/src/eslint/NoNativeRuntimeHotspots.ts",
        "packages/tooling/policy-pack/repo-configs/src/internal/eslint/generated/EffectLawsAllowlistSnapshot.ts",
        "standards/effect-laws.allowlist.jsonc",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/coverage/**",
        "!**/storybook-static/**",
        "!**/.next/**",
