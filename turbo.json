{
  "$schema": "https://v2-10-2.turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "filterUsingTasks": true,
    "globalConfiguration": true
  },
  "global": {
    "ui": "tui",
    "inputs": [
      ".bun-version",
      ".nvmrc",
      "package.json",
      "tsconfig.json",
      "tsconfig.base.json",
      "tsconfig.packages.json"
    ],
    "env": ["BEEP_ESLINT_PROFILE", "VITE_COSMOS_SPIKE"],
    "passThroughEnv": [
      "BEEP_AGENT_SESSION_ID",
      "BEEP_NODE_BIN",
      "BEEP_DOCGEN_CONCURRENCY",
      "BEEP_QUALITY_CHECK_CONCURRENCY",
      "BEEP_YEET_ADMISSION_LEASE_ID",
      "BEEP_YEET_ADMISSION_WORKLOAD_PATH",
      "BEEP_YEET_LANE_PROOF_MODE",
      "BEEP_YEET_PROOF_BASE",
      "BEEP_YEET_PUSH_REFSPEC",
      "BEEP_YEET_STATE_ROOT",
      "CLAUDE_CODE_CHILD_SESSION",
      "CLAUDE_CODE_ENTRYPOINT",
      "CLAUDE_CODE_HOST_SESSION_ID",
      "CLAUDE_CODE_SESSION_ID",
      "CLAUDE_PID",
      "CLAUDE_SESSION_ID",
      "CODEX_COMPANION_TRANSCRIPT_PATH",
      "CODEX_SESSION_ID",
      "CODEX_THREAD_ID",
      "GITHUB_ACTIONS",
      "REGEN_GOLDENS",
      "TURBO_CACHE",
      "TURBO_FORCE",
      "TURBO_TOKEN",
      "TURBO_TEAM",
      "XDG_RUNTIME_DIR",
      "NODE_TLS_REJECT_UNAUTHORIZED",
      "CHAT_TRANSPORT",
      "EPISTEMIC_EGRESS_DESTINATION_ALLOWLIST",
      "EPISTEMIC_POLICY_REVISION",
      "ONTOLOGY_MCP_MUTATIONS_ENABLED",
      "ONTOLOGY_WORKSPACE_ROOT",
      "PORTLESS_*",
      "AWS_*",
      "SST_*"
    ]
  },
  "tasks": {
    "build": {
      "persistent": false,
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!.beep/**"],
      "env": [
        "APP_ADMINS_EMAILS",
        "ALLOWED_EMAILS",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "EMAIL_*",
        "AUTH_*",
        "OPENAI_*",
        "SECURITY_*",
        "OAUTH_*",
        "NEXT_PUBLIC_*",
        "LIVEBLOCKS_*",
        "RESEND_*"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "next-env.d.ts",
        ".expo/**",
        "_next/**",
        ".output/**",
        ".vercel/output/**",
        "storybook-static/**",
        "**/node_modules/.tmp/*.tsbuildinfo",
        "!**/.turbo/**",
        "!.next/cache/**"
      ]
    },
    "@beep/api-docs#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.jsonc",
        "$TURBO_ROOT$/packages/tooling/policy-pack/lint-rules/rules/**",
        "$TURBO_ROOT$/packages/tooling/policy-pack/lint-rules/configs/**",
        "!$TURBO_ROOT$/tsconfig*.json",
        "!.beep/**"
      ]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["^lint:fix"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.jsonc",
        "!$TURBO_ROOT$/tsconfig*.json",
        "!.beep/**"
      ]
    },
    "check": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!.beep/**"],
      "outputs": []
    },
    "test": {
      "passThroughEnv": [
        "GITHUB_STEP_SUMMARY",
        "BEEP_CREATE_PACKAGE_BUN_ARGS_FILE",
        "BEEP_NODE_BIN",
        "BEEP_YEET_ADMISSION_LEASE_ID",
        "BEEP_YEET_ADMISSION_WORKLOAD_PATH"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "!.beep/**"
      ]
    },
    "package-test-typecheck": {
      "cache": false,
      "dependsOn": ["^transit"],
      "inputs": [
        "package.json",
        "scripts/**",
        "server/**",
        "src/**",
        "src-tauri/**",
        "test/**",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/packages/tooling/tool/cli/src/commands/Quality/Quality.command.ts",
        "$TURBO_ROOT$/packages/tooling/tool/cli/src/commands/Quality/internal/TestTsgoSyntheticConfig.ts"
      ],
      "outputs": [".turbo/package-test-typecheck-result.json"]
    },
    "test:property": {
      "env": ["BEEP_FC_NUM_RUNS", "BEEP_FC_SEED"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "!.beep/**"
      ]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "AI_VENICE_API_KEY",
        "BEEP_TEST_*",
        "BEEP_TIKA_*",
        "CLOUD_BOX_TOKEN",
        "FIRECRAWL_API_KEY"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "!.beep/**"
      ]
    },
    "test:integration:parallel": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "AI_VENICE_API_KEY",
        "BEEP_TEST_*",
        "BEEP_TIKA_*",
        "CLOUD_BOX_TOKEN",
        "FIRECRAWL_API_KEY"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "!.beep/**"
      ]
    },
    "test:integration:serial": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["BEEP_TEST_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts",
        "!.beep/**"
      ]
    },
    "coverage": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "BEEP_FC_SEED",
        "NODE_OPTIONS",
        "VITEST_COVERAGE_REPORT_ONLY",
        "VITEST_COVERAGE_RATCHET"
      ],
      "inputs": [
        "package.json",
        "server/**",
        "src/**",
        "src-tauri/**",
        "test/**",
        "tsconfig*.json",
        "vitest.config.ts",
        "vitest.coverage.config.ts",
        "$TURBO_ROOT$/vitest.aliases.generated.json",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/vitest.setup.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "codegen": {
      "cache": false,
      "dependsOn": ["^codegen"],
      "inputs": ["$TURBO_DEFAULT$", "!.beep/**"]
    },
    "audit": {
      "cache": true,
      "dependsOn": ["^audit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.jsonc",
        "$TURBO_ROOT$/vitest.shared.ts",
        "!.beep/**"
      ],
      "env": [
        "APP_ADMINS_EMAILS",
        "ALLOWED_EMAILS",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "EMAIL_*",
        "AUTH_*",
        "OPENAI_*",
        "SECURITY_*",
        "OAUTH_*",
        "NEXT_PUBLIC_*",
        "LIVEBLOCKS_*",
        "RESEND_*",
        "BEEP_TEST_*",
        "BEEP_TIKA_*",
        "CI"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "next-env.d.ts",
        ".expo/**",
        "_next/**",
        ".output/**",
        ".vercel/output/**",
        "docs/**",
        "**/node_modules/.tmp/*.tsbuildinfo",
        "!**/.turbo/**",
        "!.next/cache/**"
      ],
      "outputLogs": "new-only"
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "docgen": {
      "cache": true,
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!.beep/**"],
      "outputs": ["docs/**", ".beep/docgen/**", ".jsdoc-loop/generated-docs/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^build"]
    },
    "storybook": {
      "persistent": true,
      "cache": false
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/storybook/.storybook/**",
        "$TURBO_ROOT$/apps/storybook/vitest.storybook.config.ts",
        "$TURBO_ROOT$/apps/storybook/vitest.storybook.setup.ts",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/src/**",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/stories/**",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/assets/**",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/styles/**",
        "$TURBO_ROOT$/packages/drivers/graph-3d/src/**",
        "$TURBO_ROOT$/packages/drivers/graph-3d/stories/**"
      ],
      "outputs": ["storybook-static/**"]
    },
    "storybook:start": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["storybook:build"]
    },
    "test:storybook": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/storybook/.storybook/**",
        "$TURBO_ROOT$/apps/storybook/vitest.storybook.config.ts",
        "$TURBO_ROOT$/apps/storybook/vitest.storybook.setup.ts",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/src/**",
        "$TURBO_ROOT$/packages/foundation/ui-system/*/stories/**",
        "$TURBO_ROOT$/packages/drivers/graph-3d/src/**",
        "$TURBO_ROOT$/packages/drivers/graph-3d/stories/**"
      ]
    }
  }
}
