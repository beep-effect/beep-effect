+{
+  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
+  "//": "Lint-only oxlint lane (P3). Biome stays the formatter + primary linter; oxlint runs ONLY the @beep/lint-rules custom plugin for the stateful/path-aware rules that GritQL cannot express. No native oxlint rule categories are enabled, to avoid overlap with Biome. Rules ship advisory (warn); promotion to error is tracked in the SPEC exception ledger (re-assess 2026-09-20).",
+  "plugins": [],
+  "jsPlugins": ["./packages/tooling/policy-pack/lint-rules/oxlint/index.ts"],
+  "ignorePatterns": [
+    "**/dist/**",
+    "**/build/**",
+    "**/node_modules/**",
+    "**/.next/**",
+    "**/.turbo/**",
+    "**/coverage/**",
+    "**/generated/**",
+    "**/*.gen.*",
+    ".repos/**",
+    "docs/generated/**",
+    "packages/tooling/policy-pack/lint-rules/oxlint/**"
+  ],
+  "rules": {
+    "beep/namespace-node-imports": "warn",
+    "beep/no-global-process-runtime": "warn",
+    "beep/no-inline-schema-compile": "warn",
+    "beep/no-manual-effect-runtime-in-tests": "warn",
+    "beep/no-opaque-instance-fields": "warn"
+  }
+}
