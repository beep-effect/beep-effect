+ *
+ * @category protocols
+ * @since 0.0.0
+ */
+export const ContradictionRpcs = RpcGroup.make(
+  ListContradictionCandidatesRpc,
+  GetContradictionCandidateRpc,
+  ReviewContradictionCandidateRpc,
+  GetEvidenceSourcePageRpc
+);
