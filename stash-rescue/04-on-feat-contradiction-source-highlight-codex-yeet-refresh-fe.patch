+            />
+          ))}
+        </div>
+      </section>
+      <div className="flex justify-end border-t pt-4 data-[resolved=true]:justify-start" data-resolved={resolved}>
+        {O.match(settledDisposition, {
+          onNone: () => (
+            <Button
