diff --git a/apps/professional-desktop/src/contradiction/ContradictionOrchestrator.ts b/apps/professional-desktop/src/contradiction/ContradictionOrchestrator.ts
new file mode 100644
index 0000000000..6cf0a20675
--- /dev/null
+++ b/apps/professional-desktop/src/contradiction/ContradictionOrchestrator.ts
@@ -0,0 +1,344 @@
+/**
+ * Authenticated desktop orchestration for contradiction triage.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+import {
+  ContradictionActionError,
+  ContradictionBeliefView,
+  ContradictionCandidateDetailView,
+  ContradictionEvidenceView,
+  ContradictionRpcs,
+  EvidenceSourcePage,
+  EvidenceSourcePageSelector,
+} from "@beep/epistemic-use-cases/ContradictionTriage";
+import {
+  ContradictionCandidatePage,
+  ContradictionRepositoryUnavailable,
+  ContradictionReviewConflict,
+  ContradictionReviewConflictReason,
+  ContradictionReviewer,
+  ContradictionReviewScope,
+  ContradictionTriageRepository,
+  GetExpandedContradictionCandidate,
+  ListContradictionCandidates,
+} from "@beep/epistemic-use-cases/ContradictionTriage/server";
+import {
+  pageSourceText,
+  pageSourceTextContainingOffset,
+  ResolveSourceTextRequest,
+  SourceTextResolver,
+  SourceTextResolverErrorReason,
+} from "@beep/file-processing/SourceText";
+import { LogRedactedCauseOptions, logRedactedCause } from "@beep/observability";
+import {
+  toTextAnchorVerificationReceipt,
+  VerifyTextAnchorInput,
+  verifyTextAnchor,
+} from "@beep/provenance/VerifiedTextAnchor";
+import { NonNegativeInt } from "@beep/schema/Int";
+import { UserPrincipal } from "@beep/shared-domain/entity/Principal";
+import * as Shared from "@beep/shared-domain/identity/Shared";
+import * as Workspace from "@beep/shared-domain/identity/Workspace";
+import { Cause, Effect, Equal, Layer, Match, pipe } from "effect";
+import * as A from "effect/Array";
+import * as O from "effect/Option";
+import type {
+  ContradictionActionErrorReason,
+  GetContradictionCandidate,
+} from "@beep/epistemic-use-cases/ContradictionTriage";
+import type {
+  ContradictionCandidateExpandedDetail,
+  ContradictionEvidenceDetail,
+} from "@beep/epistemic-use-cases/ContradictionTriage/server";
+import type { SourceTextResolverError } from "@beep/file-processing/SourceText";
+
+const desktopOrganizationId = Shared.OrganizationId.make(1);
+const desktopUserId = Shared.UserId.make(1);
+const desktopWorkspaceId = Workspace.WorkspaceId.make(1);
+const desktopWorkspaceScopeRef = `workspace:${desktopWorkspaceId}`;
+const desktopReviewer = UserPrincipal.make({ userId: desktopUserId });
+const desktopReviewScope = ContradictionReviewScope.of({ orgId: desktopOrganizationId });
+
+const failAction = (reason: ContradictionActionErrorReason) => Effect.fail(ContradictionActionError.make({ reason }));
+
+const dropInternalFailure = (context: string, reason: ContradictionActionErrorReason) =>
+  Effect.fnUntraced(function* (error: { readonly _tag: string }) {
+    yield* logRedactedCause(
+      Cause.fail(error),
+      LogRedactedCauseOptions.make({
+        message: "contradiction action dropped internal failure",
+        level: "Warn",
+        attributes: {
+          "professional_desktop.contradiction.context": context,
+          "professional_desktop.subsystem": "contradiction",
+        },
+      })
+    );
+    return yield* failAction(reason);
+  });
+
+const reviewActionReason = (reason: ContradictionReviewConflictReason): ContradictionActionErrorReason =>
+  ContradictionReviewConflictReason.$match(reason, {
+    "already-resolved": () => "candidate-already-resolved" as const,
+    "belief-mismatch": () => "belief-mismatch" as const,
+    "not-found": () => "candidate-not-found" as const,
+    "proposal-digest-mismatch": () => "proposal-digest-mismatch" as const,
+    "proposal-not-found": () => "proposal-not-found" as const,
+    "stale-candidate": () => "stale-candidate" as const,
+  });
+
+const sourceActionReason = (error: SourceTextResolverError): ContradictionActionErrorReason =>
+  SourceTextResolverErrorReason.$match(error.reason, {
+    "extraction-failed": () => "source-unavailable" as const,
+    "extractor-unavailable": () => "source-stale" as const,
+    "locator-invalid": () => "source-access-denied" as const,
+    "page-out-of-range": () => "page-out-of-range" as const,
+    "scope-unavailable": () => "source-access-denied" as const,
+    "source-digest-mismatch": () => "source-stale" as const,
+    "source-unavailable": () => "source-unavailable" as const,
+    "text-digest-mismatch": () => "source-stale" as const,
+    "text-unavailable": () => "source-unavailable" as const,
+  });
+
+const anchorSourceActionReason = (error: SourceTextResolverError): ContradictionActionErrorReason =>
+  Match.value(error.reason).pipe(
+    Match.when("page-out-of-range", () => "source-stale" as const),
+    Match.orElse(() => sourceActionReason(error))
+  );
+
+const toEvidenceView = (detail: ContradictionEvidenceDetail): ContradictionEvidenceView =>
+  ContradictionEvidenceView.make({
+    evidence: detail.evidence,
+    verifiedAnchor: O.map(detail.latestVerification, (verification) => verification.verifiedAnchor),
+  });
+
+const toCandidateDetailView = (expanded: ContradictionCandidateExpandedDetail): ContradictionCandidateDetailView =>
+  ContradictionCandidateDetailView.make({
+    candidate: expanded.detail.candidate,
+    disposition: expanded.detail.disposition,
+    left: ContradictionBeliefView.make({
+      belief: expanded.left.belief,
+      evidence: A.map(expanded.left.evidence, toEvidenceView),
+    }),
+    right: ContradictionBeliefView.make({
+      belief: expanded.right.belief,
+      evidence: A.map(expanded.right.evidence, toEvidenceView),
+    }),
+  });
+
+const loadExpandedCandidate = Effect.fn("professional_desktop.contradiction.load_expanded_candidate")(function* (
+  repository: ContradictionTriageRepository["Service"],
+  candidateId: GetContradictionCandidate["candidateId"],
+  context: string
+) {
+  const expanded = yield* repository
+    .getExpanded(
+      GetExpandedContradictionCandidate.make({
+        candidateId,
+        orgId: desktopOrganizationId,
+      })
+    )
+    .pipe(
+      Effect.catchTag("ContradictionRepositoryUnavailable", dropInternalFailure(`${context}.repository`, "unavailable"))
+    );
+  return yield* pipe(
+    expanded,
+    O.match({
+      onNone: () => failAction("candidate-not-found"),
+      onSome: Effect.succeed,
+    })
+  );
+});
+
+const findCandidateEvidence = (
+  expanded: ContradictionCandidateExpandedDetail,
+  evidenceId: ContradictionEvidenceDetail["evidence"]["id"]
+): O.Option<ContradictionEvidenceDetail> =>
+  pipe(
+    expanded.left.evidence,
+    A.appendAll(expanded.right.evidence),
+    A.findFirst((detail) => Equal.equals(detail.evidence.id, evidenceId))
+  );
+
+/**
+ * Authenticated contradiction-triage handlers.
+ *
+ * Organization, reviewer, and workspace scope are derived inside this trusted
+ * sidecar boundary. Source resolution is permitted only for evidence already
+ * bound to the requested candidate and an anchor scoped to this workspace.
+ *
+ * @example
+ * ```ts
+ * import { ContradictionHandlersLive } from "@/contradiction/ContradictionOrchestrator"
+ * import { Layer } from "effect"
+ *
+ * console.log(Layer.isLayer(ContradictionHandlersLive)) // true
+ * ```
+ *
+ * @category layers
+ * @since 0.0.0
+ */
+export const ContradictionHandlersLive = ContradictionRpcs.toLayer(
+  Effect.gen(function* () {
+    const repository = yield* ContradictionTriageRepository;
+    const sourceTextResolver = yield* SourceTextResolver;
+
+    return ContradictionRpcs.of({
+      ListContradictionCandidates: (payload) =>
+        repository
+          .list(
+            ListContradictionCandidates.make({
+              disposition: payload.disposition,
+              knownAt: payload.knownAt,
+              limit: payload.limit,
+              offset: payload.offset,
+              orgId: desktopOrganizationId,
+              validAt: payload.validAt,
+            })
+          )
+          .pipe(
+            Effect.catchTag(
+              "ContradictionRepositoryUnavailable",
+              dropInternalFailure("ListContradictionCandidates.repository", "unavailable")
+            ),
+            Effect.withSpan("professional_desktop.contradiction.list_candidates")
+          ),
+
+      GetContradictionCandidate: ({ candidateId }) =>
+        loadExpandedCandidate(repository, candidateId, "GetContradictionCandidate").pipe(
+          Effect.map(toCandidateDetailView),
+          Effect.withSpan("professional_desktop.contradiction.get_candidate")
+        ),
+
+      ReviewContradictionCandidate: (command) =>
+        repository.review(command).pipe(
+          Effect.provideService(ContradictionReviewer, desktopReviewer),
+          Effect.provideService(ContradictionReviewScope, desktopReviewScope),
+          Effect.catchTags({
+            ContradictionRepositoryUnavailable: dropInternalFailure(
+              "ReviewContradictionCandidate.repository",
+              "unavailable"
+            ),
+            ContradictionReviewConflict: (error) => failAction(reviewActionReason(error.reason)),
+            EdgeConstraintViolation: () => failAction("belief-mismatch"),
+            EdgeRepositoryUnavailable: dropInternalFailure("ReviewContradictionCandidate.edge", "unavailable"),
+            SupersessionConflict: () => failAction("stale-candidate"),
+          }),
+          Effect.withSpan("professional_desktop.contradiction.review_candidate")
+        ),
+
+      GetEvidenceSourcePage: Effect.fn("professional_desktop.contradiction.get_evidence_source_page")(function* ({
+        candidateId,
+        evidenceId,
+        selector,
+      }) {
+        const expanded = yield* loadExpandedCandidate(repository, candidateId, "GetEvidenceSourcePage");
+        const evidence = yield* pipe(
+          findCandidateEvidence(expanded, evidenceId),
+          O.match({
+            onNone: () => failAction("evidence-not-in-candidate"),
+            onSome: Effect.succeed,
+          })
+        );
+        const verification = yield* pipe(
+          evidence.latestVerification,
+          O.match({
+            onNone: () => failAction("source-unavailable"),
+            onSome: Effect.succeed,
+          })
+        );
+        if (!Equal.equals(verification.verifiedAnchor.source.scopeRef, desktopWorkspaceScopeRef)) {
+          return yield* failAction("source-access-denied");
+        }
+        const source = yield* sourceTextResolver
+          .resolve(ResolveSourceTextRequest.make({ identity: verification.verifiedAnchor.source }))
+          .pipe(
+            Effect.catchTag("SourceTextResolverError", (error) =>
+              dropInternalFailure("GetEvidenceSourcePage.resolve", sourceActionReason(error))(error)
+            )
+          );
+        const verifiedAnchor = yield* verifyTextAnchor(
+          VerifyTextAnchorInput.make({
+            anchor: verification.verifiedAnchor.anchor,
+            expectedSource: verification.verifiedAnchor.source,
+            source: source.identity,
+            sourceText: source.text,
+          })
+        ).pipe(
+          Effect.catchTag(
+            "VerifiedTextAnchorError",
+            dropInternalFailure("GetEvidenceSourcePage.verifyAnchor", "source-stale")
+          )
+        );
+        const page = yield* EvidenceSourcePageSelector.match(selector, {
+          anchor: () =>
+            pageSourceTextContainingOffset(source, verifiedAnchor.anchor.startChar).pipe(
+              Effect.catchTag("SourceTextResolverError", (error) =>
+                dropInternalFailure("GetEvidenceSourcePage.anchorPage", anchorSourceActionReason(error))(error)
+              )
+            ),
+          page: ({ pageIndex }) =>
+            pageSourceText(source, pageIndex).pipe(
+              Effect.catchTag("SourceTextResolverError", (error) =>
+                dropInternalFailure("GetEvidenceSourcePage.page", sourceActionReason(error))(error)
+              )
+            ),
+        });
+        return EvidenceSourcePage.make({
+          evidenceId,
+          page,
+          verifiedAnchor: toTextAnchorVerificationReceipt(verifiedAnchor),
+        });
+      }),
+    });
+  })
+);
+
+/**
+ * Empty contradiction repository used by the keyless fixture runtime.
+ *
+ * @example
+ * ```ts
+ * import { ContradictionTriageRepositoryFixture } from "@/contradiction/ContradictionOrchestrator"
+ * import { Layer } from "effect"
+ *
+ * console.log(Layer.isLayer(ContradictionTriageRepositoryFixture)) // true
+ * ```
+ *
+ * @category layers
+ * @since 0.0.0
+ */
+export const ContradictionTriageRepositoryFixture = Layer.succeed(
+  ContradictionTriageRepository,
+  ContradictionTriageRepository.of({
+    get: Effect.fn("ContradictionTriageRepository.get")(() => Effect.succeed(O.none())),
+    getExpanded: Effect.fn("ContradictionTriageRepository.getExpanded")(() => Effect.succeed(O.none())),
+    list: Effect.fn("ContradictionTriageRepository.list")(() =>
+      Effect.succeed(
+        ContradictionCandidatePage.make({
+          items: [],
+          total: NonNegativeInt.make(0),
+        })
+      )
+    ),
+    review: Effect.fn("ContradictionTriageRepository.review")((command) =>
+      Effect.fail(
+        ContradictionReviewConflict.make({
+          candidateId: command.candidateId,
+          reason: "not-found",
+        })
+      )
+    ),
+    submit: Effect.fn("ContradictionTriageRepository.submit")(() =>
+      Effect.fail(
+        ContradictionRepositoryUnavailable.during(
+          "submit",
+          "The fixture contradiction repository does not accept submissions."
+        )
+      )
+    ),
+  })
+);
diff --git a/apps/professional-desktop/src/contradiction/ContradictionQaSeed.ts b/apps/professional-desktop/src/contradiction/ContradictionQaSeed.ts
new file mode 100644
index 0000000000..a69df94402
--- /dev/null
+++ b/apps/professional-desktop/src/contradiction/ContradictionQaSeed.ts
@@ -0,0 +1,1071 @@
+/**
+ * Deterministic, opt-in contradiction-triage fixtures for browser QA.
+ *
+ * The seed is intentionally inert unless `BEEP_CONTRADICTION_QA_SEED=1`.
+ * Enabled runs require an isolated `BEEP_CONTRADICTION_QA_VAULT_ROOT`; the
+ * database is expected to be isolated independently through `CHAT_DB_PATH`.
+ *
+ * Every persisted identity is deterministic. Existing fixture rows and source
+ * bytes are reused only when they exactly match, while any collision fails
+ * closed without updating the existing record.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+import { Evidence } from "@beep/epistemic-domain/entities/Evidence";
+import { EvidenceVerification } from "@beep/epistemic-domain/entities/EvidenceVerification";
+import * as Epistemic from "@beep/epistemic-domain/identity/Epistemic";
+import {
+  BeliefVersionRef,
+  ContradictionAssessment,
+  ContradictionBeliefPair,
+  ContradictionMatchBasis,
+  ContradictionProposalId,
+  ContradictionReceiptKey,
+  ContradictionResolutionProposal,
+  contradictionEvidenceDigest,
+  contradictionProposalDigest,
+} from "@beep/epistemic-domain/values/Contradiction";
+import { Confidence, EvidenceSpan } from "@beep/epistemic-domain/values/EvidenceSpan";
+import { LogicalEdgeIdentity, logicalEdgeKey } from "@beep/epistemic-domain/values/LogicalEdgeIdentity";
+import { ContradictionTriageRepositoryDrizzle } from "@beep/epistemic-server/ContradictionTriage";
+import { EdgeAuthorityRepositoryDrizzle } from "@beep/epistemic-server/EdgeAuthority";
+import { DbSchema } from "@beep/epistemic-tables";
+import { fromEdgeVersionRow } from "@beep/epistemic-tables/entities/EdgeVersion";
+import { fromEvidenceRow, toEvidenceInsert } from "@beep/epistemic-tables/entities/Evidence";
+import {
+  fromEvidenceVerificationRow,
+  toEvidenceVerificationInsert,
