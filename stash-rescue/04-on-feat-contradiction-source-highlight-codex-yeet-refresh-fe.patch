+  ContradictionEvidenceView,
+  ContradictionReviewDecision as ContradictionReviewDecisionType,
+} from "@beep/epistemic-use-cases/ContradictionTriage";
+import type { JSX } from "react";
+import type { ContradictionTriageTab } from "./ContradictionTriageView.tsx";
+
+const activeTabAtom = Atom.make<ContradictionTriageTab>("queue").pipe(Atom.keepAlive);
+const reviewDialogOpenAtom = Atom.make(false).pipe(Atom.keepAlive);
+const reviewReasonAtom = Atom.make("").pipe(Atom.keepAlive);
+const selectedProposalAtom = Atom.make<O.Option<ContradictionResolutionProposal>>(O.none()).pipe(Atom.keepAlive);
+const noVisibleReview = AsyncResult.initial<ContradictionDisposition, ContradictionActionError>();
+
+const reviewDecision = (
+  proposal: O.Option<ContradictionResolutionProposal>,
+  reason: string
+): ContradictionReviewDecisionType =>
+  O.match(proposal, {
+    onNone: () => ContradictionReviewDecision.cases.reject.make({ reason }),
+    onSome: ({ proposalDigest, proposalId }) =>
+      ContradictionReviewDecision.cases.supersedeProposal.make({
+        proposalDigest,
+        proposalId,
+        reason,
+      }),
+  });
+
+/**
+ * Connect the controlled contradiction workspace to the shared Effect Atom
+ * runtime and authenticated RPC client.
+ *
+ * @example
+ * ```tsx
+ * import { ContradictionTriagePanel } from "@beep/epistemic-ui"
+ *
+ * export function ReviewWorkspace() {
+ *   return <ContradictionTriagePanel />
+ * }
+ * ```
+ *
+ * @category components
+ * @since 0.0.0
+ */
+export function ContradictionTriagePanel(): JSX.Element {
+  const activeTab = useAtomValue(activeTabAtom);
+  const disposition = useAtomValue(contradictionDispositionFilterAtom);
+  const knownAt = useAtomValue(contradictionKnownAtAtom);
+  const offset = useAtomValue(contradictionQueueOffsetAtom);
+  const queueResult = useAtomValue(contradictionQueueAtom);
+  const reviewCandidateId = useAtomValue(contradictionReviewCandidateIdAtom);
+  const reviewDialogOpen = useAtomValue(reviewDialogOpenAtom);
+  const reviewReason = useAtomValue(reviewReasonAtom);
+  const reviewResult = useAtomValue(reviewContradictionCandidateAtom);
+  const selectedCandidate = useAtomValue(selectedContradictionCandidateAtom);
+  const selectedCandidateId = useAtomValue(selectedContradictionCandidateIdAtom);
+  const selectedProposal = useAtomValue(selectedProposalAtom);
+  const selectedSource = useAtomValue(selectedContradictionEvidenceSourceAtom);
+  const sourceResult = useAtomValue(contradictionEvidenceSourcePageAtom);
+  const validAt = useAtomValue(contradictionValidAtAtom);
+
+  const refreshSource = useAtomSet(refreshContradictionEvidenceSourceAtom);
+  const refreshTriage = useAtomSet(refreshContradictionTriageAtom);
+  const resetTemporalView = useAtomSet(resetContradictionTemporalViewAtom);
+  const reviewCandidate = useAtomSet(reviewContradictionCandidateAtom);
+  const selectCandidate = useAtomSet(selectContradictionCandidateAtom);
+  const selectSource = useAtomSet(selectContradictionEvidenceSourceAtom);
+  const setActiveTab = useAtomSet(activeTabAtom);
+  const setDisposition = useAtomSet(contradictionDispositionFilterAtom);
+  const setKnownAt = useAtomSet(contradictionKnownAtAtom);
+  const setOffset = useAtomSet(contradictionQueueOffsetAtom);
+  const setReviewDialogOpen = useAtomSet(reviewDialogOpenAtom);
+  const setReviewReason = useAtomSet(reviewReasonAtom);
+  const setSelectedProposal = useAtomSet(selectedProposalAtom);
+  const setValidAt = useAtomSet(contradictionValidAtAtom);
+
+  const query = ContradictionListPayload.make({
+    disposition,
+    knownAt,
+    limit: CONTRADICTION_QUEUE_LIMIT,
+    offset,
+    validAt,
+  });
+  const visibleReviewResult = Equal.equals(selectedCandidateId, reviewCandidateId) ? reviewResult : noVisibleReview;
+
+  const selectCandidateAndCompare = (candidateId: ContradictionCandidateId): void => {
+    selectCandidate(candidateId);
+    setActiveTab("comparison");
+  };
+  const selectEvidenceSource = (evidence: ContradictionEvidenceView): void => {
+    O.zipWith(selectedCandidateId, evidence.verifiedAnchor, (candidateId) => {
+      selectSource(
+        EvidenceSourcePagePayload.make({
+          candidateId,
+          evidenceId: evidence.evidence.id,
+          selector: EvidenceSourcePageSelector.cases.anchor.make({}),
+        })
+      );
+      setActiveTab("source");
+    });
+  };
+  const changeSourcePage = (pageIndex: number): void => {
+    O.map(selectedSource, (request) =>
+      selectSource(
+        EvidenceSourcePagePayload.make({
+          candidateId: request.candidateId,
+          evidenceId: request.evidenceId,
+          selector: EvidenceSourcePageSelector.cases.page.make({
+            pageIndex: NonNegativeInt.make(pageIndex),
+          }),
+        })
+      )
+    );
+  };
+  const openRejectReview = (): void => {
+    setSelectedProposal(O.none());
+    setReviewReason("");
+    setReviewDialogOpen(true);
+  };
+  const openSupersessionReview = (proposal: ContradictionResolutionProposal): void => {
+    setSelectedProposal(O.some(proposal));
+    setReviewReason("");
+    setReviewDialogOpen(true);
+  };
+  const confirmReview = (): void => {
+    O.zipWith(selectedCandidateId, AsyncResult.value(selectedCandidate), (candidateId, detail) => {
+      const reason = Str.trim(reviewReason);
+      reviewCandidate(
+        ReviewContradictionCandidate.make({
+          candidateId,
+          decision: reviewDecision(selectedProposal, reason),
+          expectedCandidateVersion: detail.candidate.rowVersion,
+        })
+      );
+    });
+  };
+  const changeValidAt = (value: DateTime.DateTime | null): void => {
+    O.map(O.fromNullishOr(value), (dateTime) => {
+      setValidAt(dateTime.pipe(DateTime.toUtc));
+      setOffset(NonNegativeInt.make(0));
+    });
+  };
+  const changeKnownAt = (value: DateTime.DateTime | null): void => {
+    O.map(O.fromNullishOr(value), (dateTime) => {
+      setKnownAt(dateTime.pipe(DateTime.toUtc));
+      setOffset(NonNegativeInt.make(0));
+    });
+  };
+
+  return (
+    <ContradictionTriageView
+      activeTab={activeTab}
+      detailResult={selectedCandidate}
+      onActiveTabChange={setActiveTab}
+      onCandidateSelect={selectCandidateAndCompare}
+      onDetailRetry={refreshTriage}
+      onDispositionChange={(nextDisposition) => {
+        setDisposition(nextDisposition);
+        setOffset(NonNegativeInt.make(0));
+      }}
+      onEvidenceSelect={selectEvidenceSource}
+      onKnownAtChange={changeKnownAt}
+      onNextQueuePage={() => setOffset(NonNegativeInt.make(N.sum(offset, CONTRADICTION_QUEUE_LIMIT)))}
+      onPreviousQueuePage={() =>
+        setOffset(NonNegativeInt.make(N.max(0, N.subtract(offset, CONTRADICTION_QUEUE_LIMIT))))
+      }
+      onQueueRetry={refreshTriage}
+      onRejectRequested={openRejectReview}
+      onResetNow={resetTemporalView}
+      onReviewConfirm={confirmReview}
+      onReviewDialogOpenChange={setReviewDialogOpen}
+      onReviewReasonChange={setReviewReason}
+      onSourcePageChange={changeSourcePage}
+      onSourceRetry={refreshSource}
+      onSupersedeRequested={openSupersessionReview}
+      onValidAtChange={changeValidAt}
+      query={query}
+      queueResult={queueResult}
+      reviewDialogOpen={reviewDialogOpen}
+      reviewReason={reviewReason}
+      reviewResult={visibleReviewResult}
+      selectedCandidateId={selectedCandidateId}
+      selectedProposal={selectedProposal}
+      selectedSource={selectedSource}
+      sourceResult={sourceResult}
+    />
+  );
+}
