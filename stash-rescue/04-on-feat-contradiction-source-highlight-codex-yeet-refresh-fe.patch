+
+const receiptTable = pgTable("epistemic_contradiction_p0_receipt", {
+  candidateId: bigint("candidate_id", { mode: "number" }).notNull(),
+  id: serial("id").primaryKey(),
+  receivedAt: bigint("received_at", { mode: "number" }).notNull(),
