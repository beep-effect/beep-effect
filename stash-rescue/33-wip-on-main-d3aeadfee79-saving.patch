+:root {
+  font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
+  --surface: var(--card);
+  --surface-soft: var(--muted);
+  --line: var(--border);
+  --line-strong: var(--border);
+  --text-soft: var(--muted-foreground);
+  --accent: var(--primary);
+  --accent-strong: var(--ring);
+  --shadow: 0 24px 80px rgb(0 0 0 / 0.12);
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body,
+#root {
+  min-height: 100%;
+  margin: 0;
+}
+
+body {
+  min-height: 100vh;
+  background: var(--background);
+  color: var(--foreground);
+}
+
+button,
+input,
+textarea {
+  font: inherit;
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+input,
+textarea {
+  width: 100%;
+  border-radius: 16px;
+  border: 1px solid var(--line);
+  background: var(--background);
+  color: inherit;
+  padding: 0.9rem 1rem;
+}
+
+input:focus,
+textarea:focus {
+  outline: none;
+  border-color: var(--accent);
+  box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent);
+}
+
+.shell {
+  min-height: 100vh;
+  padding: 28px;
+  display: grid;
+  gap: 20px;
+  background:
+    radial-gradient(circle at top left, color-mix(in srgb, var(--accent) 12%, transparent), transparent 24%),
+    radial-gradient(circle at bottom right, color-mix(in srgb, var(--accent-strong) 10%, transparent), transparent 28%),
+    linear-gradient(180deg, var(--background) 0%, var(--background) 100%);
+}
+
+.hero,
+.panel {
+  border: 1px solid var(--line);
+  border-radius: 28px;
+  background: var(--surface);
+  box-shadow: var(--shadow);
+}
+
+.hero {
+  padding: 24px 28px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 18px;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.hero-copy {
+  max-width: 760px;
+}
+
+.eyebrow,
+.panel-label,
+.slug-label {
+  margin: 0 0 8px;
+  font-size: 0.76rem;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+  color: var(--accent);
+}
+
+h1,
+h2,
+h3,
+p {
+  margin-top: 0;
+}
+
+h1 {
+  margin-bottom: 12px;
+  max-width: 12ch;
+  font-size: clamp(2.8rem, 4.5vw, 4.8rem);
+  line-height: 0.94;
+  letter-spacing: -0.05em;
+}
+
+.lede,
+.muted,
+.page-card span,
+.backlink-item,
+.beep-editor-placeholder,
+.slug-label {
+  color: var(--text-soft);
+}
+
+.hero-actions,
+.beep-editor-toolbar {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  align-items: center;
+}
+
+.button,
+.page-card,
+.backlink-item,
+.beep-editor-toolbar-button {
+  transition:
+    transform 140ms ease,
+    border-color 140ms ease,
+    background-color 140ms ease;
+}
+
+.button {
+  border-radius: 999px;
+  border: 1px solid var(--line);
+  background: var(--secondary);
+  color: inherit;
+  padding: 11px 16px;
+  cursor: pointer;
+}
+
+.button:hover:not(:disabled),
+.page-card:hover,
+.backlink-item:hover,
+.beep-editor-toolbar-button:hover {
+  transform: translateY(-1px);
+  border-color: var(--accent);
+}
+
+.button.primary {
+  border-color: transparent;
+  background: var(--primary);
+  color: var(--primary-foreground);
+}
+
+.button.ghost,
+.beep-editor-toolbar-button {
+  background: var(--background);
+}
+
+.button:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+.workspace-grid {
+  display: grid;
+  gap: 20px;
+  grid-template-columns: minmax(260px, 320px) minmax(0, 1fr) minmax(260px, 320px);
+  align-items: start;
+}
+
+.panel {
+  min-height: 700px;
+  padding: 20px;
+}
+
+.panel-heading {
+  display: flex;
+  align-items: start;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 18px;
+}
+
+.page-list,
+.backlinks {
+  display: grid;
+  gap: 12px;
+}
+
+.search-label,
+.editor-meta {
+  display: grid;
+  gap: 8px;
+}
+
+.page-card,
+.backlink-item {
+  width: 100%;
+  border: 1px solid var(--line);
+  border-radius: 18px;
+  background: var(--surface-soft);
+  color: inherit;
+  text-align: left;
+  padding: 14px;
+  cursor: pointer;
+}
+
+.page-card-active {
+  border-color: var(--accent);
+  background: color-mix(in srgb, var(--accent) 10%, var(--surface));
+}
+
+.page-card strong {
+  display: block;
+  margin-bottom: 6px;
+  font-size: 1rem;
+}
+
+.title-input {
+  padding: 0;
+  border: 0;
+  background: transparent;
+  font-size: 2rem;
+  font-weight: 700;
+  letter-spacing: -0.04em;
+}
+
+.title-input:focus {
+  box-shadow: none;
+}
+
+.status-pill {
+  border-radius: 999px;
+  border: 1px solid var(--line);
+  padding: 4px 10px;
+  font-size: 0.78rem;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+}
+
+.status-healthy {
+  background: color-mix(in srgb, var(--accent-strong) 12%, transparent);
+}
+
+.status-starting {
+  background: color-mix(in srgb, var(--chart-4) 18%, transparent);
+}
+
+.status-stopped,
+.status-failed {
+  background: color-mix(in srgb, var(--destructive) 15%, transparent);
+}
+
+.editor-panel {
+  display: grid;
+  gap: 16px;
+}
+
+.beep-editor-shell {
+  display: grid;
+  gap: 14px;
+  min-height: 540px;
+}
+
+.beep-editor-toolbar-button {
+  border-radius: 999px;
+  border: 1px solid var(--line);
+  color: inherit;
+  padding: 8px 12px;
+  cursor: pointer;
+}
+
+.beep-editor-content {
+  min-height: 520px;
+  border-radius: 24px;
+  border: 1px solid var(--line-strong);
+  background: var(--background);
+  padding: 24px;
+}
+
+.beep-editor-content:focus {
+  outline: none;
+}
+
+.beep-editor-placeholder {
+  position: absolute;
+  padding: 24px;
+  pointer-events: none;
+}
+
+.beep-editor-paragraph,
+.beep-editor-quote {
+  margin: 0 0 1rem;
+  line-height: 1.7;
+}
+
+.beep-editor-heading {
+  margin: 0 0 0.8rem;
+  line-height: 1.1;
+  letter-spacing: -0.03em;
+}
+
+.beep-editor-heading-h1 {
+  font-size: 2rem;
+}
+
+.beep-editor-heading-h2 {
+  font-size: 1.5rem;
+}
+
+.beep-editor-heading-h3 {
+  font-size: 1.2rem;
+}
+
+.beep-editor-quote {
+  border-left: 3px solid var(--accent);
+  padding-left: 14px;
+}
+
+.inspector-grid {
+  display: grid;
+  gap: 12px;
+  margin-bottom: 22px;
+}
+
+.inspector-grid dt {
+  color: var(--text-soft);
+  font-size: 0.8rem;
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+}
+
+.inspector-grid dd {
+  margin: 4px 0 0;
+}
+
+.error-banner {
+  border-radius: 18px;
+  border: 1px solid color-mix(in srgb, var(--destructive) 35%, transparent);
+  background: color-mix(in srgb, var(--destructive) 15%, transparent);
+  color: var(--foreground);
+  padding: 12px 14px;
+}
+
+.empty-state {
+  display: grid;
+  align-content: center;
+  justify-items: start;
+  min-height: 100%;
+}
+
+@media (max-width: 1180px) {
+  .workspace-grid {
+    grid-template-columns: 1fr;
+  }
+}
