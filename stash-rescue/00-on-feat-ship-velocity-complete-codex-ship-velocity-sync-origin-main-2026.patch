+  for (const args of commands) {
+    const result = Bun.spawnSync(["git", ...args], { cwd: context.repoRoot, stderr: "ignore", stdout: "pipe" });
+    if (result.exitCode === 0) paths.push(...A.filter(Str.split(result.stdout.toString(), "\0"), Str.isNonEmpty));
