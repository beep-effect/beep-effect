+import { buildExplorationAtlasContent } from "@beep/repo-cli/commands/Explore";
+import { Unknown } from "@beep/schema/Unknown";
+import { NodeServices } from "@effect/platform-node";
+import { Effect, FileSystem, Layer, Path } from "effect";
+import { describe, expect, it } from "vitest";
+
+const encodeJson = Unknown.encodeUnknownSyncFromJsonString;
+const provideNodeServices = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+  Effect.scoped(
+    Layer.build(NodeServices.layer).pipe(Effect.flatMap((context) => effect.pipe(Effect.provide(context))))
+  );
+
+describe("exploration Atlas", () => {
+  it("renders every valid manifest wholesale in stable status/slug order and reports invalid packets", () =>
+    Effect.runPromise(
+      provideNodeServices(
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          const path = yield* Path.Path;
+          const root = yield* fs.makeTempDirectory({ prefix: "beep-exploration-atlas-" });
+          const explorations = path.join(root, "explorations");
+          const manifest = (slug: string, title: string, status: string, stage: string) => ({
+            schemaVersion: "exploration-manifest/v1",
+            exploration: { slug, title, status, stage, updated: "2026-08-27" },
+          });
+          for (const [slug, document] of [
+            ["zeta", manifest("zeta", "Zeta", "active", "shape")],
+            ["alpha", manifest("alpha", "Alpha", "active", "research")],
+            ["done", manifest("done", "Done", "graduated", "graduate")],
+          ] as const) {
+            const ops = path.join(explorations, slug, "ops");
+            yield* fs.makeDirectory(ops, { recursive: true });
+            yield* fs.writeFileString(path.join(ops, "manifest.json"), encodeJson(document));
+          }
+          yield* fs.makeDirectory(path.join(explorations, "broken"), { recursive: true });
+          yield* fs.makeDirectory(path.join(explorations, "_internal"), { recursive: true });
+
+          const content = yield* buildExplorationAtlasContent(root);
+
+          expect(content).toContain("4 exploration packets.");
