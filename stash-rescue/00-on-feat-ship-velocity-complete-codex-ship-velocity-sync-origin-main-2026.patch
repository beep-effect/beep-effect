+export const selectAdmissionWaiter: {
+  (nowEpochMs: number): (waiters: ReadonlyArray<AdmissionWaiter>) => O.Option<AdmissionWaiter>;
+  (waiters: ReadonlyArray<AdmissionWaiter>, nowEpochMs: number): O.Option<AdmissionWaiter>;
