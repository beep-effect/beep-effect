+    queuePosition: input.queuePosition,
+    usedTokens: input.usedTokens,
+    capacityTokens: input.capacityTokens,
+    memAvailableGiB: input.availableKiB / (1024 * 1024),
+    psiAvg10: input.psiAvg10,
+    reason: "admitted",
