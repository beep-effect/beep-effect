+[Unit]
+Description=Yeet published-PR dead-owner recovery watcher
+After=default.target
+
+[Service]
+Type=simple
+ExecStart=@WATCH_SCRIPT@
+Restart=on-failure
+RestartSec=5
+Environment=BEEP_YEET_LEASE_STALE_SECONDS=240
+Environment=BEEP_YEET_WATCH_INTERVAL_SECONDS=30
+
+[Install]
+WantedBy=default.target
