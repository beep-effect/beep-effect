+  const ordered = A.sort(waiters, waiterOrder);
+  const aged = A.filter(ordered, (waiter) => nowEpochMs - waiter.enqueuedAtEpochMs >= ADMISSION_PUBLISH_AGING_MS);
+  if (A.isReadonlyArrayNonEmpty(aged)) return A.head(aged);
