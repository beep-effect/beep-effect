+  const some = A.findFirst(Str.split(text, "\n"), Str.startsWith("some "));
+  return pipe(
+    some,
+    O.flatMap((line) => O.fromNullishOr(/\bavg10=([0-9.]+)/u.exec(line)?.[1])),
+    O.map((value) => globalThis.Number.parseFloat(value)),
+    O.filter(globalThis.Number.isFinite),
+    O.getOrElse(() => 0)
