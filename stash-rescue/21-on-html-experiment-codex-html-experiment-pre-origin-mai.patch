diff --git a/packages/foundation/primitive/data/test/html-tags.test.ts b/packages/foundation/primitive/data/test/html-tags.test.ts
new file mode 100644
index 0000000000..b8231e70c3
--- /dev/null
+++ b/packages/foundation/primitive/data/test/html-tags.test.ts
@@ -0,0 +1,66 @@
+import {
+  HtmlAttributeDataByName,
+  HtmlAttributeDataNameValues,
+  HtmlAttributeDataTagsByAttribute,
+  HtmlAttributeDataValues,
+  HtmlTagDataAttributesByTag,
+  HtmlTagDataByTag,
+  HtmlTagDataMetadata,
+  HtmlTagDataSourceSha256,
+  HtmlTagDataSourceUrls,
+  HtmlTagDataTagValues,
+} from "@beep/data/HtmlTags";
+import { ELEMENT_META, StandardGlobalAttributes } from "@beep/html";
+import { A } from "@beep/utils";
+import { describe, expect, it } from "@effect/vitest";
+import { Struct } from "effect";
+
+describe("WHATWG HTML tag data", () => {
+  it("exports generated tag metadata and source metadata", () => {
+    expect(HtmlTagDataByTag.div.tag).toBe("div");
+    expect(HtmlTagDataByTag.img.interface).toBe("HTMLImageElement");
+    expect(HtmlTagDataTagValues).toContain("html");
+    expect(HtmlTagDataTagValues).toContain("template");
+    expect(HtmlTagDataSourceUrls).toEqual([
+      "https://html.spec.whatwg.org/multipage/indices.html",
+      "https://html.spec.whatwg.org/multipage/dom.html",
+    ]);
+    expect(HtmlTagDataSourceSha256.indices).toHaveLength(64);
+    expect(HtmlTagDataSourceSha256.dom).toHaveLength(64);
+    expect(HtmlTagDataMetadata.sha256).toEqual(HtmlTagDataSourceSha256);
+  });
+
+  it("exports attribute applicability maps", () => {
+    expect(HtmlAttributeDataByName.class.scope).toBe("global");
+    expect(HtmlAttributeDataByName.class.applicableTags).toContain("div");
+    expect(HtmlAttributeDataByName["data-*"].scope).toBe("global");
+    expect(HtmlAttributeDataByName.src.applicableTags).toContain("img");
+    expect(HtmlTagDataAttributesByTag.img).toContain("src");
+    expect(HtmlTagDataAttributesByTag.div).toContain("class");
+    expect(HtmlAttributeDataTagsByAttribute.src).toContain("img");
+  });
+
+  it("keeps v1 scope to HTML non-event attributes", () => {
+    const attributesByName = HtmlAttributeDataByName as Readonly<Record<string, unknown>>;
+
+    expect(HtmlAttributeDataNameValues).not.toContain("role");
+    expect(HtmlAttributeDataNameValues).not.toContain("aria-label");
+    expect(attributesByName.onload).toBeUndefined();
+  });
+
+  it("aligns current tags and global attributes with @beep/html", () => {
+    const standardGlobalAttributeNames = Struct.keys(StandardGlobalAttributes);
+    const globalHtmlAttributes = A.filter(
+      HtmlAttributeDataValues,
+      (entry) => entry.scope === "global" && entry.name !== "data-*"
+    );
+
+    for (const tag of HtmlTagDataTagValues) {
+      expect(ELEMENT_META[tag]?.conformance).toBe("conforming");
+    }
+
+    for (const attribute of globalHtmlAttributes) {
+      expect(standardGlobalAttributeNames).toContain(attribute.name);
+    }
+  });
+});
