+/**
+ * Official WHATWG HTML tag and attribute index target definition.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+import { $RepoCliId } from "@beep/identity/packages";
+import { A, Str } from "@beep/utils";
+import { Effect, Order, pipe, Result } from "effect";
+import { flow } from "effect/Function";
+import * as P from "effect/Predicate";
+import * as R from "effect/Record";
+import * as S from "effect/Schema";
+import { parse } from "parse5";
+import { SyncDataTargetProjection, SyncDataToTsError } from "../internal/Models.js";
+import {
+  fetchSource,
+  formatJson,
+  formatTsDocCommentValue,
+  formatTsLiteral,
+  outputFile,
+  sourceMetadata,
+} from "../internal/Source.js";
+import type { DefaultTreeAdapterTypes } from "parse5";
+import type { SyncDataTarget } from "../internal/Models.js";
+
+const $I = $RepoCliId.create("commands/SyncDataToTs/targets/HtmlTags");
+const targetId = "html-tags-attributes" as const;
+const outputPath = "packages/foundation/primitive/data/src/generated/html-tags.ts" as const;
+const canonicalPath = "packages/foundation/primitive/data/src/generated/html-tags.data.json" as const;
+const WHATWG_HTML_BASE_URL = "https://html.spec.whatwg.org/multipage/" as const;
+const WHATWG_HTML_DATA_ATTRIBUTE_HREF = "https://html.spec.whatwg.org/multipage/dom.html#attr-data-*" as const;
+const validHtmlTagNamePattern = /^[a-z][a-z0-9-]*$/u;
+
+/**
+ * Official WHATWG HTML element and attribute index.
+ *
+ * @category configuration
+ * @since 0.0.0
+ */
+export const WHATWG_HTML_INDICES_SOURCE_URL = "https://html.spec.whatwg.org/multipage/indices.html" as const;
+
+/**
+ * Official WHATWG HTML DOM chapter source for custom `data-*` attributes.
+ *
+ * @category configuration
+ * @since 0.0.0
+ */
+export const WHATWG_HTML_DOM_SOURCE_URL = "https://html.spec.whatwg.org/multipage/dom.html" as const;
+
+class HtmlTagEntry extends S.Class<HtmlTagEntry>($I`HtmlTagEntry`)(
+  {
+    tag: S.String,
+    description: S.String,
+    interface: S.String,
+    sourceHref: S.String,
+  },
+  $I.annote("HtmlTagEntry", {
+    description: "Normalized WHATWG HTML element index entry rendered into @beep/data.",
+  })
+) {}
+
+const HtmlAttributeScope = S.Literals(["element", "global", "mixed"]).pipe(
+  $I.annoteSchema("HtmlAttributeScope", {
+    description: "Scope of an HTML attribute after normalizing WHATWG applicability rows.",
+  })
+);
+
+class HtmlAttributeUsageEntry extends S.Class<HtmlAttributeUsageEntry>($I`HtmlAttributeUsageEntry`)(
+  {
+    name: S.String,
+    scope: HtmlAttributeScope,
+    applicableTags: S.Array(S.String),
+    description: S.String,
+    value: S.String,
+    sourceHrefs: S.Array(S.String),
+  },
+  $I.annote("HtmlAttributeUsageEntry", {
+    description: "One WHATWG HTML attribute usage row with concrete element applicability.",
+  })
+) {}
+
+class HtmlAttributeEntry extends S.Class<HtmlAttributeEntry>($I`HtmlAttributeEntry`)(
+  {
+    name: S.String,
+    scope: HtmlAttributeScope,
+    applicableTags: S.Array(S.String),
+    description: S.String,
+    value: S.String,
+    usages: S.Array(HtmlAttributeUsageEntry),
+    sourceHrefs: S.Array(S.String),
+  },
+  $I.annote("HtmlAttributeEntry", {
+    description: "Aggregated WHATWG HTML attribute data keyed by attribute name.",
+  })
+) {}
+
+type HtmlTagEntryType = HtmlTagEntry;
+type HtmlAttributeUsageEntryType = HtmlAttributeUsageEntry;
+type HtmlAttributeEntryType = HtmlAttributeEntry;
+type HtmlNode = DefaultTreeAdapterTypes.Node;
+type HtmlElement = DefaultTreeAdapterTypes.Element;
+
+const normalizeText = flow(Str.replaceAll(/\s+/gu, " "), Str.trim);
+const lowerTrim = flow(normalizeText, Str.toLowerCase);
+
+const childNodes = (node: HtmlNode): ReadonlyArray<HtmlNode> =>
+  P.hasProperty(node, "childNodes") && A.isArray(node.childNodes)
+    ? (node.childNodes as ReadonlyArray<HtmlNode>)
+    : A.empty<HtmlNode>();
+
+const isElement = (node: HtmlNode): node is HtmlElement => P.hasProperty(node, "tagName") && P.isString(node.tagName);
+
+const isTextNode = (node: HtmlNode): node is DefaultTreeAdapterTypes.TextNode =>
+  node.nodeName === "#text" && P.hasProperty(node, "value") && P.isString(node.value);
+
+const directElementChildren = (node: HtmlNode, tagNames: ReadonlyArray<string>): ReadonlyArray<HtmlElement> => {
+  const children = A.empty<HtmlElement>();
+  for (const child of childNodes(node)) {
+    if (isElement(child) && A.some(tagNames, (tagName) => child.tagName === tagName)) {
+      A.appendInPlace(children, child);
+    }
+  }
+  return children;
+};
+
+const textContent = (node: HtmlNode): string => {
+  if (isTextNode(node)) {
+    return node.value;
+  }
+  return pipe(childNodes(node), A.map(textContent), A.join(""));
+};
+
+const normalizedTextContent = (node: HtmlNode): string => normalizeText(textContent(node));
+
+const allElements = (node: HtmlNode): ReadonlyArray<HtmlElement> => {
+  const elements = A.empty<HtmlElement>();
+  const visit = (current: HtmlNode) => {
+    if (isElement(current)) {
+      A.appendInPlace(elements, current);
+    }
+    for (const child of childNodes(current)) {
+      visit(child);
+    }
+  };
+
+  visit(node);
+  return elements;
+};
+
+const elementAttrValue = (element: HtmlElement, name: string): string | undefined => {
+  const attribute = A.findFirst(element.attrs, (candidate) => candidate.name === name);
+  return attribute._tag === "Some" ? attribute.value.value : undefined;
+};
+
+const resolveHref = (href: string): string => new URL(href, WHATWG_HTML_BASE_URL).href;
+
+const anchorLinks = (node: HtmlNode): ReadonlyArray<readonly [label: string, href: string]> =>
+  pipe(
+    allElements(node),
+    A.filter((element) => element.tagName === "a"),
+    A.filterMap((element) => {
+      const href = elementAttrValue(element, "href");
+      const label = normalizedTextContent(element);
+      return href !== undefined && Str.isNonEmpty(label)
+        ? Result.succeed([label, resolveHref(href)] as const)
+        : Result.failVoid;
+    })
+  );
+
+const sourceHrefsFromCells = (cells: ReadonlyArray<HtmlElement>): ReadonlyArray<string> =>
+  pipe(
+    cells,
+    A.flatMap((cell) =>
+      pipe(
+        anchorLinks(cell),
+        A.map(([, href]) => href)
+      )
+    ),
+    A.dedupe,
+    A.sort(Order.String)
+  );
+
+const tableCaption = (table: HtmlElement): string =>
+  pipe(directElementChildren(table, ["caption"]), A.head, (option) =>
+    option._tag === "Some" ? normalizedTextContent(option.value) : ""
+  );
+
+const findTableByCaption = (document: HtmlNode, expectedCaption: string): HtmlElement | undefined =>
+  pipe(
+    allElements(document),
+    A.findFirst((element) => element.tagName === "table" && Str.includes(expectedCaption)(tableCaption(element))),
+    (option) => (option._tag === "Some" ? option.value : undefined)
+  );
+
+const tableRows = (table: HtmlElement): ReadonlyArray<ReadonlyArray<HtmlElement>> => {
+  const rows = A.empty<ReadonlyArray<HtmlElement>>();
+  for (const row of directElementChildren(table, ["tbody", "thead", "tfoot", "tr"]).flatMap((child) =>
+    child.tagName === "tr" ? [child] : directElementChildren(child, ["tr"])
+  )) {
+    const cells = directElementChildren(row, ["th", "td"]);
+    if (A.length(cells) > 0) {
+      A.appendInPlace(rows, cells);
+    }
+  }
+  return rows;
+};
+
+const firstAnchorLabel = (cell: HtmlElement): string | undefined =>
+  pipe(anchorLinks(cell), A.head, (option) => (option._tag === "Some" ? option.value[0] : undefined));
+
+const firstCodeLabel = (cell: HtmlElement): string | undefined =>
+  pipe(
+    allElements(cell),
+    A.findFirst((element) => element.tagName === "code"),
+    (option) => (option._tag === "Some" ? normalizedTextContent(option.value) : undefined)
+  );
+
+const sortedUnique = (values: ReadonlyArray<string>): ReadonlyArray<string> =>
+  pipe(values, A.filter(Str.isNonEmpty), A.dedupe, A.sort(Order.String));
+
+const tagNamesFromCell = (cell: HtmlElement, tagNames: ReadonlySet<string>): ReadonlyArray<string> =>
+  pipe(
+    anchorLinks(cell),
+    A.map(([label]) => lowerTrim(label)),
+    A.filter((label) => tagNames.has(label)),
+    sortedUnique
+  );
+
+const isGlobalApplicability = (cell: HtmlElement): boolean =>
+  Str.includes("HTML elements")(normalizedTextContent(cell));
+
+const isExcludedAttributeName = (name: string): boolean =>
+  name === "role" || Str.startsWith("aria-")(name) || Str.startsWith("on")(name);
+
+const parseHtmlTagEntries = (indicesHtml: string): Effect.Effect<ReadonlyArray<HtmlTagEntryType>, SyncDataToTsError> =>
+  Effect.gen(function* () {
+    const document = parse(indicesHtml);
+    const table = findTableByCaption(document, "List of elements");
+
+    if (table === undefined) {
+      return yield* SyncDataToTsError.make({
+        message: "Failed to locate the WHATWG HTML element index table.",
+        targetId,
+      });
+    }
+
+    const values = pipe(
+      tableRows(table),
+      A.filterMap((cells) => {
+        const tagCell = cells[0];
+        const descriptionCell = cells[1];
+        const interfaceCell = cells[6];
+
+        if (tagCell === undefined || descriptionCell === undefined || interfaceCell === undefined) {
+          return Result.failVoid;
+        }
+
+        const tagLabel = firstAnchorLabel(tagCell) ?? firstCodeLabel(tagCell);
+        if (tagLabel === undefined) {
+          return Result.failVoid;
+        }
+        const tag = lowerTrim(tagLabel);
+        if (!validHtmlTagNamePattern.test(tag)) {
+          return Result.failVoid;
+        }
+
+        const tagSourceHref = pipe(anchorLinks(tagCell), A.head, (option) =>
+          option._tag === "Some" ? option.value[1] : resolveHref(`#the-${tag}-element`)
+        );
+
+        return Result.succeed(
+          HtmlTagEntry.make({
+            tag,
+            description: normalizedTextContent(descriptionCell),
+            interface: normalizedTextContent(interfaceCell),
+            sourceHref: tagSourceHref,
+          })
+        );
+      }),
+      A.sort(Order.mapInput(Order.String, ({ tag }: HtmlTagEntryType) => tag))
+    );
+
+    return A.length(values) === 0
+      ? yield* SyncDataToTsError.make({
+          message: "The WHATWG HTML element index table did not contain any usable tag rows.",
+          targetId,
+        })
+      : values;
+  });
+
+const findElementById = (document: HtmlNode, id: string): HtmlElement | undefined =>
+  pipe(
+    allElements(document),
+    A.findFirst((element) => elementAttrValue(element, "id") === id),
+    (option) => (option._tag === "Some" ? option.value : undefined)
+  );
+
+const dataAttributeDescription = (domHtml: string): string => {
+  const document = parse(domHtml);
+  const dataAttributeAnchor = findElementById(document, "attr-data-*");
+  const parent = dataAttributeAnchor?.parentNode;
+
+  if (parent !== undefined && parent !== null) {
+    const parentText = normalizedTextContent(parent);
+    if (Str.isNonEmpty(parentText)) {
+      return parentText;
+    }
+  }
+
+  return "Custom data attributes store custom data private to the page or application on any HTML element.";
+};
+
+const makeDataAttributeUsage = (tagNames: ReadonlyArray<string>, domHtml: string): HtmlAttributeUsageEntryType =>
+  HtmlAttributeUsageEntry.make({
+    name: "data-*",
+    scope: "global",
+    applicableTags: tagNames,
+    description: dataAttributeDescription(domHtml),
+    value: "Any string",
+    sourceHrefs: [WHATWG_HTML_DATA_ATTRIBUTE_HREF],
+  });
+
+const parseHtmlAttributeUsageEntries = (
+  indicesHtml: string,
+  domHtml: string,
+  tags: ReadonlyArray<HtmlTagEntryType>
+): Effect.Effect<ReadonlyArray<HtmlAttributeUsageEntryType>, SyncDataToTsError> =>
+  Effect.gen(function* () {
+    const document = parse(indicesHtml);
+    const table = findTableByCaption(document, "List of attributes");
+    const tagNames = A.map(tags, (entry) => entry.tag);
+    const tagNameSet = new Set(tagNames);
+
+    if (table === undefined) {
+      return yield* SyncDataToTsError.make({
+        message: "Failed to locate the WHATWG HTML attribute index table.",
+        targetId,
+      });
+    }
+
+    const values = pipe(
+      tableRows(table),
+      A.filterMap((cells) => {
+        const nameCell = cells[0];
+        const elementCell = cells[1];
+        const descriptionCell = cells[2];
+        const valueCell = cells[3];
+
+        if (
+          nameCell === undefined ||
+          elementCell === undefined ||
+          descriptionCell === undefined ||
+          valueCell === undefined
+        ) {
+          return Result.failVoid;
+        }
+
+        const nameLabel = firstAnchorLabel(nameCell) ?? firstCodeLabel(nameCell);
+        if (nameLabel === undefined) {
+          return Result.failVoid;
+        }
+
+        const name = lowerTrim(nameLabel);
+        if (Str.isEmpty(name) || isExcludedAttributeName(name)) {
+          return Result.failVoid;
+        }
+
+        const scope = isGlobalApplicability(elementCell) ? "global" : "element";
+        const applicableTags = scope === "global" ? tagNames : tagNamesFromCell(elementCell, tagNameSet);
+
+        if (A.length(applicableTags) === 0) {
+          return Result.failVoid;
+        }
+
+        return Result.succeed(
+          HtmlAttributeUsageEntry.make({
+            name,
+            scope,
+            applicableTags,
+            description: normalizedTextContent(descriptionCell),
+            value: normalizedTextContent(valueCell),
+            sourceHrefs: sourceHrefsFromCells([nameCell, elementCell, descriptionCell, valueCell]),
+          })
+        );
+      })
+    );
+
+    const withDataAttribute = pipe(
+      A.append(values, makeDataAttributeUsage(tagNames, domHtml)),
+      A.sort(
+        Order.mapInput(
+          Order.String,
+          (entry: HtmlAttributeUsageEntryType) => `${entry.name}\u0000${A.join(entry.applicableTags, ",")}`
+        )
+      )
+    );
+
+    return A.length(withDataAttribute) === 0
+      ? yield* SyncDataToTsError.make({
+          message: "The WHATWG HTML attribute index table did not contain any usable attribute rows.",
+          targetId,
+        })
+      : withDataAttribute;
+  });
+
+const mergeAttributeScope = (usages: ReadonlyArray<HtmlAttributeUsageEntryType>): HtmlAttributeEntryType["scope"] => {
+  const hasGlobal = A.some(usages, (usage) => usage.scope === "global");
+  const hasElement = A.some(usages, (usage) => usage.scope === "element");
+  return hasGlobal && hasElement ? "mixed" : hasGlobal ? "global" : "element";
+};
+
+const aggregateAttributes = (
+  usages: ReadonlyArray<HtmlAttributeUsageEntryType>
+): ReadonlyArray<HtmlAttributeEntryType> => {
+  const grouped = R.empty<string, Array<HtmlAttributeUsageEntryType>>();
+
+  for (const usage of usages) {
+    grouped[usage.name] = [...(grouped[usage.name] ?? []), usage];
+  }
+
+  return pipe(
+    R.keys(grouped),
+    A.sort(Order.String),
+    A.map((name) => {
+      const attributeUsages = grouped[name] ?? A.empty<HtmlAttributeUsageEntryType>();
+      const firstUsage = attributeUsages[0];
+      return HtmlAttributeEntry.make({
+        name,
+        scope: mergeAttributeScope(attributeUsages),
+        applicableTags: sortedUnique(A.flatten(A.map(attributeUsages, (usage) => usage.applicableTags))),
+        description: firstUsage?.description ?? "",
+        value: firstUsage?.value ?? "",
+        usages: attributeUsages,
+        sourceHrefs: sortedUnique(A.flatten(A.map(attributeUsages, (usage) => usage.sourceHrefs))),
+      });
+    })
+  );
+};
+
+const byTag = (values: ReadonlyArray<HtmlTagEntryType>) =>
+  R.fromEntries(A.map(values, (entry) => [entry.tag, entry] as const));
+
+const byAttributeName = (values: ReadonlyArray<HtmlAttributeEntryType>) =>
+  R.fromEntries(A.map(values, (entry) => [entry.name, entry] as const));
+
+const attributesByTag = (
+  tags: ReadonlyArray<HtmlTagEntryType>,
+  attributes: ReadonlyArray<HtmlAttributeEntryType>
+): Record<string, ReadonlyArray<string>> => {
+  const grouped: Record<string, ReadonlyArray<string>> = R.fromEntries(
+    A.map(tags, (entry) => [entry.tag, A.empty<string>()] as const)
+  );
+
+  for (const attribute of attributes) {
+    for (const tag of attribute.applicableTags) {
+      grouped[tag] = sortedUnique(A.append(grouped[tag] ?? A.empty<string>(), attribute.name));
+    }
+  }
+
+  return grouped;
+};
+
+const tagsByAttribute = (attributes: ReadonlyArray<HtmlAttributeEntryType>): Record<string, ReadonlyArray<string>> =>
+  R.fromEntries(A.map(attributes, (entry) => [entry.name, entry.applicableTags] as const));
+
+const renderHtmlTagsModule = (
+  indicesSha256: string,
+  domSha256: string,
+  tags: ReadonlyArray<HtmlTagEntryType>,
+  attributeUsages: ReadonlyArray<HtmlAttributeUsageEntryType>,
+  attributes: ReadonlyArray<HtmlAttributeEntryType>
+): string => `/**
+ * Generated WHATWG HTML tag and attribute index data.
+ *
+ * Generated by \`bun run beep sync-data-to-ts --target html-tags-attributes\`.
+ * Source: ${formatTsDocCommentValue(WHATWG_HTML_INDICES_SOURCE_URL)}
+ * Source: ${formatTsDocCommentValue(WHATWG_HTML_DOM_SOURCE_URL)}
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+/**
+ * Stable source metadata for the official WHATWG HTML tag and attribute dataset.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataMetadata = ${formatTsLiteral({
+  sourceUrls: [WHATWG_HTML_INDICES_SOURCE_URL, WHATWG_HTML_DOM_SOURCE_URL],
+  sha256: {
+    indices: indicesSha256,
+    dom: domSha256,
+  },
+})} as const;
+
+/**
+ * Official WHATWG HTML source URLs used by this dataset.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataSourceUrls = ${formatTsLiteral([WHATWG_HTML_INDICES_SOURCE_URL, WHATWG_HTML_DOM_SOURCE_URL])} as const;
+
+/**
+ * SHA-256 digests of the official source payloads used for this generated module.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataSourceSha256 = ${formatTsLiteral({
+  indices: indicesSha256,
+  dom: domSha256,
+})} as const;
+
+/**
+ * Normalized WHATWG HTML tag entries.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataValues = ${formatTsLiteral(tags)} as const;
+
+/**
+ * Normalized WHATWG HTML tag entries keyed by tag name.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataByTag = ${formatTsLiteral(byTag(tags))} as const;
+
+/**
+ * WHATWG HTML tag literal values.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataTagValues = ${formatTsLiteral(A.map(tags, (entry) => entry.tag))} as const;
+
+/**
+ * Normalized WHATWG HTML attribute usage rows.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataUsageValues = ${formatTsLiteral(attributeUsages)} as const;
+
+/**
+ * Aggregated WHATWG HTML attribute entries.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataValues = ${formatTsLiteral(attributes)} as const;
+
+/**
+ * Aggregated WHATWG HTML attribute entries keyed by attribute name.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataByName = ${formatTsLiteral(byAttributeName(attributes))} as const;
+
+/**
+ * WHATWG HTML attribute literal values.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataNameValues = ${formatTsLiteral(A.map(attributes, (entry) => entry.name))} as const;
+
+/**
+ * Attribute names applicable to each WHATWG HTML tag.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataAttributesByTag = ${formatTsLiteral(attributesByTag(tags, attributes))} as const;
+
+/**
+ * HTML tag names applicable to each WHATWG HTML attribute.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataTagsByAttribute = ${formatTsLiteral(tagsByAttribute(attributes))} as const;
+`;
+
+/**
+ * Normalize the WHATWG HTML source payloads into tag and attribute records.
+ *
+ * @category utilities
+ * @since 0.0.0
+ */
+export const normalizeHtmlTagsSources = Effect.fn("SyncDataToTs.HtmlTags.normalize")(function* (
+  indicesHtml: string,
+  domHtml: string
+) {
+  const tags = yield* parseHtmlTagEntries(indicesHtml);
+  const attributeUsages = yield* parseHtmlAttributeUsageEntries(indicesHtml, domHtml, tags);
+  const attributes = aggregateAttributes(attributeUsages);
+
+  return { tags, attributeUsages, attributes } as const;
+});
+
+const acquireHtmlTagsProjection = Effect.fn("SyncDataToTs.HtmlTags.acquire")(function* () {
+  const indicesSource = yield* fetchSource(targetId, "whatwg-html-indices", WHATWG_HTML_INDICES_SOURCE_URL);
+  const domSource = yield* fetchSource(targetId, "whatwg-html-dom", WHATWG_HTML_DOM_SOURCE_URL);
+  const { tags, attributeUsages, attributes } = yield* normalizeHtmlTagsSources(indicesSource.text, domSource.text);
+  const sourceMetadataValues = [sourceMetadata(indicesSource), sourceMetadata(domSource)];
+  const canonical = {
+    schemaVersion: "beep-data/html-tags-attributes/v1",
+    metadata: sourceMetadataValues,
+    tagsByTag: byTag(tags),
+    attributesByName: byAttributeName(attributes),
+  } as const;
+
+  return SyncDataTargetProjection.make({
+    files: [
+      outputFile(
+        outputPath,
+        renderHtmlTagsModule(indicesSource.sha256, domSource.sha256, tags, attributeUsages, attributes)
+      ),
+      outputFile(canonicalPath, formatJson(canonical)),
+    ],
+    canonicalPath,
+    canonical,
+    recordCount: A.length(tags) + A.length(attributes),
+    summary: `${A.length(tags)} HTML tags and ${A.length(attributes)} attributes from WHATWG`,
+    sources: sourceMetadataValues,
+  });
+});
+
+/**
+ * Checked-in sync target for WHATWG HTML tag and attribute metadata.
+ *
+ * @category configuration
+ * @since 0.0.0
+ */
+export const htmlTagsTarget: SyncDataTarget = {
+  id: targetId,
+  access: "public",
+  description: "Sync official WHATWG HTML tag and attribute applicability data.",
+  sourceUrls: [WHATWG_HTML_INDICES_SOURCE_URL, WHATWG_HTML_DOM_SOURCE_URL],
