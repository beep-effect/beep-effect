diff --git a/packages/foundation/primitive/data/dtslint/html-tags.tst.ts b/packages/foundation/primitive/data/dtslint/html-tags.tst.ts
new file mode 100644
index 0000000000..1968957987
--- /dev/null
+++ b/packages/foundation/primitive/data/dtslint/html-tags.tst.ts
@@ -0,0 +1,54 @@
+import { HtmlAttributeDataByName, HtmlTagDataByTag } from "@beep/data/HtmlTags";
+import { describe, expect, it } from "tstyche";
+import type {
+  HtmlAttributeData,
+  HtmlAttributeName,
+  HtmlAttributeScope,
+  HtmlAttributeUsageData,
+  HtmlTagData,
+  HtmlTagName,
+} from "@beep/data/HtmlTags";
+
+describe("HtmlTagName", () => {
+  it("includes current WHATWG HTML tag literals", () => {
+    expect<"div">().type.toBeAssignableTo<HtmlTagName>();
+    expect<"img">().type.toBeAssignableTo<HtmlTagName>();
+    expect<"template">().type.toBeAssignableTo<HtmlTagName>();
+  });
+
+  it("rejects unknown or obsolete tag strings", () => {
+    expect<"not-a-tag">().type.not.toBeAssignableTo<HtmlTagName>();
+    expect<"blink">().type.not.toBeAssignableTo<HtmlTagName>();
+  });
+});
+
+describe("HtmlAttributeName", () => {
+  it("includes synced WHATWG HTML attribute literals", () => {
+    expect<"class">().type.toBeAssignableTo<HtmlAttributeName>();
+    expect<"src">().type.toBeAssignableTo<HtmlAttributeName>();
+    expect<"data-*">().type.toBeAssignableTo<HtmlAttributeName>();
+  });
+
+  it("rejects attributes intentionally outside v1 scope", () => {
+    expect<"onload">().type.not.toBeAssignableTo<HtmlAttributeName>();
+    expect<"aria-label">().type.not.toBeAssignableTo<HtmlAttributeName>();
+    expect<"role">().type.not.toBeAssignableTo<HtmlAttributeName>();
+  });
+});
+
+describe("HTML data constants", () => {
+  it("preserves literal tag and attribute shapes", () => {
+    expect(HtmlTagDataByTag.div).type.toBeAssignableTo<HtmlTagData>();
+    expect(HtmlTagDataByTag.div.tag).type.toBe<"div">();
+    expect(HtmlAttributeDataByName.class).type.toBeAssignableTo<HtmlAttributeData>();
+    expect(HtmlAttributeDataByName.class.scope).type.toBe<"global">();
+    expect(HtmlAttributeDataByName.src).type.toBeAssignableTo<HtmlAttributeData>();
+    expect(HtmlAttributeDataByName.src.usages[0]).type.toBeAssignableTo<HtmlAttributeUsageData>();
+  });
+
+  it("exposes the attribute scope union", () => {
+    expect<"global">().type.toBeAssignableTo<HtmlAttributeScope>();
+    expect<"element">().type.toBeAssignableTo<HtmlAttributeScope>();
+    expect<"mixed">().type.toBeAssignableTo<HtmlAttributeScope>();
+  });
+});
diff --git a/packages/foundation/primitive/data/src/HtmlTags.ts b/packages/foundation/primitive/data/src/HtmlTags.ts
new file mode 100644
index 0000000000..bb1ed1e942
--- /dev/null
+++ b/packages/foundation/primitive/data/src/HtmlTags.ts
@@ -0,0 +1,233 @@
+/**
+ * WHATWG HTML tag and attribute index data.
+ *
+ * Provides typed constants for current HTML tags, non-event HTML attributes,
+ * per-attribute applicability, and tag-to-attribute lookup tables sourced from
+ * the WHATWG HTML Standard.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+import * as internal from "./generated/html-tags.ts";
+
+// -------------------------------------------------------------------------------------
+// types
+// -------------------------------------------------------------------------------------
+
+/**
+ * Union of current WHATWG HTML tag names.
+ *
+ * @example
+ * ```typescript
+ * import type { HtmlTagName } from "@beep/data/HtmlTags"
+ *
+ * const tag: HtmlTagName = "div"
+ * console.assert(tag === "div")
+ * ```
+ *
+ * @category type-level
+ * @since 0.0.0
+ */
+export type HtmlTagName = (typeof internal.HtmlTagDataTagValues)[number];
+
+/**
+ * Union of synced WHATWG HTML attribute names.
+ *
+ * Event-handler attributes, ARIA attributes, SVG, and MathML are intentionally
+ * outside this v1 dataset.
+ *
+ * @example
+ * ```typescript
+ * import type { HtmlAttributeName } from "@beep/data/HtmlTags"
+ *
+ * const attr: HtmlAttributeName = "class"
+ * console.assert(attr === "class")
+ * ```
+ *
+ * @category type-level
+ * @since 0.0.0
+ */
+export type HtmlAttributeName = (typeof internal.HtmlAttributeDataNameValues)[number];
+
+/**
+ * A single generated WHATWG HTML tag entry.
+ *
+ * @example
+ * ```typescript
+ * import { HtmlTagDataByTag, type HtmlTagData } from "@beep/data/HtmlTags"
+ *
+ * const div: HtmlTagData = HtmlTagDataByTag.div
+ * console.assert(div.tag === "div")
+ * ```
+ *
+ * @category type-level
+ * @since 0.0.0
+ */
+export type HtmlTagData = (typeof internal.HtmlTagDataValues)[number];
+
+/**
+ * A single generated WHATWG HTML attribute usage row.
+ *
+ * @example
+ * ```typescript
+ * import { HtmlAttributeDataUsageValues, type HtmlAttributeUsageData } from "@beep/data/HtmlTags"
+ *
+ * const usage: HtmlAttributeUsageData = HtmlAttributeDataUsageValues[0]
+ * console.assert(usage.sourceHrefs.length > 0)
+ * ```
+ *
+ * @category type-level
+ * @since 0.0.0
+ */
+export type HtmlAttributeUsageData = (typeof internal.HtmlAttributeDataUsageValues)[number];
+
+/**
+ * A generated WHATWG HTML attribute entry aggregated by attribute name.
+ *
+ * @example
+ * ```typescript
+ * import { HtmlAttributeDataByName, type HtmlAttributeData } from "@beep/data/HtmlTags"
+ *
+ * const classAttribute: HtmlAttributeData = HtmlAttributeDataByName.class
+ * console.assert(classAttribute.scope === "global")
+ * ```
+ *
+ * @category type-level
+ * @since 0.0.0
+ */
+export type HtmlAttributeData = (typeof internal.HtmlAttributeDataValues)[number];
+
+/**
+ * Scope marker for a synced HTML attribute.
+ *
+ * @category type-level
+ * @since 0.0.0
+ */
+export type HtmlAttributeScope = HtmlAttributeData["scope"];
+
+/**
+ * Stable source metadata for the generated WHATWG HTML dataset.
+ *
+ * @category type-level
+ * @since 0.0.0
+ */
+export type HtmlTagDataMetadata = typeof internal.HtmlTagDataMetadata;
+
+// -------------------------------------------------------------------------------------
+// constants
+// -------------------------------------------------------------------------------------
+
+/**
+ * Stable source metadata for the generated WHATWG HTML dataset.
+ *
+ * @example
+ * ```typescript
+ * import { HtmlTagDataMetadata } from "@beep/data/HtmlTags"
+ *
+ * console.assert(HtmlTagDataMetadata.sourceUrls.length === 2)
+ * ```
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataMetadata: typeof internal.HtmlTagDataMetadata = internal.HtmlTagDataMetadata;
+
+/**
+ * Official WHATWG source URLs used for the generated dataset.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataSourceUrls: typeof internal.HtmlTagDataSourceUrls = internal.HtmlTagDataSourceUrls;
+
+/**
+ * SHA-256 digests of the official source payloads used for the generated dataset.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataSourceSha256: typeof internal.HtmlTagDataSourceSha256 = internal.HtmlTagDataSourceSha256;
+
+/**
+ * Generated WHATWG HTML tag entries.
+ *
+ * @example
+ * ```typescript
+ * import { HtmlTagDataValues } from "@beep/data/HtmlTags"
+ *
+ * console.assert(HtmlTagDataValues.some((entry) => entry.tag === "div"))
+ * ```
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataValues: typeof internal.HtmlTagDataValues = internal.HtmlTagDataValues;
+
+/**
+ * Generated WHATWG HTML tag entries keyed by tag name.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataByTag: typeof internal.HtmlTagDataByTag = internal.HtmlTagDataByTag;
+
+/**
+ * Current WHATWG HTML tag literal values.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataTagValues: typeof internal.HtmlTagDataTagValues = internal.HtmlTagDataTagValues;
+
+/**
+ * Generated WHATWG HTML attribute usage rows.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataUsageValues: typeof internal.HtmlAttributeDataUsageValues =
+  internal.HtmlAttributeDataUsageValues;
+
+/**
+ * Generated WHATWG HTML attribute entries aggregated by attribute name.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataValues: typeof internal.HtmlAttributeDataValues = internal.HtmlAttributeDataValues;
+
+/**
+ * Generated WHATWG HTML attribute entries keyed by attribute name.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataByName: typeof internal.HtmlAttributeDataByName = internal.HtmlAttributeDataByName;
+
+/**
+ * Synced WHATWG HTML attribute literal values.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataNameValues: typeof internal.HtmlAttributeDataNameValues =
+  internal.HtmlAttributeDataNameValues;
+
+/**
+ * Attribute names applicable to each WHATWG HTML tag.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlTagDataAttributesByTag: typeof internal.HtmlTagDataAttributesByTag =
+  internal.HtmlTagDataAttributesByTag;
+
+/**
+ * HTML tag names applicable to each synced WHATWG HTML attribute.
+ *
+ * @category constants
+ * @since 0.0.0
+ */
+export const HtmlAttributeDataTagsByAttribute: typeof internal.HtmlAttributeDataTagsByAttribute =
+  internal.HtmlAttributeDataTagsByAttribute;
