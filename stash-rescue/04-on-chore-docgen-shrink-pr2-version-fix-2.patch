diff --git a/packages/tooling/tool/docgen/src/internal/version.ts b/packages/tooling/tool/docgen/src/internal/version.ts
index e321d87495..31c126310c 100644
--- a/packages/tooling/tool/docgen/src/internal/version.ts
+++ b/packages/tooling/tool/docgen/src/internal/version.ts
@@ -4,21 +4,70 @@
  * @packageDocumentation
  * @since 0.0.0
  */
-import packageJson from "../../package.json" with { type: "json" };
+import { $RepoDocgenId } from "@beep/identity/packages";
+import { Effect, FileSystem, Path } from "effect";
+import * as S from "effect/Schema";
+import * as Domain from "../Domain.ts";
+
+const $I = $RepoDocgenId.create("InternalVersion");
+
+const PackageManifestVersion = S.Struct({ version: S.String }).pipe(
+  $I.annoteSchema("PackageManifestVersion", {
+    description: "Required package manifest fields used to identify the running docgen version.",
+  })
+);
+
+const decodePackageManifestVersion = S.decodeUnknownEffect(S.fromJsonString(PackageManifestVersion));
 
 /**
- * Runtime package version shown in the CLI banner.
+ * Reads the runtime package version shown in the CLI banner and proof manifests.
  *
  * **Example** (Log package version)
  *
  * ```ts
- * import { moduleVersion } from "../../src/internal/version.ts"
+ * import { BunServices } from "@effect/platform-bun"
+ * import { Effect } from "effect"
+ * import { readModuleVersion } from "../../src/internal/version.ts"
  *
- * console.log(moduleVersion)
+ * const version = await Effect.runPromise(
+ *   readModuleVersion().pipe(Effect.provide(BunServices.layer))
+ * )
+ * console.log(version)
  * ```
  *
  * @internal
  * @category configuration
  * @since 0.0.0
  */
-export const moduleVersion = packageJson.version;
+export const readModuleVersion = Effect.fn("InternalVersion.readModuleVersion")(function* (): Effect.fn.Return<
+  string,
+  Domain.DocgenError,
+  FileSystem.FileSystem | Path.Path
+> {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const manifestUrl = new URL("../../package.json", import.meta.url);
+  const manifestPath = yield* path.fromFileUrl(manifestUrl).pipe(
+    Effect.mapError((cause) =>
+      Domain.DocgenError.make({
+        message: `[InternalVersion.readModuleVersion] Failed to resolve manifest path '${manifestUrl.pathname}'\n${String(cause)}`,
+      })
+    )
+  );
+  const manifestJson = yield* fs.readFileString(manifestPath).pipe(
+    Effect.mapError((cause) =>
+      Domain.DocgenError.make({
+        message: `[InternalVersion.readModuleVersion] Failed to read manifest '${manifestPath}'\n${String(cause)}`,
+      })
+    )
+  );
+  const manifest = yield* decodePackageManifestVersion(manifestJson).pipe(
+    Effect.mapError((cause) =>
+      Domain.DocgenError.make({
+        message: `[InternalVersion.readModuleVersion] Failed to decode manifest '${manifestPath}'\n${cause.message}`,
+      })
+    )
+  );
+
+  return manifest.version;
+});
diff --git a/packages/tooling/tool/docgen/test/version.test.ts b/packages/tooling/tool/docgen/test/version.test.ts
new file mode 100644
index 0000000000..add4141dfb
--- /dev/null
+++ b/packages/tooling/tool/docgen/test/version.test.ts
@@ -0,0 +1,13 @@
+import { readModuleVersion } from "@beep/repo-docgen/internal/version";
+import * as BunServices from "@effect/platform-bun/BunServices";
+import { expect, it } from "@effect/vitest";
+import { Effect } from "effect";
+
+it.effect("reads the docgen package version from its manifest", () =>
+  readModuleVersion().pipe(
+    Effect.provide(BunServices.layer),
+    Effect.map((version) => {
+      expect(version).toBe("0.0.2");
+    })
+  )
+);
