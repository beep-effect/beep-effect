diff --git a/output/stack-installer/p1-live/INTAKE_MACOS_PROOF.sh b/output/stack-installer/p1-live/INTAKE_MACOS_PROOF.sh
new file mode 100755
index 0000000000..4729ec37c5
--- /dev/null
+++ b/output/stack-installer/p1-live/INTAKE_MACOS_PROOF.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+BUNDLE_NAME="stack-installer-p1-macos.tgz"
+OUTPUT_ROOT="output/stack-installer/p1-live"
+TARGET_BUNDLE="$OUTPUT_ROOT/$BUNDLE_NAME"
+
+fail() {
+  printf 'ERROR: %s\n' "$*" >&2
+  exit 1
+}
+
+usage() {
+  cat <<'USAGE'
+Usage:
+  output/stack-installer/p1-live/INTAKE_MACOS_PROOF.sh [path/to/stack-installer-p1-macos.tgz]
+
+If no path is supplied, the helper looks in:
+  output/stack-installer/p1-live/
+  output/stack-installer/p1-live/taildrop-inbox/
+  ~/Downloads
+  ~/Desktop
+  /tmp
+USAGE
+}
+
+repo_root="$(pwd)"
+[ -f "$repo_root/apps/stack-installer/package.json" ] ||
+  fail "Run this script from the repository root."
+
+source_bundle="${1:-}"
+
+case "$source_bundle" in
+  -h | --help)
+    usage
+    exit 0
+    ;;
+esac
+
+if [ -z "$source_bundle" ]; then
+  if [ -f "$TARGET_BUNDLE" ]; then
+    source_bundle="$TARGET_BUNDLE"
+  else
+    search_roots=("$OUTPUT_ROOT/taildrop-inbox" "$HOME/Downloads" "$HOME/Desktop" /tmp)
+
+    for root in "${search_roots[@]}"; do
+      [ -d "$root" ] || continue
+      source_bundle="$(
+        {
+          find "$root" \
+            -maxdepth 3 \
+            -type f \
+            -name "$BUNDLE_NAME" \
+            2>/dev/null \
+            || true
+        } \
+          | sort \
+          | head -n 1
+      )"
+      [ -z "$source_bundle" ] || break
+    done
+  fi
+fi
+
+[ -n "$source_bundle" ] || fail "Could not find $BUNDLE_NAME. Pass its path as the first argument."
+[ -f "$source_bundle" ] || fail "Bundle file not found: $source_bundle"
+
+mkdir -p "$OUTPUT_ROOT"
+
+if [ "$source_bundle" != "$TARGET_BUNDLE" ]; then
+  cp "$source_bundle" "$TARGET_BUNDLE"
+fi
+
+printf 'Using macOS proof bundle: %s\n' "$TARGET_BUNDLE"
+
+cd apps/stack-installer
+bun run p1:proof:intake -- --output-root ../../output/stack-installer/p1-live
+bun run p1:proof:audit -- --platform macos
+bun run p1:proof:status -- --output-root ../../output/stack-installer/p1-live
