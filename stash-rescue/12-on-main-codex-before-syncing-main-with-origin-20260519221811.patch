+#!/usr/bin/env bash
+set -euo pipefail
+
+DEFAULT_OPERATOR_LABEL="operator-macos-001"
+DEFAULT_TEST_MESSAGE="Stack Installer P1 macOS proof"
+
+usage() {
+  cat <<'USAGE'
+Stack Installer P1 macOS proof runner
+
+Run from the extracted repository root:
+
+  ./RUN_MAC_PROOF.sh
+
+Have these values ready before starting:
+
+  - Discord guild ID, or an op:// reference that resolves to it
+  - Discord channel ID, or an op:// reference that resolves to it
+  - Discord channel display name, or an op:// reference that resolves to it
+  - Discord bot token 1Password reference shaped like op://vault/item/field
+  - Operator label, default: operator-macos-001
+  - Test message, default: Stack Installer P1 macOS proof
+
+The bot token must never be pasted as plaintext. Use only the op:// reference.
+USAGE
+}
+
+fail() {
+  printf 'ERROR: %s\n' "$*" >&2
+  exit 1
+}
+
+prompt() {
+  local label="$1"
+  local value
+  printf '%s: ' "$label" >&2
+  IFS= read -r value
+  printf '%s' "$value"
+}
+
+prompt_default() {
+  local label="$1"
+  local default="$2"
+  local value
+  printf '%s [%s]: ' "$label" "$default" >&2
+  IFS= read -r value
+  if [ -z "$value" ]; then
+    printf '%s' "$default"
+  else
+    printf '%s' "$value"
+  fi
+}
+
+require_command() {
+  local name="$1"
+  if ! command -v "$name" >/dev/null 2>&1; then
+    fail "Missing required command: $name. Install it, authenticate if needed, then rerun this script."
+  fi
+}
+
+ensure_op_read_ready() {
+  local probe_reference="$1"
+  op read "$probe_reference" >/dev/null 2>&1 ||
+    fail "1Password CLI cannot read the probe reference in this shell. Unlock or sign in to 1Password, then rerun this script."
+}
+
+require_nonempty() {
+  local label="$1"
+  local value="$2"
+  [ -n "$value" ] || fail "$label cannot be empty."
+}
+
+require_discord_id() {
+  local label="$1"
+  local value="$2"
+  require_nonempty "$label" "$value"
+  case "$value" in
+    *[!0-9]*) fail "$label must contain only digits." ;;
+  esac
+}
+
+require_not_discord_id() {
+  local label="$1"
+  local value="$2"
+  require_nonempty "$label" "$value"
+  case "$value" in
+    *[!0-9]*) ;;
+    *) fail "$label resolved to only digits. It looks like a Discord ID, not a display name." ;;
+  esac
+}
+
+is_op_reference() {
+  case "$1" in
+    op://*) return 0 ;;
+    *) return 1 ;;
+  esac
+}
+
+resolve_value_reference() {
+  local label="$1"
+  local value="$2"
+  local resolved
+
+  require_nonempty "$label" "$value"
+
+  if is_op_reference "$value"; then
+    resolved="$(op read "$value" 2>/dev/null)" ||
+      fail "Could not read $label from 1Password reference."
+    case "$resolved" in
+      *$'\n'* | *$'\r'*) fail "$label from 1Password must resolve to a single line." ;;
+    esac
+    require_nonempty "$label" "$resolved"
+    printf '%s' "$resolved"
+  else
+    printf '%s' "$value"
+  fi
+}
+
+validate_bot_token_reference() {
+  local reference="$1"
+  local guild_id="$2"
+  local channel_id="$3"
+  local token
+
+  case "$reference" in
+    op://*) ;;
+    *) fail "Discord bot token reference must start with op://. Never paste a plaintext token here." ;;
+  esac
+
+  token="$(op read "$reference" 2>/dev/null)" ||
+    fail "Could not read Discord bot token from 1Password reference."
+  case "$token" in
+    *$'\n'* | *$'\r'*) fail "Discord bot token must resolve to a single line." ;;
+  esac
+  require_nonempty "Discord bot token" "$token"
+
+  if [ "$token" = "$guild_id" ] || [ "$token" = "$channel_id" ]; then
+    fail "Discord bot token reference resolved to one of the Discord IDs. Point it at the bot token field."
+  fi
+
+  case "$token" in
+    *[!0-9]*) ;;
+    *) fail "Discord bot token reference resolved to only digits. It looks like a Discord ID, not a bot token." ;;
+  esac
+}
+
+case "${1:-}" in
+  -h | --help)
+    usage
+    exit 0
+    ;;
+  "")
+    ;;
+  *)
+    fail "Unknown argument: $1. Use --help for usage."
+    ;;
+esac
+
+repo_root="$(pwd)"
+[ -f "$repo_root/apps/stack-installer/package.json" ] ||
+  fail "Run this script from the extracted repository root."
+
+printf '\nStack Installer P1 macOS proof runner\n'
+printf 'Repo: %s\n\n' "$repo_root"
+
+printf 'Checking required commands...\n'
+require_command git
+require_command bun
+require_command cargo
+require_command op
+require_command claude
+require_command codex
+
+printf '\nChecking provider/auth status. No secrets will be printed by this script.\n'
+printf '\nEnter the Discord proof target values.\n'
+printf 'Guild ID, channel ID, and display name may be literal values or op:// references.\n'
+printf 'Use only an op:// reference for the bot token.\n'
+operator_label="$(prompt_default 'Operator label' "$DEFAULT_OPERATOR_LABEL")"
+discord_guild_id_input="$(prompt 'Discord guild ID or 1Password reference')"
+discord_channel_id_input="$(prompt 'Discord channel ID or 1Password reference')"
+discord_channel_display_name_input="$(prompt 'Discord channel display name or 1Password reference')"
+discord_bot_token_reference="$(prompt 'Discord bot token 1Password reference')"
+test_message="$(prompt_default 'Deterministic test message' "$DEFAULT_TEST_MESSAGE")"
+
+discord_guild_id="$(resolve_value_reference 'Discord guild ID' "$discord_guild_id_input")"
+discord_channel_id="$(resolve_value_reference 'Discord channel ID' "$discord_channel_id_input")"
+discord_channel_display_name="$(resolve_value_reference 'Discord channel display name' "$discord_channel_display_name_input")"
+
+require_nonempty "Operator label" "$operator_label"
+require_discord_id "Discord guild ID" "$discord_guild_id"
+require_discord_id "Discord channel ID" "$discord_channel_id"
+require_nonempty "Discord channel display name" "$discord_channel_display_name"
+require_not_discord_id "Discord channel display name" "$discord_channel_display_name"
+require_nonempty "Deterministic test message" "$test_message"
+ensure_op_read_ready "$discord_bot_token_reference"
+validate_bot_token_reference "$discord_bot_token_reference" "$discord_guild_id" "$discord_channel_id"
+
+claude auth status >/dev/null
+codex login status >/dev/null
+
+export STACK_INSTALLER_PLATFORM="macos"
+export STACK_INSTALLER_OPERATOR_LABEL="$operator_label"
+export STACK_INSTALLER_DISCORD_GUILD_ID="$discord_guild_id"
+export STACK_INSTALLER_DISCORD_CHANNEL_ID="$discord_channel_id"
+export STACK_INSTALLER_DISCORD_CHANNEL_DISPLAY_NAME="$discord_channel_display_name"
+export STACK_INSTALLER_DISCORD_BOT_TOKEN_REFERENCE="$discord_bot_token_reference"
+export STACK_INSTALLER_TEST_MESSAGE="$test_message"
+
+export STACK_INSTALLER_REQUEST_JSON="$(
+  bun --print '
+JSON.stringify({
+  targetPlatform: process.env.STACK_INSTALLER_PLATFORM,
+  operatorLabel: process.env.STACK_INSTALLER_OPERATOR_LABEL,
+  discordGuildId: process.env.STACK_INSTALLER_DISCORD_GUILD_ID,
+  discordChannelId: process.env.STACK_INSTALLER_DISCORD_CHANNEL_ID,
+  discordChannelDisplayName: process.env.STACK_INSTALLER_DISCORD_CHANNEL_DISPLAY_NAME,
+  discordBotTokenReference: process.env.STACK_INSTALLER_DISCORD_BOT_TOKEN_REFERENCE,
+  testMessageContent: process.env.STACK_INSTALLER_TEST_MESSAGE
+})
+'
+)"
+
+printf '\nPreflight checks...\n'
+git status --short --branch
+bun install
+bun run config-sync:check
+(cd apps/stack-installer && bun run build)
+(cd apps/stack-installer/src-tauri && cargo check)
+
+mkdir -p output/stack-installer/p1-live/macos
+
+printf '\nStart macOS screen recording now with Shift+Command+5.\n'
+printf 'Record only this terminal proof window. Do not show passwords, account pages, or token pages.\n'
+printf 'Press return after the recording has started.'
+IFS= read -r _
+
+printf '\nRunning live macOS proof capture...\n'
+(cd apps/stack-installer && bun run p1:proof:capture -- --request-json "$STACK_INSTALLER_REQUEST_JSON")
+
+printf '\nStop the screen recording now.\n'
+recording_path="$(prompt 'Path to the saved .mov recording')"
+[ -f "$recording_path" ] || fail "Recording file not found: $recording_path"
+cp "$recording_path" output/stack-installer/p1-live/macos/screencast.mov
+
+printf '\nRefreshing checksums and running local macOS audit...\n'
+(cd apps/stack-installer && bun run p1:proof:checksums -- --platform macos)
+(cd apps/stack-installer && bun run p1:proof:audit -- --platform macos)
+
+printf '\nPackaging macOS proof bundle...\n'
+tar -czf output/stack-installer/p1-live/stack-installer-p1-macos.tgz \
+  -C output/stack-installer/p1-live \
+  macos
+
+printf '\nDone. Transfer this file back to the coordinator machine:\n'
+printf '%s/output/stack-installer/p1-live/stack-installer-p1-macos.tgz\n' "$repo_root"
