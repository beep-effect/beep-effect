+/**
+ * App-local Bun repair workflow.
+ *
+ * @packageDocumentation
+ * @category workflows
+ * @since 0.0.0
+ */
+
+import { BunCli } from "@beep/bun-cli";
+import {
+  BunRuntimeHealthResult,
+  BunRuntimeRepairRequest,
+  BunRuntimeRepairResult,
+} from "@beep/installer-dependencies-use-cases/public";
+import { InstallerDependenciesUseCases } from "@beep/installer-dependencies-use-cases/server";
+import { InstallerDependenciesServerLive } from "@beep/installer-dependencies-server";
+import { BunChildProcessSpawner, BunRuntime, BunServices } from "@effect/platform-bun";
+import * as BunPath from "@effect/platform-bun/BunPath";
+import { Effect, Layer, pipe } from "effect";
+import * as Path from "effect/Path";
+import * as S from "effect/Schema";
+
+const decodePackageJson = S.decodeUnknownEffect(
+  S.Struct({
+    packageManager: S.optionalKey(S.String),
+  })
+);
+const encodeBunRuntimeHealthResult = S.encodeUnknownEffect(S.fromJsonString(BunRuntimeHealthResult));
+const encodeBunRuntimeRepairResult = S.encodeUnknownEffect(S.fromJsonString(BunRuntimeRepairResult));
+
+const BaseLayer = Layer.mergeAll(BunServices.layer, BunPath.layer);
+const DriverLayer = BunCli.makeLayer().pipe(Layer.provideMerge(BunChildProcessSpawner.layer), Layer.provideMerge(BaseLayer));
+export const BunRuntimeRepairLayer = InstallerDependenciesServerLive.pipe(Layer.provideMerge(DriverLayer));
+
+const readRequiredBunVersion = Effect.fn("StackInstaller.readRequiredBunVersion")(function* (repoRoot: string) {
+  const path = yield* Path.Path;
+  const bunVersionPath = path.join(repoRoot, ".bun-version");
+  const packageJsonPath = path.join(repoRoot, "package.json");
+  const bunVersionFile = Bun.file(bunVersionPath);
+
+  if (yield* Effect.promise(() => bunVersionFile.exists())) {
+    const version = (yield* Effect.promise(() => bunVersionFile.text())).trim();
+    if (version.length > 0) {
+      return version;
+    }
+  }
+
+  const packageJson = yield* Effect.promise(() => Bun.file(packageJsonPath).json());
+  const decoded = yield* decodePackageJson(packageJson);
+  const packageManager = decoded.packageManager ?? "";
+  const match = /^bun@(.+)$/.exec(packageManager);
+
+  if (match !== null && match[1] !== undefined && match[1].length > 0) {
+    return match[1];
+  }
+
+  return yield* Effect.fail("Unable to resolve the required Bun version from repo metadata.");
+});
+
+/**
+ * Inspect Bun runtime health for the focused app-first repair flow.
+ *
+ * @category workflows
+ * @since 0.0.0
+ */
+export const inspectBunRuntimeForApp = Effect.fn("StackInstaller.inspectBunRuntimeForApp")(function* (repoRoot: string) {
+  const expectedVersion = yield* readRequiredBunVersion(repoRoot);
+  const dependencies = yield* InstallerDependenciesUseCases;
+  return yield* dependencies.inspectBunRuntime(expectedVersion);
+});
+
+/**
+ * Run the approval-first Bun repair flow for the app.
+ *
+ * @category workflows
+ * @since 0.0.0
+ */
+export const repairBunRuntimeForApp = Effect.fn("StackInstaller.repairBunRuntimeForApp")(function* (repoRoot: string) {
+  const expectedVersion = yield* readRequiredBunVersion(repoRoot);
+  const dependencies = yield* InstallerDependenciesUseCases;
+  return yield* dependencies.repairBunRuntime(
+    new BunRuntimeRepairRequest({
+      approved: true,
+      expectedVersion,
+    })
+  );
+});
+
+/**
+ * Encode the Bun health result as JSON for the Tauri bridge.
+ *
+ * @category workflows
+ * @since 0.0.0
+ */
+export const inspectBunRuntimeJson = Effect.fn("StackInstaller.inspectBunRuntimeJson")(function* (repoRoot: string) {
+  const result = yield* inspectBunRuntimeForApp(repoRoot);
+  return yield* encodeBunRuntimeHealthResult(result);
+});
+
+/**
+ * Encode the Bun repair result as JSON for the Tauri bridge.
+ *
+ * @category workflows
+ * @since 0.0.0
+ */
+export const repairBunRuntimeJson = Effect.fn("StackInstaller.repairBunRuntimeJson")(function* (repoRoot: string) {
+  const result = yield* repairBunRuntimeForApp(repoRoot);
+  return yield* encodeBunRuntimeRepairResult(result);
+});
+
+/**
+ * Run the Bun repair CLI main entrypoint.
+ *
+ * @category workflows
+ * @since 0.0.0
+ */
+export const runBunRuntimeRepairMain = (program: Effect.Effect<string, string>) =>
+  BunRuntime.runMain(
+    pipe(
+      program,
+      Effect.tap((encoded) =>
+        Effect.sync(() => {
+          console.log(encoded);
+        })
+      ),
+      Effect.catch((message: string) =>
+        Effect.sync(() => {
+          console.error(message);
+          process.exitCode = 1;
+        })
+      )
+    )
+  );
