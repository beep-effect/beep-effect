+  Layer.effect(InstallerDependenciesUseCases, makeInstallerDependenciesServer()).pipe(Layer.provideMerge(portLayer));
+
+describe("@beep/installer-dependencies-server Bun repair flow", () => {
+  layer(makeTestLayer(healthyPort))((it) => {
+    it.effect("reports Bun as healthy when the detected version meets the minimum", () =>
+      Effect.gen(function* () {
+        const dependencies = yield* InstallerDependenciesUseCases;
+        const result = yield* dependencies.inspectBunRuntime("1.3.14");
+
+        expect(result.state).toBe("healthy");
+        expect(result.summary).toContain("satisfies the required version");
+      })
+    );
+
+    it.effect("rejects repair when Bun is already healthy", () =>
+      Effect.gen(function* () {
+        const dependencies = yield* InstallerDependenciesUseCases;
+        const error = yield* dependencies
+          .repairBunRuntime(
+            new BunRuntimeRepairRequest({
+              approved: true,
+              expectedVersion: "1.3.14",
+            })
+          )
+          .pipe(Effect.flip);
+
+        expect(error).toBeInstanceOf(BunRuntimeAlreadyHealthy);
+      })
+    );
+  });
+
+  layer(makeTestLayer(repairingPort))((it) => {
+    it.effect("runs Bun repair and returns before/after evidence", () =>
+      Effect.gen(function* () {
+        const dependencies = yield* InstallerDependenciesUseCases;
+        const result = yield* dependencies.repairBunRuntime(
+          new BunRuntimeRepairRequest({
+            approved: true,
+            expectedVersion: "1.3.14",
+          })
+        );
+
+        expect(result.before.state).toBe("repair-required");
+        expect(result.after.state).toBe("healthy");
+        expect(result.command).toBe("bun upgrade");
+      })
+    );
+  });
+
+  layer(makeTestLayer(healthyPort))((it) => {
+    it.effect("requires explicit approval before mutating Bun", () =>
+      Effect.gen(function* () {
+        const dependencies = yield* InstallerDependenciesUseCases;
+        const error = yield* dependencies
+          .repairBunRuntime(
+            new BunRuntimeRepairRequest({
+              approved: false,
+              expectedVersion: "1.3.14",
+            })
+          )
+          .pipe(Effect.flip);
+
+        expect(error).toBeInstanceOf(BunRuntimeRepairApprovalRequired);
+      })
+    );
+  });
+
+  layer(makeTestLayer(failedRepairPort))((it) => {
+    it.effect("translates failed upgrades into public repair failures", () =>
+      Effect.gen(function* () {
+        const dependencies = yield* InstallerDependenciesUseCases;
+        const error = yield* dependencies
+          .repairBunRuntime(
+            new BunRuntimeRepairRequest({
+              approved: true,
+              expectedVersion: "1.3.14",
+            })
+          )
+          .pipe(Effect.flip);
+
+        expect(error).toBeInstanceOf(BunRuntimeRepairFailed);
+      })
+    );
+  });
+});
