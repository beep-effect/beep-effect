+/**
+ * EXAMPLE_SLICE entity-id registry.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+import {$SharedDomainId} from "@beep/identity";
+import {EntityId} from "@beep/shared-domain/entity";
+
+const $I = $SharedDomainId.create("identity/EXAMPLE_SLICE");
+const make = EntityId.factory("EXAMPLE_SLICE", $I);
+
+
+/**
+ * ExampleEntity entity identifier.
+ *
+ * @example
+ * ```ts
+ * import { ExampleEntityId } from "@beep/shared-domain/identity/EXAMPLE_SLICE";
+ *
+ * console.log(ExampleEntityId.tableName)
+ * ```
+ *
+ * @category entity ids
+ * @since 0.0.0
+ */
+export const ExampleEntityId = make("example_entity", {
+  description: "Identifier for an EXAMPLE_SLICE ExampleEntity entity.",
+});
+
+/**
+ * Companion type for {@link ExampleEntityId.Type}
+ *
+ * @example
+ * ```ts
+ * import { Effect } from "effect"
+ * import { OrganizationId } from "@beep/shared-domain/identity/Shared"
+ * import * as S from "effect/Schema"
+ *
+ * const program = Effect.gen(function* () {
+ *   const id = yield* S.decodeUnknownEffect(OrganizationId)(1)
+ *   return id
+ * })
+ * void program
+ * ```
+ *
+ * @category entity ids
+ * @since 0.0.0
+ */
+export type ExampleEntityId = typeof ExampleEntityId.Type;
