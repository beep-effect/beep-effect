-const columnDefinitionFor = (column: ProjectedColumn): string =>
-  pipe(
-    [
-      quoteIdentifier(column.name),
-      column.getSQLType(),
-      column.primary ? "PRIMARY KEY" : "",
-      column.notNull && !column.primary ? "NOT NULL" : "",
-    ],
-    A.filter(Str.isNonEmpty),
-    A.join(" ")
