+/**
+ * Lab-app lifecycle command group.
+ *
+ * `beep labs list` renders every lab under `apps/labs/*` from its decoded
+ * `lab.manifest.json` (SPEC D9): name, disposition, purpose, and creation
+ * date, stable-sorted by lab directory. A lab with a missing or invalid
+ * manifest is reported as a failing row and the command exits nonzero; the
+ * zero-lab tree (also the delete-last-lab state) prints a friendly empty state
+ * and exits zero.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+import { findRepoRoot } from "@beep/repo-utils";
+import { A } from "@beep/utils";
+import { Console, DateTime, Effect } from "effect";
+import { Command } from "effect/unstable/cli";
+import { failWithReportedExit } from "../../internal/cli/ExitCodeError.ts";
+import { LAB_MANIFEST_FILE_NAME } from "../../internal/cli/Labs/LabManifest.schemas.ts";
+import { isFailedLabRow, LabListRow, listLabRows } from "../../internal/cli/Labs/LabsDiscovery.ts";
+import { LABS_WORKSPACE_ROOT } from "../../internal/cli/Labs/LabsPath.ts";
+import { printLines } from "../../internal/cli/Printer.ts";
+
+const renderLabRow = LabListRow.match({
+  decoded: (row) =>
+    `- ${row.lab.packageName} ${row.lab.dir} [${row.manifest.disposition}] created ${DateTime.formatIso(
+      row.manifest.created
+    )} purpose: ${row.manifest.purpose}`,
+  failed: (row) => `- ${row.lab.packageName} ${row.lab.dir} MANIFEST ERROR: ${row.reason}`,
+});
+
+const listHandler = Effect.fn("Labs.list")(function* () {
+  const repoRoot = yield* findRepoRoot();
+  const rows = yield* listLabRows(repoRoot);
+  if (A.isReadonlyArrayEmpty(rows)) {
+    yield* Console.log(`[labs] no labs exist under ${LABS_WORKSPACE_ROOT}.`);
+    return;
+  }
+  yield* Console.log(`[labs] ${A.length(rows)} lab(s) under ${LABS_WORKSPACE_ROOT}:`);
+  yield* printLines(A.map(rows, renderLabRow));
+  const failures = A.filter(rows, isFailedLabRow);
+  if (A.isReadonlyArrayNonEmpty(failures)) {
+    yield* Console.error(`[labs] ${A.length(failures)} lab(s) have a missing or invalid ${LAB_MANIFEST_FILE_NAME}.`);
+    return yield* failWithReportedExit("labs list: manifest failures found.");
+  }
+});
+
+const labsListCommand = Command.make("list", {}, listHandler).pipe(
+  Command.withDescription("List every lab under apps/labs with its decoded manifest")
+);
+
+/**
+ * `bun run beep labs` — lab-app lifecycle command group.
+ *
+ * **Example** (List labs)
+ *
+ * ```ts
+ * console.log("bun run beep labs list")
+ * ```
+ *
+ * @category cli-commands
+ * @since 0.0.0
+ */
+export const labsCommand = Command.make("labs", {}, () =>
+  printLines(["Labs commands:", "- bun run beep labs list"])
+).pipe(Command.withDescription("Lab-app lifecycle tooling (list)"), Command.withSubcommands([labsListCommand]));
