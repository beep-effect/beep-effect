+    absolutePath: path === "." ? "/repo" : `/repo/${path}`,
+    packageJson: PackageJson.make({ name, ...(scripts === undefined ? {} : { scripts }) }),
+  });
+
+const rootWorkspace = workspaceInfo("beep", ".", { coverage: "beep-cli coverage" });
+const coveredProduct = workspaceInfo("@beep/schema", "packages/foundation/modeling/schema", {
+  coverage: "vitest run --coverage",
+});
+const uncoveredProduct = workspaceInfo("@beep/storybook", "apps/storybook", { test: "vitest run" });
+// A lab that (wrongly) ships a coverage script must still stay outside the
+// coverage universe: exclusion is by labs path, never by script presence.
+const coveredLab = workspaceInfo("@beep/trustgraph-workbench", "apps/labs/trustgraph-workbench", {
+  coverage: "vitest run --coverage",
+});
+const uncoveredLab = workspaceInfo("@beep/orbit-lab", "apps/labs/orbit-lab", { test: "vitest run" });
+
+describe("coverage regression labs scoping", () => {
+  it("keeps labs out of the coverage-owning package universe", () => {
+    const selected = workspaceCoveragePackagesForTesting([coveredLab, coveredProduct, uncoveredProduct, rootWorkspace]);
+    expect(A.map(selected, (info) => info.name)).toEqual(["@beep/schema", "beep"]);
+  });
+
+  it("keeps labs and the root out of the disposition-gap universe", () => {
+    const universe = coverageDispositionUniverseForTesting([
+      rootWorkspace,
+      coveredProduct,
+      uncoveredProduct,
+      coveredLab,
+      uncoveredLab,
+    ]);
+    expect(A.map(universe, (info) => info.name)).toEqual(["@beep/schema", "@beep/storybook"]);
+  });
+
+  it("never turns a lab into a disposition gap or an exemption demand", () => {
+    const universe = coverageDispositionUniverseForTesting([
+      coveredProduct,
+      uncoveredProduct,
+      coveredLab,
+      uncoveredLab,
+    ]);
+    const gaps = coverageDispositionGapsForTesting(
+      A.map(universe, (info) => info.name),
+      A.map(workspaceCoveragePackagesForTesting(universe), (info) => info.name),
+      A.empty<string>()
+    );
+    expect(gaps).toEqual(["@beep/storybook"]);
+  });
+
+  it("drops labs-owned paths from the affected coverage planner input", () => {
+    const changed = coveragePlannerChangedFilesForTesting([
+      "apps/labs/trustgraph-workbench/package.json",
+      "apps/labs/trustgraph-workbench/src/main.ts",
+      "apps/storybook/src/index.ts",
+      "packages/foundation/modeling/schema/src/index.ts",
+    ]);
+    expect(changed).toEqual(["apps/storybook/src/index.ts", "packages/foundation/modeling/schema/src/index.ts"]);
+  });
+
+  it("treats only apps/labs/ as labs-owned in the planner input", () => {
+    const changed = coveragePlannerChangedFilesForTesting(["apps/labside/src/index.ts", "apps/labs/x/file.ts"]);
+    expect(changed).toEqual(["apps/labside/src/index.ts"]);
+  });
+});
