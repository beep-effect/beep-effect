index 0000000000..9a02cde4b1
--- /dev/null
+++ b/packages/tooling/tool/cli/test/labs-list.test.ts
@@ -0,0 +1,168 @@
+import { labsCommand } from "@beep/repo-cli/test/Labs";
+import { FsUtilsLive } from "@beep/repo-utils/FsUtils";
+import { provideScopedLayer } from "@beep/test-utils";
+import { A, Str } from "@beep/utils";
+import { NodeServices } from "@effect/platform-node";
+import { Effect, FileSystem, Layer, Path } from "effect";
+import * as O from "effect/Option";
+import * as P from "effect/Predicate";
+import * as TestConsole from "effect/testing/TestConsole";
+import { Command } from "effect/unstable/cli";
+import { describe, expect, it } from "vitest";
+import { expectReportedExit, withTempWorkingDirectory } from "./support/CommandTest.ts";
+
+const commandLayer = Layer.mergeAll(
+  NodeServices.layer,
+  TestConsole.layer,
+  FsUtilsLive.pipe(Layer.provide(NodeServices.layer))
+);
+const runLabs = Command.runWith(labsCommand, { version: "0.0.0" });
+
+const writeRepoRoot = (workspaces: ReadonlyArray<string>) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const workspaceLiterals = A.join(
+      A.map(workspaces, (workspace) => `"${workspace}"`),
+      ", "
+    );
+    yield* fs.writeFileString("bun.lock", "");
+    yield* fs.writeFileString(
+      "package.json",
+      `{ "name": "fixture", "private": true, "workspaces": [${workspaceLiterals}] }\n`
+    );
+  });
+
+const writeLab = (name: string, manifestJson: O.Option<string>) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const dir = path.join("apps", "labs", name);
+    yield* fs.makeDirectory(dir, { recursive: true });
+    yield* fs.writeFileString(path.join(dir, "package.json"), `{ "name": "@beep/${name}", "private": true }\n`);
+    if (O.isSome(manifestJson)) {
+      yield* fs.writeFileString(path.join(dir, "lab.manifest.json"), manifestJson.value);
+    }
+  });
+
+const stringLogLines = Effect.gen(function* () {
+  const lines = yield* TestConsole.logLines;
+  return A.filter(lines, P.isString);
+});
+
+const lineIndexContaining = (lines: ReadonlyArray<string>, needle: string): O.Option<number> =>
+  A.findFirstIndex(lines, Str.includes(needle));
+
+describe("beep labs list", () => {
+  it("renders every decoded lab row stable-sorted by lab directory", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          yield* writeRepoRoot(["apps/labs/*", "packages/*"]);
+          const fs = yield* FileSystem.FileSystem;
+          const path = yield* Path.Path;
+          yield* fs.makeDirectory(path.join("packages", "not-a-lab"), { recursive: true });
+          yield* fs.writeFileString(
+            path.join("packages", "not-a-lab", "package.json"),
+            '{ "name": "@beep/not-a-lab", "private": true }\n'
+          );
+          yield* writeLab(
+            "zeta-lab",
+            O.some(
+              '{ "purpose": "Probe zeta ideas", "created": "2026-08-02T09:00:00.000Z", "disposition": "promote" }\n'
+            )
+          );
+          yield* writeLab(
+            "alpha-lab",
+            O.some(
+              '{ "purpose": "Explore alpha", "created": "2026-08-01T12:30:00.000Z", "disposition": "active", "postgresSchema": "lab_alpha" }\n'
+            )
+          );
+
+          yield* runLabs(["list"]);
+          const lines = yield* stringLogLines;
+
+          expect(A.some(lines, Str.includes("2 lab(s) under apps/labs"))).toBe(true);
+          const alphaIndex = lineIndexContaining(lines, "@beep/alpha-lab");
+          const zetaIndex = lineIndexContaining(lines, "@beep/zeta-lab");
+          expect(O.isSome(alphaIndex)).toBe(true);
+          expect(O.isSome(zetaIndex)).toBe(true);
+          expect(O.getOrThrow(alphaIndex)).toBeLessThan(O.getOrThrow(zetaIndex));
+
+          const alphaRow = O.getOrThrow(A.findFirst(lines, Str.includes("@beep/alpha-lab")));
+          expect(alphaRow).toContain("apps/labs/alpha-lab");
+          expect(alphaRow).toContain("[active]");
+          expect(alphaRow).toContain("created 2026-08-01T12:30:00.000Z");
+          expect(alphaRow).toContain("purpose: Explore alpha");
+          const zetaRow = O.getOrThrow(A.findFirst(lines, Str.includes("@beep/zeta-lab")));
+          expect(zetaRow).toContain("[promote]");
+          expect(A.some(lines, Str.includes("@beep/not-a-lab"))).toBe(false);
+        })
+      ).pipe(provideScopedLayer(commandLayer))
+    ));
+
+  it("reports an invalid manifest as a failing row and exits nonzero", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          yield* writeRepoRoot(["apps/labs/*"]);
+          yield* writeLab(
+            "good-lab",
+            O.some('{ "purpose": "Fine", "created": "2026-08-01T00:00:00.000Z", "disposition": "active" }\n')
+          );
+          yield* writeLab(
+            "bad-lab",
+            O.some('{ "purpose": "Broken", "created": "2026-08-01T00:00:00.000Z", "disposition": "abandoned" }\n')
+          );
+
+          const exit = yield* Effect.exit(runLabs(["list"]));
+          expectReportedExit(exit);
+
+          const lines = yield* stringLogLines;
+          expect(A.some(lines, Str.includes("@beep/good-lab"))).toBe(true);
+          const badRow = O.getOrThrow(A.findFirst(lines, Str.includes("@beep/bad-lab")));
+          expect(badRow).toContain("MANIFEST ERROR");
+          expect(badRow).toContain("invalid lab.manifest.json");
+          const errors = A.filter(yield* TestConsole.errorLines, P.isString);
+          expect(A.some(errors, Str.includes("1 lab(s) have a missing or invalid lab.manifest.json"))).toBe(true);
+        })
+      ).pipe(provideScopedLayer(commandLayer))
+    ));
+
+  it("reports a missing manifest as a failing row and exits nonzero", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          yield* writeRepoRoot(["apps/labs/*"]);
+          yield* writeLab("bare-lab", O.none());
+
+          const exit = yield* Effect.exit(runLabs(["list"]));
+          expectReportedExit(exit);
+
+          const lines = yield* stringLogLines;
+          const bareRow = O.getOrThrow(A.findFirst(lines, Str.includes("@beep/bare-lab")));
+          expect(bareRow).toContain("MANIFEST ERROR");
+          expect(bareRow).toContain("missing lab.manifest.json");
+        })
+      ).pipe(provideScopedLayer(commandLayer))
+    ));
+
+  it("prints a friendly empty state and exits zero when no labs exist", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          yield* writeRepoRoot(["apps/labs/*", "packages/*"]);
+          const fs = yield* FileSystem.FileSystem;
+          const path = yield* Path.Path;
+          yield* fs.makeDirectory(path.join("packages", "not-a-lab"), { recursive: true });
+          yield* fs.writeFileString(
+            path.join("packages", "not-a-lab", "package.json"),
+            '{ "name": "@beep/not-a-lab", "private": true }\n'
+          );
+
+          yield* runLabs(["list"]);
+          const lines = yield* stringLogLines;
+          expect(A.some(lines, Str.includes("no labs exist under apps/labs"))).toBe(true);
+        })
+      ).pipe(provideScopedLayer(commandLayer))
+    ));
+});
