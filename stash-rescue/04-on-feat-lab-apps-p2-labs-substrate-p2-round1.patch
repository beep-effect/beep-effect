diff --git a/.github/workflows/check.yml b/.github/workflows/check.yml
index e3793e6d62..a618a08580 100644
--- a/.github/workflows/check.yml
+++ b/.github/workflows/check.yml
@@ -400,6 +400,86 @@ jobs:
         if: always()
         run: bun run beep ci append-turbo-summary
 
+  labs:
+    # lab-apps-lifecycle P2 (D10): labs (apps/labs/*) are excluded from every
+    # required lane and surface only through this visible family context.
+    # Lands NON-required; the required flip (ruleset 10240248 addition) is a
+    # later branch-ruleset action after a stable green history. No TURBO_*
+    # remote-cache env on purpose: the lane is local-cache-only, keeping the
+    # workflow's push-guarded remote-cache surface unchanged.
+    name: Labs
+    runs-on: ubuntu-24.04
+    timeout-minutes: 45
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+
+      - name: Fetch pull request base
+        if: github.event_name == 'pull_request'
+        shell: bash
+        run: |
+          git fetch --quiet --no-tags origin "+refs/heads/${GITHUB_BASE_REF:-main}:refs/remotes/origin/${GITHUB_BASE_REF:-main}"
+
+      - name: Determine lane execution
+        id: lane-gate
+        shell: bash
+        run: |
+          set -euo pipefail
+          should_run=true
+
+          # Zero-lab tree (also the delete-last-lab state): nothing to verify.
+          # turbo 2.10.9 rejects any apps/labs filter while the directory is
+          # absent, and the lane body would no-op anyway.
+          if ! compgen -G "apps/labs/*/package.json" > /dev/null; then
+            should_run=false
+          elif [[ "$GITHUB_EVENT_NAME" == "pull_request" ]]; then
+            base_ref="origin/${GITHUB_BASE_REF:-main}"
+            changed_files="$(git diff --name-only "${base_ref}...HEAD")"
+
+            if [[ -z "$changed_files" ]]; then
+              should_run=false
+            elif ! grep -Eq '^apps/labs/' <<< "$changed_files"; then
+              should_run=false
+            fi
+          fi
+
+          echo "should_run=$should_run" >> "$GITHUB_OUTPUT"
+
+      - name: Setup monorepo CI
+        if: steps.lane-gate.outputs.should_run == 'true'
+        uses: ./.github/actions/setup-monorepo-ci
+        with:
+          cache-turbo: "true"
+          cache-write: "false"
+
+      - name: Run labs lane
+        if: steps.lane-gate.outputs.should_run == 'true'
+        shell: bash
+        run: |
+          set -euo pipefail
+          shape_args=()
+
+          if [[ "$GITHUB_EVENT_NAME" == "pull_request" ]]; then
+            shape_args+=(--affected --base "origin/${GITHUB_BASE_REF:-main}")
+          fi
+
+          shape_args+=(--summarize)
+
+          bun run beep ci lane labs "${shape_args[@]}"
+
+      - name: Append Turbo summary
+        if: steps.lane-gate.outputs.should_run == 'true' && always()
+        run: bun run beep ci append-turbo-summary
+
+      - name: Skip lane
+        if: steps.lane-gate.outputs.should_run != 'true'
+        run: echo "Skipping Labs for this change set."
+
   fallow-advisory:
     name: Fallow Advisory Envelopes
     runs-on: ubuntu-24.04
