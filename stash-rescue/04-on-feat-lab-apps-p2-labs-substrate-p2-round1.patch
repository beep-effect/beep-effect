@@ -0,0 +1,96 @@
+import {
+  isLabDisposition,
+  LAB_MANIFEST_FILE_NAME,
+  LabDisposition,
+  LabManifest,
+  LabManifestJson,
+} from "@beep/repo-cli/test/Labs";
+import { Str } from "@beep/utils";
+import { DateTime, Effect } from "effect";
+import * as O from "effect/Option";
+import * as S from "effect/Schema";
+import { describe, expect, it } from "vitest";
+
+const decodeDisposition = S.decodeUnknownEffect(LabDisposition);
+const encodeDisposition = S.encodeUnknownEffect(LabDisposition);
+
+describe("lab manifest schemas", () => {
+  it("names the manifest file lab.manifest.json", () => {
+    expect(LAB_MANIFEST_FILE_NAME).toBe("lab.manifest.json");
+  });
+
+  it.each(["active", "promote", "expired"] as const)("round-trips the %s disposition", (disposition) =>
+    Effect.runPromise(
+      Effect.gen(function* () {
+        const decoded = yield* decodeDisposition(disposition);
+        expect(decoded).toBe(disposition);
+        expect(yield* encodeDisposition(decoded)).toBe(disposition);
+        expect(isLabDisposition(disposition)).toBe(true);
+      })
+    )
+  );
+
+  it("rejects a disposition outside the ratified literal domain", () => {
+    expect(isLabDisposition("abandoned")).toBe(false);
+    expect(isLabDisposition("")).toBe(false);
+  });
+
+  it("round-trips a manifest with an owned Postgres schema through JSON text", () =>
+    Effect.runPromise(
+      Effect.gen(function* () {
+        const manifest = LabManifest.make({
+          purpose: "Explore alpha",
+          created: DateTime.makeUnsafe("2026-08-01T12:30:00.000Z"),
+          disposition: "active",
+          postgresSchema: O.some("lab_alpha"),
+        });
+        const text = yield* LabManifestJson.encode(manifest);
+        const decoded = yield* LabManifestJson.decode(text);
+        expect(decoded.purpose).toBe("Explore alpha");
+        expect(decoded.disposition).toBe("active");
+        expect(DateTime.formatIso(decoded.created)).toBe("2026-08-01T12:30:00.000Z");
+        expect(O.getOrThrow(decoded.postgresSchema)).toBe("lab_alpha");
+      })
+    ));
+
+  it("omits an absent postgresSchema from the encoded JSON and decodes it back to none", () =>
+    Effect.runPromise(
+      Effect.gen(function* () {
+        const manifest = LabManifest.make({
+          purpose: "Probe zeta ideas",
+          created: DateTime.makeUnsafe("2026-08-02T09:00:00.000Z"),
+          disposition: "promote",
+          postgresSchema: O.none(),
+        });
+        const text = yield* LabManifestJson.encode(manifest);
+        expect(Str.includes("postgresSchema")(text)).toBe(false);
+        const decoded = yield* LabManifestJson.decode(text);
+        expect(O.isNone(decoded.postgresSchema)).toBe(true);
+      })
+    ));
+
+  it("decodes an ISO created string into a DateTime.Utc", () =>
+    Effect.runPromise(
+      Effect.gen(function* () {
+        const decoded = yield* LabManifestJson.decode(
+          '{ "purpose": "Fine", "created": "2026-08-01T00:00:00.000Z", "disposition": "expired" }'
+        );
+        expect(DateTime.isDateTime(decoded.created)).toBe(true);
+        expect(DateTime.formatIso(decoded.created)).toBe("2026-08-01T00:00:00.000Z");
+      })
+    ));
+
+  it.each([
+    ["malformed JSON", "{ not json"],
+    ["empty purpose", '{ "purpose": "", "created": "2026-08-01T00:00:00.000Z", "disposition": "active" }'],
+    ["missing created", '{ "purpose": "Fine", "disposition": "active" }'],
+    ["invalid created", '{ "purpose": "Fine", "created": "yesterday-ish", "disposition": "active" }'],
+    ["invalid disposition", '{ "purpose": "Fine", "created": "2026-08-01T00:00:00.000Z", "disposition": "abandoned" }'],
+    [
+      "empty postgresSchema",
+      '{ "purpose": "Fine", "created": "2026-08-01T00:00:00.000Z", "disposition": "active", "postgresSchema": "" }',
+    ],
+  ])("refuses to decode a manifest with %s", (_label, text) => {
+    expect(O.isNone(LabManifestJson.decodeOption(text))).toBe(true);
+  });
+});
