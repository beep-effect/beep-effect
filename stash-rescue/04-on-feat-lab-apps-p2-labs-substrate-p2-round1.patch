+/**
+ * Shared schema-first predicates for the `apps/labs/*` lab-app root.
+ *
+ * Every consumer of "is this workspace a lab?" (tsconfig root-reference
+ * scoping, identity labs segment, ceremony inventory exclusions, CI lane
+ * filters, create/delete lab behavior) derives its answer from these branded
+ * schemas so the labs boundary has exactly one definition. Paths are
+ * repo-relative POSIX paths; relativize absolute directories against the repo
+ * root before applying the guards.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+import { $RepoCliId } from "@beep/identity/packages";
+import * as S from "effect/Schema";
+
+const $I = $RepoCliId.create("internal/cli/Labs");
+
+/** Repo-relative root directory that owns every lab app workspace. */
+export const LABS_WORKSPACE_ROOT = "apps/labs";
+
+const LABS_WORKSPACE_DIR_PATTERN = /^apps\/labs\/[^/]+$/;
+const LABS_OWNED_PATH_PATTERN = /^apps\/labs\//;
+
+/**
+ * Branded schema for a repo-relative lab workspace directory
+ * (`apps/labs/<name>`). Labs live exactly one level below the labs root;
+ * nested groupings are not part of the ratified geometry (SPEC D1/D5).
+ */
+export const LabsWorkspaceDir = S.String.check(S.isPattern(LABS_WORKSPACE_DIR_PATTERN)).pipe(
+  S.brand("LabsWorkspaceDir"),
+  $I.annoteSchema("LabsWorkspaceDir", {
+    description: "Repo-relative workspace directory exactly one level under apps/labs.",
+  })
+);
+export type LabsWorkspaceDir = typeof LabsWorkspaceDir.Type;
+
+/** Guard derived from {@link LabsWorkspaceDir}. */
+export const isLabsWorkspaceDir = S.is(LabsWorkspaceDir);
+
+/** Branded schema for any repo-relative path owned by the labs root. */
+export const LabsOwnedPath = S.String.check(S.isPattern(LABS_OWNED_PATH_PATTERN)).pipe(
+  S.brand("LabsOwnedPath"),
+  $I.annoteSchema("LabsOwnedPath", {
+    description: "Repo-relative path underneath the apps/labs lab root.",
+  })
+);
+export type LabsOwnedPath = typeof LabsOwnedPath.Type;
+
+/** Guard derived from {@link LabsOwnedPath}. */
+export const isLabsOwnedPath = S.is(LabsOwnedPath);
