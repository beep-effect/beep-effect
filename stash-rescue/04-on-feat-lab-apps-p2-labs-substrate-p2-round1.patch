diff --git a/packages/tooling/tool/cli/test/identity-labs-segment.test.ts b/packages/tooling/tool/cli/test/identity-labs-segment.test.ts
new file mode 100644
index 0000000000..cfa0577aed
--- /dev/null
+++ b/packages/tooling/tool/cli/test/identity-labs-segment.test.ts
@@ -0,0 +1,287 @@
+import { CreatePackageIdentityRegistration } from "@beep/repo-cli/commands/CreatePackage/internal/IdentityRegistration";
+import { IdentitySegmentSurface, RegistrationTarget, surfacesForTarget } from "@beep/repo-cli/test/DeletePackage";
+import { TSMorphServiceLive } from "@beep/repo-utils";
+import { FsUtilsLive } from "@beep/repo-utils/FsUtils";
+import { PosixPath } from "@beep/schema/PosixPath";
+import { provideScopedLayer } from "@beep/test-utils";
+import { A } from "@beep/utils";
+import { NodeServices } from "@effect/platform-node";
+import { Effect, FileSystem, Layer, Path } from "effect";
+import * as O from "effect/Option";
+import * as S from "effect/Schema";
+import { describe, expect, it } from "vitest";
+import { withTempWorkingDirectory } from "./support/CommandTest.ts";
+
+const encodeJson = S.encodeUnknownSync(S.fromJsonString(S.Unknown));
+
+const labsLayer = Layer.mergeAll(
+  NodeServices.layer,
+  TSMorphServiceLive.pipe(Layer.provide(NodeServices.layer)),
+  FsUtilsLive.pipe(Layer.provide(NodeServices.layer))
+);
+
+const IDENTITY_REGISTRY_PATH = "packages/identity/src/packages.ts";
+
+const BASE_REGISTRY = [
+  'const generatedComposers = $I.compose("identity", "widget");',
+  "",
+  "const composers = {",
+  "  ...generatedComposers,",
+  "};",
+  "",
+  'export const $IdentityId: Identity.IdentityComposer<"@beep/identity"> = composers.$IdentityId;',
+  'export const $WidgetId: Identity.IdentityComposer<"@beep/widget"> = composers.$WidgetId;',
+  "",
+].join("\n");
+
+const syncContent = CreatePackageIdentityRegistration.syncedLabsIdentityRegistryContent;
+
+describe("labs identity registry content sync", () => {
+  it("creates the whole labs region for the first lab", () => {
+    const next = syncContent(BASE_REGISTRY, ["lab-a"]);
+    expect(next).toContain(CreatePackageIdentityRegistration.LABS_COMPOSE_GROUP_COMMENT);
+    expect(next).toContain('const generatedLabComposers = $I.compose("lab-a");');
+    expect(next).toContain("  ...generatedComposers,\n  ...generatedLabComposers,");
+    expect(next).toContain(
+      [
+        CreatePackageIdentityRegistration.LAB_EXPORTS_START_MARKER,
+        'export const $LabAId: Identity.IdentityComposer<"@beep/lab-a"> = composers.$LabAId;',
+        CreatePackageIdentityRegistration.LAB_EXPORTS_END_MARKER,
+      ].join("\n")
+    );
+  });
+
+  it("inserts subsequent labs deterministically in slug order", () => {
+    const oneThenTwo = syncContent(syncContent(BASE_REGISTRY, ["lab-b"]), ["lab-b", "lab-a"]);
+    const bothAtOnce = syncContent(BASE_REGISTRY, ["lab-a", "lab-b"]);
+    expect(oneThenTwo).toBe(bothAtOnce);
+    expect(bothAtOnce).toContain('const generatedLabComposers = $I.compose("lab-a", "lab-b");');
+  });
+
+  it("removes the entire region when the last lab disappears", () => {
+    expect(syncContent(syncContent(BASE_REGISTRY, ["lab-a"]), [])).toBe(BASE_REGISTRY);
+  });
+
+  it("is a byte-level no-op for a zero-lab registry", () => {
+    expect(syncContent(BASE_REGISTRY, [])).toBe(BASE_REGISTRY);
+  });
+
+  it("reads group-scoped and marker-scoped slugs", () => {
+    const synced = syncContent(BASE_REGISTRY, ["lab-b", "lab-a"]);
+    expect(CreatePackageIdentityRegistration.labIdentityComposerGroupSlugs(synced)).toEqual(["lab-a", "lab-b"]);
+    expect(CreatePackageIdentityRegistration.labIdentityExportBlockSlugs(synced)).toEqual(["lab-a", "lab-b"]);
+    expect(CreatePackageIdentityRegistration.packageIdentityComposerGroupSlugs(synced)).toEqual(["identity", "widget"]);
+    expect(CreatePackageIdentityRegistration.labIdentityComposerGroupSlugs(BASE_REGISTRY)).toEqual([]);
+    expect(CreatePackageIdentityRegistration.labIdentityExportBlockSlugs(BASE_REGISTRY)).toEqual([]);
+  });
+});
+
+const writeLabsWorkspaceFixture = Effect.fn("writeLabsWorkspaceFixture")(function* (options: {
+  readonly registryContent: string;
+  readonly labs: ReadonlyArray<string>;
+}) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+
+  yield* fs.writeFileString("bun.lock", "");
+  yield* fs.writeFileString(
+    "package.json",
+    `${encodeJson({
+      name: "fixture-root",
+      private: true,
+      type: "module",
+      workspaces: ["packages/*", "apps/labs/*"],
+    })}\n`
+  );
+
+  yield* fs.makeDirectory(path.join("packages", "identity", "src"), { recursive: true });
+  yield* fs.writeFileString(
+    path.join("packages", "identity", "package.json"),
+    `${encodeJson({ name: "@beep/identity", version: "0.0.0", type: "module" })}\n`
+  );
+  yield* fs.writeFileString(
+    path.join("packages", "identity", "tsconfig.json"),
+    `${encodeJson({ compilerOptions: {} })}\n`
+  );
+  yield* fs.writeFileString(IDENTITY_REGISTRY_PATH, options.registryContent);
+
+  yield* fs.makeDirectory(path.join("packages", "widget", "src"), { recursive: true });
+  yield* fs.writeFileString(
+    path.join("packages", "widget", "package.json"),
+    `${encodeJson({ name: "@beep/widget", version: "0.0.0", type: "module" })}\n`
+  );
+
+  for (const lab of options.labs) {
+    yield* fs.makeDirectory(path.join("apps", "labs", lab, "src"), { recursive: true });
+    yield* fs.writeFileString(
+      path.join("apps", "labs", lab, "package.json"),
+      `${encodeJson({ name: `@beep/${lab}`, version: "0.0.0", type: "module" })}\n`
+    );
+  }
+});
+
+describe("syncLabsIdentitySegment", { concurrent: false }, () => {
+  it("materializes the labs region from the live workspace catalog", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          yield* writeLabsWorkspaceFixture({ registryContent: BASE_REGISTRY, labs: ["lab-b", "lab-a"] });
+
+          const synced = yield* CreatePackageIdentityRegistration.syncLabsIdentitySegment(".");
+
+          expect(synced).toEqual(["lab-a", "lab-b"]);
+          const next = yield* fs.readFileString(IDENTITY_REGISTRY_PATH);
+          expect(next).toBe(syncContent(BASE_REGISTRY, ["lab-a", "lab-b"]));
+        })
+      ).pipe(provideScopedLayer(labsLayer))
+    ));
+
+  it("removes the labs region when the last lab is deleted", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          yield* writeLabsWorkspaceFixture({
+            registryContent: syncContent(BASE_REGISTRY, ["lab-a"]),
+            labs: [],
+          });
+
+          const synced = yield* CreatePackageIdentityRegistration.syncLabsIdentitySegment(".");
+
+          expect(synced).toEqual([]);
+          const next = yield* fs.readFileString(IDENTITY_REGISTRY_PATH);
+          expect(next).toBe(BASE_REGISTRY);
+        })
+      ).pipe(provideScopedLayer(labsLayer))
+    ));
+
+  it("leaves a pristine zero-lab registry byte-identical", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          yield* writeLabsWorkspaceFixture({ registryContent: BASE_REGISTRY, labs: [] });
+
+          yield* CreatePackageIdentityRegistration.syncLabsIdentitySegment(".");
+
+          const next = yield* fs.readFileString(IDENTITY_REGISTRY_PATH);
+          expect(next).toBe(BASE_REGISTRY);
+        })
+      ).pipe(provideScopedLayer(labsLayer))
+    ));
+
+  it("fails loudly when the composers merge anchors are missing", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          yield* writeLabsWorkspaceFixture({
+            registryContent: [
+              'const composers = $I.compose("identity", "widget");',
+              "export const $IdentityId = composers.$IdentityId;",
+              "export const $WidgetId = composers.$WidgetId;",
+              "",
+            ].join("\n"),
+            labs: ["lab-a"],
+          });
+
+          const exit = yield* Effect.exit(CreatePackageIdentityRegistration.syncLabsIdentitySegment("."));
+
+          expect(exit._tag).toBe("Failure");
+        })
+      ).pipe(provideScopedLayer(labsLayer))
+    ));
+
+  it("registers lab workspaces only through the labs segment", () =>
+    Effect.runPromise(
+      withTempWorkingDirectory(
+        Effect.gen(function* () {
+          const fs = yield* FileSystem.FileSystem;
+          yield* writeLabsWorkspaceFixture({ registryContent: BASE_REGISTRY, labs: ["lab-a"] });
+
+          const registered = yield* CreatePackageIdentityRegistration.registerMissingWorkspaceIdentityPackages(".");
+
+          expect(registered).toEqual(["lab-a"]);
+          const next = yield* fs.readFileString(IDENTITY_REGISTRY_PATH);
+          expect(next).toBe(syncContent(BASE_REGISTRY, ["lab-a"]));
+          expect(CreatePackageIdentityRegistration.packageIdentityComposerGroupSlugs(next)).toEqual([
+            "identity",
+            "widget",
+          ]);
+        })
+      ).pipe(provideScopedLayer(labsLayer))
+    ));
+});
+
+const runEnsure = (registryContent: string, packageName: string, packageRelativeDir?: string) =>
+  withTempWorkingDirectory(
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      yield* fs.writeFileString("bun.lock", "");
+      yield* fs.writeFileString("tsconfig.json", '{ "compilerOptions": {} }\n');
+      yield* fs.writeFileString("packages.ts", registryContent);
+      yield* CreatePackageIdentityRegistration.ensureIdentityPackageRegistration(
+        "packages.ts",
+        packageName,
+        packageRelativeDir
+      );
+      return yield* fs.readFileString("packages.ts");
+    })
+  ).pipe(provideScopedLayer(labsLayer));
+
+describe("ensureIdentityPackageRegistration labs guard", { concurrent: false }, () => {
+  it("refuses to append a lab slug into the package compose group", () =>
+    Effect.runPromise(
+      Effect.gen(function* () {
+        const exit = yield* Effect.exit(runEnsure(BASE_REGISTRY, "lab-a", "apps/labs/lab-a"));
+        expect(exit._tag).toBe("Failure");
+      })
+    ));
+
+  it("does not duplicate a slug already owned by the labs group", () =>
+    Effect.runPromise(
+      Effect.gen(function* () {
+        const synced = syncContent(BASE_REGISTRY, ["lab-a"]);
+        const next = yield* runEnsure(synced, "lab-a");
+        expect(next).toBe(synced);
+      })
+    ));
+
+  it("keeps non-lab registration in the package group", () =>
+    Effect.runPromise(
+      Effect.gen(function* () {
+        const synced = syncContent(BASE_REGISTRY, ["lab-a"]);
+        const next = yield* runEnsure(synced, "gizmo");
+        expect(
+          A.some(CreatePackageIdentityRegistration.packageIdentityComposerGroupSlugs(next), (slug) => slug === "gizmo")
+        ).toBe(true);
+        expect(CreatePackageIdentityRegistration.labIdentityComposerGroupSlugs(next)).toEqual(["lab-a"]);
+        expect(next).toContain("export const $GizmoId");
+      })
+    ));
+});
+
+describe("registration geometry labs identity grouping", () => {
+  const identityGroupsOf = (target: RegistrationTarget): ReadonlyArray<O.Option<string>> =>
+    A.flatMap(surfacesForTarget(target), (surface) =>
+      surface instanceof IdentitySegmentSurface ? A.of(surface.generatedGroup) : A.empty<O.Option<string>>()
+    );
+
+  it("routes labs targets into the generated labs compose group", () => {
+    const target = RegistrationTarget.make({
+      packageName: "@beep/trustgraph-workbench",
+      packagePath: PosixPath.make("apps/labs/trustgraph-workbench"),
+      private: true,
+    });
+    expect(identityGroupsOf(target)).toEqual([O.some("generatedLabComposers")]);
+  });
+
+  it("keeps package targets groupless", () => {
+    const target = RegistrationTarget.make({
+      packageName: "@beep/widget",
+      packagePath: PosixPath.make("packages/common/widget"),
+      private: true,
+    });
+    expect(identityGroupsOf(target)).toEqual([O.none()]);
+  });
+});
