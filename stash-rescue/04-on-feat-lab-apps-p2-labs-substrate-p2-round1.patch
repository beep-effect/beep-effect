diff --git a/packages/tooling/tool/cli/src/internal/cli/Labs/LabManifest.schemas.ts b/packages/tooling/tool/cli/src/internal/cli/Labs/LabManifest.schemas.ts
new file mode 100644
index 0000000000..650b7b26ed
--- /dev/null
+++ b/packages/tooling/tool/cli/src/internal/cli/Labs/LabManifest.schemas.ts
@@ -0,0 +1,63 @@
+/**
+ * Schema-first contracts for the lab-app manifest (`lab.manifest.json`).
+ *
+ * Every lab workspace under `apps/labs/<name>` carries one schema-validated
+ * manifest at its root (SPEC D9). The manifest is the machine-readable record
+ * of why the lab exists, when it was created, what the operator intends for it
+ * (disposition), and which local Postgres schema it owns, if any (SPEC D12 —
+ * delete-package reads that field to print the manual drop step). All reads go
+ * through {@link LabManifestJson}; the manifest is never hand-parsed.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+import { $RepoCliId } from "@beep/identity/packages";
+import { LiteralKit } from "@beep/schema";
+import * as S from "effect/Schema";
+import { JsonStringCodec } from "../../schema/JsonCodec.ts";
+
+const $I = $RepoCliId.create("internal/cli/Labs/LabManifest");
+
+/** File name of the schema-validated manifest at every lab workspace root (SPEC D9). */
+export const LAB_MANIFEST_FILE_NAME = "lab.manifest.json";
+
+/**
+ * Operator-declared lab lifecycle intent (SPEC D9): `active` (in use),
+ * `promote` (earned a lawful durable home), `expired` (ready for deletion).
+ * States are inventory, not TTL — nothing acts on them automatically.
+ */
+export const LabDisposition = LiteralKit(["active", "promote", "expired"]).pipe(
+  $I.annoteSchema("LabDisposition", {
+    description: "Operator-declared lab lifecycle intent: active, promote, or expired.",
+  })
+);
+export type LabDisposition = typeof LabDisposition.Type;
+
+/** Guard derived from {@link LabDisposition}. */
+export const isLabDisposition = S.is(LabDisposition);
+
+/**
+ * Decoded `lab.manifest.json` contract. The encoded `created` field is a UTC
+ * ISO 8601 string; `postgresSchema` is an optional key that decodes to an
+ * `Option` (absent for labs without a local data resource).
+ */
+export class LabManifest extends S.Class<LabManifest>($I`LabManifest`)(
+  {
+    purpose: S.NonEmptyString,
+    created: S.DateTimeUtcFromString,
+    disposition: LabDisposition,
+    postgresSchema: S.OptionFromOptionalKey(S.NonEmptyString),
+  },
+  $I.annote("LabManifest", {
+    description:
+      "Schema-validated lab manifest: purpose, ISO creation date, disposition, and optional owned Postgres schema.",
+  })
+) {}
+
+/**
+ * JSON-string codec for {@link LabManifest}. `decode` fails with a
+ * `SchemaError` on malformed JSON or a manifest mismatch; `encode` produces the
+ * compact JSON text written to {@link LAB_MANIFEST_FILE_NAME}.
+ */
+export const LabManifestJson = JsonStringCodec(LabManifest);
diff --git a/packages/tooling/tool/cli/src/internal/cli/Labs/LabsDiscovery.ts b/packages/tooling/tool/cli/src/internal/cli/Labs/LabsDiscovery.ts
new file mode 100644
index 0000000000..d75e7e0be1
--- /dev/null
+++ b/packages/tooling/tool/cli/src/internal/cli/Labs/LabsDiscovery.ts
@@ -0,0 +1,138 @@
+/**
+ * Lab workspace discovery and manifest reading for `beep labs` tooling.
+ *
+ * Discovery reuses `resolveWorkspaceDirs` from `@beep/repo-utils` — the same
+ * workspace catalog the RegistrationGeometry probes use — rather than
+ * `discoverWorkspacePackages`, because that helper lives under
+ * `commands/Quality/internal` and internal/cli modules must not depend on
+ * `commands/**`. Absolute workspace directories are relativized against the
+ * repo root before the {@link isLabsWorkspaceDir} guard is applied, per the
+ * LabsPath contract. A lab whose manifest is missing or invalid is reported as
+ * a failed row instead of failing the whole listing, so `beep labs list` can
+ * render every lab and exit nonzero afterwards (SPEC D9 gate).
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+
+import { $RepoCliId } from "@beep/identity/packages";
+import { resolveWorkspaceDirs } from "@beep/repo-utils";
+import { LiteralKit, normalizePath } from "@beep/schema";
+import { A, Str, thunkFalse } from "@beep/utils";
+import { Effect, FileSystem, Path, pipe, Tuple } from "effect";
+import * as O from "effect/Option";
+import * as S from "effect/Schema";
+import { LAB_MANIFEST_FILE_NAME, LabManifest, LabManifestJson } from "./LabManifest.schemas.ts";
+import { isLabsWorkspaceDir, LabsWorkspaceDir } from "./LabsPath.ts";
+
+const $I = $RepoCliId.create("internal/cli/Labs/LabsDiscovery");
+
+/** One discovered lab workspace: package name plus repo-relative lab directory. */
+export class LabWorkspaceRef extends S.Class<LabWorkspaceRef>($I`LabWorkspaceRef`)(
+  {
+    packageName: S.NonEmptyString,
+    dir: LabsWorkspaceDir,
+  },
+  $I.annote("LabWorkspaceRef", {
+    description: "One discovered lab workspace: package name plus repo-relative lab directory.",
+  })
+) {}
+
+/** A lab whose manifest decoded cleanly. */
+export class DecodedLabRow extends S.Class<DecodedLabRow>($I`DecodedLabRow`)(
+  {
+    kind: S.tag("decoded"),
+    lab: LabWorkspaceRef,
+    manifest: LabManifest,
+  },
+  $I.annote("DecodedLabRow", {
+    description: "A lab workspace paired with its successfully decoded manifest.",
+  })
+) {}
+
+/** A lab whose manifest is missing, unreadable, or schema-invalid. */
+export class FailedLabRow extends S.Class<FailedLabRow>($I`FailedLabRow`)(
+  {
+    kind: S.tag("failed"),
+    lab: LabWorkspaceRef,
+    reason: S.NonEmptyString,
+  },
+  $I.annote("FailedLabRow", {
+    description: "A lab workspace whose manifest is missing, unreadable, or schema-invalid.",
+  })
+) {}
+
+/** Tagged union of `beep labs list` rows: a decoded manifest or a reported failure. */
+export const LabListRow = LiteralKit(["decoded", "failed"])
+  .mapMembers(Tuple.evolve([() => DecodedLabRow, () => FailedLabRow]))
+  .pipe(
+    S.toTaggedUnion("kind"),
+    $I.annoteSchema("LabListRow", {
+      description: "One labs listing row: a decoded manifest or a reported manifest failure.",
+    })
+  );
+export type LabListRow = typeof LabListRow.Type;
+
+/** Guard derived from {@link FailedLabRow}. */
+export const isFailedLabRow = S.is(FailedLabRow);
+
+/**
+ * Enumerate lab workspaces from the root workspace catalog, sorted by lab
+ * directory for stable rendering. Safe on the zero-lab tree: with no
+ * `apps/labs/<name>` workspaces the result is empty.
+ */
+export const discoverLabWorkspaces = Effect.fn("Labs.discoverLabWorkspaces")(function* (repoRoot: string) {
+  const path = yield* Path.Path;
+  const workspaces = A.fromIterable(yield* resolveWorkspaceDirs(repoRoot));
+  // v4 `A.filterMap` takes a `Result`-returning callback (an `Option` one
+  // silently yields `[]`), so the Option pipeline goes through `A.getSomes`.
+  return pipe(
+    workspaces,
+    A.map(([packageName, dir]) =>
+      pipe(
+        normalizePath(path.relative(repoRoot, dir)),
+        O.liftPredicate(isLabsWorkspaceDir),
+        O.map((relativeDir) => LabWorkspaceRef.make({ packageName, dir: relativeDir }))
+      )
+    ),
+    A.getSomes,
+    A.sortWith((lab) => lab.dir, Str.Order)
+  );
+});
+
+/**
+ * Read and decode one lab's `lab.manifest.json` into a {@link LabListRow}.
+ * Missing, unreadable, and schema-invalid manifests each become a
+ * {@link FailedLabRow} so the caller can render every lab before failing.
+ */
+export const readLabManifestRow = Effect.fn("Labs.readLabManifestRow")(function* (
+  repoRoot: string,
+  lab: LabWorkspaceRef
+) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const file = path.join(repoRoot, lab.dir, LAB_MANIFEST_FILE_NAME);
+  const exists = yield* fs.exists(file).pipe(Effect.orElseSucceed(thunkFalse));
+  if (!exists) {
+    return FailedLabRow.make({ lab, reason: `missing ${LAB_MANIFEST_FILE_NAME}` });
+  }
+  const content = yield* fs.readFileString(file).pipe(Effect.option);
+  if (O.isNone(content)) {
+    return FailedLabRow.make({ lab, reason: `unreadable ${LAB_MANIFEST_FILE_NAME}` });
+  }
+  return yield* LabManifestJson.decode(content.value).pipe(
+    Effect.map((manifest) => DecodedLabRow.make({ lab, manifest })),
+    Effect.catchTag("SchemaError", (error) =>
+      Effect.succeed(FailedLabRow.make({ lab, reason: `invalid ${LAB_MANIFEST_FILE_NAME}: ${error.message}` }))
+    )
+  );
+});
+
+/**
+ * Discover every lab workspace and decode each manifest into a stable-sorted
+ * row list — the single read surface behind `beep labs list`.
+ */
+export const listLabRows = Effect.fn("Labs.listLabRows")(function* (repoRoot: string) {
+  const labs = yield* discoverLabWorkspaces(repoRoot);
+  return yield* Effect.forEach(labs, (lab) => readLabManifestRow(repoRoot, lab));
+});
