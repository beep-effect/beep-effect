+
+@theme {
+  --color-brand-50: #eef5ee;
+  --color-brand-100: #d4e8d4;
+  --color-brand-200: #aed1ae;
+  --color-brand-300: #2d632d;
+  --color-brand-400: #214e21;
+  --color-brand-500: #3d7d3d;
+  --color-brand-600: #2d632d;
+  --color-brand-700: #214e21;
+  --color-brand-800: #1a3a1a;
+  --color-brand-900: #122812;
+  --color-surface-0: #ffffff;
+  --color-surface-50: #fafafa;
+  --color-surface-100: #f4f4f5;
+  --color-surface-200: #e4e4e7;
+  --color-surface-300: #d4d4d8;
+  --color-surface-400: #a1a1aa;
+  --color-fg: #18181b;
+  --color-fg-muted: #52525b;
+  --color-fg-subtle: #71717a;
+  --color-border: #d4d4d8;
+  --color-border-hover: #a1a1aa;
+  --color-success: #16a34a;
+  --color-warning: #854d0e;
+  --color-error: #b91c1c;
+  --font-brand-sans: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif;
+  --font-brand-mono: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, monospace;
+  --font-sans: var(--font-brand-sans);
+  --font-mono: var(--font-brand-mono);
