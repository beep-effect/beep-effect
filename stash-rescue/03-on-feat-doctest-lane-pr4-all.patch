+
+const isIdentifierText = (node: Node, values: ReadonlyArray<string>): boolean =>
+  Node.isIdentifier(node) && A.contains(values, node.getText());
+
+const isLiteralLikeExpression = (node: Node): boolean => {
+  if (
+    Node.isStringLiteral(node) ||
+    Node.isNoSubstitutionTemplateLiteral(node) ||
+    Node.isNumericLiteral(node) ||
+    Node.isBigIntLiteral(node) ||
+    node.getKind() === SyntaxKind.TrueKeyword ||
+    node.getKind() === SyntaxKind.FalseKeyword ||
+    node.getKind() === SyntaxKind.NullKeyword ||
+    isIdentifierText(node, ["undefined", "NaN", "Infinity"])
+  ) {
+    return true;
+  }
+  if (Node.isParenthesizedExpression(node)) return isLiteralLikeExpression(node.getExpression());
+  if (Node.isPrefixUnaryExpression(node)) {
+    const operator = node.getOperatorToken();
+    return (
