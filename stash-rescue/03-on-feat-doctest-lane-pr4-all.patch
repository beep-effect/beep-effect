+    return findings;
+  }
+  if (O.isNone(canonical)) {
+    A.appendInPlace(
+      findings,
+      DoctestFinding.make({
+        kind: "unnameable-example-title",
+        location: fence.location,
+        info,
+        verdict,
+        message: "Example title contains both quote delimiters and cannot be represented by upstream metadata.",
