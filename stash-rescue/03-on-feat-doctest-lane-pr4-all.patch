+      Result.try({
+        try: () => transformDoctest(code, file, line),
+        catch: (cause) =>
+          P.hasProperty(cause, "message") && P.isString(cause.message) ? cause.message : "Invalid assertion",
+      }),
+      { onFailure: O.some, onSuccess: () => O.none() }
+    )
+);
