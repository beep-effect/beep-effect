+  if (Node.isArrayLiteralExpression(node)) {
+    return A.every(node.getElements(), (element) => !Node.isSpreadElement(element) && isLiteralLikeExpression(element));
+  }
+  if (Node.isObjectLiteralExpression(node)) {
