+    runGitLines(repoRoot, ["diff", "--name-only", "HEAD", "--", "packages", "apps"], gitErrorAdapter),
+    runGitLines(repoRoot, ["ls-files", "--others", "--exclude-standard", "--", "packages", "apps"], gitErrorAdapter),
