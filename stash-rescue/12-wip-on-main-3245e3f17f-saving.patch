+/**
+ * Beep Primitives
+ *
+ * Effect Schema aligned primitive types with OSDK-compatible metadata.
+ * These form the algebraic signature Σ from which free algebras are constructed.
+ *
+ * @packageDocumentation
+ * @since 0.0.0
+ */
+import { $OntologyId } from "@beep/identity";
+import { LiteralKit, UnknownRecord } from "@beep/schema";
+import { dual, O, P, Str } from "@beep/utils";
+import { pipe } from "effect";
+import * as S from "effect/Schema";
+import type { AnnotatedSchema } from "@beep/identity";
+
+const $I = $OntologyId.create("experimental/Primitive/Primitive.schemas");
+
+type CompositeFieldSchemaMeta = {
+  readonly description: string;
+};
+
+// =============================================================================
+// Primitive Types
+// =============================================================================
+
+/**
+ * Literal vocabulary for scalar primitive field tags.
+ *
+ * @example
+ * ```ts
+ * import { PrimitiveTag } from "@beep/ontology"
+ *
+ * const tag = PrimitiveTag.Enum.String
+ * console.log(PrimitiveTag.is.String(tag))
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export const PrimitiveTag = LiteralKit([
+  "String",
+  "Int",
+  "Number",
+  "Boolean",
+  "Date",
+  "DateTimeUtc",
+  "Timestamp",
+  "Decimal",
+]).annotate(
+  $I.annote("PrimitiveTag", {
+    description: "Literal vocabulary for scalar primitive field tags.",
+  })
+);
+
+/**
+ * Runtime type for {@link PrimitiveTag}.
+ *
+ * @example
+ * ```ts
+ * import { PrimitiveTag } from "@beep/ontology"
+ *
+ * const tag: PrimitiveTag = PrimitiveTag.Enum.DateTimeUtc
+ * console.log(tag)
+ * ```
+ *
+ * @category models
+ * @since 0.0.0
+ */
+export type PrimitiveTag = typeof PrimitiveTag.Type;
+
+/**
+ * Beep primitive type for String values.
+ *
+ * @example
+ * ```ts
+ * import { StringType } from "@beep/ontology"
+ * const stringType = StringType.make({})
+ *
+ * console.log(stringType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class StringType extends S.TaggedClass<StringType>($I`StringType`)(
+  PrimitiveTag.Enum.String,
+  {},
+  $I.annote("StringType", {
+    description: "Beep primitive type for string values.",
+  })
+) {}
+
+/**
+ * Beep primitive type for Int values.
+ *
+ * @example
+ * ```ts
+ * import { IntType } from "@beep/ontology"
+ * const intType = IntType.make({})
+ *
+ * console.log(intType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class IntType extends S.TaggedClass<IntType>($I`IntType`)(
+  PrimitiveTag.Enum.Int,
+  {},
+  $I.annote("IntType", {
+    description: "Beep primitive type for integer values.",
+  })
+) {}
+
+/**
+ * Beep primitive type for Number values.
+ *
+ * @example
+ * ```ts
+ * import { NumberType } from "@beep/ontology"
+ * const numberType = NumberType.make({})
+ *
+ * console.log(numberType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class NumberType extends S.TaggedClass<NumberType>($I`NumberType`)(
+  PrimitiveTag.Enum.Number,
+  {},
+  $I.annote("NumberType", {
+    description: "Beep primitive type for floating-point number values.",
+  })
+) {}
+
+/**
+ * Beep primitive type for Boolean values.
+ *
+ * @example
+ * ```ts
+ * import { BooleanType } from "@beep/ontology"
+ * const booleanType = BooleanType.make({})
+ *
+ * console.log(booleanType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class BooleanType extends S.TaggedClass<BooleanType>($I`BooleanType`)(
+  PrimitiveTag.Enum.Boolean,
+  {},
+  $I.annote("BooleanType", {
+    description: "Beep primitive type for boolean values.",
+  })
+) {}
+
+/**
+ * Beep primitive type for Date values.
+ *
+ * @example
+ * ```ts
+ * import { DateType } from "@beep/ontology"
+ * const dateType = DateType.make({})
+ *
+ * console.log(dateType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class DateType extends S.TaggedClass<DateType>($I`DateType`)(
+  PrimitiveTag.Enum.Date,
+  {},
+  $I.annote("DateType", {
+    description: "Beep primitive type for calendar date values without time component.",
+  })
+) {}
+
+/**
+ * Beep primitive type for DateTimeUtc values.
+ *
+ * @example
+ * ```ts
+ * import { DateTimeUtcType } from "@beep/ontology"
+ * const dateTimeUtcType = DateTimeUtcType.make({})
+ *
+ * console.log(dateTimeUtcType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class DateTimeUtcType extends S.TaggedClass<DateTimeUtcType>($I`DateTimeUtcType`)(
+  PrimitiveTag.Enum.DateTimeUtc,
+  {},
+  $I.annote("DateTimeUtcType", {
+    description: "Beep primitive type for UTC date-time values with timezone information.",
+  })
+) {}
+
+/**
+ * Beep primitive type for Timestamp values.
+ *
+ * @example
+ * ```ts
+ * import { TimestampType } from "@beep/ontology"
+ * const timestampType = TimestampType.make({})
+ *
+ * console.log(timestampType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class TimestampType extends S.TaggedClass<TimestampType>($I`TimestampType`)(
+  PrimitiveTag.Enum.Timestamp,
+  {},
+  $I.annote("TimestampType", {
+    description: "Beep primitive type for Unix timestamp values representing moments in time.",
+  })
+) {}
+
+/**
+ * Beep primitive type for Decimal values.
+ *
+ * @example
+ * ```ts
+ * import { DecimalType } from "@beep/ontology"
+ * const decimalType = DecimalType.make({})
+ *
+ * console.log(decimalType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class DecimalType extends S.TaggedClass<DecimalType>($I`DecimalType`)(
+  PrimitiveTag.Enum.Decimal,
+  {},
+  $I.annote("DecimalType", {
+    description: "Beep primitive type for arbitrary-precision decimal values.",
+  })
+) {}
+
+// =============================================================================
+// Composite Types
+// =============================================================================
+
+/**
+ * Literal vocabulary for composite field tags.
+ *
+ * @example
+ * ```ts
+ * import { CompositeTag } from "@beep/ontology"
+ *
+ * const tag = CompositeTag.Enum.Array
+ * console.log(CompositeTag.is.Array(tag))
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export const CompositeTag = LiteralKit(["Array", "Struct"]).annotate(
+  $I.annote("CompositeTag", {
+    description: "Literal vocabulary for composite field tags.",
+  })
+);
+
+/**
+ * Runtime type for {@link CompositeTag}.
+ *
+ * @example
+ * ```ts
+ * import { CompositeTag } from "@beep/ontology"
+ *
+ * const tag: CompositeTag = CompositeTag.Enum.Struct
+ * console.log(tag)
+ * ```
+ *
+ * @category models
+ * @since 0.0.0
+ */
+export type CompositeTag = typeof CompositeTag.Type;
+
+/**
+ * Beep composite type for array values.
+ *
+ * @example
+ * ```ts
+ * import { ArrayType, StringType } from "@beep/ontology"
+ *
+ * const arrayType = ArrayType.make({ _item: StringType.make({}) })
+ * console.log(arrayType._item)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class ArrayType extends S.TaggedClass<ArrayType>($I`ArrayType`)(
+  CompositeTag.Enum.Array,
+  {
+    _item: S.Unknown.pipe(
+      $I.annoteKey("ArrayType._item", {
+        description: "Descriptor carried for each element of an array field.",
+      })
+    ),
+  },
+  $I.annote("ArrayType", {
+    description: "Composite field type whose elements share a single descriptor.",
+  })
+) {
+  /**
+   * Creates an annotated array item field schema from a child schema.
+   *
+   * @example
+   * ```ts
+   * import { ArrayType, StringType } from "@beep/ontology"
+   *
+   * const schema = ArrayType.create(StringType, {
+   *   description: "Primitive descriptor for each array item."
+   * })
+   *
+   * console.log(schema.fields._item)
+   * ```
+   *
+   * @category constructors
+   * @since 0.0.0
+   */
+  static readonly create: {
+    <const T extends S.Top>(
+      meta: CompositeFieldSchemaMeta
+    ): (schema: T) => S.Struct<{
+      readonly _item: T["Rebuild"];
+    }>;
+    <const T extends S.Top>(
+      schema: T,
+      meta: CompositeFieldSchemaMeta
+    ): S.Struct<{
+      readonly _item: T["Rebuild"];
+    }>;
+  } = dual(
+    2,
+    <const T extends S.Top>(
+      schema: T,
+      meta: CompositeFieldSchemaMeta
+    ): S.Struct<{
+      readonly _item: T["Rebuild"];
+    }> =>
+      S.Struct({
+        _item: schema.annotateKey({ description: meta.description }),
+      })
+  );
+}
+
+/**
+ * Beep composite type for struct values.
+ *
+ * @example
+ * ```ts
+ * import { StringType, StructType } from "@beep/ontology"
+ *
+ * const structType = StructType.make({ _fields: { name: StringType.make({}) } })
+ * console.log(structType._fields.name)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class StructType extends S.TaggedClass<StructType>($I`StructType`)(
+  CompositeTag.Enum.Struct,
+  {
+    _fields: UnknownRecord.pipe(
+      $I.annoteKey("StructType._fields", {
+        description: "Record of named field descriptors carried by a struct field.",
+      })
+    ),
+  },
+  $I.annote("StructType", {
+    description: "Composite field type represented by a record of named field descriptors.",
+  })
+) {
+  /**
+   * Creates an annotated struct fields schema from a child schema.
+   *
+   * @example
+   * ```ts
+   * import { StructType } from "@beep/ontology"
+   * import { UnknownRecord } from "@beep/schema"
+   *
+   * const schema = StructType.create(UnknownRecord, {
+   *   description: "Record containing named field descriptors."
+   * })
+   *
+   * console.log(schema.fields._fields)
+   * ```
+   *
+   * @category constructors
+   * @since 0.0.0
+   */
+  static readonly create: {
+    <const T extends S.Top>(
+      meta: CompositeFieldSchemaMeta
+    ): (schema: T) => S.Struct<{
+      readonly _fields: T["Rebuild"];
+    }>;
+    <const T extends S.Top>(
+      schema: T,
+      meta: CompositeFieldSchemaMeta
+    ): S.Struct<{
+      readonly _fields: T["Rebuild"];
+    }>;
+  } = dual(
+    2,
+    <const T extends S.Top>(
+      schema: T,
+      meta: CompositeFieldSchemaMeta
+    ): S.Struct<{
+      readonly _fields: T["Rebuild"];
+    }> =>
+      S.Struct({
+        _fields: schema.annotateKey({ description: meta.description }),
+      })
+  );
+}
+
+// =============================================================================
+// OSDK-specific Types
+// =============================================================================
+
+/**
+ * Literal vocabulary for OSDK-specific primitive field tags.
+ *
+ * @example
+ * ```ts
+ * import { OsdkPrimitiveTag } from "@beep/ontology"
+ *
+ * const tag = OsdkPrimitiveTag.Enum.GeoPoint
+ * console.log(OsdkPrimitiveTag.is.GeoPoint(tag))
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export const OsdkPrimitiveTag = LiteralKit(["GeoPoint", "GeoShape", "MediaReference"]).annotate(
+  $I.annote("OsdkPrimitiveTag", {
+    description: "Literal vocabulary for OSDK-specific primitive field tags.",
+  })
+);
+
+/**
+ * Runtime type for {@link OsdkPrimitiveTag}.
+ *
+ * @example
+ * ```ts
+ * import { OsdkPrimitiveTag } from "@beep/ontology"
+ *
+ * const tag: OsdkPrimitiveTag = OsdkPrimitiveTag.Enum.MediaReference
+ * console.log(tag)
+ * ```
+ *
+ * @category models
+ * @since 0.0.0
+ */
+export type OsdkPrimitiveTag = typeof OsdkPrimitiveTag.Type;
+
+/**
+ * Beep primitive type for OSDK geospatial point values.
+ *
+ * @example
+ * ```ts
+ * import { GeoPointType } from "@beep/ontology"
+ *
+ * const geoPointType = GeoPointType.make({})
+ * console.log(geoPointType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class GeoPointType extends S.TaggedClass<GeoPointType>($I`GeoPointType`)(
+  OsdkPrimitiveTag.Enum.GeoPoint,
+  {},
+  $I.annote("GeoPointType", {
+    description: "Beep primitive type for OSDK geospatial point values.",
+  })
