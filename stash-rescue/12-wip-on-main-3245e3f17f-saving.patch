+ * const geoShapeType = GeoShapeType.make({})
+ * console.log(geoShapeType._tag)
+ * ```
+ *
+ * @category schemas
+ * @since 0.0.0
+ */
+export class GeoShapeType extends S.TaggedClass<GeoShapeType>($I`GeoShapeType`)(
