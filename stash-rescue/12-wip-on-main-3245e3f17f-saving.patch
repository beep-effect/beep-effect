+export const VersionBoundStr = <Major extends number = 0, Minor extends number = 0, Patch extends number = 0>(
+  expectedClientVersion?: undefined | VersionString<Major, Minor, Patch>
+) =>
+  O.fromNullishOr(expectedClientVersion).pipe(
+    O.match({
+      onNone: () => VersionString<Major, Minor, Patch>(0 as Major, 0 as Minor, 0 as Patch),
+      onSome: (expectedClientVersion) => {
+        const { major, minor, patch } = fromClientVersion(expectedClientVersion);
+
+        return VersionString(major, minor, patch);
+      },
+    })
+  );
+
