+
+const fromClientVersion = <Major extends number, Minor extends number, Patch extends number>(
+  expectedClientVersion?: undefined | VersionString<Major, Minor, Patch>
+) => {
+  const expectedClientVersionOpt = O.fromNullishOr(expectedClientVersion);
+
+  const makeDefaultParts = () => {
+    const major = 0 as Major;
+    const minor = 0 as Minor;
+    const patch = 0 as Patch;
+
+    return {
+      major,
+      minor,
+      patch,
+    };
+  };
+
+  return expectedClientVersionOpt.pipe(
+    O.match({
+      onNone: makeDefaultParts,
+      onSome: (expectedClientVersion) => {
+        const is = S.is(S.Number);
+
+        const isMajor = (value: unknown): value is Major => is(value);
+        const isMinor = (value: unknown): value is Minor => is(value);
+        const isPatch = (value: unknown): value is Patch => is(value);
+
+        return pipe(Str.split(".")(expectedClientVersion), ([major, minor, patch]) =>
+          pipe(
+            {
+              major,
+              minor,
+              patch,
+            },
+            O.liftPredicate(
+              P.Struct({
+                major: isMajor,
+                minor: isMinor,
+                patch: isPatch,
+              })
+            ),
+            O.getOrElse(makeDefaultParts)
+          )
+        );
+      },
+    })
+  );
+};
