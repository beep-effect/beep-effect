+  Major extends number = 0,
+  Minor extends number = 0,
+  Patch extends number = 0,
+> = AnnotatedSchema<S.TemplateLiteral<readonly [S.Literal<Major>, ".", S.Literal<Minor>, ".", S.Literal<Patch>]>>;
