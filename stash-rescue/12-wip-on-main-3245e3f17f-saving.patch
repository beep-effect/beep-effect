+/**
+ * ObjectType - Schema wrapper with OSDK metadata
+ *
+ * Wraps Effect S.TaggedClass definitions with ontology metadata
+ * (primaryKey, title, links, displayName) for OSDK compilation.
+ *
+ * @example
+ * ```ts
+ * import * as S from "effect"
+ * import { ObjectType } from "@beep/ontology"
+ *
+ * class Department extends S.TaggedClass<Department>()("Department", {
+ *   id: S.String.pipe(S.brand("DepartmentId")),
+ *   name: S.NonEmptyString,
+ * }) {}
+ *
+ * const DepartmentType = ObjectType.from(Department, {
+ *   primaryKey: "id",
+ *   title: "name",
+ *   displayName: "Department",
+ * })
+ * ```
+ */
+import { $OntologyId } from "@beep/identity";
+import { LiteralKit } from "@beep/schema";
+
+const $I = $OntologyId.create("experimental/Primitive/ObjectType.schemas");
+
+// =============================================================================
+// Link Configuration
+// =============================================================================
+
+/**
+ * Link cardinality options
+ *
+ * @example
+ * ```ts
+ * import { LinkCardinality } from "@beep/ontology";
+ *
+ * console.log(LinkCardinality.Enum.OneToMany)
+ *
+ * ```
+ *
+ * @since 0.1.0
+ * @category models
+ */
+export const LinkCardinality = LiteralKit(["OneToOne", "OneToMany", "ManyToOne", "ManyToMany"]).pipe(
+  $I.annoteSchema("LinkCardinality", {
+    description: "Link cardinality options for ObjectType definitions",
+  })
+);
+
+/**
+ * Companion type for {@link LinkCardinality}
+ *
+ * @example
+ * ```ts
+ * import { LinkCardinality } from "@beep/ontology";
+ *
+ * const T: LinkCardinality = LinkCardinality.Enum.OneToMany
+ *
+ * ```
+ *
+ * @since 0.1.0
+ * @category models
+ */
+export type LinkCardinality = typeof LinkCardinality.Type;
