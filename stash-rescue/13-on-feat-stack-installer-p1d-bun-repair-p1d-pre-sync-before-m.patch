 #[tauri::command]
 fn stack_installer_health() -> StackInstallerHealth {
     StackInstallerHealth {
@@ -54,10 +60,56 @@ fn run_p1_manual_proof(request: P1ManualProofRequest) -> Result<String, String>
     Err(stderr)
