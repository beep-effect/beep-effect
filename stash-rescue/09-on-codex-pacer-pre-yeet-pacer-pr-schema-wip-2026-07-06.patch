diff --git a/packages/foundation/modeling/schema/test/Platform.test.ts b/packages/foundation/modeling/schema/test/Platform.test.ts
new file mode 100644
index 0000000000..64f26a95cc
--- /dev/null
+++ b/packages/foundation/modeling/schema/test/Platform.test.ts
@@ -0,0 +1,66 @@
+import { PlatformArch, PlatformOS } from "@beep/schema";
+import { describe, expect, it } from "@effect/vitest";
+import * as S from "effect/Schema";
+
+describe("PlatformOS", () => {
+  const decode = S.decodeUnknownSync(PlatformOS);
+
+  it("exports operating-system literals from the package root", () => {
+    expect(PlatformOS.Options).toEqual(["darwin", "linux", "windows", "unknown"]);
+    expect(PlatformOS.Enum.linux).toBe("linux");
+  });
+
+  it("decodes supported operating-system identifiers", () => {
+    expect(decode("darwin")).toBe("darwin");
+    expect(decode("windows")).toBe("windows");
+  });
+
+  it("rejects unsupported operating-system identifiers", () => {
+    expect(() => decode("freebsd")).toThrow();
+  });
+
+  it("exposes derived guards and match helpers", () => {
+    expect(PlatformOS.is.unknown("unknown")).toBe(true);
+    expect(PlatformOS.is.linux("darwin")).toBe(false);
+
+    expect(
+      PlatformOS.$match("windows", {
+        darwin: () => "mac",
+        linux: () => "linux",
+        windows: () => "windows",
+        unknown: () => "unknown",
+      })
+    ).toBe("windows");
+  });
+});
+
+describe("PlatformArch", () => {
+  const decode = S.decodeUnknownSync(PlatformArch);
+
+  it("exports architecture literals from the package root", () => {
+    expect(PlatformArch.Options).toEqual(["arm64", "x64", "other"]);
+    expect(PlatformArch.Enum.arm64).toBe("arm64");
+  });
+
+  it("decodes supported architecture identifiers", () => {
+    expect(decode("arm64")).toBe("arm64");
+    expect(decode("x64")).toBe("x64");
+  });
+
+  it("rejects unsupported architecture identifiers", () => {
+    expect(() => decode("ia32")).toThrow();
+  });
+
+  it("exposes derived guards and match helpers", () => {
+    expect(PlatformArch.is.other("other")).toBe(true);
+    expect(PlatformArch.is.x64("arm64")).toBe(false);
+
+    expect(
+      PlatformArch.$match("arm64", {
+        arm64: () => "arm",
+        x64: () => "x64",
+        other: () => "other",
+      })
+    ).toBe("arm");
+  });
+});
