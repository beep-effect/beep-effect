+/**
+ * Runtime platform architecture literal domain.
+ *
+ * @packageDocumentation
+ * @category validation
+ * @since 0.0.0
+ */
+import { $SchemaId } from "@beep/identity";
+import { LiteralKit } from "./LiteralKit/index.ts";
+
+const $I = $SchemaId.create("PlatformArch");
+
+/**
+ * CPU architecture identifier for runtime platform checks.
+ *
+ * @example
+ * ```ts
+ * import { PlatformArch } from "@beep/schema"
+ *
+ * console.log(PlatformArch.Options.includes("arm64")) // true
+ * console.log(PlatformArch.is.x64("arm64")) // false
+ * ```
+ *
+ * @category validation
+ * @since 0.0.0
+ */
+export const PlatformArch = LiteralKit(["arm64", "x64", "other"]).annotate(
+  $I.annote("PlatformArch", {
+    description: "CPU architecture identifier for runtime platform checks.",
+  })
+);
+
+/**
+ * Type for {@link PlatformArch}. {@inheritDoc PlatformArch}
+ *
+ * @example
+ * ```ts
+ * import { PlatformArch } from "@beep/schema"
+ *
+ * const arch: PlatformArch = PlatformArch.Enum.arm64
+ * console.log(arch) // "arm64"
+ * ```
+ *
+ * @category models
+ * @since 0.0.0
+ */
+export type PlatformArch = typeof PlatformArch.Type;
