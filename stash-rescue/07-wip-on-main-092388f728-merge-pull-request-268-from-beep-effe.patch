@@ -0,0 +1,26 @@
+import * as S from "effect/Schema";
+
+export interface Message<
+	Name extends string,
+	Payload extends S.Top
+> {
+	readonly _tag: "Message";
+	readonly name: Name;
+	readonly schema: Payload;
+}
+
+export const make = <
+	const Name extends string,
+	Payload extends S.Top
+>(options: {
+	readonly name: Name;
+	readonly schema: Payload;
+}): Message<Name, Payload> => ({
+	_tag: "Message",
+	name: options.name,
+	schema: options.schema
+});
+
+export type PayloadOf<T extends AnyMessage> = T["schema"]["Type"];
+
+export type AnyMessage<TSchema extends S.Top = S.Top> = Message<string, TSchema>;
