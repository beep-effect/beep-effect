+import * as Message from "./Message.ts";
+import {Effect} from "effect";
+import * as S from "effect/Schema";
+import * as Driver from "./Driver.ts";
+import * as Errors from "./Errors.ts";
+
+export const publish = Effect.fn("Scratchpad.publish")(function* <
+	const Name extends string,
+	TSchema extends S.Top,
+>(
+	message: Message.Message<Name, TSchema>,
+	payload: TSchema["Type"],
+) {
+	const driver = yield* Driver.Driver;
+
+	const validatedPayload = yield* S.decodeUnknownEffect(message.schema)(payload)
+		.pipe(Effect.mapError((cause) => Errors.InvalidMessagePayload.make({
+			messageName: message.name,
+			payload,
+			cause,
+		})));
+
+	yield* driver.publish(message, validatedPayload);
+});
