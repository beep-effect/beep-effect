diff --git a/packages/drivers/libpff/test/integration/Libpff.pffexport.live.test.ts b/packages/drivers/libpff/test/integration/Libpff.pffexport.live.test.ts
new file mode 100644
index 0000000000..84f0c538e5
--- /dev/null
+++ b/packages/drivers/libpff/test/integration/Libpff.pffexport.live.test.ts
@@ -0,0 +1,114 @@
+// Live pffexport lane against an operator-provided PST archive.
+//
+// Opt in by setting BEEP_TEST_PST_PATH to a readable .pst file; the real
+// pffexport binary is resolved from BEEP_TEST_PFFEXPORT_PATH or PATH. No PST
+// fixture is committed because the PST container cannot be synthesized
+// without proprietary tooling; the documented public sample fallback is the
+// EDRM Enron Email Data Set v2 PST distribution
+// (https://edrm.net/resources/data-sets/edrm-enron-email-data-set/), which is
+// public and free to use.
+import { ArtifactLocator, SourceArtifact } from "@beep/file-processing/Artifact";
+import { ExportArchiveOperation } from "@beep/file-processing/Operation";
+import { decodeTestOperationIdentifiers } from "@beep/file-processing/test";
+import { LibpffMessageRecord, makePffexportFileProcessingEngine, PffexportEngineConfig } from "@beep/libpff";
+import { NonNegativeInt } from "@beep/schema";
+import { PosixPath } from "@beep/schema/PosixPath";
+import { provideScopedLayer } from "@beep/test-utils";
+import { O } from "@beep/utils";
+import { NodeChildProcessSpawner, NodeServices } from "@effect/platform-node";
+import { describe, expect, it } from "@effect/vitest";
+import { Config, Effect, FileSystem, Layer, Path } from "effect";
+import * as S from "effect/Schema";
+import * as Str from "effect/String";
+
+const BEEP_TEST_PST_PATH_ENV = "BEEP_TEST_PST_PATH";
+const BEEP_TEST_PFFEXPORT_PATH_ENV = "BEEP_TEST_PFFEXPORT_PATH";
+
+// Snapshot the opt-in lane keys once, treating absent and blank values as
+// "not configured" so the lane no-ops instead of dialing a phantom binary.
+const livePstPath = Config.string(BEEP_TEST_PST_PATH_ENV).pipe(Config.option, Effect.map(O.filter(Str.isNonEmpty)));
+const livePffexportPath = Config.string(BEEP_TEST_PFFEXPORT_PATH_ENV).pipe(
+  Config.option,
+  Effect.map(O.filter(Str.isNonEmpty))
+);
+
+const provideLive = provideScopedLayer(NodeChildProcessSpawner.layer.pipe(Layer.provideMerge(NodeServices.layer)));
+
+const skipNotice = Effect.logInfo(
+  `Skipping the live pffexport lane because ${BEEP_TEST_PST_PATH_ENV} is not configured.`
+);
+
+const decodeMessageRecord = S.decodeUnknownEffect(S.fromJsonString(LibpffMessageRecord));
+
+const liveOperation = Effect.fn("LibpffLive.operation")(function* (pstPath: string) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const stat = yield* fs.stat(pstPath);
+  const name = path.basename(pstPath);
+
+  const { artifactId, digest, operationId } = yield* decodeTestOperationIdentifiers();
+  const locatorValue = yield* S.decodeUnknownEffect(PosixPath)(pstPath.split(path.sep).join("/"));
+  const relativePath = yield* S.decodeUnknownEffect(PosixPath)(name);
+
+  return ExportArchiveOperation.make({
+    format: "pst",
+    operationId,
+    operationKind: "export-archive",
+    preference: { engine: "libpff" },
+    source: SourceArtifact.make({
+      digest,
+      extension: "pst",
+      id: artifactId,
+      locator: ArtifactLocator.make({ kind: "file", value: locatorValue }),
+      name,
+      relativePath,
+      sizeBytes: NonNegativeInt.make(Number(stat.size)),
+    }),
+  });
+});
+
+describe("pffexport live lane", () => {
+  it.effect(
+    "exports a real PST through the host pffexport binary",
+    Effect.fnUntraced(
+      function* () {
+        const pstPath = yield* livePstPath;
+        if (O.isNone(pstPath)) {
+          yield* skipNotice;
+          return;
+        }
+
+        const fs = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const exportRoot = yield* fs.makeTempDirectoryScoped({ prefix: "libpff-pffexport-live-" });
+        const pffexportPath = yield* livePffexportPath;
+
+        const engine = yield* makePffexportFileProcessingEngine(
+          PffexportEngineConfig.make({
+            exportRoot,
+            ...O.getSomesStruct({ pffexportPath }),
+          })
+        );
+
+        expect(engine.descriptor.version).toBeDefined();
+
+        const operation = yield* liveOperation(pstPath.value);
+        const result = yield* engine.exportArchive(operation);
+
+        expect(result.engine).toBe("libpff");
+        expect(result.children.length).toBeGreaterThan(0);
+
+        const jsonlChild = result.children.find((child) => child.relativePath.endsWith("messages.jsonl"));
+        if (jsonlChild !== undefined) {
+          const content = yield* fs.readFileString(path.join(exportRoot, jsonlChild.relativePath));
+          const lines = content.split("\n").filter((line) => Str.isNonEmpty(Str.trim(line)));
+          expect(lines.length).toBeGreaterThan(0);
+          const records = yield* Effect.forEach(lines, (line) => decodeMessageRecord(line));
+          expect(records.length).toBe(lines.length);
+        }
+      },
+      Effect.scoped,
+      provideLive
+    )
+  );
+});
