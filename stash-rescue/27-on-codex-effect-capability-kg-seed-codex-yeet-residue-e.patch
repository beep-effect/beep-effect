+const getTagsByName = (
+  sourcePath: string,
+  jsDocs: ReadonlyArray<JSDoc>,
+  tagName: string
+): ReadonlyArray<EffectCapabilityDocTag> =>
+  pipe(
+    jsDocs,
+    A.flatMap((jsDoc) => jsDoc.getTags()),
+    A.filter((tag) => tag.getTagName() === tagName),
+    A.map((tag) => makeDocTag(sourcePath, tag))
+  );
