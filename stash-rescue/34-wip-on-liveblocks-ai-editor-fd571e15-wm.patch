+import * as Context from "effect/Context";
+import {$TodoxId} from "@beep/identity/packages";
+import {Liveblocks} from "@liveblocks/node";
+import {serverEnv} from "@beep/shared-env/ServerEnv";
+import * as Redacted from "effect/Redacted";
+import * as F from "effect/Function";
+import * as Layer from "effect/Layer";
+import * as S from "effect/Schema";
+const $I = $TodoxId.create("liveblocks-ai-editor/services/liveblocks");
+
+export interface Shape extends Liveblocks {
+}
+
+export class Service extends Context.Tag($I`Service`)<Service, Shape>() {
+}
+
+
+export const layer: Layer.Layer<Service, never, never> = F.pipe(
+  Service.of(new Liveblocks({
+    secret: Redacted.value(serverEnv.liveblocks.secretKey),
+  })),
+  Layer.succeed(Service)
+);
+
+
+export class Error extends S.TaggedError<Error>($I`LiveBlocksError`)(
+  "LiveBlocksError",
+  {
+    cause: S.Defect,
+    status: S.Number,
+    details: S.optionalWith(S.String, { as: "Option"}),
+    message: S.String,
+  },
+  $I.annotations(
+    "LiveBlocksError",
+    {
+      description: "LiveBlocks error",
+    }
+  )
+) {}
