+import { $TodoxId} from "@beep/identity/packages";
+import * as Context from "effect/Context";
+import type * as Effect from "effect/Effect";
+import type * as O from "effect/Option";
+import * as S from "effect/Schema";
+import type { Models } from "../../models";
+import type * as LiveBlocksClient from "./LiveBlocksClient";
+
+const $I = $TodoxId.create("liveblocks-ai-editor/services/liveblocks");
+
+export class CreateRoomPayload extends S.Class<CreateRoomPayload>($I`CreateRoomPayload`)(
+  {
+    name: S.optionalWith(S.String, {
+      default: () => "Untitled Document"
+    })
+  },
+  $I.annotations(
+    "CreateRoomPayload",
+    {
+      description: "Payload for creating a room",
+    }
+  )
+) {}
+
+
+export class GetRoomsPayload extends S.Class<GetRoomsPayload>($I`GetRoomsPayload`)(
+  {
+
+    cursor: S.optionalWith(S.OptionFromNonEmptyTrimmedString, {
+      as: "Option"
+    }),
+    limit: S.optionalWith(S.NonNegativeInt, {
+      as: "Option"
+    })
+  },
+  $I.annotations(
+    "GetRoomsPayload",
+    {
+      description: "Payload for creating a room",
+    }
+  )
+) {}
+
+export class GetRoomTitle extends S.Class<GetRoomTitle>($I`GetRoomTitle`)(
+  {
+    roomId: S.String
+  },
+  $I.annotations(
+    "GetRoomTitle",
+    {
+      description: "Payload for getting a room title",
+    }
+  )
+) {}
+
+export interface Shape {
+  readonly getLatestRoom: () => Effect.Effect<O.Option<Models.TypedRoomData>, LiveBlocksClient.Error, LiveBlocksClient.Service>
+  readonly createRoom: (payload: CreateRoomPayload) => Effect.Effect<Models.TypedRoomData, LiveBlocksClient.Error, LiveBlocksClient.Service>
+  readonly getRooms: (payload: GetRoomsPayload) => Effect.Effect<{
+    readonly rooms: Models.TypedRoomData[],
+    readonly nextCursor: O.Option<string>
+  }>
+  readonly getRoomTitle: (payload: GetRoomTitle) => Effect.Effect<string, LiveBlocksClient.Error, LiveBlocksClient.Service>
+}
+
+export class Service extends Context.Tag($I`Service`)<Service, Shape>() {
+}
+
