-        area.releasePointerCapture(event.pointerId);
-      }}
-    >
-      <div className="absolute inset-0 overflow-hidden rounded-sm">
-        <div
-          className="absolute inset-0"
-          style={{
-            backgroundColor: `rgb(${backgroundHue.r}, ${backgroundHue.g}, ${backgroundHue.b})`,
