- */
-const parseAtomKey = (key: string): { delayMs: number; maxWaitMs: number | null } => {
-  const parts = Str.split("-")(key);
-  const delayMs = Number(parts[0]);
-  const maxWaitMs = parts[1] === "null" ? null : Number(parts[1]);
-  return { delayMs, maxWaitMs };
-};
