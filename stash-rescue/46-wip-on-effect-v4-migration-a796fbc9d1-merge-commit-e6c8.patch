-const digitToBasic = (digit: number, flag: number): number => {
-  //  0..25 map to ASCII a..z or A..Z
-  // 26..35 map to ASCII 0..9
-  return digit + 22 + 75 * Number(digit < 26) - ((flag !== 0 ? 1 : 0) << 5);
-};
