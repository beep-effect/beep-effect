# CQ-008: Which contended resources exist, and which ACTIVE seat grants currently hold each? (queued waiters are SeatRequests — CQ-021's question, never a grant state)
# Expected: non_empty | priority: must_have | derivation: direct_lookup
# GENERATED from competency-questions.yaml by regen_cq_artifacts.py — do not hand-edit.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ciops: <https://oip.law/ontology/ci-ops#>
SELECT ?res ?grant WHERE {
  ?res rdf:type ciops:ContendedResource .
  ?grant rdf:type ciops:SeatGrant ;
         ciops:contendsFor ?res ;
         ciops:hasGrantState ciops:ActiveGrant .
}
