# CQ-007: For a given episode, what is the time-to-certainty and its decomposition into queue wait, lock wait, execution, repair gap, and CI wait?
# Expected: non_empty | priority: must_have | derivation: direct_lookup
# GENERATED from competency-questions.yaml by regen_cq_artifacts.py — do not hand-edit.
PREFIX ciops: <https://oip.law/ontology/ci-ops#>
SELECT ?ep ?total ?queue ?lock ?exec ?repair ?ci WHERE {
  VALUES ?ep { ciops:ep-example }  # harness binds
  ?ep ciops:timeToCertaintyMs ?total ;
      ciops:queueWaitMs ?queue ;
      ciops:lockWaitMs ?lock ; ciops:executionMs ?exec ;
      ciops:repairGapMs ?repair ; ciops:ciWaitMs ?ci .
}
