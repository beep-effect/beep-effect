# CQ-010: Was any WorkUnit admitted whose admission charge exceeded the remaining token capacity at admission? (deployed-policy invariant; must be zero)
# Expected: zero_rows | priority: must_have | derivation: direct_lookup
# GENERATED from competency-questions.yaml by regen_cq_artifacts.py — do not hand-edit.
PREFIX ciops: <https://oip.law/ontology/ci-ops#>
SELECT ?wu ?charge ?capacity WHERE {
  ?wu ciops:admittedBy ?grant .
  ?grant ciops:admissionChargeTokens ?charge ;
         ciops:capacityAtAdmissionTokens ?capacity .
  FILTER (?charge > ?capacity)
}
