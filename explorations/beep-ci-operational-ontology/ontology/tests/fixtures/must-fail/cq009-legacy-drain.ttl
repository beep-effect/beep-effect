# Falsifiability (run-4 pin, legacy-origin-drain arm; #929 hasLegacySameOriginOwner): an active
# legacy-origin-lock grant and an active current-protocol grant on ONE ORIGIN in DIFFERENT
# checkouts are the deployed-prohibited state — CQ-009 must violate with
# ?arm = "legacy-origin-drain" (rows_ge_1_all_bound).
@prefix ciops: <https://oip.law/ontology/ci-ops#> .
ciops:co-1 a ciops:Checkout .
ciops:co-2 a ciops:Checkout .
ciops:g1 a ciops:SeatGrant ; ciops:hasGrantState ciops:ActiveGrant ;
    ciops:hasOriginKey "same-origin" ; ciops:hasCheckout ciops:co-1 ;
    ciops:hasCoordinationProtocol "legacy-origin-lock/v1" .
ciops:g2 a ciops:SeatGrant ; ciops:hasGrantState ciops:ActiveGrant ;
    ciops:hasOriginKey "same-origin" ; ciops:hasCheckout ciops:co-2 ;
    ciops:hasCoordinationProtocol "scheduler-origin-concurrency/v1" .
