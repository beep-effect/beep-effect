# Falsifiability (the demoted heuristic screen): an admitted WorkUnit whose predicted
# p95 exceeds the advisory soft budget must surface — a smell, never a guarantee.
@prefix ciops: <https://oip.law/ontology/ci-ops#> .
ciops:wu-slow ciops:admittedBy ciops:g-x ; ciops:hasCostEstimate ciops:ce-slow .
ciops:ce-slow ciops:p95Ms 1200000 .
ciops:g-x ciops:hasBudget ciops:b-x .
ciops:b-x ciops:softP95BudgetMs 900000 .
