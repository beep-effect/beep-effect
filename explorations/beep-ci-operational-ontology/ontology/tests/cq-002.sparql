# CQ-002: Which WorkUnits (lane x scope) are admissible for a given episode's diff and target tier?
# Expected: non_empty | priority: must_have | derivation: inference
# GENERATED from competency-questions.yaml by regen_cq_artifacts.py — do not hand-edit.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ciops: <https://oip.law/ontology/ci-ops#>
SELECT ?workUnit ?lane ?tier WHERE {
  VALUES ?episode { ciops:ep-example }  # harness binds
  ?workUnit rdf:type ciops:WorkUnit ;
            ciops:admissibleFor ?episode ;
            ciops:executesLane ?lane .
  ?episode ciops:targetsTier ?tier .
  ?tier ciops:requiresLane ?lane .
}
