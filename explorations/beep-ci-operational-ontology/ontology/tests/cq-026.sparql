# CQ-026: Does any admitted WorkUnit's predicted P95 duration exceed its budget's soft P95 screen? (heuristic screen, explicitly NON-GUARANTEE — a distribution fact compared to an advisory budget, never a hard limit)
# Expected: zero_rows | priority: should_have | derivation: direct_lookup
# GENERATED from competency-questions.yaml by regen_cq_artifacts.py — do not hand-edit.
PREFIX ciops: <https://oip.law/ontology/ci-ops#>
SELECT ?grant ?p95 ?softMax WHERE {
  ?grant ciops:usedCostEstimate ?c .
  ?c ciops:p95Ms ?p95 .
  ?grant ciops:hasBudget ?b . ?b ciops:softP95BudgetMs ?softMax .
  FILTER ( !isNumeric(?p95) || !isNumeric(?softMax) || ?p95 > ?softMax )
}
