# CQ-011: What invalidation events occurred in a window, and what is each one's blast radius (lanes x packages)?
# Expected: non_empty | priority: must_have | derivation: inference
# GENERATED from competency-questions.yaml by regen_cq_artifacts.py — do not hand-edit.
PREFIX ciops: <https://oip.law/ontology/ci-ops#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?event ?lane ?pkg WHERE {
  VALUES (?since ?until) { ("2026-08-01T00:00:00Z"^^xsd:dateTime "2026-08-31T23:59:59Z"^^xsd:dateTime) }  # harness binds
  ?event ciops:occurredAt ?at .
  FILTER (?at >= ?since && ?at <= ?until)
  ?event ciops:touchesHashSurface ?surface .
  ?surface ciops:feedsLane ?lane .
  ?event ciops:radiatesToPackage ?pkg .
}
