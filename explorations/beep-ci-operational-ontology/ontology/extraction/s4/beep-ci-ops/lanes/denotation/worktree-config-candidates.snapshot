  decision_relevance: Defines the doctrine against which the Fallow dead-code lane can report a BoundaryViolation.
  evidence:
  - standards/ARCHITECTURE.md:3-7 — 'If a proposed slice, package, adapter, or dependency contradicts
    this document, the proposal must change or this document must be amended.'
  - standards/ARCHITECTURE.md:255-270 — 'Forbidden by default'
  already_in_glossary: false
  status: candidate
  source_lanes:
  - s4-fallow-laws
