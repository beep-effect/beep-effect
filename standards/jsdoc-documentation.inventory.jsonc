        {
          "symbolName": "export {\n  /**\n   * Experiment execution report wrapping the canonical SHACL validation result.\n   *\n   * **Example** (Use index)\n   * ```ts\n   * import { ShaclValidationReport } from \"@effect-ontology/Schema/index\"\n   * console.log(ShaclValidationReport)\n   * ```\n   *\n   * @category validation\n   * @since 0.0.0\n   */\n  ShaclValidationReport,\n} from \"./Shacl.ts\";",
