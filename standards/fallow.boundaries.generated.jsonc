    "rules": [
      {
        "from": "@beep/acp",
        "allow": [
          "@beep/acp",
          "@beep/codegen-kit",
          "@beep/identity",
          "@beep/schema",
          "@beep/test-utils",
          "@beep/utils"
        ],
        "allowTypeOnly": [
          "@beep/acp",
          "@beep/codegen-kit",
          "@beep/identity",
          "@beep/schema",
          "@beep/test-utils",
          "@beep/utils"
        ]
      },
      {
        "from": "@beep/agents-client",
        "allow": [
          "@beep/agents-client",
          "@beep/agents-domain",
          "@beep/agents-use-cases",
          "@beep/identity",
          "@beep/md",
          "@beep/observability",
          "@beep/schema",
          "@beep/shared-domain",
          "@beep/test-utils",
          "@beep/utils",
          "@beep/workspace-use-cases"
        ],
        "allowTypeOnly": [
          "@beep/agents-client",
          "@beep/agents-domain",
          "@beep/agents-use-cases",
          "@beep/identity",
          "@beep/md",
          "@beep/observability",
          "@beep/schema",
          "@beep/shared-domain",
          "@beep/test-utils",
          "@beep/utils",
          "@beep/workspace-use-cases"
        ]
      },
      {
        "from": "@beep/agents-domain",
        "allow": [
          "@beep/agents-domain",
          "@beep/identity",
          "@beep/md",
          "@beep/schema",
          "@beep/shared-domain",
          "@beep/test-utils"
        ],
        "allowTypeOnly": [
          "@beep/agents-domain",
          "@beep/identity",
          "@beep/md",
          "@beep/schema",
          "@beep/shared-domain",
          "@beep/test-utils"
        ]
      },
      {
        "from": "@beep/agents-server",
        "allow": [
          "@beep/agents-domain",
          "@beep/agents-server",
          "@beep/agents-tables",
          "@beep/agents-use-cases",
          "@beep/ai-provider-cli",
          "@beep/anthropic",
          "@beep/identity",
          "@beep/observability",
          "@beep/postgres",
          "@beep/schema",
          "@beep/shared-domain",
          "@beep/test-utils",
          "@beep/utils"
        ],
        "allowTypeOnly": [
          "@beep/agents-domain",
          "@beep/agents-server",
          "@beep/agents-tables",
          "@beep/agents-use-cases",
