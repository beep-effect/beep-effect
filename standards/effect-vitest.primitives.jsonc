    {
      "id": "readme.resource-safety",
      "name": "README:Resource Safety and Scope",
      "kind": "readme-section",
      "file": "packages/vitest/README.md",
      "startLine": 295,
      "endLine": 317,
      "signature": "Resource Safety and Scope",
      "description": "Runner-managed scopes and direct use of scoped resources",
      "whenToUse": "Use for redundant-whole-body-scope findings (EV004, candidate class redundant-whole-body-scope); delete only a whole-body Effect.scoped wrapper and retain deliberate shorter scopes.",
      "whenNotToUse": "Do not remove a nested scope whose early finalization is part of the test.",
      "replaces": ["EV004"],
      "example": "import { it } from \"@effect/vitest\"\nimport { Effect } from \"effect\"\nconst resource = Effect.acquireRelease(Effect.succeed(\"resource\"), () => Effect.void)\nit.effect(\"resource\", () => Effect.asVoid(resource))",
      "gotchas": [
        "Both effect and live already wrap each body in a fresh inner Scope.",
        "A deliberately nested Effect.scoped remains valid when cleanup must happen before the test ends.",
        "Shared layer resources belong to the separate outer block Scope."
      ]
    },
    {
      "id": "readme.flaky",
      "name": "README:Writing Tests with `it.flakyTest`",
      "kind": "readme-section",
      "file": "packages/vitest/README.md",
      "startLine": 318,
      "endLine": 349,
      "signature": "Writing Tests with `it.flakyTest`",
      "description": "Retry helper bounded by recurrence count and elapsed-duration checks between attempts.",
      "whenToUse": "No detector replacement: consult this section only after root-cause analysis identifies external nondeterminism; then record a reason row and follow-up.",
      "whenNotToUse": "Do not use flakyTest for TestClock, event-wait, scope, or deterministic assertion defects, and never treat a longer timeout as the fix.",
      "replaces": [],
      "example": "import { it } from \"@effect/vitest\"\nimport { Effect } from \"effect\"\nit.effect(\"retry\", () => it.flakyTest(Effect.void, \"1 second\"))",
      "gotchas": [
        "Scopes and sandboxes each attempt; Schedule.recurs(10) bounds recurrences (initial attempt plus up to ten retries).",
        "The default duration is 30 seconds; elapsed duration is tested at retry boundaries. This is not a hard deadline that interrupts a hung current attempt.",
        "Remaining failure dies via Effect.orDie. The outer Vitest/D7 timeout remains independently relevant.",
        "Use only after root-cause attribution and a reviewed reason/follow-up; never to hide deterministic faults."
      ]
    },
