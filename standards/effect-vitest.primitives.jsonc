      "signature": "<A, E, R>(\n  self: Effect.Effect<A, E, R | Scope.Scope>,\n  timeout?: Duration.Input\n) => Effect.Effect<A, never, R>",
      "description": "Retry helper bounded by recurrence count and elapsed-duration checks between attempts.",
      "whenToUse": "No detector replacement: use as a first-class retry Effect only after root-cause analysis proves external nondeterminism and a reason/follow-up are recorded.",
      "whenNotToUse": "Do not hide deterministic, TestClock, scope, or event-wait failures.",
