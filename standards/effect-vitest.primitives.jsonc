      "example": "import { fcRuns } from \"@beep/fc-runs\"\nimport { prop, expect } from \"@effect/vitest\"\nimport * as S from \"effect/Schema\"\nprop(\"finite\", { value: S.Int }, ({ value }) => { expect(Number.isInteger(value)).toBe(true) }, { arbitrary: fcRuns(100) })",
      "gotchas": [
