    {
      "id": "Logger.layer",
      "name": "Logger.layer",
      "kind": "function",
      "file": "packages/effect/src/Logger.ts",
      "startLine": 1027,
      "endLine": 1049,
      "signature": "layer = <\n  const Loggers extends ReadonlyArray<Logger<unknown, unknown> | Effect.Effect<Logger<unknown, unknown>, any, any>>\n>(\n  loggers: Loggers,\n  options?: { readonly mergeWithExisting?: boolean | undefined } | undefined\n): Layer.Layer<\n  never,\n  Loggers extends readonly [] ? never : Effect.Error<Loggers[number]>,\n  Exclude<\n    Loggers extends readonly [] ? never : Effect.Services<Loggers[number]>,\n    Scope.Scope\n  >\n> =>\n  Layer.effect(\n    CurrentLoggers,\n    withFiber(effect.fnUntraced(function*(fiber) {\n      const currentLoggers = new Set(options?.mergeWithExisting === true ? fiber.getRef(effect.CurrentLoggers) : [])\n      for (const logger of loggers) {\n        currentLoggers.add(isEffect(logger) ? yield* logger : logger)\n      }\n      return currentLoggers\n    }))\n  )",
      "description": "Creates a Layer that replaces or merges the current logger set.",
      "whenToUse": "No detector replacement: provide a logger layer when logging is the intended behavior under test.",
      "whenNotToUse": "Do not treat logger provision as a reason for live clock or OS services.",
      "replaces": [],
      "example": "import { Effect, Logger } from \"effect\"\nconst program = Effect.log(\"message\").pipe(\n  Effect.provide(Logger.layer([Logger.consolePretty({ colors: false })]))\n)\nvoid program",
      "gotchas": [
        "Set mergeWithExisting only when retaining current loggers is intended."
      ]
    },
    {
      "id": "TestClock.adjust",
      "name": "TestClock.adjust",
      "kind": "function",
      "file": "packages/effect/src/testing/TestClock.ts",
      "startLine": 507,
      "endLine": 508,
      "signature": "adjust = (duration: Duration.Input): Effect.Effect<void> =>\n  testClockWith((testClock) => testClock.adjust(duration))",
      "description": "Advances the deterministic TestClock and wakes due effects.",
      "whenToUse": "Use for shared-test-clock-adjustment judgments (EV015, candidate class shared-test-clock-adjustment) to review ownership of a shared deterministic clock and forked work before advancing it. Preserve deterministic timeout subjects; prove serial ownership or isolate test services before considering a reset.",
      "whenNotToUse": "Do not use under live or treat shared setTime/reset as isolation: it mutates the shared clock and may wake other tests' sleepers. A beforeEach reset is not an unconditional repair, and single-test or nested layer blocks are not exempt from parent clock ownership review.",
      "replaces": ["EV015"],
      "example": "import { Effect } from \"effect\"\nimport * as TestClock from \"effect/testing/TestClock\"\n// Review shared clock ownership first; this work requires isolated test services\n// or proved serial ownership. Shared setTime/reset is mutation, not isolation.\nconst program = Effect.gen(function* () {\n  const fiber = yield* Effect.sleep(\"1 second\").pipe(Effect.forkChild)\n  yield* TestClock.adjust(\"1 second\")\n  return fiber\n})\nvoid program",
      "gotchas": [
        "it.effect gets a fresh TestClock, while default it.layer shares one across the block.",
        "Adjust can wake every due sleep registered on that shared clock."
      ]
    },
    {
      "id": "TestClock.withLive",
      "name": "TestClock.withLive",
      "kind": "function",
      "file": "packages/effect/src/testing/TestClock.ts",
      "startLine": 580,
      "endLine": 581,
      "signature": "withLive = <A, E, R>(effect: Effect.Effect<A, E, R>): Effect.Effect<A, E, R> =>\n  testClockWith((testClock) => testClock.withLive(effect))",
      "description": "Runs one Effect with the live Clock while retaining the surrounding test environment.",
      "whenToUse": "Use for test-clock-stall-risk findings (EV008, candidate class test-clock-stall-risk) only when a bounded external-system wait actually requires live time. Wrap that wait, including its timeout, with TestClock.withLive while retaining the surrounding test clock. Effect and default layer testers install TestClock; explicit provision can supply one elsewhere. Diagnose the wait's root cause first (D6).",
      "whenNotToUse": "Do not use live time to evade driving deterministic virtual work, hide a stall, or enlarge timeouts without diagnosis. A sibling withLive does not drive an unrelated virtual wait. Do not call when TestClock is absent, as by default under live or excludeTestServices, or use it as an unconditional watchdog across tester modes.",
      "replaces": ["EV008"],
      "example": "import { Effect, Schedule } from \"effect\"\nimport * as TestClock from \"effect/testing/TestClock\"\nconst waitForExternal = (poll: Effect.Effect<boolean>) => poll.pipe(\n  Effect.repeat({ until: (ready) => ready, schedule: Schedule.spaced(\"10 millis\") }),\n  Effect.timeout(\"1 second\"),\n  TestClock.withLive\n)\nvoid waitForExternal",
      "gotchas": [
        "The implementation casts the current Clock to TestClock.",
        "It does not advance shared test time.",
        "A D7 watchdog must select plain live sleep when TestClock is absent rather than assuming TestClock.withLive is universally available."
      ]
    },
    {
