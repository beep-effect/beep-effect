      "signature": "export interface Tester<R> extends Vitest.Test<R> {\n    skip: Vitest.Test<R>\n    skipIf: (condition: unknown) => Vitest.Test<R>\n    runIf: (condition: unknown) => Vitest.Test<R>\n    only: Vitest.Test<R>\n    each: <T>(\n      cases: ReadonlyArray<T>\n    ) => <A, E>(name: string, self: TestFunction<A, E, R, Array<T>>, timeout?: number | V.TestOptions) => void\n    fails: Vitest.Test<R>\n\n    /**\n     * Runs an Effectful property test using Schema or Arbitrary inputs.\n     *\n     * **Details**\n     *\n     * Returning `false` or completing with any non-interruption failure falsifies the property and triggers shrinking.\n     * This includes typed Effect failures, thrown exceptions, and defects such as failed assertions. Effect\n     * interruption continues to interrupt the test.\n     *\n     * The Vitest timeout interrupts the Effect fiber running generation, property evaluation, and shrinking. Effect\n     * finalizers run during that interruption.\n     *\n     * **Gotchas**\n     *\n     * A timeout cannot preempt a synchronous JavaScript callback that does not return.\n     *\n     * @since 4.0.0\n     */\n    prop: <const Arbs extends Arbitraries, A, E>(\n      name: string,\n      arbitraries: Arbs,\n      self: TestFunction<\n        A,\n        E,\n        R,\n        [\n          {\n            [K in keyof Arbs]: ArbitraryValue<Arbs[K]>\n          },\n          V.TestContext\n        ]\n      >,\n      timeout?:\n        | number\n        | V.TestOptions & {\n          arbitrary?: Arbitrary.CheckOptions\n        }\n    ) => void\n  }",
      "description": "Effect test registrar with selection, cases, failure, and property variants.",
      "whenToUse": "No detector replacement: type Effect-returning testers accepting Schema or native Arbitrary inputs.",
      "whenNotToUse": "Do not use Tester.prop to describe the synchronous MethodsNonLive.prop callback.",
      "replaces": [],
      "example": "import type { Vitest } from \"@effect/vitest\"\ndeclare const tester: Vitest.Tester<never>\nvoid tester.skip",
      "gotchas": [
        "Tester.prop supplies generated values followed by Vitest TestContext.",
        "Tester.each supplies only the selected case arguments, not TestContext."
      ]
    },
