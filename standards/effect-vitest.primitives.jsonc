      "name": "README:Resource Safety and Scope",
      "kind": "readme-section",
      "file": "packages/vitest/README.md",
      "startLine": 257,
      "endLine": 279,
      "signature": "## Resource Safety and Scope",
      "description": "Runner-managed scopes and direct use of scoped resources",
      "whenToUse": "Use for redundant-whole-body-scope findings (EV004, candidate class redundant-whole-body-scope); delete only a whole-body Effect.scoped wrapper and retain deliberate shorter scopes.",
      "whenNotToUse": "Do not remove a nested scope whose early finalization is part of the test.",
      "replaces": ["EV004"],
      "example": "import { it } from \"@effect/vitest\"\nimport { Effect } from \"effect\"\nconst resource = Effect.acquireRelease(Effect.succeed(\"resource\"), () => Effect.void)\nit.effect(\"resource\", () => Effect.asVoid(resource))",
      "gotchas": [
        "Both effect and live already wrap each body in a fresh inner Scope.",
        "A deliberately nested Effect.scoped remains valid when cleanup must happen before the test ends.",
        "Shared layer resources belong to the separate outer block Scope."
      ]
    },
