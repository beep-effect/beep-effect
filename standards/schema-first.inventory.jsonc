    },
    {
      "file": "packages/foundation/modeling/ontology/src/Fold.models.ts",
      "symbol": "TypedLiteral",
      "kind": "exported-type-literal",
      "status": "exception",
      "owner": "@beep/ontology",
      "reason": "Compile-time authoring grammar: datatype is the Curie<CoreVocab> | AbsoluteIri closed literal union, which a runtime schema cannot express without widening to string and losing the typo-is-a-compile-error property (D3). The runtime validation lives in the internal TypedLiteralValue schema inside TripleValue."
    },
