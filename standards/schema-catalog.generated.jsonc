    {
      "file": "packages/foundation/modeling/schema/src/HttpMethod/HttpMethod.schema.ts",
      "symbol": "HttpMethod_",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpMethodLiteral",
      "description": "Base literal kit for all supported HTTP method tokens."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpProtocol/HttpProtocol.schema.ts",
      "symbol": "HttpProtocol",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpProtocol",
      "description": "An HTTP protocol (\"http\" or \"https\")"
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpProtocol/HttpProtocol.schema.ts",
      "symbol": "Schema",
      "kind": "literal-kit",
      "owner": "@beep/schema"
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.category.ts",
      "symbol": "HttpStatusCategory",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpStatusCategory",
      "description": "HTTP status code category"
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "BadRequest",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "BadRequest",
      "description": "400 “Bad Request” – The server can’t return a valid response due to an error\nfrom the client’s side. Common causes are URLs with invalid syntax, deceptive\nrequest routing, large file size, etc."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "Conflict",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Conflict",
      "description": "409 “Conflict” – This error occurs when a request can not be processed due\nto a conflict in the current state of the resource on the server. An example\nof this error is when multiple edits of the same file are submitted to the\nserver and the edits conflict with each other."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "Forbidden",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Forbidden",
      "description": "403 “Forbidden” – The error indicates that the server denies access to the\nuser agent that doesn’t have permission to access the resources. This error\nis similar to HTTP code 401, but the difference is that in this case, the\nidentity of the user agent is known.\nTypical causes of this error are restrictive rules from the website’s\nserver, insufficient permissions for the website’s files and folders, etc.\nFor more information, read this article about the HTTP 403 error and how to\nfix it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "MethodNotAllowed",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "MethodNotAllowed",
      "description": "405 “Method Not Allowed” – The server understands the requested method, but\nthe target resource doesn’t support it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "NotAcceptable",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "NotAcceptable",
      "description": "406 “Not Acceptable” – The requested resource generated content that doesn’t\nmeet the criteria of the user-agent who requested it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "NotFound",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "NotFound",
      "description": "404 “Not found” – This is the most frequent error users see online. It means\nthat the server can’t find the requested resource. Usually, the cause is\nthat the URL you’re trying to access doesn’t exist.\nThe error could also be caused by a website misconfiguration. Read the\nfollowing guide for troubleshooting the HTTP error 404."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "PaymentRequired",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "PaymentRequired",
      "description": "402 “Payment Required” – This is not a standard code however it is reserved\nto be used in the future by payment systems. The purpose of the code is to\nindicate that the content is not available due to a failed payment."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "ProxyAuthenticationRequired",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "ProxyAuthenticationRequired",
      "description": "407 “Proxy Authentication Required” – There is a proxy server used in the\ncommunication between the browser and the server and it requires\nauthentication."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "RequestTimeout",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "RequestTimeout",
      "description": "408 “Request Timeout” – The server closed due to a time-out while waiting\nfor a request from your browser. In some cases, servers may send this\nmessage on an idle connection even without any previous request from the\nclient.\nIt should be noted that servers may close the connection without sending a\nmessage."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.core.ts",
      "symbol": "Unauthorized",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Unauthorized"
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "FailedDependency",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "FailedDependency",
      "description": "424 “Failed Dependency” – The request failed because it depended on another\nrequest that failed as well."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "Locked",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Locked",
      "description": "423 “Locked” – The resource that is being accessed is locked."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "MisdirectedRequest",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "MisdirectedRequest",
      "description": "421 “Misdirected Request” – The request was directed to a server unable to\nproduce a response."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "PreconditionRequired",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "PreconditionRequired",
      "description": "428 “Precondition Required” – The server requires the request to be\nconditional. In most cases, this response is used to prevent conflicts when\na client uses the GET method to request a resource, modifies it, and then\nuses PUT to upload the new version while another party may have also altered\nthe same resource."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "RequestHeaderFieldsTooLarge",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "RequestHeaderFieldsTooLarge",
      "description": "431 “Request Header Fields Too Large” – The server can’t process the request\nbecause its individual header fields or all combined header fields are too\nlarge. The client may submit a new request if the size is reduced."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "TooEarly",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "TooEarly",
      "description": "425 “Too Early” – This error indicates that the server is unwilling to risk\nprocessing a request that might be replayed."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "TooManyRequests",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "TooManyRequests",
      "description": "429 “Too many requests” – The server responds with this code when the user\nagent has sent too many requests in the given time and has exceeded the rate\nlimit.\nYou may see this error on your WordPress website if bad bots or scripts\nattempt to access the dashboard. In that case, changing the login URL is\nrecommended which can be easily done from the Login Security settings of the\nSecurity Optimizer plugin.\nYou may also see this error when you try to install a Let’s Encrypt SSL, but\nyou’ve accumulated too many failed requests. For more information, read this\nguide: Let’s Encrypt errors “429 Too Many Requests”, “No Domains\nAuthorized,” and “Certificate is not for the chosen domain.”"
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "UnavailableForLegalReasons",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "UnavailableForLegalReasons",
      "description": "451 “Unavailable for Legal Reasons” – The client requests a resource for\nwhich the server is legally bound to deny access, such as a web page\ncensored by the government."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "UnprocessableEntity",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "UnprocessableEntity",
      "description": "422 “Unprocessable Entity” – The request from the client is well-formed but\nit contains semantic errors that prevent the server from processing a\nresponse. If you stumble upon this error, check out our article about the\n422 Error Code."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.extended.ts",
      "symbol": "UpgradeRequired",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "UpgradeRequired",
      "description": "426 “Upgrade Required” – The server refuses the request using the current\nprotocols as indicated by the upgrade header sent in response. It is willing\nto accept the request if the client upgrades to another protocol."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "ExpectationFailed",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "ExpectationFailed",
      "description": "417 “Expectation Failed” – The server fails to meet the requirements set in\nthe request’s expected header field."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "Gone",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Gone",
      "description": "410 “Gone” – The requested resource is not available and will not be\navailable in the future. It is not replaced with a new resource on a new\naddress so clients are expected to remove any links and cache related to the\nresource. For example, search engines should remove the resource’s\ninformation from their databases."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "ImATeapot",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "ImATeapot",
      "description": "418 “I’m a teapot.” – This error is returned by teapots requested to brew\ncoffee. It is an April’s Fool joke dating back to 1998."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "LengthRequired",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "LengthRequired",
      "description": "411 “Length Required” – The length of the request’s content is not specified\nand the resource on the server requires it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "PayloadTooLarge",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "PayloadTooLarge",
      "description": "413 “Payload too large” – The request is larger than the limits specified on\nthe server, thus the server can not process the request.\nYou may see this error on your WordPress site when you try to upload a file\nand its size exceeds the upload limit of your website. If you encounter this\nproblem, read this guide about the “413 Entity Too Large” Error in\nWordPress."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "PreconditionFailed",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "PreconditionFailed",
      "description": "412 “Precondition failed” – The headers of the request specify certain\npreconditions that the server fails to meet."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "RangeNotSatisfiable",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "RangeNotSatisfiable",
      "description": "416 “Range Not Satisfiable” – The request asked for a portion of the\nresource that the server can’t provide. This error can occur when your\nbrowser asks for a portion of a file that is outside of the end of the file."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "UnsupportedMediaType",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "UnsupportedMediaType",
      "description": "415 “Unsupported Media Type” – The request contains a media type that the\nserver doesn’t support. For instance, you try to upload an image file in\n.jpg format, but the server doesn’t support it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.resource.ts",
      "symbol": "UriTooLong",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "UriTooLong",
      "description": "414 “URI Too Long” – The length of the URI is too long and the server can’t\nprocess it. Usually, this is the result of a GET request containing too much\ndata and therefore must be changed to a POST request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.client-error.ts",
      "symbol": "HttpStatus4XX",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpStatus4XX"
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.informational.ts",
      "symbol": "Continue",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Continue",
      "description": "100 “Continue” – The server has received the headers of the request.\nIt now tells your browser to proceed with sending the body of the request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.informational.ts",
      "symbol": "EarlyHints",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "EarlyHints",
      "description": "103 “Early Hints” – The server returns some response headers before the\nfinal HTTP response is sent."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.informational.ts",
      "symbol": "HttpStatus1XX",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpStatus1XX",
      "description": "1XX codes are informational responses from the website’s server. They do not\ngenerate content and only update clients on the progress of their requests.\nThis information is sent in the headers of the HTTP response."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.informational.ts",
      "symbol": "Processing",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Processing",
      "description": "102 “Processing” – This is a response mainly associated with WebDAV\nrequests, which may take a longer time to be completed. It indicates that\nthe server has received the request and is currently processing it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.informational.ts",
      "symbol": "SwitchingProtocols",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "SwitchingProtocols",
      "description": "101 “Switching Protocols” – The requesting client (browser) asked the server\nto change the protocols, and the server fulfilled the request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "Found",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Found",
      "description": "302 “Found” – Previously, this code was known as “Moved temporarily”. It\ninstructs browsers that the requested resource is moved temporarily to a new\nURL, but the new address may be changed again in the future. Thus, the\noriginal URL should still be used by the client. The code is used for\ntemporary redirects."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "HttpStatus3XX",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpStatus3XX",
      "description": "3XX codes specify that there will be a redirection. {@link https://www.siteground.com/kb/domain-redirects/ | Redirects} are\ncommonly\nused when a resource is moved to a new address. The different 3XX codes instruct\nbrowsers on how the redirect must be performed."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "MovedPermanently",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "MovedPermanently",
      "description": "301 “Moved Permanently” – This is the code for a permanent redirect. It means that the URL of the requested resource is permanently replaced with a new address, and search engines should update the URL in their databases.\nYou learn more about it from our article on 301 redirects."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "MultipleChoices",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "MultipleChoices"
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "NotModified",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "NotModified",
      "description": "304 “Not Modified” – The server informs your browser that the resource\nhasn’t been altered since the last time you requested it. Your browser can\nkeep using the cached version it already stores locally. Clearing the\nbrowser cache usually solves this error."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "PermanentRedirect",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "PermanentRedirect",
      "description": "308 “Permanent Redirect” – The requested resource is permanently moved to\nanother URL and all future requests must be redirected to the new address.\nThe code is similar to the HTTP 302 code, the only difference being that it\ndoesn’t allow browsers to change the type of HTTP request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "SeeOther",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "SeeOther",
      "description": "303 “See Other” – The server instructs the client that it found the\nresource, but it has to be retrieved on another URL with a GET request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "SwitchProxy",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "SwitchProxy",
      "description": "306 “Switch Proxy” – This code is no longer in use. It means that the\nfollowing requests should use the specified proxy."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "TemporaryRedirect",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "TemporaryRedirect",
      "description": "307 “Temporary redirect” – This is the new code for temporary redirects that\nreplaced the HTTP 302 code. It specifies that the requested resource has\nmoved to another URL. Unlike the HTTP 302 code, the HTTP 307 code doesn’t\nallow the HTTP method to be changed. For example, if the first request was\nGET, the second request should be GET as well."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.redirection.ts",
      "symbol": "UseProxy",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "UseProxy",
      "description": "305 “Use Proxy” – The requested resource is available only through a proxy.\nThis code is now deprecated and browsers disregard it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.schema.ts",
      "symbol": "HttpStatus",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpStatus",
      "description": "A MappedLiteralKit of all HTTP status codes."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.schema.ts",
      "symbol": "Schema",
      "kind": "literal-kit",
      "owner": "@beep/schema"
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.aggregate.ts",
      "symbol": "HttpStatus5XX",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpStatus5XX",
      "description": "The 5XX HTTP codes indicate that there is a problem on the website’s server that prevents it from processing a request. Like the 4XX codes, you will see an error page on your browser when a 5XX error is triggered."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "BadGateway",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "BadGateway",
      "description": "502 “Bad Gateway” – This error indicates that the server acted as a gateway\nor a proxy and received an invalid response from the upstream server. This\nis the official description, but various factors can cause this error. Find\nout more about the HTTP 502 “Bad Gateway” error and how to fix it here."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "GatewayTimeout",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "GatewayTimeout",
      "description": "504 “Gateway Timeout” – The server acted as a gateway and did not receive a\ntimely response from the upstream server. In most cases, this error is\ncaused by PHP scripts that don’t finish in time and exceed the server’s\nmax_execution_time PHP variable timeout limit, hence the server terminates\nthe connection. See more details in this article about the HTTP 504\n“Gateway Timeout” and how to fix it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "HttpVersionNotSupported",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "HttpVersionNotSupported",
      "description": "505 “HTTP Version Not Supported” – The server doesn’t support the HTTP\nprotocol version used in the request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "InsufficientStorage",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "InsufficientStorage",
      "description": "507 “Insufficient Storage” (WebDAV) – The server is unable to store the\nrepresentation required to complete the request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "InternalServerError",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "InternalServerError",
      "description": "500 “Internal Server Error” – This is a generic error that indicates the\nserver encountered an unexpected condition and can’t fulfill the request.\nThe server tells you there is something wrong, but it is not sure what the\nproblem is. Usually, the issue stems from the website configuration on\nthe client’s side. Read this tutorial on {@link https://www.siteground.com/kb/internal_server_error_500/ | what an “HTTP Error 500 –\nInternal Server Error” is and how to fix it} for more information."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "LoopDetected",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "LoopDetected",
      "description": "508 “Loop Detected” (WebDAV) – The server detected an infinite loop while\nprocessing the request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "NetworkAuthenticationRequired",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "NetworkAuthenticationRequired",
      "description": "511 “Network Authentication Required” – This response is sent when you need\nto be authenticated so the network can send your request to a server. Most\ncommonly, it is seen when trying to use a Wi-Fi network, and you need to\nagree to its Terms of Agreement."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "NotExtended",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "NotExtended",
      "description": "510 “Not Extended” – Further extensions to the request are required for the\nserver to fulfill it. This code is now deprecated."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "NotImplemented",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "NotImplemented",
      "description": "501 “Not Implemented” – The server doesn’t support the request method or doesn’t have the ability to fulfill the request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "ServiceUnavailable",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "ServiceUnavailable",
      "description": "503 “Service Unavailable” – The server can’t handle the request. This is\nusually a temporary condition caused by overload or ongoing maintenance on\nthe server. Read this guide on what the HTTP 503 “Service Unavailable” error\nis and how to fix it."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.server-error.ts",
      "symbol": "VariantAlsoNegotiates",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "VariantAlsoNegotiates",
      "description": "506 “Variant Also Negotiates” – This error occurs when the client and the\nserver enter into Transparent Content Negotiation, which allows the client\nto retrieve the best variant of a resource when the server supports multiple\nversions. However, there is a misconfiguration, and the chosen resource also\nprompts content negotiation that causes a closed loop."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "Accepted",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Accepted",
      "description": "202 “Accepted” – The server accepted the request but has not yet finished\nprocessing it. The request might be fulfilled or rejected, but the outcome\nis still undetermined."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "AlreadyReported",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "AlreadyReported",
      "description": "208 “Already Reported” (WebDav) – This code indicates that the internal\nmembers of a DAV binding were already enumerated in a previous part of the\nresponse and will not be enumerated again."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "Created",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Created",
      "description": "201 “Created” – The request was fulfilled, and the server created a new resource."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "HttpStatus2XX",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpStatus2XX",
      "description": "The 2XX codes are the best responses you can receive. They indicate that the\nrequest was recognized by the server, was accepted, and is being processed."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "ImUsed",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "ImUsed",
      "description": "226 “IM Used” – The server fulfilled the request, and the response is a\nrepresentation of the result of one or more instance manipulations applied\nto the current instance."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "MultiStatus",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "MultiStatus",
      "description": "207 “Multi-Status” – A code associated with WebDav when a compound request\nis made. The server returns a message containing an array of response codes\nfor all sub-requests."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "NoContent",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "NoContent",
      "description": "204 “No Content” – The server fulfilled the request but won’t return any content."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "NonAuthoritativeInformation",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "NonAuthoritativeInformation",
      "description": "203 “Non-Authoritative Information” – A code that usually appears when a\nproxy service is used. The proxy server received a 200 “OK” status code\nfrom the origin server and returns a modified version of the origin’s\nresponse."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "Ok",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "Ok",
      "description": "200 “OK” – The response for a successful HTTP request. The result will depend on the type of request."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "PartialContent",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "PartialContent",
      "description": "206 “Partial Content” – The server returns only a portion of the requested\nresources because your browser uses “range headers”. These headers allow\nbrowsers to resume downloads or split downloads into multiple simultaneous\nstreams."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.success.ts",
      "symbol": "ResetContent",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "ResetContent",
      "description": "205 “Reset Content” – The server fulfilled the request, and it won’t return\nany content but asks the client (browser) to reset the document view."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.aggregate.ts",
      "symbol": "HttpStatusUnofficial",
      "kind": "literal-kit",
      "owner": "@beep/schema",
      "identity": "HttpStatusUnofficial",
      "description": "The codes above are officially recognized by IANA, but different platforms\nuse unofficial HTTP codes to indicate specific problems related to their\nservices. The following codes are used in some of the most popular online\nservices."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "ClientClosedRequest",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "ClientClosedRequest",
      "description": "499 “Client Closed Request” – The client terminated the request before the\nserver could send a response. Another code used by NGINX."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "InvalidSslCertificate",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "InvalidSslCertificate",
      "description": "526 “Invalid SSL Certificate” – Another code mostly used by Cloudflare.\nCloudflare could not validate the SSL installed on the origin server.\nUsually, caused by invalid or missing SSL on the origin server. Read this\nguide on how to install Let’s Encrypt for your SiteGround-hosted website."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "LoginTimeout",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "LoginTimeout",
      "description": "440 “Login Time-out” – This code is used by Microsoft’s ISS (Internet\nInformation Services). The client’s login session has expired and they must\nlog in again."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "RequestHeaderFieldsTooLargeShopify",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "RequestHeaderFieldsTooLargeShopify",
      "description": "430 “Request Header Fields Too Large” – This code is used by Shopify when\ntoo many URLs are requested at the same time. It is similar to the HTTP code\n429 “Too many requests”."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "RequestHeaderTooLarge",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "RequestHeaderTooLarge",
      "description": "494 “Request header too large” – used by NGINX. The client has sent too\nlarge of a request or too long of a header line."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "SslCertificateError",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "SslCertificateError",
      "description": "495 “SSL Certificate Error” – This is also a status code used by NGINX\nsignaling that the client has provided an invalid SSL certificate."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "SslCertificateRequired",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "SslCertificateRequired",
      "description": "496 “SSL Certificate Required” – used by NGINX. A client certificate is\nrequired but is not provided."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "SslHandshakeFailed",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "SslHandshakeFailed",
      "description": "525 “SSL Handshake Failed” – Used by Cloudflare. Cloudflare is unable to\nestablish an SSL/TLS handshake with the origin server."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "WebServerIsDown",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "WebServerIsDown",
      "description": "521 “Web Server is Down” – Another Cloudflare-specific error code. The\norigin server refused the connection to Cloudflare. This error could be\ncaused by the origin’s firewall blocking Cloudflare’s IPs."
    },
    {
      "file": "packages/foundation/modeling/schema/src/HttpStatus/HttpStatus.unofficial.ts",
      "symbol": "WebServerReturnedAnUnknownError",
      "kind": "schema-const",
      "owner": "@beep/schema",
      "identity": "WebServerReturnedAnUnknownError",
      "description": "520 “Web Server Returned an Unknown Error” – This is a code used by\nCloudflare. It specifies that the origin server returned an unexpected or\nunknown response to Cloudflare."
    },
