// Regenerate with: bun run beep quality knip --write-baseline
// New packages are covered by knip.jsonc workspace discovery; keep new packages clean or regenerate this baseline in the same PR with reviewer-visible rationale.
{
  "schema_version": 1,
  "command": "bun run knip --reporter json",
  "regeneration_command": "bun run beep quality knip --write-baseline",
  "comparison": "fail-on-growth: current findings must be a subset of the committed baseline",
  "new_package_handling": "New packages are covered by knip.jsonc workspace discovery. Keep new packages free of Knip findings; if an intentional finding is unavoidable, regenerate this baseline in the same PR and document the rationale for review.",
  "normalization": {
    "ordering": "kind,file,name",
    "omitted_fields": ["line", "col", "pos"]
  },
  "check": {
    "total_findings": 2,
    "binaries": 0,
    "dependencies": 0,
    "devDependencies": 1,
    "enumMembers": 0,
    "exports": 0,
    "files": 0,
    "namespaceMembers": 0,
    "optionalPeerDependencies": 0,
    "types": 0,
    "unlisted": 0,
    "unresolved": 1
  },
  "findings": [
    {
      "kind": "devDependencies",
      "file": "packages/drivers/freshbooks/package.json",
