    },
    {
      "rule": "beep-laws/no-native-runtime",
      "file": "scratchpad/effected/markdown/internal/patterns.ts",
      "kind": "new-map-set",
      "reason": "WeakMaps cache sticky and global clones per RegExp object; keys need identity and weak retention, and source/flags keys would alias distinct patterns and share lastIndex.",
      "owner": "@beep/scratchpad",
      "issue": "EFFECTED-MD-REGEX-CLONE-CACHE"
    },
    {
      "rule": "beep-laws/no-native-runtime",
      "file": "scratchpad/effected/memfs/internal/errno.ts",
      "kind": "native-error",
      "reason": "memfs reproduces Node's errno errors: a native Error with code/errno/syscall/path fields. Handle.test.ts asserts these errors carry no _tag, which S.TaggedError would add.",
      "owner": "@beep/scratchpad",
      "issue": "EFFECTED-MEMFS-NODE-ERRNO"
    },
    {
      "rule": "beep-laws/no-native-runtime",
      "file": "scratchpad/effected/memfs/internal/errno.ts",
