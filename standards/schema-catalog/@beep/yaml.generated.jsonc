    {"file":"packages/foundation/modeling/yaml/src/YamlDocument.ts","symbol":"YamlDirective","kind":"struct-const","owner":"@beep/yaml","identity":"YamlDirective","description":"A YAML directive appearing before a document (e.g. `%YAML 1.2` or `%TAG ! tag:example.com,2000:`). `\"YAML\"` and `\"TAG\"` are the YAML 1.2 spec-defined directives; any other name is a reserved directive preserved for round-trip fidelity."},
    {"file":"packages/foundation/modeling/yaml/src/YamlDocument.ts","symbol":"YamlDocument","kind":"schema-class","owner":"@beep/yaml","identity":"YamlDocument","description":"A parsed YAML document: the root (YamlNode:type) (or `null` when empty), recovered `errors` and `warnings` as YamlDiagnostic data, the YamlDirective list, the optional document-level comments and the `---`/`...` framing flags (absent flags read as `false`)."},
    {"file":"packages/foundation/modeling/yaml/src/YamlEdit.ts","symbol":"YamlEdit","kind":"struct-const","owner":"@beep/yaml","identity":"YamlEdit","description":"A non-mutating text edit: replace the span `[offset, offset + length)` with `content`. Set `length` to `0` to insert, `content` to `\"\"` to delete."},
    {"file":"packages/foundation/modeling/yaml/src/YamlEdit.ts","symbol":"YamlRange","kind":"struct-const","owner":"@beep/yaml","identity":"YamlRange","description":"A range within a YAML document, expressed as a zero-based character `offset` and a `length` in UTF-16 code units. Pass to `YamlFormat.format` to restrict formatting to a region."},
    {"file":"packages/foundation/modeling/yaml/src/YamlFormat.ts","symbol":"YamlFormattingOptions","kind":"struct-const","owner":"@beep/yaml","identity":"YamlFormattingOptions","description":"Options controlling formatting behavior: every YamlStringifyOptions field (derived, not hand-duplicated — including `indentSequences`, `quoteStyle` and `quoteCompat`) plus `preserveComments` (default `true`), `range` (restrict edits to a region; the positional `range` argument of YamlFormat.format takes precedence over this field) and `requoteScalars` (default `false`)."},
