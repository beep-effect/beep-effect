    {"file":"packages/foundation/modeling/yaml/src/YamlLint.ts","symbol":"StyleEvidence","kind":"struct-const","owner":"@beep/yaml","identity":"StyleEvidence","description":"Per-dimension style evidence: what the observed sources say about each inferable `(rule, dimension)` — vote histograms with first-seen positions, and measured floors."},
    {"file":"packages/foundation/modeling/yaml/src/YamlLint.ts","symbol":"StyleFloorTally","kind":"struct-const","owner":"@beep/yaml","identity":"StyleFloorTally","description":"An accumulated StyleFloor for a `(rule, dimension)` pair: the largest value the observed sources prove the limit is AT LEAST. Merging takes the maximum. Floors are informational — never resolved into config options (see StyleFloor)."},
    {"file":"packages/foundation/modeling/yaml/src/YamlLint.ts","symbol":"StyleVoteTally","kind":"struct-const","owner":"@beep/yaml","identity":"StyleVoteTally","description":"An accumulated tally of one StyleVote spelling: how many times a `value` was voted for a `(rule, dimension)` pair, and the position of the FIRST occurrence seen (merging keeps the left operand's position, so on a multi-file merge the first file that exhibited the spelling names it)."},
    {"file":"packages/foundation/modeling/yaml/src/YamlLint.ts","symbol":"YamlLintConfig","kind":"struct-const","owner":"@beep/yaml","identity":"YamlLintConfig","description":"The lint configuration: a `rules` map keying rule ids (built-in or custom) to a severity literal or a typed per-rule options object."},
