    {"file":"packages/foundation/modeling/markdown/src/internal/nodes.ts","symbol":"ReferenceType","kind":"literal-kit","owner":"@beep/markdown","identity":"ReferenceType","description":"The explicitness of a reference, per mdast's `referenceType` enum."},
    {"file":"packages/foundation/modeling/markdown/src/internal/nodes.ts","symbol":"Root","kind":"union","owner":"@beep/markdown","identity":"Root","description":"Root — a whole document, and the only node that is never a child."},
    {"file":"packages/foundation/modeling/markdown/src/internal/nodes.ts","symbol":"RowContent","kind":"union","owner":"@beep/markdown","identity":"RowContent","description":"Table-cell nodes admitted as children of a table row."},
