    {"file":"packages/foundation/modeling/markdown/src/internal/nodes.ts","symbol":"TableCell","kind":"struct-const","owner":"@beep/markdown","identity":"TableCell","description":"TableCell — one cell of a TableRow: a header cell if its grandparent Table's first row, a data cell otherwise."},
