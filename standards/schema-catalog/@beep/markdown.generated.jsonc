    {"file":"packages/foundation/modeling/markdown/src/internal/nodes.ts","symbol":"Text","kind":"struct-const","owner":"@beep/markdown","identity":"Text","description":"Text — a run of literal characters, with entity references and backslash escapes already resolved into `value`."},
    {"file":"packages/foundation/modeling/markdown/src/internal/nodes.ts","symbol":"ThematicBreak","kind":"struct-const","owner":"@beep/markdown","identity":"ThematicBreak","description":"ThematicBreak — a horizontal rule (`---`, `***`, `___`)."},
