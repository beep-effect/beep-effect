{
  "name": "@beep/ontology-use-cases",
  "version": "0.0.2",
  "description": "Ontology workbench use-case package for session commands, ports, and worker protocols.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/ontology/use-cases",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/ontology/use-cases"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:test:integration && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "test:integration": "bun run beep:test:integration",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./public": "./src/public.ts",
    "./server": "./src/server.ts",
    "./worker": "./src/worker.ts",
    "./tools": "./src/tools/index.ts",
    "./aggregates/Session": "./src/aggregates/Session/index.ts",
    "./aggregates/Session/worker": "./src/aggregates/Session/worker.ts",
    "./aggregates/Session/server": "./src/aggregates/Session/server.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.ts",
      "./public": "./dist/public.js",
      "./server": "./dist/server.js",
      "./worker": "./dist/worker.js",
      "./tools": "./dist/tools/index.js",
      "./aggregates/Session": "./dist/aggregates/Session/index.js",
      "./aggregates/Session/worker": "./dist/aggregates/Session/worker.js",
      "./aggregates/Session/server": "./dist/aggregates/Session/server.js",
      "./internal/*": null,
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/identity": "workspace:^",
    "@beep/mcp-kit": "workspace:^",
    "@beep/ontology-domain": "workspace:^",
    "@beep/rdf": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/semantic-web": "workspace:^",
    "@beep/utils": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/shacl": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:"
  }
}
