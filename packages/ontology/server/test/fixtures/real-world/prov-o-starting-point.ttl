@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.w3.org/ns/prov#> a owl:Ontology ;
    dcterms:title "PROV-O starting point subset" ;
    rdfs:comment "Small interop fixture derived from the W3C PROV-O Recommendation for ontology-workbench Turtle round-trip validation." .

prov:Entity a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#> ;
    rdfs:label "Entity" .

prov:Activity a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#> ;
    rdfs:label "Activity" .

prov:Agent a owl:Class ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#> ;
    rdfs:label "Agent" .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#> ;
    rdfs:label "wasGeneratedBy" ;
    rdfs:range prov:Activity .

prov:used a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#> ;
    rdfs:label "used" ;
    rdfs:range prov:Entity .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#> ;
    rdfs:label "wasAssociatedWith" ;
    rdfs:range prov:Agent .
