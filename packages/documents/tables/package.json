{
  "name": "@beep/documents-tables",
  "version": "0.0.2",
  "description": "Documents persistence boundary for DMS sync-state table projections.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/documents/tables",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/documents/tables"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:test:integration && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "test:integration": "bun run beep:test:integration",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tables": "./src/tables.ts",
    "./entities/SyncItem": "./src/entities/SyncItem/index.ts",
    "./entities/SyncOperation": "./src/entities/SyncOperation/index.ts",
    "./entities/SyncCursor": "./src/entities/SyncCursor/index.ts",
    "./entities/SyncConflict": "./src/entities/SyncConflict/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./tables": "./dist/tables.js",
      "./entities/SyncItem": "./dist/entities/SyncItem/index.js",
      "./entities/SyncOperation": "./dist/entities/SyncOperation/index.js",
      "./entities/SyncCursor": "./dist/entities/SyncCursor/index.js",
      "./entities/SyncConflict": "./dist/entities/SyncConflict/index.js",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/documents-domain": "workspace:^",
    "@beep/effect-drizzle": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:"
  }
}
