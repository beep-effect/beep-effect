{
  "name": "@beep/data",
  "version": "0.0.2",
  "description": "A library containing data values & utilities",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "echo 'no codegen needed'",
    "build": "bun run beep:build",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps --compact false",
    "check": "bun run beep:check",
    "test": "bun run beep:test",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json",
    "beep:test": "bunx --bun vitest run",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "audit": "bun run --if-present beep:audit",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "dependencies": {
    "@beep/utils": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.json",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.json",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/foundation/primitive/data"
  },
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/foundation/primitive/data",
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null
    }
  },
  "beep": {
    "family": "foundation",
    "kind": "primitive"
  }
}
