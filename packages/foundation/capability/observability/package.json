{
  "name": "@beep/observability",
  "version": "0.0.3",
  "description": "A library containing utilities & modules for observability.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/foundation/capability/observability",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/foundation/capability/observability"
  },
  "scripts": {
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "check:examples": "tsc --noEmit -p tsconfig.examples.json",
    "codegen": "echo 'no codegen needed'",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json",
    "beep:test": "bunx --bun vitest run",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "audit": "bun run --if-present beep:audit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./CauseDiagnostics": "./src/CauseDiagnostics.ts",
    "./CauseRedaction": "./src/CauseRedaction.ts",
    "./CoreConfig": "./src/CoreConfig.ts",
    "./HttpError": "./src/HttpError.ts",
    "./Logging": "./src/Logging.ts",
    "./Metric": "./src/Metric.ts",
    "./Observed": "./src/Observed.ts",
    "./PhaseProfiler": "./src/PhaseProfiler.ts",
    "./Version": "./src/Version.ts",
    "./experimental/server": "./src/experimental/server/index.ts",
    "./server": "./src/server/index.ts",
    "./web": "./src/web/index.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./CauseDiagnostics": "./dist/CauseDiagnostics.js",
      "./CauseRedaction": "./dist/CauseRedaction.js",
      "./CoreConfig": "./dist/CoreConfig.js",
      "./HttpError": "./dist/HttpError.js",
      "./Logging": "./dist/Logging.js",
      "./Metric": "./dist/Metric.js",
      "./Observed": "./dist/Observed.js",
      "./PhaseProfiler": "./dist/PhaseProfiler.js",
      "./Version": "./dist/Version.js",
      "./experimental/server": "./dist/experimental/server/index.js",
      "./server": "./dist/server/index.js",
      "./web": "./dist/web/index.js",
      "./internal/*": null,
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/colors": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/utils": "workspace:^",
    "@effect/opentelemetry": "catalog:",
    "@opentelemetry/exporter-logs-otlp-proto": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-proto": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "beep": {
    "family": "foundation",
    "kind": "capability"
  }
}
