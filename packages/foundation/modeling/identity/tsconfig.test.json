  "references": [
    {
      "path": "../../primitive/types/tsconfig.json"
    },
    {
      "path": "../../../tooling/test-kit/fc-runs/tsconfig.json"
    },
    {
      "path": "../../../tooling/test-kit/test-runner/tsconfig.json"
    }
  ]
