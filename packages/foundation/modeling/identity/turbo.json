{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "cache": false,
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.jsonc",
        "$TURBO_ROOT$/packages/tooling/policy-pack/lint-rules/rules/**",
        "$TURBO_ROOT$/packages/tooling/policy-pack/lint-rules/configs/**",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/packages/.gitignore",
        "$TURBO_ROOT$/packages/foundation/.gitignore",
        "$TURBO_ROOT$/packages/foundation/modeling/.gitignore",
        "!.beep/**",
        "$TURBO_ROOT$/**/package.json",
        "$TURBO_ROOT$/**/tsconfig*.json",
        "$TURBO_ROOT$/**/turbo.json*",
        "$TURBO_ROOT$/**/.gitignore",
        "$TURBO_ROOT$/**/biome*.json*",
        "$TURBO_ROOT$/packages/foundation/modeling/utils/**",
        "$TURBO_ROOT$/vitest*.ts",
        "$TURBO_ROOT$/vitest*.json",
        "!$TURBO_ROOT$/.beep/**",
        "!$TURBO_ROOT$/**/node_modules/**"
      ],
      "env": ["BEEP_CACHE_TOOLCHAIN_DIGEST"],
      "passThroughEnv": ["BIOME_CONFIG_PATH"]
    }
  }
}
