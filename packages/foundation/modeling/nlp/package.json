{
  "name": "@beep/nlp",
  "version": "0.0.2",
  "description": "Schema-first natural language processing value models and pure text/graph helpers",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/foundation/modeling/nlp",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/foundation/modeling/nlp"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bun run beep:docgen",
    "doctest": "bun run beep:doctest",
    "lint": "bun run beep:lint",
    "lint:deprecated-apis": "beep-cli lint deprecated-apis --package .",
    "lint:fix": "bun run beep:lint:fix",
    "lint:jsdoc": "beep-cli lint jsdoc --package .",
    "lint:laws": "beep-cli lint laws --package .",
    "package-test-typecheck": "beep-cli quality test-tsgo-package",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json && bun run beep:check:tests",
    "beep:docgen": "bunx --bun --no-install docgen",
    "beep:doctest": "BEEP_VITEST_DOCTEST=1 bunx vitest run",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:check:tests": "tsgo -p tsconfig.test.json --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Algebra": "./src/Algebra/index.ts",
    "./Algebra/*": "./src/Algebra/*.ts",
    "./Core": "./src/Core/index.ts",
    "./Core/*": "./src/Core/*.ts",
    "./Graph": "./src/Graph/index.ts",
    "./Graph/*": "./src/Graph/*.ts",
    "./Handoff": "./src/Handoff/index.ts",
    "./Handoff/*": "./src/Handoff/*.ts",
    "./IdentifierText": "./src/IdentifierText.ts",
    "./internal/*": null,
    "./Ontology": "./src/Ontology/index.ts",
    "./Ontology/*": "./src/Ontology/*.ts",
    "./Operations": "./src/Operations/index.ts",
    "./Operations/*": "./src/Operations/*.ts",
    "./package.json": "./package.json",
    "./PathText": "./src/PathText.ts",
    "./QueryText": "./src/QueryText.ts",
    "./VariantText": "./src/VariantText.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./Algebra": "./dist/Algebra/index.js",
      "./Algebra/*": "./dist/Algebra/*.js",
      "./Core": "./dist/Core/index.js",
      "./Core/*": "./dist/Core/*.js",
      "./Graph": "./dist/Graph/index.js",
      "./Graph/*": "./dist/Graph/*.js",
      "./Handoff": "./dist/Handoff/index.js",
      "./Handoff/*": "./dist/Handoff/*.js",
      "./IdentifierText": "./dist/IdentifierText.js",
      "./internal/*": null,
      "./Ontology": "./dist/Ontology/index.js",
      "./Ontology/*": "./dist/Ontology/*.js",
      "./Operations": "./dist/Operations/index.js",
      "./Operations/*": "./dist/Operations/*.js",
      "./package.json": "./package.json",
      "./PathText": "./dist/PathText.js",
      "./QueryText": "./dist/QueryText.js",
      "./VariantText": "./dist/VariantText.js"
    }
  },
  "dependencies": {
    "@beep/identity": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/utils": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "beep": {
    "family": "foundation",
    "kind": "modeling"
  }
}
