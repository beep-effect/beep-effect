  "attributeRequirements": {
    "a": [
      {
        "message": "<a target> requires href",
        "required": [["href"]],
        "whenAttribute": "target"
      }
    ],
    "area": [
      {
        "message": "<area href> requires alt text",
        "required": [["alt"]],
        "whenAttribute": "href"
      }
    ],
    "base": [
      {
        "message": "<base> requires href or target",
        "required": [["href", "target"]]
      }
    ],
    "img": [
      {
        "message": "<img> requires alt and at least one of src or srcset",
        "required": [["alt"], ["src", "srcset"]]
      }
    ],
    "input": [
      {
        "message": "<input type=\"image\"> requires alt and src",
        "required": [["alt"], ["src"]],
        "whenAttribute": "type",
        "whenEquals": "image"
      }
    ],
    "meter": [
      {
        "message": "<meter> requires value",
        "required": [["value"]]
      }
    ],
    "map": [
      {
        "message": "<map> requires name",
        "required": [["name"]]
      }
    ],
    "source": [
      {
        "forbidden": ["height", "sizes", "srcset", "width"],
        "message": "<source> under <audio> or <video> requires src and forbids height, sizes, srcset, and width",
        "required": [["src"]],
        "whenParents": ["audio", "video"]
      },
      {
        "forbidden": ["src"],
        "message": "<source> under <picture> requires srcset and forbids src",
        "required": [["srcset"]],
        "whenParents": ["picture"]
      }
    ],
    "track": [
      {
        "message": "<track> requires src",
        "required": [["src"]]
      }
    ]
  },
  "attributeEqualities": {
    "map": [
      {
        "left": "id",
        "message": "<map id> must equal name",
        "right": "name"
      }
    ]
  },
  "uniqueAttributes": {
    "map": ["name"]
  },
