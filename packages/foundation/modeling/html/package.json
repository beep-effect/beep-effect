{
  "name": "@beep/html",
  "version": "0.0.0",
  "description": "Schema-first HTML conformance, safety policy, and deterministic serialization",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/foundation/modeling/html",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/foundation/modeling/html"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:test:integration && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json && bun run beep:check:tests && bun run beep:check:scripts",
    "beep:check:scripts": "tsgo -p tsconfig.scripts.json --noEmit",
    "beep:check:tests": "tsgo -p tsconfig.test.json --noEmit",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "check:scripts": "bun run beep:check:scripts",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bunx --bun --no-install docgen",
    "generate": "bun run scripts/generate.ts && biome check --write src/Html.model.ts src/Html.meta.ts src/internal/Html.language-tag-registry.generated.ts",
    "generate:check": "bun run generate && git diff --exit-code -- src/Html.model.ts src/Html.meta.ts src/internal/Html.language-tag-registry.generated.ts",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "test:integration": "bun run beep:test:integration",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Html": "./src/Html.ts",
    "./Html.attributes": "./src/Html.attributes.ts",
    "./Html.conformance": "./src/Html.conformance.ts",
    "./Html.contract": "./src/Html.contract.ts",
    "./Html.form-control": "./src/Html.form-control.ts",
    "./Html.meta": "./src/Html.meta.ts",
    "./Html.model": "./src/Html.model.ts",
    "./Html.nodes": "./src/Html.nodes.ts",
    "./Html.policy": "./src/Html.policy.ts",
    "./Html.script": "./src/Html.script.ts",
    "./Html.serialize": "./src/Html.serialize.ts",
    "./Html.source-size": "./src/Html.source-size.ts",
    "./Html.srcset": "./src/Html.srcset.ts",
    "./Version": "./src/Version.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./Html": "./dist/Html.js",
      "./Html.attributes": "./dist/Html.attributes.js",
      "./Html.conformance": "./dist/Html.conformance.js",
      "./Html.contract": "./dist/Html.contract.js",
      "./Html.form-control": "./dist/Html.form-control.js",
      "./Html.meta": "./dist/Html.meta.js",
      "./Html.model": "./dist/Html.model.js",
      "./Html.nodes": "./dist/Html.nodes.js",
      "./Html.policy": "./dist/Html.policy.js",
      "./Html.script": "./dist/Html.script.js",
      "./Html.serialize": "./dist/Html.serialize.js",
      "./Html.source-size": "./dist/Html.source-size.js",
      "./Html.srcset": "./dist/Html.srcset.js",
      "./Version": "./dist/Version.js",
      "./internal/*": null,
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/identity": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/utils": "workspace:^",
    "@csstools/css-color-parser": "catalog:",
    "@csstools/css-parser-algorithms": "catalog:",
    "@csstools/css-tokenizer": "catalog:",
    "@csstools/media-query-list-parser": "catalog:",
    "effect": "catalog:",
    "whatwg-url": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "jsdom": "catalog:"
  },
  "beep": {
    "family": "foundation",
    "kind": "modeling"
  }
}
