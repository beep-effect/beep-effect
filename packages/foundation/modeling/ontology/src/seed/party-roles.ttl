@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds> a skos:ConceptScheme ;
  dct:title "Party kind vocabulary" ;
  owl:versionInfo "1.0.0" .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/Party> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds> ;
  skos:notation "Party" ;
  skos:prefLabel "Party" ;
  skos:definition "A real-world person or organization identified independently of its legal roles." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s605.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/NaturalPersonParty> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds> ;
  skos:notation "NaturalPersonParty" ;
  skos:prefLabel "Natural person party" ;
  skos:definition "A human party whose identity persists across matters and role changes." ;
  skos:broader <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/Party> ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s605.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/OrganizationParty> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds> ;
  skos:notation "OrganizationParty" ;
  skos:prefLabel "Organization party" ;
  skos:definition "An institutional party whose identity persists across changes of personnel and legal roles." ;
  skos:broader <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/Party> ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s605.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/LawFirm> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds> ;
  skos:notation "LawFirm" ;
  skos:prefLabel "Law firm" ;
  skos:definition "An organization identified as a provider of legal professional services." ;
  skos:broader <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/OrganizationParty> ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s605.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/PatentOffice> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds> ;
  skos:notation "PatentOffice" ;
  skos:prefLabel "Patent office" ;
  skos:definition "An institution identified as an authority administering patent procedures." ;
  skos:broader <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/OrganizationParty> ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s605.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/TrademarkOffice> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds> ;
  skos:notation "TrademarkOffice" ;
  skos:prefLabel "Trademark office" ;
  skos:definition "An institution identified as an authority administering trademark procedures." ;
  skos:broader <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/party-kinds/concept/OrganizationParty> ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s605.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> a skos:ConceptScheme ;
  dct:title "Legal role vocabulary" ;
  owl:versionInfo "1.0.0" .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/InventorRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "InventorRole" ;
  skos:prefLabel "Inventor role" ;
  skos:definition "A contextual role attributing conception of a specified invention to a natural person on supporting evidence." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s2109.html> ;
  skos:scopeNote "35 USC 100(f)." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/ApplicantRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "ApplicantRole" ;
  skos:prefLabel "Applicant role" ;
  skos:definition "A contextual role identifying the party applying in a specified patent or trademark matter." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s605.html> ;
  skos:scopeNote "35 USC 118; 37 CFR 1.42. This patent source supplies patent context only; trademark applicability requires separate authority evidence." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/AssigneeRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "AssigneeRole" ;
  skos:prefLabel "Assignee role" ;
  skos:definition "A contextual role identifying a party to which rights are transferred by an assignment." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s301.html> ;
  skos:scopeNote "35 USC 261." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/OwnerRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "OwnerRole" ;
  skos:prefLabel "Owner role" ;
  skos:definition "A contextual role identifying a party holding rights in a specified asset." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s301.html> ;
  skos:scopeNote "35 USC 261; 15 USC 1058. This patent source supplies patent context only; trademark applicability requires separate authority evidence." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/ExaminerRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "ExaminerRole" ;
  skos:prefLabel "Examiner role" ;
  skos:definition "A contextual role identifying the official examining a specified application or proceeding." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s707.html> ;
  skos:scopeNote "35 USC 131." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/AttorneyOfRecordRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "AttorneyOfRecordRole" ;
  skos:prefLabel "Attorney of record role" ;
  skos:definition "A contextual role identifying the practitioner recorded as representing a party in a specified matter." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s402.html> ;
  skos:scopeNote "37 CFR 1.32; 37 CFR 2.17. This patent source supplies patent context only; trademark applicability requires separate authority evidence." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/CorrespondentRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "CorrespondentRole" ;
  skos:prefLabel "Correspondent role" ;
  skos:definition "A contextual role identifying the designated recipient or sender of matter correspondence." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s403.html> ;
  skos:scopeNote "37 CFR 1.33." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/ClientContactRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "ClientContactRole" ;
  skos:prefLabel "Client contact role" ;
  skos:definition "A contextual role identifying a party designated as a client communication contact." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s403.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/SignerRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "SignerRole" ;
  skos:prefLabel "Signer role" ;
  skos:definition "A contextual role identifying the party signing a specified document or submission." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s502.html> ;
  skos:scopeNote "37 CFR 1.4(d)." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/LicenseeRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "LicenseeRole" ;
  skos:prefLabel "Licensee role" ;
  skos:definition "A contextual role identifying a party receiving permission under a specified licence." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s301.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

<https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles/concept/LicensorRole> a skos:Concept ;
  skos:inScheme <https://ns.beep.sh/ontology/semantic-foundation/vocabulary/legal-roles> ;
  skos:notation "LicensorRole" ;
  skos:prefLabel "Licensor role" ;
  skos:definition "A contextual role identifying a party granting permission under a specified licence." ;
  dct:source <https://www.uspto.gov/web/offices/pac/mpep/s301.html> ;
  skos:scopeNote "Repository definition; this public authority provides procedural context, not a universal definition. Scope and supporting evidence are consumer-owned." .

