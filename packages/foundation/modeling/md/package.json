{
  "name": "@beep/md",
  "version": "0.0.2",
  "description": "Schema-first Markdown AST, trust provenance, URL policy, and safe rendering",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/foundation/modeling/md",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/foundation/modeling/md"
  },
  "scripts": {
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "build": "tsc -b tsconfig.json && bun run babel",
    "check": "tsgo -b tsconfig.json",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "bunx --bun vitest run",
    "test:property": "bunx --bun vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./Md": "./src/Md.ts",
    "./Md.behavior": "./src/Md.behavior.ts",
    "./Md.conformance": "./src/Md.conformance.ts",
    "./Md.escape": "./src/Md.escape.ts",
    "./Md.html": "./src/Md.html.ts",
    "./Md.model": "./src/Md.model.ts",
    "./Md.render": "./src/Md.render.ts",
    "./Md.safe": "./src/Md.safe.ts",
    "./Version": "./src/Version.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./Md": "./dist/Md.js",
      "./Md.behavior": "./dist/Md.behavior.js",
      "./Md.conformance": "./dist/Md.conformance.js",
      "./Md.escape": "./dist/Md.escape.js",
      "./Md.html": "./dist/Md.html.js",
      "./Md.model": "./dist/Md.model.js",
      "./Md.render": "./dist/Md.render.js",
      "./Md.safe": "./dist/Md.safe.js",
      "./Version": "./dist/Version.js",
      "./internal/*": null,
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/html": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/utils": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "micromark": "catalog:"
  },
  "beep": {
    "family": "foundation",
    "kind": "modeling"
  }
}
