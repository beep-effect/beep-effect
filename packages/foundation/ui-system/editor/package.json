{
  "name": "@beep/editor",
  "version": "0.0.0",
  "description": "Schema-first Lexical editor kit with Atom-backed runtime boundaries",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/foundation/ui-system/editor",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/foundation/ui-system/editor"
  },
  "beep": {
    "family": "foundation",
    "kind": "ui-system"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:test:integration && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json",
    "beep:check": "tsgo -p tsconfig.check.json && bun run beep:check:tests && bun run beep:check:stories",
    "beep:check:stories": "tsc -p tsconfig.stories.json --noEmit",
    "beep:check:tests": "tsgo -p tsconfig.test.json --noEmit",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "test:integration": "bun run beep:test:integration"
  },
  "exports": {
    ".": "./src/index.ts",
    "./artifact-ref-node": "./src/artifact-ref-node.tsx",
    "./capability": "./src/capability/index.ts",
    "./capability/composer": "./src/capability/composer.tsx",
    "./capability/runtime": "./src/capability/runtime.tsx",
    "./capability/shortcut-help": "./src/capability/shortcut-help.tsx",
    "./capability/toolbar": "./src/capability/toolbar.tsx",
    "./capability/*": "./src/capability/*.ts",
    "./chat/attachment-model": "./src/chat/attachment-model.ts",
    "./chat/attachments": "./src/chat/attachments.tsx",
    "./chat/atoms": "./src/chat/atoms.ts",
    "./chat/chat-composer": "./src/chat/chat-composer.tsx",
    "./chat/code-fence": "./src/chat/code-fence.ts",
    "./chat/commands": "./src/chat/commands.ts",
    "./chat/config": "./src/chat/config.ts",
    "./chat/send": "./src/chat/send.tsx",
    "./chat/slash-items": "./src/chat/slash-items.tsx",
    "./chat/toolbar": "./src/chat/toolbar.tsx",
    "./chat/typeahead": "./src/chat/typeahead.tsx",
    "./code-block-node": "./src/code-block-node.tsx",
    "./code-block-view": "./src/code-block-view.tsx",
    "./composer": "./src/composer.tsx",
    "./mermaid-node": "./src/mermaid-node.tsx",
    "./mermaid-view": "./src/mermaid-view.tsx",
    "./nodes": "./src/nodes.ts",
    "./runtime": "./src/runtime.ts",
    "./theme": "./src/theme.ts",
    "./viewer": "./src/viewer.tsx",
    "./youtube-embed": "./src/youtube-embed.tsx",
    "./youtube-node": "./src/youtube-node.tsx",
    "./package.json": "./package.json",
    "./internal/*": null
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./artifact-ref-node": "./dist/artifact-ref-node.js",
      "./capability": "./dist/capability/index.js",
      "./capability/composer": "./dist/capability/composer.js",
      "./capability/runtime": "./dist/capability/runtime.js",
      "./capability/shortcut-help": "./dist/capability/shortcut-help.js",
      "./capability/toolbar": "./dist/capability/toolbar.js",
      "./capability/*": "./dist/capability/*.js",
      "./chat/attachment-model": "./dist/chat/attachment-model.js",
      "./chat/attachments": "./dist/chat/attachments.js",
      "./chat/atoms": "./dist/chat/atoms.js",
      "./chat/chat-composer": "./dist/chat/chat-composer.js",
      "./chat/code-fence": "./dist/chat/code-fence.js",
      "./chat/commands": "./dist/chat/commands.js",
      "./chat/config": "./dist/chat/config.js",
      "./chat/send": "./dist/chat/send.js",
      "./chat/slash-items": "./dist/chat/slash-items.js",
      "./chat/toolbar": "./dist/chat/toolbar.js",
      "./chat/typeahead": "./dist/chat/typeahead.js",
      "./code-block-node": "./dist/code-block-node.js",
      "./code-block-view": "./dist/code-block-view.js",
      "./composer": "./dist/composer.js",
      "./mermaid-node": "./dist/mermaid-node.js",
      "./mermaid-view": "./dist/mermaid-view.js",
      "./nodes": "./dist/nodes.js",
      "./runtime": "./dist/runtime.js",
      "./theme": "./dist/theme.js",
      "./viewer": "./dist/viewer.js",
      "./youtube-embed": "./dist/youtube-embed.js",
      "./youtube-node": "./dist/youtube-node.js",
      "./package.json": "./package.json",
      "./internal/*": null
    }
  },
  "dependencies": {
    "@beep/identity": "workspace:^",
    "@beep/lexical-schema": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/ui": "workspace:^",
    "@beep/utils": "workspace:^",
    "@effect/atom-react": "catalog:",
    "@lexical/code": "catalog:",
    "@lexical/link": "catalog:",
    "@lexical/list": "catalog:",
    "@lexical/markdown": "catalog:",
    "@lexical/react": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/selection": "catalog:",
    "@lexical/table": "catalog:",
    "@lexical/utils": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "dompurify": "catalog:",
    "effect": "catalog:",
    "lexical": "catalog:",
    "mermaid": "catalog:"
  },
  "devDependencies": {
    "@beep/md": "workspace:^",
    "@effect/vitest": "catalog:",
    "@lexical/headless": "catalog:",
    "@lexical/html": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-types": "catalog:",
    "jsdom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
