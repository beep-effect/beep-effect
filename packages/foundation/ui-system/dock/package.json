{
  "name": "@beep/dock",
  "version": "0.0.0",
  "description": "Headless schema-first dock workspace kernel.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/foundation/ui-system/dock",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/foundation/ui-system/dock"
  },
  "beep": {
    "family": "foundation",
    "kind": "ui-system"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:test:integration && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json && bun run beep:check:tests",
    "beep:check:tests": "tsgo -p tsconfig.test.json --noEmit",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:integration": "bun run beep:test:integration"
  },
  "exports": {
    ".": "./src/index.ts",
    "./AnchoredBox": "./src/AnchoredBox.ts",
    "./Dock.atoms": "./src/Dock.atoms.ts",
    "./Dock.commands": "./src/Dock.commands.ts",
    "./Dock.errors": "./src/Dock.errors.ts",
    "./Dock.events": "./src/Dock.events.ts",
    "./Dock.geometry": "./src/Dock.geometry.ts",
    "./Dock.ids": "./src/Dock.ids.ts",
    "./Dock.models": "./src/Dock.models.ts",
    "./Dock.outcomes": "./src/Dock.outcomes.ts",
    "./Dock.placement": "./src/Dock.placement.ts",
    "./Dock.protocol": "./src/Dock.protocol.ts",
    "./Dock.reducer": "./src/Dock.reducer.ts",
    "./Dock.tree": "./src/Dock.tree.ts",
    "./DockEngine.service": "./src/DockEngine.service.ts",
    "./DockPolicy": "./src/DockPolicy.ts",
    "./Minima": "./src/Minima.ts",
    "./Recency": "./src/Recency.ts",
    "./internal/*": "./src/internal/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./AnchoredBox": "./dist/AnchoredBox.js",
      "./Dock.atoms": "./dist/Dock.atoms.js",
      "./Dock.commands": "./dist/Dock.commands.js",
      "./Dock.errors": "./dist/Dock.errors.js",
      "./Dock.events": "./dist/Dock.events.js",
      "./Dock.geometry": "./dist/Dock.geometry.js",
      "./Dock.ids": "./dist/Dock.ids.js",
      "./Dock.models": "./dist/Dock.models.js",
      "./Dock.outcomes": "./dist/Dock.outcomes.js",
      "./Dock.placement": "./dist/Dock.placement.js",
      "./Dock.protocol": "./dist/Dock.protocol.js",
      "./Dock.reducer": "./dist/Dock.reducer.js",
      "./Dock.tree": "./dist/Dock.tree.js",
      "./DockEngine.service": "./dist/DockEngine.service.js",
      "./DockPolicy": "./dist/DockPolicy.js",
      "./Minima": "./dist/Minima.js",
      "./Recency": "./dist/Recency.js",
      "./internal/*": null,
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/identity": "workspace:^",
    "@beep/pretext": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/utils": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "vitest": "catalog:"
  }
}
