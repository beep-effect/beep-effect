{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../../tsconfig.base.json",
  "include": ["src", "test"],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "outDir": "dist-test",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@beep/ui": ["./src/index.ts"],
      "@beep/ui/*": ["./src/*"],
      "@beep/ui/lib": ["./src/lib/index.ts"],
      "@beep/ui/lib/*": ["./src/lib/*"]
    }
  }
}
