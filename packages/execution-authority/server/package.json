{
  "name": "@beep/execution-authority-server",
  "version": "0.0.0",
  "description": "Execution authority slice server: the Drizzle execution ledger, the governed MCP tier gate, and governed egress.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/execution-authority/server",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/execution-authority/server"
  },
  "scripts": {
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:build": "tsrs -p tsconfig.json && bun run babel",
    "beep:check": "tsrs -p tsconfig.check.json && bun run beep:check:tests",
    "beep:check:tests": "tsrs -p tsconfig.test.json --noEmit",
    "beep:docgen": "bunx --bun --no-install docgen",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bun run beep:docgen",
    "lint": "bun run beep:lint",
    "lint:deprecated-apis": "beep-cli lint deprecated-apis --package .",
    "lint:fix": "bun run beep:lint:fix",
    "lint:jsdoc": "beep-cli lint jsdoc --package .",
    "lint:laws": "beep-cli lint laws --package .",
    "package-test-typecheck": "beep-cli quality test-tsgo-package",
    "test": "bun run beep:test",
    "test:integration": "bun run beep:test:integration"
  },
  "exports": {
    ".": "./src/index.ts",
    "./ExecutionLedger": "./src/ExecutionLedger/index.ts",
    "./GovernedEgress": "./src/GovernedEgress/index.ts",
    "./GovernedTierGate": "./src/GovernedTierGate/index.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./ExecutionLedger": "./dist/ExecutionLedger/index.js",
      "./GovernedEgress": "./dist/GovernedEgress/index.js",
      "./GovernedTierGate": "./dist/GovernedTierGate/index.js",
      "./internal/*": null,
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/api-transport": "workspace:^",
    "@beep/execution-authority-config": "workspace:^",
    "@beep/execution-authority-domain": "workspace:^",
    "@beep/execution-authority-tables": "workspace:^",
    "@beep/execution-authority-use-cases": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/mcp-kit": "workspace:^",
    "@beep/postgres": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "@beep/utils": "workspace:^",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-runner": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:"
  }
}
