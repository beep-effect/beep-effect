{
  "name": "@beep/execution-authority-domain",
  "version": "0.0.0",
  "description": "Execution authority slice domain: grants, grant sets, verdicts, and hash-chained decision and outcome records.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/execution-authority/domain",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/execution-authority/domain"
  },
  "scripts": {
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:build": "tsrs -p tsconfig.json && bun run babel",
    "beep:check": "tsrs -p tsconfig.check.json && bun run beep:check:tests",
    "beep:check:tests": "tsrs -p tsconfig.test.json --noEmit",
    "beep:docgen": "bunx --bun --no-install docgen",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bun run beep:docgen",
    "lint": "bun run beep:lint",
    "lint:deprecated-apis": "beep-cli lint deprecated-apis --package .",
    "lint:fix": "bun run beep:lint:fix",
    "lint:jsdoc": "beep-cli lint jsdoc --package .",
    "lint:laws": "beep-cli lint laws --package .",
    "package-test-typecheck": "beep-cli quality test-tsgo-package",
    "test": "bun run beep:test",
    "test:integration": "bun run beep:test:integration"
  },
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/entities/index.ts",
    "./entities/ExecutionRecord": "./src/entities/ExecutionRecord/index.ts",
    "./values": "./src/values/index.ts",
    "./values/ExecutionGrant": "./src/values/ExecutionGrant/index.ts",
    "./values/ExecutionVerdict": "./src/values/ExecutionVerdict/index.ts",
    "./values/GrantSet": "./src/values/GrantSet/index.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./entities": "./dist/entities/index.js",
      "./entities/ExecutionRecord": "./dist/entities/ExecutionRecord/index.js",
      "./values": "./dist/values/index.js",
      "./values/ExecutionGrant": "./dist/values/ExecutionGrant/index.js",
      "./values/ExecutionVerdict": "./dist/values/ExecutionVerdict/index.js",
      "./values/GrantSet": "./dist/values/GrantSet/index.js",
      "./internal/*": null,
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/epistemics": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "@beep/utils": "workspace:^",
    "@noble/hashes": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-runner": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:"
  }
}
