{
  "$schema": "../../../packages/tooling/tool/docgen/schema.json",
  "exclude": ["src/internal/**/*.ts"],
  "srcLink": "https://github.com/beep-effect/beep-effect/tree/main/packages/agents/tables/src/",
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "es2022",
    "target": "es2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "erasableSyntaxOnly": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "stripInternal": false,
    "noErrorTruncation": true,
    "types": [],
    "jsx": "react-jsx",
    "paths": {
      "@beep/agents-tables": ["../../../packages/agents/tables/src/index.ts"],
      "@beep/agents-tables/tables": [
        "../../../packages/agents/tables/src/tables.ts"
      ],
      "@beep/agents-domain": ["../../../packages/agents/domain/src/index.ts"],
      "@beep/agents-domain/entities": [
        "../../../packages/agents/domain/src/entities/index.ts"
      ],
      "@beep/agents-domain/entities/Agent": [
        "../../../packages/agents/domain/src/entities/Agent/index.ts"
      ],
      "@beep/agents-domain/entities/ProviderInstance": [
        "../../../packages/agents/domain/src/entities/ProviderInstance/index.ts"
      ],
      "@beep/agents-domain/entities/Skill": [
        "../../../packages/agents/domain/src/entities/Skill/index.ts"
      ],
      "@beep/agents-domain/values": [
        "../../../packages/agents/domain/src/values/index.ts"
      ],
      "@beep/agents-domain/values/AssistantContent": [
        "../../../packages/agents/domain/src/values/AssistantContent/index.ts"
      ],
      "@beep/drizzle": ["../../../packages/drivers/drizzle/src/index.ts"]
    }
  }
}
