{
  "name": "@beep/epistemic-domain",
  "version": "0.0.2",
  "description": "Epistemic domain models for claims, verified evidence, contradiction triage, activities, and usage.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/epistemic/domain",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/epistemic/domain"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json",
    "beep:check": "tsgo -p tsconfig.check.json",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/entities/index.ts",
    "./entities/Activity": "./src/entities/Activity/index.ts",
    "./entities/CandidateClaim": "./src/entities/CandidateClaim/index.ts",
    "./entities/ClaimDisposition": "./src/entities/ClaimDisposition/index.ts",
    "./entities/Contradiction": "./src/entities/Contradiction/index.ts",
    "./entities/EdgeVersion": "./src/entities/EdgeVersion/index.ts",
    "./entities/Evidence": "./src/entities/Evidence/index.ts",
    "./entities/EvidenceVerification": "./src/entities/EvidenceVerification/index.ts",
    "./entities/UsageRecord": "./src/entities/UsageRecord/index.ts",
    "./values": "./src/values/index.ts",
    "./values/ClaimDispositionStatus": "./src/values/ClaimDispositionStatus/index.ts",
    "./values/Contradiction": "./src/values/Contradiction/index.ts",
    "./values/ClaimGate": "./src/values/ClaimGate/index.ts",
    "./values/ClaimLifecycle": "./src/values/ClaimLifecycle/index.ts",
    "./values/ClaimProjection": "./src/values/ClaimProjection/index.ts",
    "./values/EdgeEndpoint": "./src/values/EdgeEndpoint/index.ts",
    "./values/EdgeRelation": "./src/values/EdgeRelation/index.ts",
    "./values/EpistemicFixtureKey": "./src/values/EpistemicFixtureKey/index.ts",
    "./values/EvidenceSpan": "./src/values/EvidenceSpan/index.ts",
    "./values/EvidenceVerification": "./src/values/EvidenceVerification/index.ts",
    "./values/ExecutionGrant": "./src/values/ExecutionGrant/index.ts",
    "./values/ExecutionRecord": "./src/values/ExecutionRecord/index.ts",
    "./values/ExecutionVerdict": "./src/values/ExecutionVerdict/index.ts",
    "./values/GrantSet": "./src/values/GrantSet/index.ts",
    "./values/LogicalEdgeIdentity": "./src/values/LogicalEdgeIdentity/index.ts",
    "./internal/*": null,
    "./values/internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "dependencies": {
    "@beep/identity": "workspace:^",
    "@beep/provenance": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "@beep/utils": "workspace:^",
    "@noble/hashes": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/effect-drizzle": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:"
  }
}
