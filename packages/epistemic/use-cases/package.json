{
  "name": "@beep/epistemic-use-cases",
  "version": "0.0.2",
  "description": "Epistemic use-case package: claim gate, lifecycle transition, and claim projection contracts.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/kriegcloud/beep-effect/tree/main/packages/epistemic/use-cases",
  "repository": {
    "type": "git",
    "url": "git@github.com:kriegcloud/beep-effect.git",
    "directory": "packages/epistemic/use-cases"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json",
    "beep:check": "tsgo -p tsconfig.check.json && bun run beep:check:tests",
    "beep:check:tests": "tsgo -p tsconfig.test.json --noEmit",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./public": "./src/public.ts",
    "./server": "./src/server.ts",
    "./ClaimDisposition": "./src/ClaimDisposition/index.ts",
    "./ClaimGate": "./src/ClaimGate/index.ts",
    "./ClaimLifecycle": "./src/ClaimLifecycle/index.ts",
    "./ClaimProjection": "./src/ClaimProjection/index.ts",
    "./EdgeAuthority": "./src/EdgeAuthority/index.ts",
    "./ExecutionLedger": "./src/ExecutionLedger/index.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "dependencies": {
    "@beep/epistemic-domain": "workspace:^",
    "@beep/file-processing": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/provenance": "workspace:^",
    "@beep/rdf": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/semantic-web": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:"
  }
}
