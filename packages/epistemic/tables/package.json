{
  "name": "@beep/epistemic-tables",
  "version": "0.0.2",
  "description": "Epistemic persistence boundary for metadata-only table projections.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/epistemic/tables",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/epistemic/tables"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:test:integration && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json && bun run beep:check:tests",
    "beep:check:tests": "tsgo -p tsconfig.test.json --noEmit",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "test:integration": "bun run beep:test:integration",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/entities/index.ts",
    "./entities/CandidateClaim": "./src/entities/CandidateClaim/index.ts",
    "./entities/ClaimDisposition": "./src/entities/ClaimDisposition/index.ts",
    "./entities/Contradiction": "./src/entities/Contradiction/index.ts",
    "./entities/EdgeVersion": "./src/entities/EdgeVersion/index.ts",
    "./entities/Evidence": "./src/entities/Evidence/index.ts",
    "./entities/EvidenceVerification": "./src/entities/EvidenceVerification/index.ts",
    "./entities/UsageRecord": "./src/entities/UsageRecord/index.ts",
    "./values": "./src/values/index.ts",
    "./values/ExecutionRecord": "./src/values/ExecutionRecord/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.js",
      "./entities": "./dist/entities/index.js",
      "./entities/CandidateClaim": "./dist/entities/CandidateClaim/index.js",
      "./entities/ClaimDisposition": "./dist/entities/ClaimDisposition/index.js",
      "./entities/Contradiction": "./dist/entities/Contradiction/index.js",
      "./entities/EdgeVersion": "./dist/entities/EdgeVersion/index.js",
      "./entities/Evidence": "./dist/entities/Evidence/index.js",
      "./entities/EvidenceVerification": "./dist/entities/EvidenceVerification/index.js",
      "./entities/UsageRecord": "./dist/entities/UsageRecord/index.js",
      "./values": "./dist/values/index.js",
      "./values/ExecutionRecord": "./dist/values/ExecutionRecord/index.js",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/effect-drizzle": "workspace:^",
    "@beep/epistemic-domain": "workspace:^",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/shared-domain": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:"
  }
}
