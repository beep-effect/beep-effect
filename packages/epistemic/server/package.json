{
  "name": "@beep/epistemic-server",
  "version": "0.0.2",
  "description": "Epistemic server tier: live Layer surface composing the claim gate, lifecycle transition, and bounded SHACL engine.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/kriegcloud/beep-effect/tree/main/packages/epistemic/server",
  "repository": {
    "type": "git",
    "url": "git@github.com:kriegcloud/beep-effect.git",
    "directory": "packages/epistemic/server"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:test:integration && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json",
    "beep:check": "tsgo -p tsconfig.check.json && bun run beep:check:tests",
    "beep:check:tests": "tsgo -p tsconfig.test.json --noEmit",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage test/*.test.ts test/integration/ContradictionTriage.pglite.test.ts",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:integration": "bun run beep:test:integration",
    "test:integration:parallel": "bun run beep:test:integration",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./layer": "./src/Layer.ts",
    "./ClaimDisposition": "./src/ClaimDisposition/index.ts",
    "./ContradictionTriage": "./src/ContradictionTriage/index.ts",
    "./EdgeAuthority": "./src/EdgeAuthority/index.ts",
    "./ExecutionLedger": "./src/ExecutionLedger/index.ts",
    "./GovernedEgress": "./src/GovernedEgress/index.ts",
    "./GovernedTierGate": "./src/GovernedTierGate/index.ts",
    "./ShaclValidation": "./src/ShaclValidation/index.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "dependencies": {
    "@beep/api-transport": "workspace:^",
    "@beep/epistemic-config": "workspace:^",
    "@beep/epistemic-domain": "workspace:^",
    "@beep/epistemic-tables": "workspace:^",
    "@beep/epistemic-use-cases": "workspace:^",
    "@beep/file-processing": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/mcp-kit": "workspace:^",
    "@beep/observability": "workspace:^",
    "@beep/postgres": "workspace:^",
    "@beep/provenance": "workspace:^",
    "@beep/rdf": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/semantic-web": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "@beep/utils": "workspace:^",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/pglite": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:"
  }
}
