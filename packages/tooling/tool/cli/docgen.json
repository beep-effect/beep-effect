{
  "$schema": "../../../../packages/tooling/tool/docgen/schema.json",
  "exclude": [
    "src/internal/**/*.ts",
    "src/**/internal/**/*.ts",
    "src/commands/CreatePackage/ConfigUpdater.ts",
    "src/commands/CreatePackage/FileGenerationPlanService.ts",
    "src/commands/CreatePackage/Handler.ts",
    "src/commands/CreatePackage/TemplateService.ts",
    "src/commands/CreatePackage/TsMorphIntegrationService.ts",
    "src/commands/Image/Image.progress.ts",
    "src/commands/Image/Image.render.ts",
    "src/commands/Quality/Tasks.ts",
    "src/commands/SyncDataToTs/targets/**/*.ts",
    "src/test/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "enforceDescriptions": true,
  "enforceVersion": true,
  "srcLink": "https://github.com/beep-effect/beep-effect/tree/main/packages/tooling/tool/cli/src/",
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "es2022",
    "target": "es2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "erasableSyntaxOnly": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "stripInternal": false,
    "noErrorTruncation": true,
    "types": [],
    "jsx": "react-jsx"
  }
}
