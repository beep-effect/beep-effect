{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "{{rootRelative}}tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"{{#if isEcosystem}},
    "stripInternal": true,
    "plugins": {{{effectLanguageServicePlugins}}}{{/if}}
  }
}
