/**
 * HTTP API contract for {{scopedName}}.
 *
 * @packageDocumentation
 * @since 0.0.0
 */

import { {{identityAccessor}} } from "@beep/identity/packages";
import * as S from "effect/Schema";
import { HttpApi, HttpApiEndpoint, HttpApiGroup } from "effect/http-api";

const $I = {{identityAccessor}}.create("Api");

/**
 * Service health snapshot returned by `GET /health`.
 *
 * **Example** (Build a health snapshot)
 *
 * ```ts
 * import { Health } from "@/Api"
 *
 * console.log(Health.make({ status: "ok" }).status) // "ok"
 * ```
 *
 * @category models
 * @since 0.0.0
 */
export class Health extends S.Class<Health>($I`Health`)(
  {
    status: S.tag("ok"),
  },
  $I.annote("Health", {
    description: "Service health snapshot returned by GET /health.",
  })
) {}

// Not exported: `Api` is the only consumer, and a lab-local export with no
// importer trips fallow's unused-export gate the first time the lab lands.
const ApiGroup = HttpApiGroup.make("{{name}}").add(HttpApiEndpoint.get("health", "/health", { success: Health }));

/**
 * HTTP API served by {{scopedName}}.
 *
 * **Example** (Inspect the API identifier)
 *
 * ```ts
 * import { Api } from "@/Api"
 *
 * console.log(Api.identifier) // "{{name}}-api"
 * ```
 *
 * @category constructors
 * @since 0.0.0
 */
export const Api = HttpApi.make("{{name}}-api").add(ApiGroup);
