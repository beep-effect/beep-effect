{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "{{rootRelative}}tsconfig.base.json",
  "include": ["src", "test"],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    "outDir": "dist-test",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node", "bun-types"]{{#if isEcosystem}},
    "plugins": {{{effectLanguageServicePlugins}}}{{/if}}
  }
}
