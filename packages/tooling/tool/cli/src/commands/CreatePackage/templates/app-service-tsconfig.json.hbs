{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "{{rootRelative}}tsconfig.base.json",
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "{{rootRelative}}vitest.shared.ts",
    "{{rootRelative}}vitest.aliases.generated.json"
  ],
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node"],
    "allowJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "dist",
    "rootDir": "{{rootDirRelative}}"
  }
}
