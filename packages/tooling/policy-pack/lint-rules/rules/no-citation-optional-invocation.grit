language js

`$effect.serviceOption($service)` as $lookup where {
  $service <: or {
    `CitationTextBudget`,
    `CitationOperationAdmission`
  },
  register_diagnostic(span=$lookup, message="Rule: citation request authority must be explicit. Why: optional install-time lookups silently lose accounting or acquire another permit when installs move. Fix: read CitationInvocation at call time in parent-only stages, or pass an explicit reservation to code shared with a child process.", severity="error")
}
