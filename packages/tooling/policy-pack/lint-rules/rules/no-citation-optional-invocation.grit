language js

// Syntactic names only: local aliases and aliased named imports require semantic linting.
pattern citation_authority() {
  or {
    `CitationTextBudget`,
    `CitationOperationAdmission`,
    `CitationInvocation`,
    `CitationNativeLane`,
    `$_.$name` where {
      $name <: or {
        `CitationTextBudget`,
        `CitationOperationAdmission`,
        `CitationInvocation`,
        `CitationNativeLane`
      }
    }
  }
}

or {
  `$effect.serviceOption($service)`,
  `$context.getOption($_, $service)`,
  `$context.getOption($service)`,
  `$context.getOrUndefined($_, $service)`,
  `$context.getOrUndefined($service)`,
  `$context.get($_, $service)`,
  `$context.get($service)`,
  `$context.getUnsafe($_, $service)`,
  `$context.getUnsafe($service)`,
  `$context.getOrElse($_, $service, $_)`,
  `$context.getOrElse($service, $_)`,
  `serviceOption($service)`
} as $lookup where {
  $service <: citation_authority(),
  register_diagnostic(span=$lookup, message="Rule: citation request authority must be explicit. Why: optional or captured-context lookups silently lose accounting, acquire another permit or bind one request's value when installs move. Fix: read CitationInvocation at call time in parent-only stages, or pass an explicit reservation to code shared with a child process.", severity="error")
}
