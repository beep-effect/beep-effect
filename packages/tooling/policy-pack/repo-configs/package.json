{
  "name": "@beep/repo-configs",
  "version": "0.1.1",
  "description": "An library for shared build & tooling configurations",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "codegen": "bun run ./scripts/GenerateEffectLawsAllowlistSnapshot.ts",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bun run beep:docgen",
    "lint": "bun run beep:lint",
    "lint:deprecated-apis": "beep-cli lint deprecated-apis --package .",
    "lint:fix": "bun run beep:lint:fix",
    "lint:jsdoc": "beep-cli lint jsdoc --package .",
    "lint:laws": "beep-cli lint laws --package .",
    "package-test-typecheck": "beep-cli quality test-tsgo-package",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "bun run codegen && tsrs -p tsconfig.json && bun run babel",
    "beep:check": "tsrs -p tsconfig.check.json && bun run beep:check:scripts && bun run beep:check:tests",
    "beep:docgen": "bunx --bun --no-install docgen",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:check:scripts": "tsrs -p tsconfig.scripts.json --noEmit",
    "beep:check:tests": "tsrs -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@beep/identity": "workspace:^",
    "@beep/jsonc": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/semver": "workspace:^",
    "@beep/utils": "workspace:^",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-runner": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@next/bundle-analyzer": "catalog:",
    "@next/mdx": "catalog:",
    "@serwist/next": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "next": "catalog:"
  },
  "peerDependencies": {
    "@next/bundle-analyzer": "catalog:",
    "@next/mdx": "catalog:",
    "@serwist/next": "catalog:",
    "next": "catalog:"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./cache": "./src/cache/index.ts",
    "./cache/*": null,
    "./next": "./src/next/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": "./src/internal/*.ts",
    "./laws/*": "./src/laws/*.ts",
    "./internal/laws/*": "./src/internal/laws/*.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/tooling/policy-pack/repo-configs"
  },
  "beep": {
    "family": "tooling",
    "kind": "policy-pack"
  },
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/tooling/policy-pack/repo-configs",
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.ts",
      "./cache": "./dist/cache/index.js",
      "./cache/*": null,
      "./next": "./dist/next/index.js",
      "./*": "./dist/*.js",
      "./internal/*": "./dist/internal/*.js",
      "./laws/*": "./dist/laws/*.js",
      "./internal/laws/*": "./dist/internal/laws/*.js"
    }
  }
}
