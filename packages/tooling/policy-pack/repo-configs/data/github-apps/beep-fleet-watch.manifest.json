{
  "name": "beep-fleet-watch",
  "url": "https://github.com/beep-effect/beep-effect",
  "description": "Reads workflow runs, the runner fleet's webhook deliveries and the organization's self-hosted runners for the fleet missed-event check of beep-effect.",
  "public": false,
  "redirect_url": "http://localhost:8787/callback",
  "hook_attributes": {
    "url": "https://example.invalid/beep-fleet-watch-disabled",
    "active": false
  },
  "default_events": [],
  "default_permissions": {
    "actions": "read",
    "repository_hooks": "read",
    "organization_self_hosted_runners": "read",
    "metadata": "read"
  }
}
