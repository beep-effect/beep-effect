{
  "agents": {
    "list": [
      {
        "id": "negative",
        "model": {
          "primary": "provider/model"
        },
        "name": "Negative Fixture",
        "workspace": "/beep-openclaw-placeholder/workspace"
      }
    ]
  },
  "gateway": {
    "auth": {
      "mode": "token",
      "token": {
        "id": "value",
        "provider": "op_gateway",
        "source": "exec"
      }
    },
    "bind": "loopback",
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["http://127.0.0.1:19042"],
      "unknownControlUiKey": true
    },
    "mode": "local",
    "port": 19042,
    "reload": {
      "mode": "off"
    }
  },
  "logging": {
    "file": "/beep-openclaw-placeholder/state/log/openclaw.log"
  },
  "secrets": {
    "providers": {
      "op_gateway": {
        "args": [
          "/beep-openclaw-placeholder/trusted/bin/op",
          "op://beep-p0-spike3/spike3-rotating/password"
        ],
        "command": "/beep-openclaw-placeholder/trusted/op-resolver.sh",
        "jsonOnly": false,
        "passEnv": ["OP_SERVICE_ACCOUNT_TOKEN", "PATH"],
        "source": "exec",
        "trustedDirs": ["/beep-openclaw-placeholder/trusted"]
      }
    }
  }
}
