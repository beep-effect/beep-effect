{
  "name": "@beep/govinfo",
  "version": "0.0.0",
  "description": "GovInfo driver package",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/drivers/govinfo",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/drivers/govinfo"
  },
  "beep": {
    "family": "drivers"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "beep:audit": "bun run generate && bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:test:integration && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json && bun run babel",
    "beep:check": "tsgo -p tsconfig.check.json && bun run beep:check:tests && bun run beep:check:scripts",
    "beep:check:scripts": "tsgo -p tsconfig.scripts.json --noEmit",
    "beep:check:tests": "tsgo -p tsconfig.test.json --noEmit",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/**",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "codegen": "bun run generate",
    "coverage": "bunx vitest run --coverage --exclude=test/integration/**",
    "docgen": "bunx --bun --no-install docgen",
    "generate": "bun run scripts/generate.ts",
    "generate:check": "bun run scripts/generate.ts --check",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "test:integration": "bun run beep:test:integration",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./_generated/*": null,
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "openapi.json",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.ts",
      "./_generated/*": null,
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@beep/api-transport": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/utils": "workspace:^",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/codegen-kit": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "catalog:"
  }
}
