# 1Password references for the beep-m365-outbox MCP server. References only:
# `op run --env-file` resolves them at launch, and no value is ever committed.
# Per-machine settings (attachment roots, limits, audit directory) are not
# secrets and do not belong here; see README.md.
M365_OUTBOX_TENANT_ID="op://BEEP_SECRETS/BEEP_SECRETS/CLOUD_M365_OUTBOX_TENANT_ID"
M365_OUTBOX_CLIENT_ID="op://BEEP_SECRETS/BEEP_SECRETS/CLOUD_M365_OUTBOX_CLIENT_ID"
M365_OUTBOX_CERT_THUMBPRINT_SHA256="op://BEEP_SECRETS/BEEP_SECRETS/CLOUD_M365_OUTBOX_CERT_THUMBPRINT_SHA256"
M365_OUTBOX_CERT_PRIVATE_KEY="op://BEEP_SECRETS/BEEP_SECRETS/CLOUD_M365_OUTBOX_CERT_PRIVATE_KEY"
M365_OUTBOX_MAILBOX="op://BEEP_SECRETS/BEEP_SECRETS/CLOUD_M365_OUTBOX_MAILBOX"
