{
  "name": "@beep/law-practice-domain",
  "version": "0.0.2",
  "description": "Law-practice context domain models for the runtime proof.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/packages/law-practice/domain",
  "repository": {
    "type": "git",
    "url": "git@github.com:beep-effect/beep-effect.git",
    "directory": "packages/law-practice/domain"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json",
    "beep:check": "tsgo -p tsconfig.check.json",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "test:property": "bun run beep:test",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/entities/index.ts",
    "./entities/ActFrame": "./src/entities/ActFrame/index.ts",
    "./entities/CandorDisposition": "./src/entities/CandorDisposition/index.ts",
    "./entities/Claim": "./src/entities/Claim/index.ts",
    "./entities/CorrectionDelta": "./src/entities/CorrectionDelta/index.ts",
    "./entities/Distinction": "./src/entities/Distinction/index.ts",
    "./entities/IdsSubmissionFact": "./src/entities/IdsSubmissionFact/index.ts",
    "./entities/LegalClient": "./src/entities/LegalClient/index.ts",
    "./entities/LegalContact": "./src/entities/LegalContact/index.ts",
    "./entities/LegalOppositionCandidate": "./src/entities/LegalOppositionCandidate/index.ts",
    "./entities/LegalPositionRelator": "./src/entities/LegalPositionRelator/index.ts",
    "./entities/Matter": "./src/entities/Matter/index.ts",
    "./entities/OfficeAction": "./src/entities/OfficeAction/index.ts",
    "./entities/PatentAsset": "./src/entities/PatentAsset/index.ts",
    "./entities/PatentCitationEvent": "./src/entities/PatentCitationEvent/index.ts",
    "./entities/PowerExercise": "./src/entities/PowerExercise/index.ts",
    "./entities/PriorArtReference": "./src/entities/PriorArtReference/index.ts",
    "./entities/Rejection": "./src/entities/Rejection/index.ts",
    "./values": "./src/values/index.ts",
    "./values/ApplicationNumber": "./src/values/ApplicationNumber/index.ts",
    "./values/CitingApplicationIdentity": "./src/values/CitingApplicationIdentity/index.ts",
    "./values/CourtReporterVocabulary": "./src/values/CourtReporterVocabulary/index.ts",
    "./values/KindCode": "./src/values/KindCode/index.ts",
    "./values/ObservationVersionRef": "./src/values/ObservationVersionRef/index.ts",
    "./values/OfficeCode": "./src/values/OfficeCode/index.ts",
    "./values/PatentDocument": "./src/values/PatentDocument/index.ts",
    "./values/PatentDocumentTriplet": "./src/values/PatentDocumentTriplet/index.ts",
    "./values/PatentNumber": "./src/values/PatentNumber/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "dependencies": {
    "@beep/identity": "workspace:^",
    "@beep/md": "workspace:^",
    "@beep/provenance": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:"
  }
}
