{
  "name": "@beep/law-practice-server",
  "version": "0.0.0",
  "description": "Law-practice server tier: live Layer surface composing the IR-to-law mapping and office-action review loop over the epistemic server.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/kriegcloud/beep-effect/tree/main/packages/law-practice/server",
  "repository": {
    "type": "git",
    "url": "git@github.com:kriegcloud/beep-effect.git",
    "directory": "packages/law-practice/server"
  },
  "scripts": {
    "audit": "bun run --if-present beep:audit",
    "beep:audit": "bun run beep:build && bun run beep:check && bun run beep:test && bun run beep:lint",
    "beep:build": "tsc -p tsconfig.json",
    "beep:check": "tsgo -p tsconfig.check.json",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run",
    "build": "bun run beep:build",
    "check": "bun run beep:check",
    "coverage": "bunx vitest run --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "lint": "bun run beep:lint",
    "lint:fix": "bun run beep:lint:fix",
    "test": "bun run beep:test",
    "package-test-typecheck": "beep-cli quality test-tsgo-package"
  },
  "exports": {
    ".": "./src/index.ts",
    "./layer": "./src/Layer.ts",
    "./CandorPromotionGate": "./src/CandorPromotionGate/index.ts",
    "./CandorRecord": "./src/CandorRecord/index.ts",
    "./LegalPositionRecord": "./src/LegalPositionRecord/index.ts",
    "./internal/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "dependencies": {
    "@beep/duckdb": "workspace:^",
    "@beep/epistemic-domain": "workspace:^",
    "@beep/epistemic-server": "workspace:^",
    "@beep/epistemic-tables": "workspace:^",
    "@beep/epistemic-use-cases": "workspace:^",
    "@beep/file-processing": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/langextract": "workspace:^",
    "@beep/law-practice-domain": "workspace:^",
    "@beep/law-practice-tables": "workspace:^",
    "@beep/law-practice-use-cases": "workspace:^",
    "@beep/libpff": "workspace:^",
    "@beep/mcp-kit": "workspace:^",
    "@beep/postgres": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/shared-use-cases": "workspace:^",
    "@beep/tika": "workspace:^",
    "@beep/utils": "workspace:^",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/md": "workspace:^",
    "@beep/pglite": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:"
  }
}
