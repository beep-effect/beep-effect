{
  "name": "@beep/law-practice-server",
  "version": "0.0.0",
  "description": "Law-practice server tier: live Layer surface composing the IR-to-law mapping and office-action review loop behind the matter wall.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/kriegcloud/beep-effect/tree/main/packages/law-practice/server",
  "repository": {
    "type": "git",
    "url": "git@github.com:kriegcloud/beep-effect.git",
    "directory": "packages/law-practice/server"
  },
  "scripts": {
    "build": "bun run beep:build",
    "check": "beep-cli gate run check",
    "coverage": "bunx --bun vitest run --coverage --exclude=test/integration/** --exclude=test/PartyContactSource.boundary.test.ts",
    "docgen": "bun run beep:docgen",
    "doctest": "bun run beep:doctest",
    "lint": "bun run beep:lint",
    "lint:deprecated-apis": "beep-cli lint deprecated-apis --package .",
    "lint:fix": "bun run beep:lint:fix",
    "lint:jsdoc": "beep-cli lint jsdoc --package .",
    "lint:laws": "beep-cli lint laws --package .",
    "package-test-typecheck": "beep-cli quality test-tsgo-package",
    "test": "bun run beep:test",
    "test:integration": "bun run beep:test:integration",
    "test:integration:parallel": "bun run beep:test:integration",
    "beep:build": "tsrs -p tsconfig.json --emitDeclarationOnly",
    "beep:check": "tsrs -p tsconfig.json --emitDeclarationOnly && bun run beep:check:tests",
    "beep:docgen": "bunx --bun --no-install docgen",
    "beep:doctest": "BEEP_VITEST_DOCTEST=1 bunx vitest run",
    "beep:lint": "biome check .",
    "beep:lint:fix": "biome check . --write",
    "beep:test": "bunx --bun vitest run --passWithNoTests --exclude=test/integration/** --exclude=test/PartyContactSource.boundary.test.ts && BEEP_GATE_CONTINUES=1 bunx vitest run test/PartyContactSource.boundary.test.ts",
    "beep:test:integration": "bunx --bun vitest run test/integration --passWithNoTests",
    "beep:check:tests": "tsrs -p test/tsconfig.json --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./layer": "./src/Layer.ts",
    "./CandorPromotionGate": "./src/CandorPromotionGate/index.ts",
    "./CandorRecord": "./src/CandorRecord/index.ts",
    "./ClaimInspection": "./src/ClaimInspection/index.ts",
    "./ClaimStore": "./src/ClaimStore/index.ts",
    "./DocketIntake": "./src/DocketIntake/index.ts",
    "./LegalPositionRecord": "./src/LegalPositionRecord/index.ts",
    "./DocumentIdentification": "./src/DocumentIdentification/index.ts",
    "./MailTagging": "./src/MailTagging/index.ts",
    "./MatterAuthority": "./src/MatterAuthority/index.ts",
    "./NoticeMailbox": "./src/NoticeMailbox/index.ts",
    "./internal/*": null,
    "./PracticeKgHost": "./src/PracticeKgHost/index.ts",
    "./ProvenanceTraversal": "./src/ProvenanceTraversal/index.ts",
    "./OfficeActionStructure": "./src/OfficeActionStructure/index.ts",
    "./QuestionCalendar": "./src/QuestionCalendar/index.ts",
    "./ReviewFiles": "./src/ReviewFiles/index.ts",
    "./UsptoClaims": "./src/UsptoClaims/index.ts",
    "./package.json": "./package.json",
    "./PartyContactSource": "./src/PartyContactSource/index.ts"
  },
  "files": [
    "assets/citation-html/**",
    "assets/citation-xml/**",
    "assets/citation-diff/**",
    "assets/citation/**",
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "sideEffects": [],
  "dependencies": {
    "@beep/box": "workspace:^",
    "@beep/csv": "workspace:^",
    "@beep/duckdb": "workspace:^",
    "@beep/epistemic-domain": "workspace:^",
    "@beep/epistemic-tables": "workspace:^",
    "@beep/epistemics": "workspace:^",
    "@beep/eyecite": "workspace:^",
    "@beep/file-processing": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/jsonc": "workspace:^",
    "@beep/langextract": "workspace:^",
    "@beep/law-practice-domain": "workspace:^",
    "@beep/law-practice-tables": "workspace:^",
    "@beep/law-practice-use-cases": "workspace:^",
    "@beep/libpff": "workspace:^",
    "@beep/m365": "workspace:^",
    "@beep/mcp-kit": "workspace:^",
    "@beep/party-use-cases": "workspace:^",
    "@beep/pglite": "workspace:^",
    "@beep/postgres": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/shared-use-cases": "workspace:^",
    "@beep/text": "workspace:^",
    "@beep/tika": "workspace:^",
    "@beep/uspto": "workspace:^",
    "@beep/utils": "workspace:^",
    "@beep/wink": "workspace:^",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@noble/hashes": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@beep/md": "workspace:^",
    "@beep/memfs": "workspace:^",
    "@beep/repo-utils": "workspace:^",
    "@beep/shared-domain": "workspace:^",
    "@beep/test-runner": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "bun-types": "catalog:"
  }
}
