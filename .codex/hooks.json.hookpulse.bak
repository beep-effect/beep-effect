          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/elpresidank/YeeBois/projects/beep-effect5/.codex/hooks/hook-pulse.sh'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/elpresidank/YeeBois/projects/beep-effect5/.codex/hooks/hook-pulse.sh'"
          }
        ]
      }
    ],
    "Stop": [
