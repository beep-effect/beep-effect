{
  "$schema": "../packages/tooling/tool/docgen/schema.json",
  "srcLink": "https://github.com/beep-effect/beep-effect/tree/main/scratchpad/effect-ontology/",
  "srcDir": "effect-ontology",
  "outDir": "effect-ontology/docs",
  "include": ["**/*.ts"],
  "exclude": [
    "effect-ontology/docs/**",
    "effect-ontology/node_modules/**",
    "effect-ontology/test/**",
    "effect-ontology/vitest.config.ts"
  ],
  "enforceDescriptions": true,
  "enforceExamples": true,
  "enforceVersion": true,
  "parseCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2024",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "bun"],
    "paths": {
      "@effect-ontology/index": ["effect-ontology/index.ts"],
      "@effect-ontology/Identity": ["effect-ontology/Domain/Identity.ts"],
      "@effect-ontology/PathLayout": ["effect-ontology/Domain/PathLayout.ts"],
      "@effect-ontology/Schema/EntityFactory": ["effect-ontology/Schema/EntityFactory.ts"],
      "@effect-ontology/Schema/Errors": ["effect-ontology/Schema/Errors.ts"],
      "@effect-ontology/Schema/MentionFactory": ["effect-ontology/Schema/MentionFactory.ts"],
      "@effect-ontology/Schema/RelationFactory": ["effect-ontology/Schema/RelationFactory.ts"],
      "@effect-ontology/Error/*": ["effect-ontology/Domain/Error/*"],
      "@effect-ontology/Model/*": ["effect-ontology/Domain/Model/*"],
      "@effect-ontology/Rdf/*": ["effect-ontology/Domain/Rdf/*"],
      "@effect-ontology/Schema/*": ["effect-ontology/Domain/Schema/*"],
      "@effect-ontology/*": ["effect-ontology/*"]
    }
  },
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2024",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "bun"],
    "allowJs": false,
    "erasableSyntaxOnly": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "stripInternal": false,
    "noErrorTruncation": true,
    "jsx": "react-jsx",
    "paths": {
      "@effect-ontology/index": ["../../index.ts"],
      "@effect-ontology/Identity": ["../../Domain/Identity.ts"],
      "@effect-ontology/PathLayout": ["../../Domain/PathLayout.ts"],
      "@effect-ontology/Schema/EntityFactory": ["../../Schema/EntityFactory.ts"],
      "@effect-ontology/Schema/Errors": ["../../Schema/Errors.ts"],
      "@effect-ontology/Schema/MentionFactory": ["../../Schema/MentionFactory.ts"],
      "@effect-ontology/Schema/RelationFactory": ["../../Schema/RelationFactory.ts"],
      "@effect-ontology/Error/*": ["../../Domain/Error/*"],
      "@effect-ontology/Model/*": ["../../Domain/Model/*"],
      "@effect-ontology/Rdf/*": ["../../Domain/Rdf/*"],
      "@effect-ontology/Schema/*": ["../../Domain/Schema/*"],
      "@effect-ontology/*": ["../../*"]
    }
  }
}
