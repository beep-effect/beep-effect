{
	"name": "@effected/github",
	"version": "0.15.1",
	"private": true,
	"description": "Typed GitHub REST and GraphQL services over the octokit core request surface, with app auth and resource helpers.",
	"keywords": [
		"github",
		"octokit",
		"rest",
		"graphql",
		"app-auth",
		"effect",
		"effected"
	],
	"homepage": "https://github.com/spencerbeggs/effected/tree/main/packages/github#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/effected/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/effected.git",
		"directory": "packages/github"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "turbo run build:dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/github-references": "workspace:^",
		"@effected/semver": "workspace:^",
		"@octokit/core": "^7.0.6",
		"@octokit/plugin-paginate-rest": "^16.0.0",
		"@octokit/types": "^18.0.0",
		"blakejs": "1.2.1",
		"tweetnacl": "1.0.3",
		"universal-github-app-jwt": "^2.2.2",
		"@beep/identity": "workspace:^",
		"@beep/schema": "workspace:^",
		"@beep/utils": "workspace:^"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@savvy-web/bundler": "^2.4.22",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"effect": "catalog:effect:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
