   240	export const SampledRange = S.Struct({
   241	  path: S.String,
   242	  from: ByteCount,
   243	  length: ByteCount,
   244	  bomBytes: ByteCount,
   245	  sampledEnd: ByteCount,
   246	  skipPartialLine: S.Boolean,
   247	}).annotate(
   248	  $I.annote("SampledRange", {
   249	    description: "One bounded page of a sampled historical range, read through the reader's pinned handle.",
   250	  }),
   251	);
   252	
   253	/**
   254	 * One bounded page of a sampled historical range.
   255	 *
   256	 * @internal
   257	 * @category type-level
   258	 * @since 0.0.0
   259	 */
   260	export type SampledRange = typeof SampledRange.Type;
   261	
   262	/**
   263	 * Decode one page of a sampled range through an already open handle.
   264	 *
   265	 * **Details**
   266	 *
   267	 * The handle is the one the reader opened when it sampled the range, so a file
   268	 * renamed over the path afterwards cannot leak into the read: the handle still
   269	 * names the sampled file. Every byte of the page lies inside that sample, so a
   270	 * read that reaches end of file first means the file shrank beneath the reader;
   271	 * it fails `JournalResync` (truncated) with the sampled logical end as
   272	 * `expected` and the handle's current logical size as `actual`, rather than
   273	 * ending the read early as if the history were complete. Like
   274	 * {@link readRangeWindow}, bytes after the final newline are withheld.
   275	 *
   276	 * **Example** (Fail a page the file no longer holds)
   277	 * ```ts
   278	 * import { readSampledWindow } from "@beep/scratchpad/effected/jsonl/internal/tail";
   279	 * import * as MemoryFileSystem from "@beep/test-utils/MemoryFileSystem";
   280	 * import * as Effect from "effect/Effect";
   281	 * const program = Effect.gen(function* () {
   282	 *   const fs = yield* MemoryFileSystem.make;
   283	 *   yield* fs.writeFileString("/events.jsonl", "1\n2\n");
   284	 *   const file = yield* fs.open("/events.jsonl", { flag: "r" });
   285	 *   const page = { path: "/events.jsonl", from: 0, length: 4, bomBytes: 0, sampledEnd: 4, skipPartialLine: false };
   286	 *   const window = yield* readSampledWindow(file, page);
   287	 *   window.text // => "1\n2\n"
   288	 *   yield* fs.writeFileString("/events.jsonl", "");
   289	 *   const error = yield* Effect.flip(readSampledWindow(file, page));
   290	 *   error._tag // => "JournalResync"
   291	 * });
   292	 * await Effect.runPromise(Effect.scoped(program));
   293	 * ```
   294	 *
   295	 * @internal
   296	 * @category resource-management
   297	 * @since 0.0.0
   298	 */
   299	export const readSampledWindow: {
   300	  (
   301	    file: FileSystem.File,
   302	    page: SampledRange,
   303	  ): Effect.Effect<TailWindow, PlatformError.PlatformError | InvalidUtf8 | JournalResync>;
   304	  (
   305	    page: SampledRange,
   306	  ): (file: FileSystem.File) => Effect.Effect<TailWindow, PlatformError.PlatformError | InvalidUtf8 | JournalResync>;
   307	} = dual(
   308	  2,
   309	  Effect.fn("Jsonl.readSampledWindow")(function* (
   310	    file: FileSystem.File,
   311	    page: SampledRange,
   312	  ): Effect.fn.Return<TailWindow, PlatformError.PlatformError | InvalidUtf8 | JournalResync> {
   313	    yield* file.seek(BigInt(page.from), "start");
   314	    const bytes = yield* readBytes(file, page.length);
   315	    if (bytes.length < page.length) {
   316	      const info = yield* file.stat;
   317	      return yield* JournalResync.make({
   318	        path: page.path,
   319	        reason: JournalResyncReason.Enum.truncated,
   320	        expected: page.sampledEnd,
   321	        actual: Math.max(0, ByteSize.toNumberUnsafe(info.size) - page.bomBytes),
   322	      });
   323	    }
   324	    return yield* windowOf(page.path, bytes, page.from, page.length, page.bomBytes, page.skipPartialLine, true);
   325	  }),
   326	);
   327	
   328	/**
   329	 * The BOM width of an open file, read through its handle.
