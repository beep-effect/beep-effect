    35	/** UTF-8 BOM, as bytes. `U+FEFF` encodes to these three. */
    36	const BOM = Tuple.make(0xef, 0xbb, 0xbf);
    37	
    38	/** Byte value of `\n`. Cannot occur inside a UTF-8 multi-byte sequence. */
    39	const LF = 0x0a;
    40	
    41	/**
    42	 * The default tail window.
    43	 *
    44	 * **Details**
    45	 *
    46	 * Large enough that a snapshot journal's last line is almost always inside it
    47	 * on the first read, small enough that reading it is cheap against a journal of
    48	 * any age. When it misses, {@link readTail} widens rather than failing.
    49	 *
    50	 * **Example** (Inspect the initial read budget)
    51	 *
    52	 * ```ts import.meta.vitest name="Inspect the initial read budget"
    53	 * import { DEFAULT_WINDOW } from "@beep/scratchpad/effected/jsonl/internal/tail";
    54	 * DEFAULT_WINDOW // => 8192
    55	 * ```
    56	 *
    57	 * @internal
    58	 * @category constants
    59	 * @since 0.0.0
    60	 */
    61	export const DEFAULT_WINDOW = 8192;
    62	
    63	/**
    64	 * A decoded tail window.
