      "deviations": [
        {
          "test": "scratchpad/test/jsonc/Jsonc.test.ts:362 (adjusts upstream __test__/Jsonc.test.ts:389)",
          "upstreamBehaviour": "a throwing toJSON escapes Jsonc.stringifyResult as the thrown RangeError and Jsonc.stringify as a Cause.Die defect",
          "labBehaviour": "Jsonc.stringifyResult fails with JsoncStringifyError code SerializationFailed (its detail is the codec's sentence, not the thrown message; see the detail deviation); Jsonc.stringify fails typed with it",
          "reason": "law:7 (typed errors via S.TaggedError) + law:13 (schema transformation over ad-hoc serialization); upstream CLAUDE.md hardening invariant requires hostile input to fail through the typed channel"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncModifier.test.ts:232 (tighten upstream __test__/JsoncModifier.test.ts:162 and :171)",
          "upstreamBehaviour": "multi-line inserted values keep column-0 layout after the first line, so nested members sit one level too shallow",
          "labBehaviour": "every line after the first is prefixed with the insertion indent, aligning the nested value with its siblings",
          "reason": "upstream-bug: modify('{\\n  \"a\": 1\\n}', ['b'], {c:{d:1}}) applies upstream with the nested object mis-indented; upstream tests only assert include('\\t\"b\"')"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncEdit.test.ts:87 and :42 (adjust upstream __test__/JsoncEdit.test.ts:47)",
          "upstreamBehaviour": "JsoncEdit.applyAll throws a native Error ending 'overlapping edits are a programmer error'",
          "labBehaviour": "JsoncEdit.applyAll throws the tagged JsoncEditOverlapError {lower, upper}; JsoncEdit.applyAllResult returns it as a Result failure",
          "reason": "law:7 (no native Error in production source; extend S.TaggedError)"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncModifier.test.ts:91 and scratchpad/test/jsonc/Properties.test.ts (JsoncModifier insert property)",
          "upstreamBehaviour": "with a trailing comma before the closer, navigate scans past the closer and inserts outside the container: modify('{ \"a\": 1, }', ['delta'], []) yields '{ \"a\": 1, },\\n  \"delta\": []' (unparseable); '{ \"a\": { \"b\": 1, } }' at ['a','c'] writes c into the parent; '[1, ]' at [1] yields '[1, ,\\n  2]'",
          "labBehaviour": "a comma followed by the closer ends the scan, so the insertion lands after the last member inside the container and the result parses to the expected value",
          "reason": "upstream-bug: the default JSONC options accept trailing commas, and the property 'JsoncModifier insert' (result parses to {...doc, delta: next}) fails upstream on '{ \"a\": 1, }'; upstream tests never insert into a trailing-comma container"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncFormatter.test.ts:56 and scratchpad/test/jsonc/Properties.test.ts:395 (no upstream test passes unbalanced closers)",
          "upstreamBehaviour": "JsoncFormatter.format and formatToString throw RangeError (indentUnit.repeat(-1)) on any surplus closer: ']]', '{\"a\":1}}', '[1]]'",
          "labBehaviour": "format is total: a surplus closer formats with no indent, every edit still rewrites whitespace only",
          "reason": "upstream-bug: a RangeError defect escapes a formatter on hostile input, violating upstream's own hardening invariant (malformed input fails typed, never as a defect) and the format-package convention C1"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncVisitor.test.ts:68",
          "upstreamBehaviour": "JsoncVisitor.visit wraps one generator object in Stream.fromIterable, so a second run of the same stream yields no events (probe: 5 events, then 0)",
          "labBehaviour": "each run of the stream creates a fresh generator, so every run yields the same events",
          "reason": "upstream-bug: a generator object's [Symbol.iterator]() returns itself, so the per-run iterator re-acquisition resumes an exhausted generator; a Stream is a re-runnable description everywhere else in Effect"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncModifier.test.ts:254",
          "upstreamBehaviour": "JsoncModifier.modify serializes with JSON.stringify, so a bigint, a cycle or a throwing toJSON escapes as a defect; the only typed failure is JsoncModificationError",
          "labBehaviour": "modify fails typed with JsoncStringifyError (BigIntValue, CircularReference or SerializationFailed) on the whole-document, replace and insert paths",
          "reason": "law:7 (typed errors via S.TaggedError instead of escaping native exceptions); same cause as the recorded stringifyResult deviation"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncModifier.test.ts:58",
          "upstreamBehaviour": "JsoncModificationError.offset is Schema.optionalKey(Schema.Number), so Infinity or NaN decode and render",
          "labBehaviour": "offset is S.optionalKey(S.Finite), so a non-finite offset fails decoding; modify never sets offset",
          "reason": "law:tsgo-schemaNumber (effect(schemaNumber) is an error in tsconfig.base.json: S.Number admits NaN and Infinity) and schema-first precision"
        },
        {
          "test": "scratchpad/test/jsonc/Jsonc.test.ts:650 (\"carries the schema codec's sentence as detail for every thrown failure\"); upstream __test__/Jsonc.test.ts:330 and :342 assert only code, so no upstream assertion changes",
          "upstreamBehaviour": "Jsonc.stringifyResult catches the engine's TypeError and stores its message as detail (JavaScriptCore: \"JSON.stringify cannot serialize BigInt.\" and \"JSON.stringify cannot serialize cyclic structures.\"; upstream's JSDoc says the V8 cycle message also names the property path)",
          "labBehaviour": "for BigIntValue, CircularReference and SerializationFailed detail is \"Expected a JSON-serializable value\", the message of the schema issue the S.fromJsonString codec reports; code still names the cause and equals upstream's for bigints (primitive or boxed) and cycles; TopLevelUnrepresentable keeps upstream's sentence",
          "reason": "law:13 (schema transformations over ad-hoc serialization) plus the JSON-codec rule of standards/effect-first-development.md:104 / effect-first skill law 22 (never JSON.parse or JSON.stringify; use schema JSON codecs): only a direct JSON.stringify inside a try can observe the thrown message, and the codec's getter discards it"
        },
        {
          "test": "scratchpad/test/jsonc/Jsonc.test.ts:669 (\"classifies a caller-thrown TypeError as SerializationFailed whatever its message says\")",
          "upstreamBehaviour": "every caught TypeError is classified by matching its message against /circular|cyclic/i and /bigint/i, so a toJSON or getter that throws TypeError(\"my bigint thing\") returns a typed BigIntValue failure with the caller's message as detail, and TypeError(\"circular dependency\") returns CircularReference",
          "labBehaviour": "the code comes from the value the engine refused (bigint by internal slot, cycle by ancestor identity); any throw from caller code is SerializationFailed",
          "reason": "upstream-bug: upstream's own JSDoc for stringifyResult says a throwing toJSON method or getter \"is caller code failing and rethrows as a defect, never a typed error\"; the message heuristic contradicts it for a TypeError mentioning one of the three words (probe: stringifyResult({ toJSON() { throw new TypeError(\"my bigint thing\") } }) returns BigIntValue), and upstream __test__/Jsonc.test.ts:389 throws a RangeError, which the heuristic never reaches"
        },
        {
          "test": "scratchpad/test/jsonc/Jsonc.test.ts:710, scratchpad/test/jsonc/JsoncFormatter.test.ts:152 and scratchpad/test/jsonc/JsoncModifier.test.ts:360 (each \"rejects a non-finite width\"); no upstream test passes a non-finite width",
          "upstreamBehaviour": "tabSize is Schema.optionalKey(Schema.Number) on JsoncStringifyOptions and JsoncFormattingOptions, so NaN and the infinities are accepted: stringifyResult reads NaN and -Infinity as compact and Infinity as ten spaces; with insertSpaces true, format and modify read NaN as no indent and fail with a RangeError for either infinity",
          "labBehaviour": "both fields are S.Finite with the default 2; every finite width is accepted, and a non-finite one is rejected when the options are constructed or decoded (make throws, so format and formatToString throw and modify dies on a literal that carries one)",
          "reason": "law:tsgo-schemaNumber (effect(schemaNumber) is an error in tsconfig.base.json: S.Number admits NaN and Infinity); same cause as the JsoncModificationError.offset deviation"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncFormatter.test.ts:138 (\"formats a width of -1 or below with no indent instead of throwing\") and scratchpad/test/jsonc/JsoncModifier.test.ts:344 (\"stays total for a width of -1 or below, with no indent\"); no upstream test passes a negative width",
          "upstreamBehaviour": "with insertSpaces true, JsoncFormatter.format, formatToString and JsoncModifier.modify build the indent unit with \" \".repeat(tabSize), which throws a RangeError for a width of -1 or below; modify builds it before navigating, so every call dies, deletions and no-ops included",
          "labBehaviour": "Str.repeat clamps the unit to the empty string: the formatter breaks lines without indenting and modify inserts unindented entries around a compact value; widths between -1 and 0, fractional widths and insertSpaces false behave exactly as upstream",
          "reason": "upstream-bug: a RangeError defect escapes format and formatToString, which upstream documents as pure and total, and modify, on an option value upstream's own schema accepts; same family as the surplus-closer formatter deviation"
        }
