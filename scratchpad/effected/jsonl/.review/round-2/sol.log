    79	  { text: S.String, start: ByteCount, atFileStart: S.Boolean, size: ByteCount },
    80	  $I.annote("TailWindow", {
    81	    description: "A tail read beginning at a line boundary, with post-BOM offsets.",
    82	  }),
    83	) {
    84	}
    85	
    86	/** Does the buffer begin with a UTF-8 BOM? */
    87	const hasBom = (bytes: Uint8Array): boolean =>
    88	  bytes.length >= 3 && bytes[0] === BOM[0] && bytes[1] === BOM[1] && bytes[2] === BOM[2];
    89	
    90	/** Read up to the bounded byte count, tolerating successful short reads. */
    91	const readBytes = Effect.fn("Jsonl.readBytes")(function* (file: FileSystem.File, length: number) {
    92	  const bytes = new Uint8Array(length);
    93	  let offset = 0;
    94	  while (offset < length) {
    95	    const chunk = yield* file.readAlloc(Math.min(length - offset, CHUNK));
    96	    if (O.isNone(chunk) || chunk.value.length === 0) break;
    97	    bytes.set(chunk.value, offset);
    98	    offset += chunk.value.length;
    99	  }
   100	  return bytes.subarray(0, offset);
   101	});
   102	
   103	/** Index just past the first newline, or the buffer length when it holds none. */
   104	const afterFirstNewline = (bytes: Uint8Array): number => {
   105	  const newline = bytes.indexOf(LF);
   106	  return newline === -1 ? bytes.length : newline + 1;
   107	};
   108	
   109	/** Decode the bytes read at `from` into a window with logical offsets. */
   110	const windowOf = Effect.fn("Jsonl.windowOf")(function* (
   111	  path: string,
   112	  bytes: Uint8Array,
   113	  from: number,
   114	  length: number,
   115	  bomBytes: number,
   116	  skipPartialLine: boolean,
   117	  completeOnly: boolean,
   118	): Effect.fn.Return<TailWindow, InvalidUtf8> {
   119	  // Both scans use the typed-array natives, as upstream does: they search the
   120	  // bytes in place, where an Array helper first copies the whole window into a
   121	  // Number array. `lastIndexOf` returns -1 for a window without a newline, so
   122	  // `end` is then 0 and nothing of the unfinished line is decoded.
   123	  const cursor = skipPartialLine ? afterFirstNewline(bytes) : 0;
   124	  const end = completeOnly ? bytes.lastIndexOf(LF) + 1 : bytes.length;
   125	  // Discard byte fragments before decoding. A cursor can point into a UTF-8
   126	  // sequence, and an unfinished suffix can contain a pending multi-byte code point.
   127	  const text = yield* Effect.try({
   128	    try: () => new TextDecoder("utf-8", {
   129	      fatal: true,
   130	      ignoreBOM: true,
   131	    }).decode(bytes.subarray(cursor, end)),
   132	    catch: (cause) => InvalidUtf8.make({ path, offset: from + cursor, cause }),
   133	  });
   134	  return TailWindow.make({
   135	    text,
   136	    start: from + cursor - bomBytes,
   137	    size: from + length - bomBytes,
   138	    atFileStart: from === bomBytes,
   139	  });
   140	});
   141	
   142	const readWindow = Effect.fn("Jsonl.readWindow")(function* (
   143	  fs: FileSystem.FileSystem,
   144	  path: string,
   145	  from: number,
   146	  length: number,
   147	  bomBytes: number,
   148	  skipPartialLine: boolean,
   149	  completeOnly: boolean,
   150	): Effect.fn.Return<TailWindow, PlatformError.PlatformError | InvalidUtf8, Scope.Scope> {
   151	  const file = yield* fs.open(path, { flag: "r" });
   152	  yield* file.seek(BigInt(from), "start");
   153	  const bytes = yield* readBytes(file, length);
   154	  return yield* windowOf(path, bytes, from, length, bomBytes, skipPartialLine, completeOnly);
   155	}, Effect.scoped);
