 * @invariant `id` and `title` are non-empty.
 * @category models
 * @since 0.0.0
 */
export class TaskInput extends S.Class<TaskInput>($I`TaskInput`)(
  {
    id: S.NonEmptyString,
    title: S.NonEmptyString,
  },
  $I.annote("TaskInput", {
    description: "Validated input for creating a task.",
