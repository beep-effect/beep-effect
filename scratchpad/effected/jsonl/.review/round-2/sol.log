  let swap = false;
  const journal = yield* open({ ...fs, watch: () => Stream.never, stat: (target) => Effect.gen(function* () {
    const info = yield* fs.stat(target);
    if (swap && target===path) { swap=false; yield* fs.rename(\"/journal/new\",path); }
    return info;
  }) });
  yield* settle;
  yield* externalAppend(fs,line(2));
  swap = true;
  const appended = yield* journal.append(\"noted\",{ round:3,label:\"seed\" });
