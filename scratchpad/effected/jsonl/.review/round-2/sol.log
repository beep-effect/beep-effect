   165	 * post-BOM offsets; size records the sampled range end, including withheld bytes.
   166	 *
   167	 * **Example** (Hold an unfinished multi-byte suffix)
   168	 * ```ts
   169	 * import { readRangeWindow } from "@beep/scratchpad/effected/jsonl/internal/tail";
   170	 * import * as MemoryFileSystem from "@beep/test-utils/MemoryFileSystem";
   171	 * import { Effect } from "effect";
   172	 * const program = Effect.gen(function* () {
   173	 *   const fs = yield* MemoryFileSystem.make;
   174	 *   yield* fs.writeFile("/events.jsonl", new Uint8Array([0x34, 0x32, 0x0a, 0xe2]));
   175	 *   const window = yield* readRangeWindow(fs, "/events.jsonl", 0, 4, 0);
   176	 *   window.text // => "42\n"
   177	 *   window.size // => 4
   178	 * });
   179	 * await Effect.runPromise(program);
   180	 * ```
   181	 * @internal
   182	 * @category resource-management
   183	 * @since 0.0.0
   184	 */
   185	export const readRangeWindow: {
   186	  (
   187	    fs: FileSystem.FileSystem,
   188	    path: string,
   189	    from: number,
   190	    length: number,
   191	    bomBytes: number,
   192	    skipPartialLine?: boolean,
   193	  ): Effect.Effect<TailWindow, PlatformError.PlatformError | InvalidUtf8>;
   194	  (
   195	    path: string,
   196	    from: number,
   197	    length: number,
   198	    bomBytes: number,
   199	    skipPartialLine?: boolean,
   200	  ): (fs: FileSystem.FileSystem) => Effect.Effect<TailWindow, PlatformError.PlatformError | InvalidUtf8>;
   201	} = dual(
   202	  (args) => P.isObject(args[0]),
   203	  Effect.fn("Jsonl.readRangeWindow")(
   204	    (
   205	      fs: FileSystem.FileSystem,
   206	      path: string,
   207	      from: number,
   208	      length: number,
   209	      bomBytes: number,
   210	      skipPartialLine = false,
   211	    ) => readWindow(fs, path, from, length, bomBytes, skipPartialLine, true),
   212	  ),
   213	);
