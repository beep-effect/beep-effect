   442	export const JournalConfig = S.Struct({
   443	  /** Journal path; construction permits a missing file. */
   444	  path: S.String,
   445	  /** Directory to watch until creation; defaults to the parent of path. */
   446	  directory: S.optional(S.String),
   447	  /** Backpressured subscriber capacity; defaults to 64. */
   448	  capacity: S.optional(Capacity),
   449	  /** Bound on graceful shutdown publication, as any Duration.Input; defaults to five seconds. */
   450	  shutdownPublishTimeout: S.optional(DurationInput),
