  console.log(\"NODE reconciliation\", JSON.stringify({ append:[appended.line.offset,appended.line.end], query:queried.map(row=>[row.data.round,row.line.offset,row.line.end]) }));
})));
await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
  const fs = yield* memory();
  const journal = yield* open({...fs,watch:()=>Stream.never},{path,capacity:1});
  yield* journal.create;
  yield* settle;
  const sub=yield* PubSub.subscribe(journal.hub);
  yield* externalAppend(fs,line(1)+line(2)+line(3));
  const fourth=yield* journal.append(\"noted\",{round:4,label:\"seed\"}).pipe(Effect.forkChild({startImmediately:true}));
  const fifth=yield* journal.append(\"noted\",{round:5,label:\"seed\"}).pipe(Effect.forkChild({startImmediately:true}));
  const sixth=yield* journal.append(\"noted\",{round:6,label:\"seed\"}).pipe(Effect.forkChild({startImmediately:true}));
  yield* settle;
  yield* Fiber.interrupt(fifth);
  const rows=[];
  for(let i=0;i<5;i++) rows.push((yield* PubSub.take(sub))[0].data.round);
  yield* Fiber.join(fourth); yield* Fiber.join(sixth);
  console.log(\"NODE publication\",JSON.stringify(rows));
})));
await Effect.runPromise(Effect.scoped(Effect.gen(function* () {
