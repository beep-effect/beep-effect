   465	 * Bounded rather than indefinite: a subscriber that never consumes cannot
   466	 * observe completion, so waiting on it forever only converts "one stuck
   467	 * subscriber" into "the process cannot shut down".
   468	 */
   469	const SHUTDOWN_PUBLISH_TIMEOUT = Duration.seconds(5);
