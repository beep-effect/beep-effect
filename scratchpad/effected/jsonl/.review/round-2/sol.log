   364	  days: S.optional(DurationNumber),
   365	  hours: S.optional(DurationNumber),
   366	  minutes: S.optional(DurationNumber),
   367	  seconds: S.optional(DurationNumber),
   368	  milliseconds: S.optional(DurationNumber),
   369	  microseconds: S.optional(DurationNumber),
   370	  nanoseconds: S.optional(DurationNumber),
   371	}).annotate(
   372	  $I.annote("DurationObject", { description: "Additive duration components accepted by Duration.fromInput." })
