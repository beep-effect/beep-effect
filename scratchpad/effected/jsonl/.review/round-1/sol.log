116:export const matchesFrame: {
117:  (frame: EnvelopeFrame, slice: Slice<JsonlEvent.Registry, string> | undefined): boolean;
118:  (slice: Slice<JsonlEvent.Registry, string> | undefined): (frame: EnvelopeFrame) => boolean;
119:} = dual(2, (frame: EnvelopeFrame, slice: Slice<JsonlEvent.Registry, string> | undefined): boolean => {
120:  if (P.isUndefined(slice)) {
121:    return true;
122:  }
123:  if (P.isNotUndefined(slice.events) && !A.contains(slice.events, frame.event)) {
124:    return false;
125:  }
126:  if (P.isNotUndefined(slice.scopes)) {
127:    if (P.isUndefined(frame.scope) || !A.contains(slice.scopes, frame.scope)) {
128:      return false;
129:    }
130:  }
131:  const millis = frame.at.epochMilliseconds;
132:  if (
133:    P.isNotUndefined(slice.from) && millis < slice.from.epochMilliseconds) {
134:    return false;
135:  }
136:  return !(P.isNotUndefined(slice.to) && millis >= slice.to.epochMilliseconds);
137:});
