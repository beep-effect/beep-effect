560:const textEncoder = new TextEncoder();
561:
562:const decodeWindow = <R extends JsonlEvent.Registry>(events: R, window: TailWindow): O.Option<EnvelopeUnion<R>> =>
563:  O.map(Envelope.lastValidResult(window.text, events), (envelope) => ({
564:    ...envelope,
565:    line: LineSlice.rebase(envelope.line, window.start),
566:  }));
567:
568:const makeEngine = Effect.fn("Journal.makeEngine")(function* <R extends JsonlEvent.Registry>(
569:  events: R,
570:  config: typeof JournalSettings.Type,
571:  fs: FileSystem.FileSystem
572:): Effect.fn.Return<JournalShape<R>, PlatformError.PlatformError | InvalidUtf8, Scope.Scope> {
573:  const terminalTags = HashSet.fromIterable(
574:    A.map(
575:      A.filter(events, (event) => event.terminal),
576:      (event) => event.tag
577:    )
578:  );
579:  const reopenTags = HashSet.fromIterable(
580:    A.map(
581:      A.filter(events, (event) => event.reopen),
582:      (event) => event.tag
583:    )
584:  );
585:
587:  const writePermit = Semaphore.makeUnsafe(1);
600:  let publishBaton: Deferred.Deferred<void> = Deferred.makeUnsafe<void>();
601:  Deferred.doneUnsafe(publishBaton, Exit.void);
603:  let bomBytes = 0;
614:  let identity: O.Option<string> = O.none();
615:  const hub = yield* PubSub.bounded<Take.Take<EnvelopeUnion<R>, JsonlError>>(config.capacity);
616:  const latest = yield* SubscriptionRef.make(O.none<EnvelopeUnion<R>>());
618:  let closed = false;
620:  let consumed = 0;
621:
622:  const exists = fs.exists(config.path);
623:
624:  const requireFile = Effect.gen(function* () {
625:    const present = yield* exists;
626:    if (!present) {
627:      return yield* JournalNotFound.make({ path: config.path });
628:    }
629:  });
630:
631:  const readLatest = Effect.gen(function* () {
632:    yield* requireFile;
633:    return yield* readTailUntil(
634:      fs,
635:      config.path,
636:      bomBytes,
637:      (window) => decodeWindow(events, window),
638:      DEFAULT_WINDOW,
639:      true
640:    );
641:  });
642:
643:  const refresh = Effect.gen(function* () {
644:    const found = yield* readLatest;
645:    yield* SubscriptionRef.set(latest, found);
646:    return found;
647:  });
648:
649:  const isTerminalTail = Effect.gen(function* () {
650:    const current = yield* SubscriptionRef.get(latest);
651:    return O.isSome(current) && HashSet.has(terminalTags, current.value.event);
652:  });
653:
671:  const decodeRange = Effect.fn("Journal.decodeRange")(function* (from: number, to: number) {
672:    const window = yield* readRangeWindow(fs, config.path, from + bomBytes, to - from, bomBytes);
673:    const advanced = window.start + utf8Length(window.text);
674:    let decoded = Chunk.empty<EnvelopeUnion<R>>();
675:    for (const line of Line.split(window.text)) {
676:      if (Line.isBlank(line)) continue;
677:      const rebased = LineSlice.rebase(line, window.start);
678:      const envelope = Envelope.decodeResult(rebased, events);
679:      if (Result.isSuccess(envelope)) decoded = Chunk.append(decoded, envelope.success);
680:    }
681:    return {
682:      decoded: A.fromIterable(decoded),
683:      advanced,
684:      torn:
685:        advanced < window.size
686:          ? O.some(JournalUnterminated.make({ path: config.path, offset: advanced, end: window.size }))
687:          : O.none<JournalUnterminated>(),
688:    };
689:  });
690:
691:  const identityOf = (info: FileSystem.File.Info): O.Option<string> => O.map(info.ino, (ino) => `${info.dev}:${ino}`);
692:
693:  // Caller owns writePermit. This stage changes state but never waits on a
694:  // subscriber. Both local writes and watch pokes reconcile through it.
695:  const reconcile = Effect.fn("Journal.reconcile")(function* (
696:    restore: <AX, EX, RX>(effect: Effect.Effect<AX, EX, RX>) => Effect.Effect<AX, EX, RX>
697:  ) {
698:    yield* restore(requireFile);
699:    const info = yield* restore(fs.stat(config.path));
700:    const currentIdentity = identityOf(info);
701:    const size = ByteSize.toNumberUnsafe(info.size);
702:    const replaced = O.isSome(identity) && O.isSome(currentIdentity) && identity.value !== currentIdentity.value;
703:    const shrank = size < consumed + bomBytes;
704:    const bom = replaced || shrank || O.isNone(identity) ? yield* restore(probeBomBytes(fs, config.path)) : bomBytes;
705:    const logicalSize = size - bom;
706:    if (replaced || shrank) {
707:      const failure = JournalResync.make({
708:        path: config.path,
709:        reason: replaced ? JournalResyncReason.Enum.replaced : JournalResyncReason.Enum.truncated,
710:        expected: consumed,
711:        actual: logicalSize,
712:      });
713:      yield* Effect.logWarning("Journal source requires resynchronization").pipe(
714:        Effect.annotateLogs({
715:          path: config.path,
716:          reason: failure.reason,
717:          expected: failure.expected,
718:          actual: failure.actual,
719:        })
720:      );
721:      identity = currentIdentity;
722:      bomBytes = bom;
723:      consumed = 0;
724:      yield* SubscriptionRef.set(latest, O.none());
725:      const entries: ReadonlyArray<Take.Take<EnvelopeUnion<R>, JsonlError>> = [Exit.fail(failure)];
726:      return {
727:        entries,
728:        failure: O.some<JournalResync | InvalidUtf8>(failure),
729:        torn: O.none<JournalUnterminated>(),
730:        size,
731:      };
732:    }
733:    bomBytes = bom;
734:    const reading = yield* restore(decodeRange(consumed, logicalSize)).pipe(
735:      Effect.map(Result.succeed),
736:      Effect.catchTag("InvalidUtf8", flow(Result.fail, Effect.succeed))
737:    );
738:    if (Result.isFailure(reading)) {
739:      const failure = reading.failure;
740:      const entries: ReadonlyArray<Take.Take<EnvelopeUnion<R>, JsonlError>> = [Exit.fail(failure)];
741:      return {
742:        entries,
743:        failure: O.some<JournalResync | InvalidUtf8>(failure),
744:        torn: O.none<JournalUnterminated>(),
745:        size,
746:      };
747:    }
748:    const range = reading.success;
749:    identity = currentIdentity;
750:    consumed = range.advanced;
751:    const last = A.last(range.decoded);
752:    if (O.isSome(last)) yield* SubscriptionRef.set(latest, last);
753:    const entries: ReadonlyArray<Take.Take<EnvelopeUnion<R>, JsonlError>> = A.map(range.decoded, (row) => [row]);
754:    return {
755:      entries,
756:      failure: O.none<JournalResync | InvalidUtf8>(),
757:      torn: range.torn,
758:      size,
759:    };
760:  });
761:
762:  const publish = Effect.fn("Journal.publish")(function* (
763:    entries: ReadonlyArray<Take.Take<EnvelopeUnion<R>, JsonlError>>,
764:    predecessor: Deferred.Deferred<void>
765:  ) {
766:    yield* Deferred.await(predecessor);
767:    for (const entry of entries) yield* PubSub.publish(hub, entry);
768:  });
769:
771:  const appendWith = Effect.fn("Journal.appendWith")(function* (
772:    event: string,
773:    build: (current: O.Option<EnvelopeUnion<R>>) => unknown,
774:    scope: string | undefined
775:  ): Effect.fn.Return<EnvelopeUnion<R>, JournalWriteError> {
776:    if (closed) return yield* JournalClosed.make({ event });
777:    const mine = Deferred.makeUnsafe<void>();
778:    // Install cleanup BEFORE the permit can link this deferred. This covers
779:    // interruption during permit release as well as suspended publication.
780:    return yield* Effect.gen(function* () {
781:      const staged = yield* writePermit.withPermits(1)(
782:        Effect.uninterruptibleMask(
783:          Effect.fn("Journal.stageAppend")(function* (restore) {
784:            if (closed) return yield* JournalClosed.make({ event });
785:            const state = yield* reconcile(restore);
786:            const outcome: Exit.Exit<EnvelopeUnion<R>, JournalWriteError> = O.isSome(state.failure)
787:              ? Exit.fail(state.failure.value)
788:              : yield* Effect.exit(
789:                  Effect.gen(function* () {
790:                    const current = yield* SubscriptionRef.get(latest);
791:                    if (
792:                      O.isSome(current) &&
793:                      HashSet.has(terminalTags, current.value.event) &&
794:                      !HashSet.has(reopenTags, event)
795:                    ) {
796:                      return yield* TerminalViolation.make({ event, terminal: current.value.event });
797:                    }
798:                    if (O.isSome(state.torn)) return yield* state.torn.value;
799:                    const at = yield* DateTime.now;
800:                    const encoded = Envelope.encodeResult<JsonlEvent.Registry>(
801:                      { event, data: build(current), at, ...O.getSomesStruct({ scope: O.fromUndefinedOr(scope) }) },
802:                      events
803:                    );
804:                    if (Result.isFailure(encoded)) return yield* encoded.failure;
805:                    const bytes = textEncoder.encode(encoded.success);
806:                    const decoded = Envelope.decodeResult(
807:                      LineSlice.make({
808:                        offset: 0,
809:                        end: bytes.length,
810:                        length: bytes.length - 1,
811:                        text: Str.slice(0, -1)(encoded.success),
812:                        terminated: true,
813:                      }),
814:                      events
815:                    );
816:                    if (Result.isFailure(decoded)) return yield* decoded.failure;
817:                    const actual = yield* restore(
818:                      Effect.scoped(
819:                        Effect.gen(function* () {
820:                          const file = yield* fs.open(config.path, { flag: "a" });
821:                          yield* file.writeAll(bytes);
822:                          return ByteSize.toNumberUnsafe((yield* file.stat).size);
823:                        })
824:                      )
825:                    );
826:                    const expected = state.size + bytes.length;
827:                    // EOF is shared by cooperating writers. Unexpected growth cannot
828:                    // prove our line's position; leave consumed at the known boundary
829:                    // so the next reconciliation reads the real file in its own order.
830:                    if (actual !== expected)
831:                      return yield* JournalWriteConflict.make({ path: config.path, expected, actual });
832:                    const line = LineSlice.make({
833:                      ...decoded.success.line,
834:                      offset: state.size - bomBytes,
835:                      end: actual - bomBytes,
836:                    });
837:                    const envelope = { ...decoded.success, line };
838:                    consumed = line.end;
839:                    yield* SubscriptionRef.set(latest, O.some(envelope));
840:                    return envelope;
841:                  })
842:                );
843:            const entries = Exit.isSuccess(outcome)
844:              ? A.append(state.entries, [outcome.value] satisfies Take.Take<EnvelopeUnion<R>, JsonlError>)
845:              : state.entries;
846:            const predecessor = publishBaton;
847:            publishBaton = mine;
848:            return { entries, predecessor, outcome };
849:          })
850:        )
851:      );
852:      yield* publish(staged.entries, staged.predecessor);
853:      return yield* staged.outcome;
854:    }).pipe(Effect.ensuring(Deferred.done(mine, Exit.void)));
855:  });
856:
874:  const decodeSelection = S.decodeUnknownEffect(S.UndefinedOr(CursoredSlice(S.String)));
875:  const validateSelection = Effect.fn("Journal.validateSelection")((slice: unknown) =>
876:    decodeSelection(slice).pipe(Effect.mapError((error) => InvalidSlice.make({ error })))
877:  );
878:
879:  const readFrom = (
880:    input: CursoredSlice<R, JsonlEvent.Tag<R>> | undefined
881:  ): Stream.Stream<EnvelopeUnion<R>, JournalReadError | JsonlError> =>
882:    Stream.unwrap(
883:      Effect.gen(function* () {
884:        const slice = yield* validateSelection(input);
885:        yield* requireFile;
886:        const from = slice?.cursor ?? 0;
887:        const bom = yield* probeBomBytes(fs, config.path);
888:        const info = yield* fs.stat(config.path);
889:        const logicalSize = ByteSize.toNumberUnsafe(info.size) - bom;
890:        if (from >= logicalSize) {
891:          return Stream.empty;
892:        }
893:        // Pin the sampled file. Every page is read through this one handle, so
894:        // a file renamed over the path later cannot leak into the range, and
895:        // a truncation surfaces as a short page instead of an early end. A
896:        // replacement between the stat above and this open is caught here.
897:        const file = yield* fs.open(config.path, { flag: "r" });
898:        const pinned = yield* file.stat;
899:        const sampledIdentity = identityOf(info);
900:        const pinnedIdentity = identityOf(pinned);
901:        if (
902:          O.isSome(sampledIdentity) &&
903:          O.isSome(pinnedIdentity) &&
904:          sampledIdentity.value !== pinnedIdentity.value
905:        ) {
906:          return yield* JournalResync.make({
907:            path: config.path,
908:            reason: JournalResyncReason.Enum.replaced,
909:            expected: logicalSize,
910:            actual: Math.max(0, ByteSize.toNumberUnsafe(pinned.size) - bom),
911:          });
912:        }
913:        // Capture one absolute range. Growth after this snapshot must not
914:        // move its start or extend its end. The preceding byte establishes
915:        // whether the cursor is at a boundary or inside a partial line.
916:        const start = Math.max(0, from - 1);
917:        const readPage = (position: number, length: number) =>
918:          readSampledWindow(file, {
919:            path: config.path,
920:            from: position + bom,
921:            length,
922:            bomBytes: bom,
923:            sampledEnd: logicalSize,
924:            skipPartialLine: position === start && start > 0,
925:          });
926:        return Stream.paginate(
927:          start,
928:          Effect.fn("Journal.readPage")(function* (position) {
929:            let length = Math.min(DEFAULT_WINDOW, logicalSize - position);
930:            let window = yield* readPage(position, length);
931:            while (Str.isEmpty(window.text) && position + length < logicalSize) {
932:              length = Math.min(length * 2, logicalSize - position);
933:              window = yield* readPage(position, length);
934:            }
935:            const advanced = window.start + utf8Length(window.text);
936:            const next = advanced > position && advanced < logicalSize ? O.some(advanced) : O.none<number>();
937:            let selected = Chunk.empty<Result.Result<EnvelopeUnion<R>, JsonlError>>();
938:            for (const line of Line.split(window.text)) {
939:              if (Line.isBlank(line)) continue;
940:              const rebased = LineSlice.rebase(line, window.start);
941:              if (rebased.offset < from) continue;
942:              // Frame filtering precedes payload decoding on every page.
943:              const decoded = Envelope.decodeSelectedResult(rebased, events, (frame) => matchesFrame(frame, slice));
944:              if (O.isNone(decoded)) continue;
945:              selected = Chunk.append(selected, decoded.value);
946:              if (Result.isFailure(decoded.value)) return Tuple.make(Chunk.toReadonlyArray(selected), O.none<number>());
947:            }
948:            return Tuple.make(Chunk.toReadonlyArray(selected), next);
949:          })
950:        ).pipe(Stream.mapEffect(Effect.fromResult));
951:      })
952:    );
953:
966:  const matchesEnvelope = <T extends JsonlEvent.Tag<R>>(
967:    envelope: EnvelopeUnion<R>,
968:    slice: CursoredSlice<R, T> | undefined
969:  ): envelope is EnvelopeWithTag<R, T> =>
970:    matchesFrame(
971:      {
972:        at: envelope.at,
973:        event: envelope.event,
974:        ...O.getSomesStruct({ scope: O.fromUndefinedOr(envelope.scope) }),
975:        data: envelope.data,
976:      },
977:      slice
978:    );
979:
980:  const isTerminalEnvelope = (envelope: EnvelopeUnion<R>): boolean => HashSet.has(terminalTags, envelope.event);
981:
982:  const changesStream = (
983:    input: CursoredSlice<R, JsonlEvent.Tag<R>> | undefined
984:  ): Stream.Stream<EnvelopeUnion<R>, JournalReadError | JsonlError> =>
985:    Stream.unwrap(
986:      Effect.gen(function* () {
987:        yield* validateSelection(input);
988:        const slice = input;
989:        // Validation precedes subscription acquisition, including no-replay reads.
990:        // Quiescent already? A terminal Exit published before this
991:        // subscriber attached is invisible to it — a hub has no replay — so
992:        // without this check the stream would wait for an event that has
993:        // already happened. Ending here is what makes "terminates rather
994:        // than hangs" true.
995:        const alreadyQuiescent = yield* isTerminalTail;
996:        const replay = slice?.cursor === undefined ? Stream.empty : readFrom(slice);
997:        if (alreadyQuiescent || closed) {
998:          return replay;
999:        }
1000:        // SUBSCRIBE BEFORE REPLAYING, and do it here rather than through
1001:        // `Stream.fromPubSubTake`. That constructor subscribes on its first
1002:        // pull, which `Stream.concat` does not reach until the replay has
1003:        // finished — and a hub has no replay of its own, so every append
1004:        // published while the history was being read was dropped on the
1005:        // floor. Subscribing in the effect the stream is unwrapped from puts
1006:        // the subscription strictly before the first byte is read; the scope
1007:        // is the stream's own, so it is released with the stream.
1008:        const subscription = yield* PubSub.subscribe(hub);
1009:        // The overlap that early subscription creates, and the reason the
1010:        // join still cannot duplicate: a line can be on disk when the replay
1011:        // reads it AND still in flight to the hub, so it arrives twice.
1012:        // Offsets are monotonic in file order, so the last replayed `end` is
1013:        // exactly the boundary between "already delivered" and "new". The
1014:        // requested cursor is the starting boundary, so a live line starting
1015:        // below it is filtered exactly as the replay filters it.
1016:        let replayedThrough = slice?.cursor ?? 0;
1017:        const history = replay.pipe(
1018:          Stream.tap((envelope) =>
1019:            Effect.sync(() => {
1020:              replayedThrough = Math.max(replayedThrough, envelope.line.end);
1021:            })
1022:          )
1023:        );
1024:        const live = subscription.pipe(
1025:          PubSub.take,
1026:          Channel.fromEffectTake,
1027:          Stream.fromChannel,
1028:          // The terminal envelope ends THIS subscription, whatever the
1029:          // slice says: the journal is finished, so there is nothing more
1030:          // to wait for. `takeUntil` runs before the slice filter so a
1031:          // terminal event that the slice excludes still ends the stream —
1032:          // but is not delivered. It also runs before the de-duplication
1033:          // filter, so a terminal envelope that the replay already
1034:          // delivered still ends the stream rather than being dropped and
1035:          // leaving the subscriber waiting on a journal that is over.
1036:          Stream.takeUntil(isTerminalEnvelope),
1037:          Stream.filter((envelope) => envelope.line.offset >= replayedThrough)
1038:        );
1039:        // ONE seam: history and tail are the same stream, filtered the same
1040:        // way downstream, so a consumer cannot see a gap or a duplicate at
1041:        // the join.
1042:        return Stream.concat(history, live);
1043:      })
1044:    );
1045:
1046:  const ingest = Effect.suspend(() => {
1047:    const mine = Deferred.makeUnsafe<void>();
1048:    return Effect.gen(function* () {
1049:      const staged = yield* writePermit.withPermits(1)(
1050:        Effect.uninterruptibleMask(
1051:          Effect.fn("Journal.stageIngest")(function* (restore) {
1052:            if (!(yield* restore(exists))) return O.none();
1053:            const state = yield* reconcile(restore);
1054:            const predecessor = publishBaton;
1055:            publishBaton = mine;
1056:            return O.some({ entries: state.entries, predecessor });
1057:          })
1058:        )
1059:      );
1060:      if (O.isSome(staged)) yield* publish(staged.value.entries, staged.value.predecessor);
1061:    }).pipe(Effect.ensuring(Deferred.done(mine, Exit.void)));
1062:  });
1063:
1064:  function append<T extends JsonlEvent.Tag<R>>(
1065:    event: T,
1066:    data: JsonlEvent.Data<R, NoInfer<T>>,
1067:    options?: AppendOptions
1068:  ): Effect.Effect<EnvelopeWithTag<R, T>, JournalWriteError>;
1069:  function append(
1070:    event: JsonlEvent.Tag<R>,
1071:    data: unknown,
1072:    options?: AppendOptions
1073:  ): Effect.Effect<EnvelopeUnion<R>, JournalWriteError> {
1074:    return appendWith(event, () => data, options?.scope);
1075:  }
1076:
1077:  function appendPatch<T extends JsonlEvent.Tag<R>>(
1078:    event: T,
1079:    patch: Partial<JsonlEvent.Data<R, NoInfer<T>>>,
1080:    options?: AppendOptions
1081:  ): Effect.Effect<EnvelopeWithTag<R, T>, JournalWriteError>;
1082:  function appendPatch(
1083:    event: JsonlEvent.Tag<R>,
1084:    patch: unknown,
1085:    options?: AppendOptions
1086:  ): Effect.Effect<EnvelopeUnion<R>, JournalWriteError> {
1087:    return appendWith(
1088:      event,
1089:      (current) => {
1090:        const base = O.isSome(current) ? current.value.data : undefined;
1091:        // The record guards establish the merge inputs; canMerge checks the
1092:        // prototype compatibility of the patch. Encoding validates the result.
1093:        return isRecordLike(base) && isRecordLike(patch) && canMerge(base, patch) ? shallowMerge(base, patch) : patch;
1094:      },
1095:      options?.scope
1096:    );
1097:  }
1098:
1099:  function query<T extends JsonlEvent.Tag<R>>(
1100:    slice: CursoredSlice<R, T> & { readonly events: ReadonlyArray<T> }
1101:  ): Stream.Stream<EnvelopeWithTag<R, T>, JournalReadError | JsonlError>;
1102:  function query(
1103:    slice?: CursoredSlice<R, JsonlEvent.Tag<R>>
1104:  ): Stream.Stream<EnvelopeUnion<R>, JournalReadError | JsonlError>;
1105:  function query(
1106:    slice?: CursoredSlice<R, JsonlEvent.Tag<R>>
1107:  ): Stream.Stream<EnvelopeUnion<R>, JournalReadError | JsonlError> {
1108:    return readFrom(slice).pipe(Stream.filter((envelope) => matchesEnvelope(envelope, slice)));
1109:  }
1110:
1111:  function changes<T extends JsonlEvent.Tag<R>>(
1112:    slice: CursoredSlice<R, T> & { readonly events: ReadonlyArray<T> }
1113:  ): Stream.Stream<EnvelopeWithTag<R, T>, JournalReadError | JsonlError>;
1114:  function changes(
1115:    slice?: CursoredSlice<R, JsonlEvent.Tag<R>>
1116:  ): Stream.Stream<EnvelopeUnion<R>, JournalReadError | JsonlError>;
1117:  function changes(
1118:    slice?: CursoredSlice<R, JsonlEvent.Tag<R>>
1119:  ): Stream.Stream<EnvelopeUnion<R>, JournalReadError | JsonlError> {
1120:    return changesStream(slice).pipe(Stream.filter((envelope) => matchesEnvelope(envelope, slice)));
1121:  }
1122:
1123:  function projection<State, T extends JsonlEvent.Tag<R>>(
1124:    initial: State,
1125:    fold: (state: State, envelope: EnvelopeWithTag<R, NoInfer<T>>) => State,
1126:    slice: CursoredSlice<R, T> & { readonly events: ReadonlyArray<T> }
1127:  ): Stream.Stream<State, JournalReadError | JsonlError>;
1128:  function projection<State>(
1129:    initial: State,
1130:    fold: (state: State, envelope: EnvelopeUnion<R>) => State,
1131:    slice?: CursoredSlice<R, JsonlEvent.Tag<R>>
1132:  ): Stream.Stream<State, JournalReadError | JsonlError>;
1133:  function projection<State, T extends JsonlEvent.Tag<R>>(
1134:    initial: State,
1135:    fold: (state: State, envelope: EnvelopeWithTag<R, T>) => State,
1136:    slice?: CursoredSlice<R, T>
1137:  ): Stream.Stream<State, JournalReadError | JsonlError> {
1138:    return changesStream(slice).pipe(
1139:      Stream.filter((envelope): envelope is EnvelopeWithTag<R, T> => matchesEnvelope(envelope, slice)),
1140:      Stream.scan(() => initial, fold)
1141:    );
1142:  }
1143:
1144:  const shape: JournalShape<R> = {
1145:    append,
1146:    appendPatch,
1147:    latest,
1148:    quiescent: isTerminalTail,
1149:    query,
1150:    changes,
1151:    projection,
1152:    create: Effect.gen(function* () {
1153:      const present = yield* exists;
1154:      if (!present) {
1155:        // Opening with `O_APPEND` creates the file; nothing is written.
1156:        // Do NOT `writeAll(new Uint8Array(0))` to "touch" it — a zero-byte
1157:        // write returns 0 bytes, which `writeAll`'s loop reports as a
1158:        // stalled write (`WriteZero`), so the create fails on a file it
1159:        // just successfully created.
1160:        yield* Effect.scoped(fs.open(config.path, { flag: "a" }));
1161:      }
1162:    }),
1163:    remove: fs.remove(config.path, { force: true }),
1164:    hub,
1165:  };
1166:
1167:  // Seed `latest` from whatever is already on disk, and set the append
1168:  // cursor past it. A missing file is legal here: layer construction must
1169:  // never fail on one.
1170:  const present = yield* exists;
1171:  if (present) {
1172:    yield* Effect.gen(function* () {
1173:      bomBytes = yield* probeBomBytes(fs, config.path);
1174:      // Narrowed to JournalNotFound only: a permissions error or a bad handle
1175:      // must NOT present as an empty journal. Anything other than "the file
1176:      // vanished between the check and the read" is a real failure.
1177:      // Sample identity before the seed read: a replacement during that
1178:      // read must not attach its old cursor to the replacement's inode.
1179:      const info = yield* fs.stat(config.path);
1180:      const seed = yield* refresh;
1181:      // Resume at the same completed seed record, never at a later stat EOF:
1182:      // a torn suffix or unread growth must remain pending for reconciliation.
1183:      consumed = O.getOrElse(
1184:        O.map(seed, (row) => row.line.end),
1185:        () => 0
1186:      );
1187:      // Detect replacement even before the supervisor's first catch-up read.
1188:      identity = identityOf(info);
1189:    }).pipe(
1190:      Effect.catchTag("JournalNotFound", () =>
1191:        Effect.sync(() => {
1192:          bomBytes = 0;
1193:        })
1194:      )
1195:    );
1196:  }
1197:
1229:  const basename = basenameOf(config.path);
1230:  const directory = config.directory ?? parentOf(config.path);
1231:
1232:  const watchJournal = fs.watch(config.path).pipe(
1233:    // The event is a poke, never a source of paths. Re-stat and ingest.
1234:    Stream.runForEach(() => ingest),
1235:    Effect.ignore
1236:  );
1237:
1238:  const watchForCreation = fs.watch(directory).pipe(
1239:    Stream.filter((event) => basenameOf(event.path) === basename),
1240:    // END once the journal exists. A directory watch reports creation, not a
1241:    // child's later content appends, so staying on it after activation
1242:    // leaves the journal silently blind to external growth. Ending here is
1243:    // what returns control to the supervisor loop, which then arms the FILE
1244:    // watch. `takeUntilEffect` runs before the ingest below, and the element
1245:    // that satisfies it is still emitted, so the creation event that ends
1246:    // this watch is also the one that catches the journal up.
1247:    Stream.takeUntilEffect(() => exists),
1248:    Stream.runForEach(() => ingest),
1249:    Effect.ignore
1250:  );
1251:
1252:  const supervise = Effect.gen(function* () {
1253:    // Activate over a missing file without a rebuild and without polling:
1254:    // watch the directory until the journal appears, then watch the journal.
1255:    // `fs.watch` stats first and fails on a missing path, which is exactly
1256:    // why the two cases are separate rather than one call.
1257:    //
1258:    // The re-arm loop is BOUNDED against a watch that ends or fails
1259:    // immediately. Looping unconditionally on such a watch is a hot spin —
1260:    // and since no timer is permitted here, backing off is not an option, so
1261:    // the honest behaviour is to stop re-arming and let local appends carry
1262:    // on without live observation rather than burn a core forever.
1263:    let immediateCompletions = 0;
1264:    for (;;) {
1265:      const startedAt = consumed;
1266:      const present = yield* exists;
1267:      if (present) {
1268:        // ARM FIRST, THEN CATCH UP. The reverse order — catch up, then arm —
1269:        // leaves a window in which the file can grow while nothing is
1270:        // watching and nothing will re-read, so the write stays invisible
1271:        // until some LATER event happens to trigger another ingest. In a
1272:        // quiet journal that is hours, and it presents as a stale `latest`
1273:        // and a silently idle subscription. Real consumer-visible staleness,
1274:        // not a test artifact.
1275:        //
1276:        // `fs.watch` exposes no "registered" signal — `Stream.onStart` fires
1277:        // before acquisition and `Stream.toQueue` does not register eagerly
1278:        // (both measured) — so establishment is ordered by forking the
1279:        // consumer and yielding to it before the catch-up runs. Registration
1280:        // happens on the consumer's first pull, which the yield guarantees
1281:        // has been scheduled.
1282:        const armed = yield* Effect.forkChild(watchJournal);
1283:        // Yield to the forked consumer so it reaches its first pull, which is
1284:        // when registration happens.
1285:        //
1286:        // HONEST LIMITATION, do not read this as a guarantee: `fs.watch`
1287:        // exposes no "registered" signal, so this ORDERS by scheduling
1288:        // rather than by synchronisation. Measured: `Stream.toQueue` does not
1289:        // register eagerly, and `Stream.onStart` fires BEFORE acquisition —
1290:        // neither is a hook. One yield was not enough and the arming-window
1291:        // test caught it; this many is empirically sufficient here, which
1292:        // makes it a heuristic, not a proof.
1293:        //
1294:        // The one primitive that would make this airtight is
1295:        // `FileSystem.WatchBackend.register(path, stat)`, which registers
1296:        // synchronously and returns the stream — at the cost of putting
1297:        // `WatchBackend` in this layer's `R`.
1298:        for (let turn = 0; turn < ARM_YIELDS; turn++) {
1299:          yield* Effect.yieldNow;
1300:        }
1301:        // Reconcile after arming to include any growth during registration.
1302:        // A stable file contributes no envelopes to the publication batch.
1303:        yield* ingest;
1304:        yield* Fiber.join(armed);
1305:        // The journal watch ended — the file was replaced or removed. Loop
1306:        // back and re-arm, because a node watcher follows the inode and the
1307:        // old registration is now attached to a file nobody writes to.
1308:        yield* ingest;
1309:      } else {
1310:        yield* watchForCreation;
1311:      }
1312:      immediateCompletions = consumed === startedAt ? immediateCompletions + 1 : 0;
1313:      if (immediateCompletions > MAX_IMMEDIATE_REARMS) {
1314:        yield* Effect.logWarning("Journal watcher stopped after immediate completions").pipe(
1315:          Effect.annotateLogs({ path: config.path, rearms: immediateCompletions })
1316:        );
1317:        return;
1318:      }
1319:    }
1320:  });
1321:
1322:  // Ignored deliberately, and the cost is stated: if the watch cannot be
1323:  // established the journal keeps working for local appends and simply stops
1324:  // observing external ones. Failing the layer instead would violate the
1325:  // missing-journal contract, which requires construction to succeed.
1326:  yield* Effect.forkScoped(supervise.pipe(Effect.annotateLogs({ path: config.path }), Effect.ignore));
1327:
1328:  // Graceful shutdown, as TWO mechanisms. Refusal is the flag above, checked
1329:  // before the permit and failing typed. Drain is here: taking the permit
1330:  // waits for the in-flight append to finish, and only then is the terminal
1331:  // Exit published — so the last accepted append is on disk and visible to
1332:  // subscribers before their streams end.
1333:  yield* Effect.addFinalizer(
1334:    Effect.fn("Journal.close")(function* () {
1335:      closed = true;
1336:      // Drain the write half AND capture the tail of the publish chain under
1337:      // the same permit. Reading `publishBaton` here is a consistent
1338:      // snapshot precisely because it is only ever mutated while holding
1339:      // this permit.
1340:      //
1341:      // Capturing it is the whole point: once publishing moved out of the
1342:      // write critical section, "writes drained" stopped implying
1343:      // "publishes drained" — and the terminal Exit, which is NOT on the
1344:      // baton chain, could overtake an envelope whose append had already
1345:      // completed. A subscriber would see the stream end before the last
1346:      // line it was promised.
1347:      const pending = yield* writePermit.withPermits(1)(Effect.sync(() => publishBaton));
1348:
1349:      // Await the outstanding publishes, THEN end the stream. Both halves
1350:      // share one bound: a subscriber that never consumes cannot observe
1351:      // completion by definition and must not hold scope close hostage, so
1352:      // the ordering guarantee is offered to consuming subscribers only.
1353:      // An interruptible region inside an otherwise-uninterruptible
1354:      // finalizer is what lets the timeout fire at all.
1355:      yield* Effect.interruptible(
1356:        Effect.gen(function* () {
1357:          yield* Deferred.await(pending);
1358:          yield* PubSub.publish(hub, Exit.void);
1359:        })
1360:      ).pipe(Effect.timeout(config.shutdownPublishTimeout), Effect.ignore);
1361:    })
1362:  );
1363:
1364:  return shape;
1365:});
