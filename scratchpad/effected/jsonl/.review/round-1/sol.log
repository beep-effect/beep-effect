465:// default, and the shutdown bound becomes a Duration.
466:const JournalSettings = S.Struct({
467:  ...JournalConfig.fields,
468:  capacity: Capacity.pipe(S.withDecodingDefault(Effect.succeed(64))),
469:  shutdownPublishTimeout: DurationFromInput.pipe(S.withDecodingDefaultType(Effect.succeed(SHUTDOWN_PUBLISH_TIMEOUT))),
