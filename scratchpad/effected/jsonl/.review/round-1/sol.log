510:const lastSeparator = (path: string): number =>
511:  Math.max(
512:    O.getOrElse(Str.lastIndexOf("/")(path), () => -1),
513:    O.getOrElse(Str.lastIndexOf("\\")(path), () => -1)
514:  );
515:
524:const basenameOf = (path: string): string => Str.slice(lastSeparator(path) + 1)(path);
525:
539:const parentOf = (path: string): string => {
540:  const separator = lastSeparator(path);
541:  if (separator < 0) return ".";
542:  // A separator at index 0 means the file sits in the root directory, which is
543:  // that separator itself — slicing to an empty string would name nothing.
544:  return separator === 0 ? Str.slice(0, 1)(path) : Str.slice(0, separator)(path);
545:};
