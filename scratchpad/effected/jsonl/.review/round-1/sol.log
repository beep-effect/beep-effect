331:const DurationString = S.declare((input: unknown): input is DurationString => isDurationText(input))
332:  .annotate({
333:    toCodecArbitrary: () => S.link<DurationString>()(DurationText, SchemaTransformation.passthroughSupertype()),
334:  })
335:  .pipe(
336:    $I.annoteSchema("DurationString", {
337:      description: "A duration string accepted by Duration.fromInput, including signed decimals and infinities.",
338:    })
339:  );
