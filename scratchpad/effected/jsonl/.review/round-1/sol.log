1462:export const Journal = {
1463:  Service:
1464:    <Self>() =>
1465:    <const Id extends string, const R extends JsonlEvent.Registry>(
1466:      id: Id,
1467:      options: { readonly events: R }
1468:    ): JournalClass<Self, Id, R> => {
1469:      const key = Context.Service<Self, JournalShape<R>>()(id);
1470:      // Augment the constructor itself: a spread would lose Context's
1471:      // inherited service protocol, while an intermediate subclass would
1472:      // introduce a different Self from the caller's class.
1473:      return Object.assign(key, {
1474:        events: options.events,
1475:        layer: (
1476:          config: JournalConfig
1477:        ): Layer.Layer<Self, PlatformError.PlatformError | InvalidJournalConfig | InvalidUtf8, FileSystem.FileSystem> =>
1478:          Layer.effect(
1479:            key,
1480:            Effect.gen(function* () {
1481:              const settings = yield* decodeSettings(config).pipe(
1482:                Effect.mapError((error) => InvalidJournalConfig.make({ error }))
1483:              );
1484:              const fs = yield* FileSystem.FileSystem;
1485:              return yield* makeEngine(options.events, settings, fs);
1486:            })
1487:          ),
1488:      });
1489:    },
1490:};
