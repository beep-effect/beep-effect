368:const SLUG_PATTERN = /^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/;
370:export const Slug = S.String.check(
371:  S.isPattern(SLUG_PATTERN, {
372:    identifier: $I`SlugPatternCheck`,
373:    title: "Slug",
374:    description: "A lowercase hyphen-delimited identifier.",
375:    message: "Expected a lowercase slug beginning with a letter",
376:  })
377:)
378:  .annotate({
379:    toArbitrary: () => (fc) => fc.stringMatching(SLUG_PATTERN),
380:  })
