55:    line: LineSlice.pipe(
56:      $I.annoteKey("ParsedLine.line", {
57:        description: "Where this line lives in the source.",
58:      }),
59:    ),
61:    value: S.Unknown.pipe(
62:      $I.annoteKey("ParsedLine.value", {
63:        description: "The parsed JSON value — any JSON value, not necessarily an object.",
64:      }),
65:    ),
66:  },
67:  $I.annote("ParsedLine", {
68:    description: "A line that parsed as JSON, paired with the slice it came from.",
69:    documentation:
70:      "`value` is deliberately `unknown`: this layer knows JSON, not envelopes.\nValidating `event`, `at`, `scope` and the registered payload schema is the\nenvelope layer's job, and keeping the split means a malformed *envelope* and\na malformed *line* stay distinguishable failures.",
71:  }),
