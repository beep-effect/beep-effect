      "deviations": [
        {
          "test": "scratchpad/test/jsonc/Jsonc.test.ts:362 (adjusts upstream __test__/Jsonc.test.ts:389)",
          "upstreamBehaviour": "a throwing toJSON escapes Jsonc.stringifyResult as the thrown RangeError and Jsonc.stringify as a Cause.Die defect",
          "labBehaviour": "Jsonc.stringifyResult fails with JsoncStringifyError code SerializationFailed; Jsonc.stringify fails typed with it",
          "reason": "law:7 (typed errors via S.TaggedError) + law:13 (schema transformation over ad-hoc serialization); upstream CLAUDE.md hardening invariant requires hostile input to fail through the typed channel"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncModifier.test.ts:232 (tighten upstream __test__/JsoncModifier.test.ts:162 and :171)",
          "upstreamBehaviour": "multi-line inserted values keep column-0 layout after the first line, so nested members sit one level too shallow",
          "labBehaviour": "every line after the first is prefixed with the insertion indent, aligning the nested value with its siblings",
          "reason": "upstream-bug: modify('{\\n  \"a\": 1\\n}', ['b'], {c:{d:1}}) applies upstream with the nested object mis-indented; upstream tests only assert include('\\t\"b\"')"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncEdit.test.ts:87 and :42 (adjust upstream __test__/JsoncEdit.test.ts:47)",
          "upstreamBehaviour": "JsoncEdit.applyAll throws a native Error ending 'overlapping edits are a programmer error'",
          "labBehaviour": "JsoncEdit.applyAll throws the tagged JsoncEditOverlapError {lower, upper}; JsoncEdit.applyAllResult returns it as a Result failure",
          "reason": "law:7 (no native Error in production source; extend S.TaggedError)"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncModifier.test.ts:91 and scratchpad/test/jsonc/Properties.test.ts (JsoncModifier insert property)",
          "upstreamBehaviour": "with a trailing comma before the closer, navigate scans past the closer and inserts outside the container: modify('{ \"a\": 1, }', ['delta'], []) yields '{ \"a\": 1, },\\n  \"delta\": []' (unparseable); '{ \"a\": { \"b\": 1, } }' at ['a','c'] writes c into the parent; '[1, ]' at [1] yields '[1, ,\\n  2]'",
          "labBehaviour": "a comma followed by the closer ends the scan, so the insertion lands after the last member inside the container and the result parses to the expected value",
          "reason": "upstream-bug: the default JSONC options accept trailing commas, and the property 'JsoncModifier insert' (result parses to {...doc, delta: next}) fails upstream on '{ \"a\": 1, }'; upstream tests never insert into a trailing-comma container"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncFormatter.test.ts:56 and scratchpad/test/jsonc/Properties.test.ts:395 (no upstream test passes unbalanced closers)",
          "upstreamBehaviour": "JsoncFormatter.format and formatToString throw RangeError (indentUnit.repeat(-1)) on any surplus closer: ']]', '{\"a\":1}}', '[1]]'",
          "labBehaviour": "format is total: a surplus closer formats with no indent, every edit still rewrites whitespace only",
          "reason": "upstream-bug: a RangeError defect escapes a formatter on hostile input, violating upstream's own hardening invariant (malformed input fails typed, never as a defect) and the format-package convention C1"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncVisitor.test.ts:68",
          "upstreamBehaviour": "JsoncVisitor.visit wraps one generator object in Stream.fromIterable, so a second run of the same stream yields no events (probe: 5 events, then 0)",
          "labBehaviour": "each run of the stream creates a fresh generator, so every run yields the same events",
          "reason": "upstream-bug: a generator object's [Symbol.iterator]() returns itself, so the per-run iterator re-acquisition resumes an exhausted generator; a Stream is a re-runnable description everywhere else in Effect"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncModifier.test.ts:254",
          "upstreamBehaviour": "JsoncModifier.modify serializes with JSON.stringify, so a bigint, a cycle or a throwing toJSON escapes as a defect; the only typed failure is JsoncModificationError",
          "labBehaviour": "modify fails typed with JsoncStringifyError (BigIntValue, CircularReference or SerializationFailed) on the whole-document, replace and insert paths",
          "reason": "law:7 (typed errors via S.TaggedError instead of escaping native exceptions); same cause as the recorded stringifyResult deviation"
        },
        {
          "test": "scratchpad/test/jsonc/JsoncModifier.test.ts:58",
          "upstreamBehaviour": "JsoncModificationError.offset is Schema.optionalKey(Schema.Number), so Infinity or NaN decode and render",
          "labBehaviour": "offset is S.optionalKey(S.Finite), so a non-finite offset fails decoding; modify never sets offset",
          "reason": "law:tsgo-schemaNumber (effect(schemaNumber) is an error in tsconfig.base.json: S.Number admits NaN and Infinity) and schema-first precision"
        }
      ],
