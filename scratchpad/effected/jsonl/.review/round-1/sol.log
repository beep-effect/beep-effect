105:const windowOf = Effect.fn("Jsonl.windowOf")(function* (
106:  path: string,
107:  bytes: Uint8Array,
108:  from: number,
109:  length: number,
110:  bomBytes: number,
111:  skipPartialLine: boolean,
112:  completeOnly: boolean,
113:): Effect.fn.Return<TailWindow, InvalidUtf8> {
114:  const cursor = skipPartialLine
115:    ? A.findFirstIndex(bytes, (byte) => byte === LF).pipe(
116:      O.map((newline) => newline + 1),
117:      O.getOrElse(() => bytes.length),
118:    )
119:    : 0;
120:  const end = completeOnly
121:    ? A.findLastIndex(bytes, (byte) => byte === LF).pipe(
122:      O.map((newline) => newline + 1),
123:      O.getOrElse(() => 0),
124:    )
125:    : bytes.length;
126:  // Discard byte fragments before decoding. A cursor can point into a UTF-8
127:  // sequence, and an unfinished suffix can contain a pending multi-byte code point.
128:  const text = yield* Effect.try({
129:    try: () => new TextDecoder("utf-8", {
130:      fatal: true,
131:      ignoreBOM: true,
132:    }).decode(bytes.subarray(cursor, end)),
133:    catch: (cause) => InvalidUtf8.make({ path, offset: from + cursor, cause }),
134:  });
135:  return TailWindow.make({
136:    text,
137:    start: from + cursor - bomBytes,
138:    size: from + length - bomBytes,
139:    atFileStart: from === bomBytes,
140:  });
141:});
