1374:export interface JournalClass<Self, Id extends string, R extends JsonlEvent.Registry>
1375:  extends Context.ServiceClass<Self, Id, JournalShape<R>> {
1377:  readonly events: R;
1425:  readonly layer: (
1426:    config: JournalConfig
1427:  ) => Layer.Layer<Self, PlatformError.PlatformError | InvalidJournalConfig | InvalidUtf8, FileSystem.FileSystem>;
1428:}
