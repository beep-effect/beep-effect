102:export const Line = {
116:  isBlank,
141:  byteLength: utf8Length,
142:
171:  split(text: string): ReadonlyArray<LineSlice> {
172:    if (Str.isEmpty(text)) return A.empty();
173:    const parts = Str.split(text, "\n");
174:    const terminatedCount = A.length(parts) - 1;
175:    const candidates = Str.endsWith("\n")(text) ? A.dropRight(parts, 1) : parts;
176:    return A.mapAccum(candidates, 0, (offset, raw, index) => {
177:      const terminated = index < terminatedCount;
178:      const hadCarriageReturn = terminated && Str.endsWith("\r")(raw);
179:      const content = hadCarriageReturn ? Str.slice(0, -1)(raw) : raw;
180:      const length = utf8Length(content);
181:      const end = offset + length + (terminated ? (hadCarriageReturn ? 2 : 1) : 0);
182:      return [end, LineSlice.make({
183:        offset,
184:        end,
185:        length,
186:        text: content,
187:        terminated,
188:      })];
189:    })[1];
190:  },
191:
213:  consumedOffset(text: string): number {
214:    return pipe(
215:      Line.split(text),
216:      A.last,
217:      O.map((last) => (last.terminated ? last.end : last.offset)),
218:      O.getOrElse(thunk0),
219:    );
220:  },
221:
248:  parseResult(line: LineSlice): Result.Result<ParsedLine, MalformedLine> {
249:    return decodeJson(line.text).pipe(
250:      Result.map((value) => ParsedLine.make({ line, value })),
251:      Result.mapError(() => MalformedLine.make({ line })),
252:    );
253:  },
254:
283:  parseAll(text: string): ReadonlyArray<Result.Result<ParsedLine, MalformedLine>> {
284:    return pipe(
285:      Line.split(text),
286:      A.filter(P.not(isBlank)),
287:      A.map(Line.parseResult),
288:    );
289:  },
290:
326:  lastValid: (text: string): O.Option<ParsedLine> => pipe(
327:    Line.split(text),
328:    A.findLast(
329:      flow(
330:        O.liftPredicate(P.not(isBlank)),
331:        O.flatMap(flow(Line.parseResult, Result.getSuccess)),
332:      ),
333:    ),
334:  ),
335:};
