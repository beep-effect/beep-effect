134:export interface JournalShape<R extends JsonlEvent.Registry> {
149:  readonly append: <T extends JsonlEvent.Tag<R>>(
150:    event: T,
151:    data: JsonlEvent.Data<R, NoInfer<T>>,
152:    options?: AppendOptions | undefined
153:  ) => Effect.Effect<EnvelopeWithTag<R, T>, JournalWriteError>;
154:
168:  readonly appendPatch: <T extends JsonlEvent.Tag<R>>(
169:    event: T,
170:    patch: Partial<JsonlEvent.Data<R, NoInfer<T>>>,
171:    options?: AppendOptions | undefined
172:  ) => Effect.Effect<EnvelopeWithTag<R, T>, JournalWriteError>;
173:
184:  readonly latest: SubscriptionRef.SubscriptionRef<O.Option<EnvelopeUnion<R>>>;
185:
194:  readonly quiescent: Effect.Effect<boolean>;
195:
226:  readonly query: {
227:    <T extends JsonlEvent.Tag<R>>(
228:      slice: CursoredSlice<R, T> & { readonly events: ReadonlyArray<T> }
229:    ): Stream.Stream<EnvelopeWithTag<R, T>, JournalReadError | JsonlError>;
230:    (
231:      slice?: CursoredSlice<R, JsonlEvent.Tag<R>> | undefined
232:    ): Stream.Stream<EnvelopeUnion<R>, JournalReadError | JsonlError>;
233:  };
234:
264:  readonly changes: {
265:    <T extends JsonlEvent.Tag<R>>(
266:      slice: CursoredSlice<R, T> & { readonly events: ReadonlyArray<T> }
267:    ): Stream.Stream<EnvelopeWithTag<R, T>, JournalReadError | JsonlError>;
268:    (
269:      slice?: CursoredSlice<R, JsonlEvent.Tag<R>> | undefined
270:    ): Stream.Stream<EnvelopeUnion<R>, JournalReadError | JsonlError>;
271:  };
272:
281:  readonly projection: {
282:    <S, T extends JsonlEvent.Tag<R>>(
283:      initial: S,
284:      fold: (state: S, envelope: EnvelopeWithTag<R, NoInfer<T>>) => S,
285:      slice: CursoredSlice<R, T> & { readonly events: ReadonlyArray<T> }
286:    ): Stream.Stream<S, JournalReadError | JsonlError>;
287:    <S>(
288:      initial: S,
289:      fold: (state: S, envelope: EnvelopeUnion<R>) => S,
290:      slice?: CursoredSlice<R, JsonlEvent.Tag<R>> | undefined
291:    ): Stream.Stream<S, JournalReadError | JsonlError>;
292:  };
