321:const DURATION_STRING =
322:  /^(?:-?Infinity|-?\d+(?:\.\d+)?\s+(?:nanos?|micros?|millis?|seconds?|minutes?|hours?|days?|weeks?))$/;
323:
325:const DurationText = S.String.check(S.isPattern(DURATION_STRING));
326:const isDurationText = S.is(DurationText);
