102:export const canMerge: {
103:  (base: unknown, patch: unknown): boolean;
104:  (patch: unknown): (base: unknown) => boolean;
105:} = dual(2, (base: unknown, patch: unknown): boolean => {
106:  if (!isRecordLike(base) || !isRecordLike(patch)) {
107:    return false;
108:  }
