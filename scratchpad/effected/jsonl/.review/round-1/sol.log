148:export const shallowMerge: {
149:  (base: Record<string, unknown>, patch: Record<string, unknown>): Record<string, unknown>;
150:  (patch: Record<string, unknown>): (base: Record<string, unknown>) => Record<string, unknown>;
151:} = dual(2, (base: Record<string, unknown>, patch: Record<string, unknown>): Record<string, unknown> => {
152:  const result: Record<string, unknown> = Object.create(Object.getPrototypeOf(base));
153:  for (const key of R.keys(base)) {
154:    if (HashSet.has(FORBIDDEN, key)) continue;
155:    define(result, key, base[key]);
156:  }
157:  for (const key of R.keys(patch)) {
158:    if (HashSet.has(FORBIDDEN, key)) continue;
159:    define(result, key, patch[key]);
160:  }
161:  return result;
162:});
