        {
          "test": "scratchpad/test/github-actions/CheckDocument.test.ts:222,365; scratchpad/test/github-actions/BlobStore.test.ts:230; scratchpad/test/github-actions/Artifact.test.ts:392; scratchpad/test/github-actions/ActionLogger.test.ts",
          "upstreamBehaviour": "ActionCache, ActionInput, BlobStore, CacheKey, CheckDocument, pnpmExe and sigv4 use native Set/Map/Object helpers; CheckDocument exposes ReadonlyMap; stamps use Date.parse; signing and retention use native wall-clock time; buffering supplies a native logger Set.",
          "labBehaviour": "Effect hash collections and Record helpers replace native structures; CheckDocumentSnapshot carries HashMap checks plus explicit first-report order; DateTime makes zone-less stamps UTC; signing and retention read fiber Clock; ActionLogger builds scoped Logger.layer.",
          "reason": "native-runtime: never native Set/Map/Object.*/Date.* in domain logic; the 2026-10-09 grilling ruling empties the effected allowlist and authorizes public collection changes and UTC stamp parsing, preserving explicit document order."
        },
        {
          "test": "scratchpad/test/github-actions/CacheKey.test.ts:583; scratchpad/test/github-actions/ManagedDocument.test.ts:305",
          "upstreamBehaviour": "CacheKey and ManagedDocument schema definitions use CacheKeyEncoded and ManagedDocumentEncoded names; Context services and references use @effected/github-actions identifiers.",
          "labBehaviour": "CacheKey/ManagedDocument JSON Schema definition paths include @beep/scratchpad/effected/github-actions identities; services and references such as EnvOverrides and ActiveBuffer use file-local IdentityComposer keys.",
          "reason": "identity-keys: step 4 requires @beep/identity identifiers; the 2026-10-09 grilling ruling requires one systemic record for identity-derived keys and retargeted JSON Schema assertions."
        },
        {
          "test": "scratchpad/test/github-actions/CacheKey.test.ts:245; scratchpad/test/github-actions/ActionState.test.ts:58; scratchpad/test/github-actions/Exports.test.ts:16",
          "upstreamBehaviour": "Invalid state names, digest lengths, unreachable check states, missing child pids, rejected region dialects and unstubbed members construct native Error/RangeError values; the five public replacement classes are absent.",
          "labBehaviour": "ActionState, CacheKey, CheckState, DetachedProcess, ManagedDocument and internal/unstubbed use identity-annotated S.TaggedError classes with retained messages; invalid-state writeFailed has a tagged cause; index.ts exports the five public replacements.",
          "reason": "tagged-errors: law 7 requires schema tagged errors and typed failures; D2 requires introduced public error classes to be exported; round-1 c3 and fix-github-actions-g9 record the required additions."
        },
        {
          "test": "scratchpad/test/github-actions/ActionInput.test.ts; scratchpad/test/github-actions/ActionEnvironment.test.ts:239; scratchpad/test/github-actions/ActionState.test.ts:156; scratchpad/test/github-actions/CheckState.test.ts:9; scratchpad/test/github-actions/DetachedProcess.test.ts:110",
          "upstreamBehaviour": "ActionInput uses asserted literal/list shapes; payload, state, JWT and installer paths use native JSON codecs; CheckState is S.Literals; InvalidPidError uses Schema.Number; ArtifactItem is an interface and the check registry has no snapshot schema.",
          "labBehaviour": "Schema-derived guards, JSON codecs, LiteralKit CheckState/NonFiniteSpelling, IeeeNumber links, ArtifactItem Struct and CheckDocumentSnapshot schema own the models; malformed JSON retains outer failure policy but detail/cause can become SchemaError rather than native syntax/type errors.",
          "reason": "schema-first: schema-first laws, law 19 and tsgo preferSchemaOverJson require runtime models, LiteralKit domains, JSON codecs and schema-derived guards; c4 records diagnostic/cause changes; IeeeNumber preserves non-finite invalid-pid payloads."
        },
        {
          "test": "scratchpad/test/github-actions/CacheKey.test.ts; scratchpad/test/github-actions/DetachedProcess.test.ts:160; scratchpad/test/github-actions/Artifact.test.ts:193; scratchpad/test/github-actions/ActionEnvironment.test.ts:150",
          "upstreamBehaviour": "Schema.Number accepts non-finite values in HTTP status fields, GitHubContext runId/runAttempt, OIDC count, document line, envelope version and DetachedSignalFailedError pid; RestoreDepth and ProcessId use integer filters.",
          "labBehaviour": "S.Finite narrows statuses in ActionCache/Artifact/BlobStore/OidcTokenIssuer/ToolInstaller, run numbers, OIDC count, ManagedDocument line, envelope version and signal pid; RestoreDepth is finite and ProcessId adds an abort-ordered finite check; InvalidPidError retains all IEEE numbers.",
          "reason": "numeric-domains: tsgo schemaNumber and the operator S.Finite ruling require finite numeric domains and refinements; non-finite direct construction/decoding narrows, while ProcessId acceptance and its positive-integer message are preserved."
        },
        {
          "test": "scratchpad/test/github-actions/deliberatelyInvalid.ts; scratchpad/test/github-actions/GitHubMarkdown.test.ts:173; scratchpad/test/github-actions/ActionsIdentityToken.test.ts; scratchpad/test/github-actions/CheckDocument.test.ts:21",
          "upstreamBehaviour": "Source and tests rely on casts/non-null assertions for JSON, table cells, process reports, service composition, fetch mocks and wrong-input fixtures; null installer manifests/packuments can defect on property access.",
          "labBehaviour": "Action, GitHubMarkdown, PackageManagerInstaller, actionsResults, fsProbe, pnpmExe and twirp narrow unknown values; fetch fixtures provide preconnect; CheckDocument suppression is removed; deliberatelyInvalid owns the permitted wrong-input cast; null installer JSON takes typed missing-bin/integrity failures.",
          "reason": "type-safety: D15 removes unsafe assertions and the 2026-10-09 ruling permits only the module deliberatelyInvalid helper for deliberate wrong inputs; c7 attributes null-boundary changes to forced guard/cast removal, not an unverified upstream-bug claim."
        },
