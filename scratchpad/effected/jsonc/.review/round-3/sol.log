 *
 * ```ts
 * import { NavigateContainer } from "@beep/scratchpad/effected/jsonc/internal/navigate"
 *
 * console.log(NavigateContainer.is.object("object")) // true
 * console.log(NavigateContainer.is.object("array")) // false
 * ```
 *
 * @category schemas
 * @since 0.0.0
 */
