          if (O.isSome(valueNode)) {
            children.push(
              makeNodeUnsafe({
                type: "property",
                offset: propOffset,
                length: valueNode.value.offset + valueNode.value.length - propOffset,
                colonOffset,
                children: [keyNode, valueNode.value],
              })
            );
          } else {
            pushError("ValueExpected", ["CloseBrace", "Comma"]);
            children.push(
              makeNodeUnsafe({
                type: "property",
                offset: propOffset,
                length: scanner.getTokenOffset() - propOffset,
                colonOffset,
                children: [keyNode],
              })
            );
