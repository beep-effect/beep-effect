1: // The `JsoncFingerprint` facade: canonical JSON serialization (RFC 8785, the
2: // JSON Canonicalization Scheme) and SHA-256 content fingerprints over it.
3: //
4: // The pure core is the JCS emitter: compact output, object keys sorted by
5: // UTF-16 code units, ECMAScript number serialization, with the package's
6: // usual `Result` primitive / spanned `Effect` twin arrangement. Hashing is the
7: // one effectful edge: it requires core's `Crypto.Crypto` service and owns no
8: // backend, so consumers provide a `Crypto` layer at the application edge.
9: //
10: // This is a deliberately different contract from `Jsonc.stringify`:
11: // fingerprints must never silently alter the document, so every non-JSON
12: // value is a typed failure carrying the JSON-pointer path to fix.
13: 
14: import { $ScratchpadId } from "@beep/identity/packages";
15: import { LiteralKit } from "@beep/schema/LiteralKit";
16: import * as A from "effect/Array";
17: import * as Crypto from "effect/Crypto";
18: import * as Effect from "effect/Effect";
19: import * as Hex from "effect/encoding/Hex";
20: import { flow, identity } from "effect/Function";
21: import * as I from "effect/Iterable";
22: import * as Order from "effect/Order";
23: import type { PlatformError } from "effect/PlatformError";
24: import * as P from "effect/Predicate";
25: import * as R from "effect/Record";
26: import * as Result from "effect/Result";
27: import * as S from "effect/Schema";
28: import * as Str from "effect/String";
29: import { MAX_NESTING_DEPTH } from "./internal/limits.ts";
30: 
31: const $I = $ScratchpadId.create("effected/jsonc/JsoncFingerprint");
32: 
64: export const JsoncCanonicalizeErrorCode = LiteralKit([
65:   "UnrepresentableValue",
66:   "BigIntValue",
67:   "NonFiniteNumber",
68:   "LoneSurrogate",
69:   "NonPlainObject",
70:   "NestingDepthExceeded",
71:   "InvalidDigest",
72: ]).annotate(
73:   $I.annote("JsoncCanonicalizeErrorCode", {
74:     description: "Why a value could not be canonicalized or fingerprinted.",
75:   })
76: );
77: 
85: export type JsoncCanonicalizeErrorCode = typeof JsoncCanonicalizeErrorCode.Type;
86: 
109: export class JsoncCanonicalizeError extends S.TaggedError<JsoncCanonicalizeError>($I.make("JsoncCanonicalizeError"))(
110:   "JsoncCanonicalizeError",
111:   {
112:     code: JsoncCanonicalizeErrorCode,
113:     path: S.String,
114:     detail: S.String,
115:   },
116:   $I.annoteError<JsoncCanonicalizeError>("JsoncCanonicalizeError", {
117:     description: "A value that has no RFC 8785 canonical form, located by JSON pointer.",
118:   })
119: ) {
134:   override get message(): string {
135:     return `Canonical JSON serialization failed: ${this.code} at "${this.path}" — ${this.detail}`;
136:   }
137: }
138: 
162: export class JsoncTextHashOptions extends S.Class<JsoncTextHashOptions>($I`JsoncTextHashOptions`)(
163:   {
164:     normalizeEol: S.Boolean.pipe(
165:       S.withConstructorDefault(Effect.succeed(false)),
166:       S.withDecodingDefaultKey(Effect.succeed(false))
167:     ),
168:   },
169:   $I.annote("JsoncTextHashOptions", {
170:     description: "Line-ending normalization applied before hashing raw text.",
171:   })
172: ) {}
173: 
190: export type JsoncDigest = (bytes: Uint8Array) => Uint8Array;
191: 
192: // ── Internal: the JCS emitter ───────────────────────────────────────────────
193: 
194: type Emit = Result.Result<string, JsoncCanonicalizeError>;
195: 
196: const escapePointerSegment = flow(Str.replaceAll("~", "~0"), Str.replaceAll("/", "~1"));
197: 
198: const fail = (code: JsoncCanonicalizeErrorCode, path: string, detail: string): Emit =>
199:   Result.fail(JsoncCanonicalizeError.make({ code, path, detail }));
200: 
201: // RFC 8785 string and number serialization match `JSON.stringify` exactly:
202: // the two-character escapes, lowercase `\u00xx` escapes for the remaining
203: // control characters, and ECMAScript shortest round-trip numbers. The codec
204: // is total for the finite, well-formed scalars `emit` feeds it, so the
205: // failure side is an invariant violation rather than a reachable path.
206: const encodeScalar = S.encodeResult(S.fromJsonString(S.Union([S.String, S.Finite, S.Boolean, S.Null])));
207: 
208: const emitScalar = (value: string | number | boolean | null): string =>
209:   Result.getOrThrowWith(encodeScalar(value), identity);
210: 
211: // Member and element reads go through this guard. An accessor property is
212: // invoked, matching `JSON.stringify` semantics, but a getter that throws must
213: // not escape as a raw exception through the `canonicalizeResult` boundary.
214: const readProperty = (container: object, key: string | number, path: string): Result.Result<unknown, JsoncCanonicalizeError> =>
215:   Result.try({
216:     try: () => Reflect.get(container, key),
217:     catch: () =>
218:       JsoncCanonicalizeError.make({
219:         code: "UnrepresentableValue",
220:         path,
221:         detail: "the property getter for this value threw; getters must return plain JSON values",
222:       }),
223:   });
224: 
225: const isPlainObject = (value: object): boolean => {
226:   const prototype: unknown = Reflect.getPrototypeOf(value);
227:   return prototype === Object.prototype || prototype === null;
228: };
229: 
230: // One member: read it through the getter guard, then canonicalize the value
231: // it produced one level deeper.
232: const emitMember = (container: object, key: string | number, memberPath: string, depth: number): Emit =>
233:   readProperty(container, key, memberPath).pipe(Result.flatMap((member) => emit(member, memberPath, depth + 1)));
234: 
235: // Members are produced lazily and `Result.all` stops pulling at the first
236: // failure, as upstream's throw carrier stops its walk: after a member fails no
237: // later getter runs, and no later exception can replace the typed failure.
238: const emitMembers = <K>(keys: Iterable<K>, member: (key: K) => Emit): Result.Result<Array<string>, JsoncCanonicalizeError> =>
239:   Result.all(I.map(keys, member));
240: 
241: const emitArray = (value: ReadonlyArray<unknown>, path: string, depth: number): Emit =>
242:   // Indexed reads, never `map`: `map` skips holes, which must instead read as
243:   // `undefined` and fail typed at the hole's index. The index iterator
244:   // re-reads `length` before every step, as upstream's indexed loop does.
245:   emitMembers(value.keys(), (index) => emitMember(value, index, `${path}/${index}`, depth)).pipe(
246:     Result.map((items) => `[${A.join(items, ",")}]`)
247:   );
248: 
249: const emitRecord = (value: { readonly [x: PropertyKey]: unknown }, path: string, depth: number): Emit => {
250:   if (!isPlainObject(value)) {
251:     return fail("NonPlainObject", path, "only arrays and plain objects canonicalize; encode domain values to plain JSON first");
252:   }
253:   // Sorting by `<` compares UTF-16 code units, the order RFC 8785 mandates.
254:   return emitMembers(A.sort(R.keys(value), Order.String), (key) => {
255:     const memberPath = `${path}/${escapePointerSegment(key)}`;
256:     // Member keys are strings too: an unpaired surrogate in a key is the same
257:     // RFC 8785 I-JSON violation as one in a value. The key is checked just
258:     // before its own member is read (upstream order), so an earlier member's
259:     // failure wins over a later ill-formed key.
260:     return key.isWellFormed()
261:       ? emitMember(value, key, memberPath, depth).pipe(Result.map((item) => `${emitScalar(key)}:${item}`))
262:       : fail("LoneSurrogate", memberPath, "object member key contains an unpaired surrogate; RFC 8785 requires well-formed Unicode");
263:   }).pipe(Result.map((members) => `{${A.join(members, ",")}}`));
264: };
265: 
266: const isFiniteNumber = S.is(S.Finite);
267: 
268: const emit = (value: unknown, path: string, depth: number): Emit => {
269:   if (P.isNull(value) || P.isBoolean(value)) {
270:     return Result.succeed(emitScalar(value));
271:   }
272:   if (P.isNumber(value)) {
273:     return isFiniteNumber(value)
274:       ? Result.succeed(emitScalar(value))
275:       : fail("NonFiniteNumber", path, `${String(value)} has no canonical JSON representation`);
276:   }
277:   if (P.isString(value)) {
278:     return value.isWellFormed()
279:       ? Result.succeed(emitScalar(value))
280:       : fail("LoneSurrogate", path, "string contains an unpaired surrogate; RFC 8785 requires well-formed Unicode");
281:   }
282:   if (P.isBigInt(value)) {
283:     return fail("BigIntValue", path, "bigint values cannot be represented in JSON");
284:   }
285:   if (!A.isArray(value) && !P.isObject(value)) {
286:     return fail("UnrepresentableValue", path, `${typeof value} values have no JSON representation`);
287:   }
288:   if (depth >= MAX_NESTING_DEPTH) {
289:     return fail("NestingDepthExceeded", path, `nesting exceeds ${MAX_NESTING_DEPTH} levels (a cyclic value also fails here)`);
290:   }
291:   return A.isArray(value) ? emitArray(value, path, depth) : emitRecord(value, path, depth);
292: };
293: 
294: const encoder = new TextEncoder();
295: 
296: // SHA-256 produces 32 bytes. The `Crypto.Crypto` path cannot return anything
297: // else; the caller-supplied `JsoncDigest` can, so the sync twins check it.
298: const SHA256_DIGEST_BYTES = 32;
299: 
300: const digestHexResult = (text: string, digest: JsoncDigest): Result.Result<string, JsoncCanonicalizeError> =>
301:   Result.try({
302:     try: () => digest(encoder.encode(text)),
303:     catch: (thrown) =>
304:       JsoncCanonicalizeError.make({
305:         code: "InvalidDigest",
306:         path: "",
307:         detail: `the supplied digest threw: ${P.isError(thrown) ? thrown.message : String(thrown)}`,
308:       }),
309:   }).pipe(
310:     Result.flatMap((bytes) =>
311:       bytes.length === SHA256_DIGEST_BYTES
312:         ? Result.succeed(Hex.encode(bytes))
313:         : fail("InvalidDigest", "", `the supplied digest returned ${bytes.length} bytes; SHA-256 produces ${SHA256_DIGEST_BYTES}`)
314:     )
315:   );
316: 
317: const digestHex = Effect.fnUntraced(function* (text: string) {
318:   const crypto = yield* Crypto.Crypto;
319:   const digest = yield* crypto.digest("SHA-256", encoder.encode(text));
320:   return Hex.encode(digest);
321: });
322: 
323: const normalizeEol = Str.replace(/\r\n?/g, "\n");
324: 
325: const prepareText = (text: string, options?: JsoncTextHashOptions): string =>
326:   (options ?? JsoncTextHashOptions.make({})).normalizeEol ? normalizeEol(text) : text;
327: 
328: // ── Facade ──────────────────────────────────────────────────────────────────
329: 
357: export abstract class JsoncFingerprint {
385:   static canonicalizeResult(value: unknown): Result.Result<string, JsoncCanonicalizeError> {
386:     return emit(value, Str.empty, 0);
387:   }
388: 
409:   static readonly canonicalize = Effect.fn("JsoncFingerprint.canonicalize")((value: unknown) =>
410:     Effect.fromResult(JsoncFingerprint.canonicalizeResult(value))
411:   );
412: 
433:   static normalizeEol(text: string): string {
434:     return normalizeEol(text);
435:   }
436: 
464:   static hashResult(value: unknown, digest: JsoncDigest): Result.Result<string, JsoncCanonicalizeError> {
465:     return Result.flatMap(JsoncFingerprint.canonicalizeResult(value), (text) => digestHexResult(text, digest));
466:   }
467: 
499:   static readonly hash = Effect.fn("JsoncFingerprint.hash")(
500:     (value: unknown): Effect.Effect<string, JsoncCanonicalizeError | PlatformError, Crypto.Crypto> =>
501:       Effect.flatMap(Effect.fromResult(JsoncFingerprint.canonicalizeResult(value)), digestHex)
502:   );
503: 
530:   static hashTextResult(
531:     text: string,
532:     digest: JsoncDigest,
533:     options?: JsoncTextHashOptions
534:   ): Result.Result<string, JsoncCanonicalizeError> {
535:     return digestHexResult(prepareText(text, options), digest);
536:   }
537: 
570:   static readonly hashText = Effect.fn("JsoncFingerprint.hashText")(
571:     (text: string, options?: JsoncTextHashOptions): Effect.Effect<string, PlatformError, Crypto.Crypto> =>
572:       digestHex(prepareText(text, options))
573:   );
574: }

FILE scratchpad/effected/jsonc/JsoncVisitor.ts
1: // SAX-style visitor: a demand-driven `Stream` of typed events over a JSONC
2: // document, enabling early termination (`Stream.take`) without building an
3: // AST.
4: //
5: // The event union is a `S.TaggedUnion`: serializable tagged values with
6: // structural equality, consistent with the rest of the library. Malformed
7: // input surfaces as `Error` events inside the union, so the stream stays
8: // infallible at the type level. There is no collecting variant:
9: // `Stream.filter` plus `Stream.runCollect` cover it.
10: 
11: import { $ScratchpadId } from "@beep/identity/packages";
12: import * as A from "effect/Array";
13: import * as Match from "effect/Match";
14: import * as O from "effect/Option";
15: import * as S from "effect/Schema";
16: import * as Stream from "effect/Stream";
17: import { MAX_NESTING_DEPTH } from "./internal/limits.ts";
18: import { scanErrorToCode } from "./internal/parser.ts";
19: import { createScanner, SyntaxKind } from "./internal/scanner.ts";
20: import type { SkipCursor } from "./internal/skip.ts";
21: import { skipBalancedValue } from "./internal/skip.ts";
22: import { JsoncParseErrorCode, type JsoncParseOptions } from "./Jsonc.ts";
23: import { JsoncPath, type JsoncSegment } from "./JsoncNode.ts";
24: 
25: const $I = $ScratchpadId.create("effected/jsonc/JsoncVisitor");
26: 
27: const Span = { offset: S.Natural, length: S.Natural };
28: 
60: export const JsoncVisitorEvent = S.TaggedUnion({
61:   ObjectBegin: { ...Span, path: JsoncPath },
62:   ObjectEnd: Span,
63:   ObjectProperty: { ...Span, property: S.String, path: JsoncPath },
64:   ArrayBegin: { ...Span, path: JsoncPath },
65:   ArrayEnd: Span,
66:   LiteralValue: { ...Span, value: S.Unknown, path: JsoncPath },
67:   Separator: { ...Span, character: S.Literals([",", ":"]) },
68:   Comment: Span,
69:   Error: { ...Span, code: JsoncParseErrorCode },
70: }).pipe(
71:   $I.annoteSchema("JsoncVisitorEvent", {
72:     description: "One event of a JSONC document walk: structure, values, separators, comments or recovered errors.",
73:   }),
74: );
75: 
83: export type JsoncVisitorEvent = typeof JsoncVisitorEvent.Type;
84: 
108: export abstract class JsoncVisitor {
140:   static visit(text: string, options?: JsoncParseOptions): Stream.Stream<JsoncVisitorEvent> {
141:     const disallowComments = options?.disallowComments ?? false;
142:     // A generator object iterates once; suspending creates a fresh one per
143:     // run so the stream stays a re-runnable description (upstream-bug fix).
144:     return Stream.suspend(() => Stream.fromIterable(visitGen(text, disallowComments)));
145:   }
146: }
147: 
148: const isTrivia = S.is(SyntaxKind.pick(["Trivia", "LineBreak"]));
149: const isComment = S.is(SyntaxKind.pick(["LineComment", "BlockComment"]));
150: const isScalar = S.is(SyntaxKind.pick(["String", "Number", "True", "False", "Null"]));
151: const isNotConsumable = S.is(SyntaxKind.pick(["CloseBrace", "CloseBracket", "EOF"]));
152: 
153: const literalValue = (kind: SyntaxKind, tokenValue: string): unknown =>
154:   Match.value(kind).pipe(
155:     Match.when(SyntaxKind.Enum.String, (): unknown => tokenValue),
156:     Match.when(SyntaxKind.Enum.Number, (): unknown => Number.parseFloat(tokenValue)),
157:     Match.when(SyntaxKind.Enum.True, (): unknown => true),
158:     Match.when(SyntaxKind.Enum.False, (): unknown => false),
159:     Match.orElse((): unknown => null),
160:   );
161: 
162: type Events = Generator<JsoncVisitorEvent, void>;
163: 
164: function* visitGen(text: string, disallowComments: boolean): Events {
165:   const scanner = createScanner(text, false);
166:   let path = A.empty<JsoncSegment>();
167:   // Current collection-nesting depth. Deeply nested input would otherwise
168:   // overflow the stack through visitObject/visitArray recursion, a defect
169:   // when the stream is pulled. At the cap the visitor emits one in-band Error
170:   // event and skips the over-deep subtree iteratively.
171:   let depth = 0;
172: 
173:   const span = () => ({
174:     offset: scanner.getTokenOffset(),
175:     length: scanner.getTokenLength(),
176:   });
177:   const error = (code: JsoncParseErrorCode): JsoncVisitorEvent => JsoncVisitorEvent.cases.Error.make({
178:     ...span(),
179:     code,
180:   });
181:   const separator = (character: "," | ":"): JsoncVisitorEvent =>
182:     JsoncVisitorEvent.cases.Separator.make({ ...span(), character });
183: 
184:   // Cursor adapter for the shared iterative bracket-balance skip. `advance` is
185:   // the raw scanner.scan, not the event-emitting scanNext, so nothing is
186:   // emitted while a too-deep container is consumed.
187:   const skipCursor: SkipCursor = {
188:     getToken: () => scanner.getToken(),
189:     advance: () => {
190:       scanner.scan();
191:     },
192:     tokenStart: () => scanner.getTokenOffset(),
193:     tokenLength: () => scanner.getTokenLength(),
194:   };
195: 
196:   function* scanNext(): Events {
197:     for (; ;) {
198:       const kind = scanner.scan();
199:       const code = scanErrorToCode(scanner.getTokenError());
200:       if (O.isSome(code)) {
201:         yield error(code.value);
202:       }
203:       if (isComment(kind)) {
204:         yield disallowComments ? error("InvalidCommentToken") : JsoncVisitorEvent.cases.Comment.make(span());
205:       } else if (!isTrivia(kind)) {
206:         return;
207:       }
208:     }
209:   }
210: 
211:   function* visitContainer(body: () => Events): Events {
212:     if (depth >= MAX_NESTING_DEPTH) {
213:       yield error("NestingDepthExceeded");
214:       skipBalancedValue(skipCursor);
215:       return;
216:     }
217:     depth++;
218:     try {
219:       yield* body();
220:     } finally {
221:       depth--;
222:     }
223:   }
224: 
225:   function* visitValue(): Events {
226:     const kind = scanner.getToken();
227:     if (SyntaxKind.is.OpenBrace(kind)) {
228:       yield* visitContainer(visitObject);
229:     } else if (SyntaxKind.is.OpenBracket(kind)) {
230:       yield* visitContainer(visitArray);
231:     } else if (isScalar(kind)) {
232:       yield JsoncVisitorEvent.cases.LiteralValue.make({
233:         ...span(),
234:         value: literalValue(kind, scanner.getTokenValue()),
235:         path,
236:       });
237:       yield* scanNext();
238:     } else {
239:       yield error("ValueExpected");
240:       // Consume the offending token so recovery always makes progress:
241:       // leaving it in place loops forever on inputs like `[bad]`. Container
242:       // closers stay put so the enclosing visit can close normally.
243:       if (!isNotConsumable(kind)) {
244:         yield* scanNext();
245:       }
246:     }
247:   }
248: 
249:   // Shared container-loop step: emits the separator before an entry or the
250:   // missing-comma error. Returns `false` when a trailing comma closed the
251:   // container.
252:   function* entrySeparator(closer: SyntaxKind, needsComma: boolean): Generator<JsoncVisitorEvent, boolean> {
253:     if (SyntaxKind.is.Comma(scanner.getToken())) {
254:       yield separator(",");
255:       yield* scanNext();
256:       return scanner.getToken() !== closer;
257:     }
258:     if (needsComma) {
259:       yield error("CommaExpected");
260:     }
261:     return true;
262:   }
263: 
264:   function* closeContainer(closer: SyntaxKind, end: () => JsoncVisitorEvent, missing: JsoncParseErrorCode): Events {
265:     if (scanner.getToken() === closer) {
