203: export class JsoncEdit extends S.Class<JsoncEdit>($I`JsoncEdit`)(
204:   {
205:     offset: S.Natural,
206:     length: S.Natural,
207:     content: S.String,
208:   },
209:   $I.annote("JsoncEdit", {
210:     description: "A replacement of one character span with new content.",
211:   })
212: ) {
240:   static applyAllResult(text: string, edits: ReadonlyArray<JsoncEdit>): Result.Result<string, JsoncEditOverlapError> {
241:     const sorted = A.sort(edits, byOffsetDescending);
242:     const overlap = A.findFirst(A.zip(sorted, A.drop(sorted, 1)), ([upper, lower]) => lower.offset + lower.length > upper.offset);
243:     return O.match(overlap, {
244:       onNone: () =>
245:         Result.succeed(
246:           A.reduce(sorted, text, (result, edit) =>
247:             Str.substring( 0, edit.offset)(result) + edit.content + Str.substring(edit.offset + edit.length)(result)
248:           )
249:         ),
250:       onSome: ([upper, lower]) => Result.fail(JsoncEditOverlapError.make({ lower: lower.offset, upper: upper.offset })),
251:     });
252:   }
253: 
282:   static applyAll(text: string, edits: ReadonlyArray<JsoncEdit>): string {
283:     return Result.getOrThrowWith(JsoncEdit.applyAllResult(text, edits), identity);
284:   }
285: }

