1: // The recursive JSONC AST node and the path vocabulary used to navigate it.
2: //
3: // `JsoncNode` is a `S.Class` with a `S.suspend` self-reference for `children`;
4: // it deliberately carries no parent pointers (circular references would break
5: // structural equality, serialization and Schema encode/decode). Navigation
6: // methods walk `children` locally and return `Option`, never a `NotFound`
7: // error. Value extraction (`toValue`) is a pure total function.
8: import * as R from "effect/Record";
9: import { $ScratchpadId } from "@beep/identity/packages";
10: import { LiteralKit } from "@beep/schema/LiteralKit";
11: import * as A from "effect/Array";
12: import * as O from "effect/Option";
13: import * as P from "effect/Predicate";
14: import * as S from "effect/Schema";
15: import { MAX_NESTING_DEPTH } from "./internal/limits.ts";
16: import { thunkNull } from "@beep/utils/thunk";
17: import { dual } from "effect/Function";
18: 
19: const $I = $ScratchpadId.create("effected/jsonc/JsoncNode");
