293: export declare namespace JsoncNode {
300:   export type Encoded = {
301:     readonly type: JsoncNodeType;
302:     readonly offset: number;
303:     readonly length: number;
304:     readonly value?: unknown;
305:     readonly colonOffset?: number;
306:     readonly children?: ReadonlyArray<JsoncNode.Encoded>;
307:   };
308: }
