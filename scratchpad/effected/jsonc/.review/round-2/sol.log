347: const toFlags = (options?: JsoncParseOptions): ParseFlags => options ?? JsoncParseOptions.make({});
348: 
349: const lineChar = (text: string, offset: number): { readonly line: number; readonly character: number } => {
350:   let line = 0;
351:   let lineStart = 0;
352:   const limit = Math.min(offset, text.length);
353:   for (let i = 0; i < limit; i++) {
354:     const ch = text.charCodeAt(i);
355:     if (ch === 0x0d && i + 1 < text.length && text.charCodeAt(i + 1) === 0x0a) {
356:       i++;
357:     }
358:     // LS and PS count as line breaks in the scanner; stay aligned so error
359:     // positions after them are correct.
360:     if (ch === 0x0a || ch === 0x0d || ch === 0x2028 || ch === 0x2029) {
361:       line++;
362:       lineStart = i + 1;
363:     }
364:   }
365:   return { line, character: offset - lineStart };
366: };
367: 
368: const toDetails = (text: string, errors: ReadonlyArray<RawParseError>): ReadonlyArray<JsoncParseErrorDetail> =>
369:   A.map(errors, (e) => JsoncParseErrorDetail.make({ ...e, ...lineChar(text, e.offset) }));
370: 
371: const aggregate = (text: string, errors: ReadonlyArray<RawParseError>): O.Option<JsoncParseError> =>
372:   A.isReadonlyArrayNonEmpty(errors)
373:     ? O.some(JsoncParseError.make({ errors: toDetails(text, errors), input: text }))
374:     : O.none();
375: 
376: const deepEqual = (a: unknown, b: unknown, depth: number): boolean => {
377:   if (a === b) {
378:     return true;
379:   }
380:   // Over-deep comparison (reachable through `equalsValue`, whose value side is
381:   // caller-supplied): treat as unequal rather than overflowing the stack.
382:   if (depth >= MAX_NESTING_DEPTH) {
383:     return false;
384:   }
385:   if (A.isArray(a) || A.isArray(b)) {
386:     return (
387:       A.isArray(a) &&
388:       A.isArray(b) &&
389:       a.length === b.length &&
390:       A.every(A.zip(a, b), ([x, y]) => deepEqual(x, y, depth + 1))
391:     );
392:   }
393:   if (P.isObject(a) && P.isObject(b)) {
394:     const aKeys = R.keys(a);
395:     return aKeys.length === R.keys(b).length && A.every(aKeys, (key) => R.has(b, key) && deepEqual(a[key], b[key], depth + 1));
396:   }
397:   return false;
398: };
