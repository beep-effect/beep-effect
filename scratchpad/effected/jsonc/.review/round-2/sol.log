608:   static stringifyResult(value: unknown, options?: JsoncStringifyOptions): Result.Result<string, JsoncStringifyError> {
609:     const resolved = options ?? JsoncStringifyOptions.make({});
610:     const space = resolved.insertSpaces ? resolved.tabSize : "\t";
611:     // The replacer runs ahead of serialization and classifies the failure the
612:     // codec is about to report: the codec itself only knows "not JSON".
613:     let code: JsoncStringifyErrorCode = JsoncStringifyErrorCode.Enum.SerializationFailed;
614:     // The replacer's first call receives the root after any `toJSON`, so it
615:     // alone decides whether the output is absent (upstream classifies the
616:     // same post-`toJSON` value).
617:     let root = true;
618:     // The open containers from the root down to the current holder, popped in
619:     // place: each visit costs the cycle scan the engine also makes, not a copy
620:     // of the whole stack.
621:     const ancestors: Array<object> = [];
622:     const codec = S.fromJsonString(S.Unknown, {
623:       space,
624:       replacer: function (this: unknown, _key: string, current: unknown): unknown {
625:         if (root) {
626:           root = false;
627:           if (isUnrepresentable(current)) {
628:             code = JsoncStringifyErrorCode.Enum.TopLevelUnrepresentable;
629:           }
630:         }
631:         if (P.isBigInt(current)) {
632:           code = JsoncStringifyErrorCode.Enum.BigIntValue;
633:         } else if (P.isObjectKeyword(current)) {
634:           while (A.isArrayNonEmpty(ancestors) && A.lastNonEmpty(ancestors) !== this) {
635:             ancestors.pop();
636:           }
637:           if (A.some(ancestors, (ancestor) => ancestor === current)) {
638:             code = JsoncStringifyErrorCode.Enum.CircularReference;
639:           }
640:           ancestors.push(current);
641:         }
642:         return current;
643:       },
644:     });
645:     return S.encodeResult(codec)(value).pipe(
646:       Result.mapError((error) =>
647:         JsoncStringifyError.make({
648:           code,
649:           detail: JsoncStringifyErrorCode.is.TopLevelUnrepresentable(code) ? topLevelUnrepresentableDetail : error.message,
650:           value,
651:         })
652:       )
653:     );
654:   }
655: 
677:   static readonly stringify = Effect.fn("Jsonc.stringify")((value: unknown, options?: JsoncStringifyOptions) =>
678:     Effect.fromResult(Jsonc.stringifyResult(value, options))
679:   );
680: 
704:   static stripComments(text: string, replaceCh?: string): string {
705:     const scanner = createScanner(text);
706:     // Pieces grow in place: an immutable append copies every earlier piece per
707:     // comment and makes comment-heavy documents quadratic.
708:     const parts: Array<string> = [];
709:     let lastOffset = 0;
710:     let kind = scanner.scan();
711:     while (kind !== "EOF") {
712:       if (isComment(kind)) {
713:         const offset = scanner.getTokenOffset();
714:         const length = scanner.getTokenLength();
715:         parts.push(text.substring(lastOffset, offset));
716:         if (P.isString(replaceCh)) {
717:           const comment = text.substring(offset, offset + length);
718:           parts.push(Str.replace(/[^\n\r]/g, replaceCh)(comment));
719:         }
720:         lastOffset = offset + length;
721:       }
722:       kind = scanner.scan();
723:     }
724:     parts.push(text.substring(lastOffset));
725:     return A.join(parts, Str.empty);
726:   }
727: 
750:   static equals(a: string, b: string): boolean {
751:     const ra = parseValueInternal(a, toFlags());
752:     const rb = parseValueInternal(b, toFlags());
753:     return A.isReadonlyArrayEmpty(ra.errors) && A.isReadonlyArrayEmpty(rb.errors) && deepEqual(ra.value, rb.value, 0);
754:   }
755: 
773:   static equalsValue(text: string, value: unknown): boolean {
774:     const r = parseValueInternal(text, toFlags());
775:     return A.isReadonlyArrayEmpty(r.errors) && deepEqual(r.value, value, 0);
776:   }
777: 
804:   static fromString(options?: JsoncParseOptions): S.Codec<unknown, string> {
805:     const flags = toFlags(options);
806:     return S.String.pipe(
807:       S.decodeTo(
808:         S.Unknown,
809:         SchemaTransformation.transformEffect({
810:           decode: (input: string) => {
811:             const { value, errors } = parseValueInternal(input, flags);
812:             return O.match(aggregate(input, errors), {
813:               onNone: () => Effect.succeed(value),
814:               onSome: (error) => Effect.fail(new SchemaIssue.InvalidValue({ message: error.message }, input)),
815:             });
816:           },
817:           encode: (value: unknown) =>
818:             Effect.fromResult(Jsonc.stringifyResult(value)).pipe(
819:               Effect.mapError((error) => new SchemaIssue.InvalidValue({ message: error.message }, value))
820:             ),
821:         })
822:       )
823:     );
824:   }
825: 
841:   static readonly JsoncFromString: S.Codec<unknown, string> = Jsonc.fromString();
842: 
868:   static schema<T, E, RD = never, RE = never>(
869:     target: S.Codec<T, E, RD, RE>,
870:     options?: JsoncParseOptions
871:   ): S.Codec<T, string, RD, RE> {
872:     return Jsonc.fromString(options).pipe(S.decodeTo(target));
873:   }
874: 
905:   static bind<T, E, RD = never, RE = never>(target: S.Codec<T, E, RD, RE>): JsoncBoundCodec<T, RD, RE> {
906:     const schema = Jsonc.schema(target);
907:     return {
908:       schema,
909:       decode: S.decodeEffect(schema),
910:       encode: S.encodeEffect(schema),
911:     };
912:   }
913: }

