444: export abstract class Jsonc {
475:   static parseResult(text: string, options?: JsoncParseOptions): Result.Result<unknown, JsoncParseError> {
476:     const { value, errors } = parseValueInternal(text, toFlags(options));
477:     return O.match(aggregate(text, errors), {
478:       onNone: () => Result.succeed(value),
479:       onSome: Result.fail,
480:     });
481:   }
482: 
505:   static readonly parse = Effect.fn("Jsonc.parse")((text: string, options?: JsoncParseOptions) =>
506:     Effect.fromResult(Jsonc.parseResult(text, options))
507:   );
508: 
536:   static parseTreeResult(text: string, options?: JsoncParseOptions): Result.Result<O.Option<JsoncNode>, JsoncParseError> {
537:     const { root, errors } = parseTreeInternal(text, toFlags(options));
538:     return O.match(aggregate(text, errors), {
539:       onNone: () => Result.succeed(root),
540:       onSome: Result.fail,
541:     });
542:   }
543: 
570:   static readonly parseTree = Effect.fn("Jsonc.parseTree")((text: string, options?: JsoncParseOptions) =>
571:     Effect.fromResult(Jsonc.parseTreeResult(text, options))
572:   );
