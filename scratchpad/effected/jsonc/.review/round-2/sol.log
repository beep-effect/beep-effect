340: export const makeNodeUnsafe = (props: JsoncNode.Encoded): JsoncNode =>
341:   JsoncNode.make(props, { disableChecks: true });
342: 
343: const propertyKey = (prop: JsoncNode): O.Option<string> =>
344:   JsoncNodeType.is.property(prop.type)
345:     ? O.fromUndefinedOr(prop.children).pipe(
346:       O.flatMap(A.head),
347:       O.map((keyNode) => keyNode.value),
348:       O.filter(P.isString),
349:     )
350:     : O.none();
351: 
352: const covers = (node: JsoncNode, offset: number): boolean =>
353:   offset >= node.offset && offset < node.offset + node.length;
354: 
355: // An array index addresses an element only when it is a non-negative integer:
356: // upstream reads `children[segment]`, which is `undefined` for `0.5` or `-1`,
357: // while `A.get` floors a fractional index onto a real element.
358: const isArrayIndex = S.is(S.Natural);
359: 
360: const childAt = (node: JsoncNode, segment: JsoncSegment): O.Option<JsoncNode> => {
361:   const children = O.fromUndefinedOr(node.children);
362:   if (P.isString(segment)) {
363:     return JsoncNodeType.is.object(node.type)
364:       ? children.pipe(
365:         O.flatMap(A.findFirst((child) => O.contains(propertyKey(child), segment))),
366:         O.flatMap((prop) => O.flatMap(O.fromUndefinedOr(prop.children), A.get(1))),
367:       )
368:       : O.none();
369:   }
370:   return JsoncNodeType.is.array(node.type) && isArrayIndex(segment) ? O.flatMap(children, A.get(segment)) : O.none();
371: };
372: 
373: // Recursive walkers below cap their descent at MAX_NESTING_DEPTH. A tree built
374: // by the parser is already bounded (the parser caps at the same depth), but a
375: // tree assembled by hand via `JsoncNode.make` can nest arbitrarily deep, so
376: // each walker guards independently, returning a bounded placeholder rather
377: // than overflowing the stack as a defect.
378: 
379: const findAtOffsetImpl = (node: JsoncNode, offset: number, depth: number): O.Option<JsoncNode> => {
380:   if (!covers(node, offset)) {
381:     return O.none();
382:   }
383:   if (node.children === undefined || depth >= MAX_NESTING_DEPTH) {
384:     return O.some(node);
385:   }
386:   return A.findFirst(node.children, (child) => covers(child, offset)).pipe(
387:     O.flatMap((child) => findAtOffsetImpl(child, offset, depth + 1)),
388:     O.orElseSome(() => node),
389:   );
390: };
391: 
392: const buildPath = (
393:   node: JsoncNode,
394:   offset: number,
395:   currentPath: ReadonlyArray<JsoncSegment>,
396:   depth: number,
397: ): O.Option<JsoncPath> => {
398:   if (!covers(node, offset)) {
399:     return O.none();
400:   }
401:   if (node.children === undefined || depth >= MAX_NESTING_DEPTH) {
402:     return O.some(currentPath);
403:   }
404:   if (JsoncNodeType.is.object(node.type)) {
405:     for (const prop of node.children) {
406:       const key = propertyKey(prop);
407:       if (O.isSome(key) && covers(prop, offset)) {
408:         const valuePath = A.append(currentPath, key.value);
409:         return O.fromUndefinedOr(prop.children).pipe(
410:           O.flatMap(A.get(1)),
411:           O.filter((valueChild) => covers(valueChild, offset)),
412:           O.flatMap((valueChild) => buildPath(valueChild, offset, valuePath, depth + 1)),
413:           O.orElseSome(() => valuePath),
414:         );
415:       }
416:     }
417:     return O.some(currentPath);
418:   }
419:   if (JsoncNodeType.is.array(node.type)) {
420:     let index = 0;
421:     for (const child of node.children) {
422:       if (covers(child, offset)) {
423:         return buildPath(child, offset, A.append(currentPath, index), depth + 1);
424:       }
425:       index++;
426:     }
427:   }
428:   return O.some(currentPath);
429: };
430: 
431: const evaluateNode: {
432:   (node: JsoncNode, depth: number): unknown,
433:   (depth: number): (node: JsoncNode) => unknown
434: } = dual(2, (node: JsoncNode, depth: number): unknown => {
435:   // Over-deep subtree (only reachable on a hand-built tree): stop descending
436:   // and yield a bounded placeholder rather than overflowing the stack.
437:   if (depth >= MAX_NESTING_DEPTH) {
438:     return JsoncNodeType.$match(node.type, {
439:       object: R.empty,
440:       array: A.empty<unknown>,
441:       property: thunkNull,
442:       string: thunkNull,
443:       number: thunkNull,
444:       boolean: thunkNull,
445:       null: thunkNull,
446:     });
447:   }
448:   const children = node.children ?? A.empty<JsoncNode>();
449:   const thunkNodeValue = () => node.value;
450:   return JsoncNodeType.$match(node.type, {
451:     object: () => {
452:       const obj = R.empty<string, unknown>();
453:       for (const prop of children) {
454:         const key = propertyKey(prop);
455:         const valueNode = O.flatMap(O.fromUndefinedOr(prop.children), A.get(1));
456:         if (O.isSome(key) && O.isSome(valueNode)) {
457:           // Own data property, not a prototype mutation: matches the value
458:           // parser and JSON.parse semantics for a `__proto__` key.
459:           Object.defineProperty(obj, key.value, {
460:             value: evaluateNode(valueNode.value, depth + 1),
461:             writable: true,
462:             enumerable: true,
463:             configurable: true,
464:           });
465:         }
466:       }
467:       return obj;
468:     },
469:     array: () => A.map(children, evaluateNode(depth + 1)),
470:     property: () => O.getOrUndefined(O.map(A.get(children, 1), evaluateNode(depth + 1))),
471:     string: thunkNodeValue,
472:     number: thunkNodeValue,
