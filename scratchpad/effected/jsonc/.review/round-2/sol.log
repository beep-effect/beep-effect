417: export interface JsoncBoundCodec<T, RD = never, RE = never> {
419:   readonly schema: S.Codec<T, string, RD, RE>;
421:   readonly decode: (text: string) => Effect.Effect<T, S.SchemaError, RD>;
423:   readonly encode: (value: T) => Effect.Effect<string, S.SchemaError, RE>;
424: }
