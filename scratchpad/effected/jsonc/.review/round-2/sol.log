169:     length: S.Natural,
170:     value: S.optionalKey(S.Unknown),
171:     colonOffset: S.optionalKey(S.Natural),
172:     children: S.suspend((): S.Codec<JsoncNode, JsoncNode.Encoded> => JsoncNode).pipe(S.Array, S.optionalKey),
173:   },
174:   $I.annote("JsoncNode", {
175:     description: "An immutable JSONC AST node with a tight source span and optional children.",
176:   }),
