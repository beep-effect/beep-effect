204:   find(path: JsoncPath): O.Option<JsoncNode> {
205:     let current: O.Option<JsoncNode> = O.some(this);
206:     for (const segment of path) {
207:       current = O.flatMap(current, (node) => childAt(node, segment));
208:     }
209:     return current;
210:   }
