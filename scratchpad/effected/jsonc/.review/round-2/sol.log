400: const isComment = S.is(SyntaxKind.pick(["LineComment", "BlockComment"]));
401: 
402: const isUnrepresentable = (value: unknown): boolean => P.isUndefined(value) || P.isFunction(value) || P.isSymbol(value);
403: 
404: const topLevelUnrepresentableDetail = "the top-level value (undefined, a function or a symbol) has no JSON representation";
