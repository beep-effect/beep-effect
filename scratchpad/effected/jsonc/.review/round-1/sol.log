275: const emit = (value: unknown, path: string, depth: number): Emit => {
276:   if (P.isNull(value) || P.isBoolean(value)) {
277:     return Result.succeed(emitScalar(value));
278:   }
279:   if (P.isNumber(value)) {
280:     return S.is(S.Finite)(value)
281:       ? Result.succeed(emitScalar(value))
282:       : fail("NonFiniteNumber", path, "non-finite numbers have no canonical JSON representation");
283:   }
284:   if (P.isString(value)) {
285:     return value.isWellFormed()
286:       ? Result.succeed(emitScalar(value))
287:       : fail("LoneSurrogate", path, "string contains an unpaired surrogate; RFC 8785 requires well-formed Unicode");
288:   }
289:   if (P.isBigInt(value)) {
290:     return fail("BigIntValue", path, "bigint values cannot be represented in JSON");
291:   }
292:   if (!A.isArray(value) && !P.isObject(value)) {
293:     return fail("UnrepresentableValue", path, "undefined, function and symbol values have no JSON representation");
294:   }
295:   if (depth >= MAX_NESTING_DEPTH) {
296:     return fail("NestingDepthExceeded", path, `nesting exceeds ${MAX_NESTING_DEPTH} levels (a cyclic value also fails here)`);
297:   }
298:   return A.isArray(value) ? emitArray(value, path, depth) : emitRecord(value, path, depth);
