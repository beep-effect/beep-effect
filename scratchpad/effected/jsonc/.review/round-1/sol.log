796:               onNone: () => Effect.succeed(value),
797:               onSome: (error) => Effect.fail(new SchemaIssue.InvalidValue({ message: error.message }, input)),
798:             });
799:           },
800:           encode: (value: unknown) =>
801:             Effect.fromResult(Jsonc.stringifyResult(value)).pipe(
802:               Effect.mapError((error) => new SchemaIssue.InvalidValue({ message: error.message }, value))
803:             ),
804:         })
805:       )
806:     );
807:   }
808: 
824:   static readonly JsoncFromString: S.Codec<unknown, string> = Jsonc.fromString();
825: 
851:   static schema<T, E, RD = never, RE = never>(
852:     target: S.Codec<T, E, RD, RE>,
853:     options?: JsoncParseOptions
854:   ): S.Codec<T, string, RD, RE> {
855:     return Jsonc.fromString(options).pipe(S.decodeTo(target));
856:   }
857: 
888:   static bind<T, E, RD = never, RE = never>(target: S.Codec<T, E, RD, RE>): JsoncBoundCodec<T, RD, RE> {
889:     const schema = Jsonc.schema(target);
890:     return {
891:       schema,
892:       decode: S.decodeEffect(schema),
893:       encode: S.encodeEffect(schema),
