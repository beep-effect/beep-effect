214: const readProperty = (container: object, key: string | number, path: string): Result.Result<unknown, JsoncCanonicalizeError> =>
215:   Result.try({
216:     try: () => Reflect.get(container, key),
217:     catch: () =>
218:       JsoncCanonicalizeError.make({
219:         code: "UnrepresentableValue",
220:         path,
221:         detail: "the property getter for this value threw; getters must return plain JSON values",
