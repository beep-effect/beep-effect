83: export type JsoncVisitorEvent = typeof JsoncVisitorEvent.Type;
84: 
108: export abstract class JsoncVisitor {
139:   static visit(text: string, options?: JsoncParseOptions): Stream.Stream<JsoncVisitorEvent> {
140:     return Stream.fromIterable(visitGen(text, options?.disallowComments ?? false));
141:   }
142: }
143: 
144: const isTrivia = S.is(SyntaxKind.pick(["Trivia", "LineBreak"]));
145: const isComment = S.is(SyntaxKind.pick(["LineComment", "BlockComment"]));
146: const isScalar = S.is(SyntaxKind.pick(["String", "Number", "True", "False", "Null"]));
147: const isNotConsumable = S.is(SyntaxKind.pick(["CloseBrace", "CloseBracket", "EOF"]));
148: 
149: const literalValue = (kind: SyntaxKind, tokenValue: string): unknown =>
150:   Match.value(kind).pipe(
151:     Match.when(SyntaxKind.Enum.String, (): unknown => tokenValue),
152:     Match.when(SyntaxKind.Enum.Number, (): unknown => Number.parseFloat(tokenValue)),
153:     Match.when(SyntaxKind.Enum.True, (): unknown => true),
154:     Match.when(SyntaxKind.Enum.False, (): unknown => false),
155:     Match.orElse((): unknown => null),
156:   );
157: 
158: type Events = Generator<JsoncVisitorEvent, void>;
159: 
160: function* visitGen(text: string, disallowComments: boolean): Events {
161:   const scanner = createScanner(text, false);
162:   let path = A.empty<JsoncSegment>();
167:   let depth = 0;
168: 
169:   const span = () => ({
170:     offset: scanner.getTokenOffset(),
171:     length: scanner.getTokenLength(),
172:   });
173:   const error = (code: JsoncParseErrorCode): JsoncVisitorEvent => JsoncVisitorEvent.cases.Error.make({
174:     ...span(),
175:     code,
176:   });
177:   const separator = (character: "," | ":"): JsoncVisitorEvent =>
178:     JsoncVisitorEvent.cases.Separator.make({ ...span(), character });
179: 
183:   const skipCursor: SkipCursor = {
184:     getToken: () => scanner.getToken(),
185:     advance: () => {
186:       scanner.scan();
187:     },
188:     tokenStart: () => scanner.getTokenOffset(),
189:     tokenLength: () => scanner.getTokenLength(),
190:   };
191: 
192:   function* scanNext(): Events {
193:     for (; ;) {
194:       const kind = scanner.scan();
195:       const code = scanErrorToCode(scanner.getTokenError());
196:       if (O.isSome(code)) {
197:         yield error(code.value);
198:       }
199:       if (isComment(kind)) {
200:         yield disallowComments ? error("InvalidCommentToken") : JsoncVisitorEvent.cases.Comment.make(span());
201:       } else if (!isTrivia(kind)) {
202:         return;
203:       }
204:     }
205:   }
206: 
207:   function* visitContainer(body: () => Events): Events {
208:     if (depth >= MAX_NESTING_DEPTH) {
209:       yield error("NestingDepthExceeded");
210:       skipBalancedValue(skipCursor);
211:       return;
212:     }
213:     depth++;
214:     try {
215:       yield* body();
216:     } finally {
217:       depth--;
218:     }
219:   }
220: 
221:   function* visitValue(): Events {
222:     const kind = scanner.getToken();
223:     if (SyntaxKind.is.OpenBrace(kind)) {
224:       yield* visitContainer(visitObject);
225:     } else if (SyntaxKind.is.OpenBracket(kind)) {
226:       yield* visitContainer(visitArray);
227:     } else if (isScalar(kind)) {
228:       yield JsoncVisitorEvent.cases.LiteralValue.make({
229:         ...span(),
230:         value: literalValue(kind, scanner.getTokenValue()),
231:         path,
232:       });
233:       yield* scanNext();
234:     } else {
235:       yield error("ValueExpected");
239:       if (!isNotConsumable(kind)) {
240:         yield* scanNext();
241:       }
242:     }
243:   }
244: 
248:   function* entrySeparator(closer: SyntaxKind, needsComma: boolean): Generator<JsoncVisitorEvent, boolean> {
249:     if (SyntaxKind.is.Comma(scanner.getToken())) {
250:       yield separator(",");
251:       yield* scanNext();
252:       return scanner.getToken() !== closer;
253:     }
254:     if (needsComma) {
255:       yield error("CommaExpected");
256:     }
257:     return true;
258:   }
259: 
260:   function* closeContainer(closer: SyntaxKind, end: () => JsoncVisitorEvent, missing: JsoncParseErrorCode): Events {
261:     if (scanner.getToken() === closer) {
262:       yield end();
263:       yield* scanNext();
264:     } else {
265:       yield error(missing);
266:     }
267:   }
268: 
269:   function* visitObject(): Events {
270:     yield JsoncVisitorEvent.cases.ObjectBegin.make({ ...span(), path });
271:     yield* scanNext(); // skip {
272:     let needsComma = false;
273:     while (!SyntaxKind.is.CloseBrace(scanner.getToken()) && !SyntaxKind.is.EOF(scanner.getToken())) {
274:       if (!(yield* entrySeparator("CloseBrace", needsComma))) {
275:         break;
276:       }
277:       if (!SyntaxKind.is.String(scanner.getToken())) {
278:         yield error("PropertyNameExpected");
279:         yield* scanNext();
280:         continue;
281:       }
282:       const key = scanner.getTokenValue();
283:       yield JsoncVisitorEvent.cases.ObjectProperty.make({
284:         ...span(),
285:         property: key,
286:         path,
287:       });
288:       path = A.append(path, key);
289:       yield* scanNext(); // skip key
290:       if (SyntaxKind.is.Colon(scanner.getToken())) {
291:         yield separator(":");
292:         yield* scanNext(); // skip colon
293:       } else {
294:         yield error("ColonExpected");
295:       }
296:       yield* visitValue();
297:       path = A.dropRight(path, 1);
298:       needsComma = true;
299:     }
300:     yield* closeContainer("CloseBrace", () => JsoncVisitorEvent.cases.ObjectEnd.make(span()), "CloseBraceExpected");
301:   }
302: 
303:   function* visitArray(): Events {
304:     yield JsoncVisitorEvent.cases.ArrayBegin.make({ ...span(), path });
305:     yield* scanNext(); // skip [
306:     let index = 0;
307:     let needsComma = false;
308:     while (!SyntaxKind.is.CloseBracket(scanner.getToken()) && !SyntaxKind.is.EOF(scanner.getToken())) {
309:       if (!(yield* entrySeparator("CloseBracket", needsComma))) {
310:         break;
311:       }
312:       path = A.append(path, index);
313:       yield* visitValue();
314:       path = A.dropRight(path, 1);
315:       index++;
316:       needsComma = true;
317:     }
318:     yield* closeContainer("CloseBracket", () => JsoncVisitorEvent.cases.ArrayEnd.make(span()), "CloseBracketExpected");
319:   }
320: 
321:   yield* scanNext();
322:   if (!SyntaxKind.is.EOF(scanner.getToken())) {
323:     yield* visitValue();
324:     if (!SyntaxKind.is.EOF(scanner.getToken())) {
325:       yield error("EndOfFileExpected");
326:     }
327:   }
328: }

