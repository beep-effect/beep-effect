254: const emitRecord = (value: { readonly [x: PropertyKey]: unknown }, path: string, depth: number): Emit => {
255:   if (!isPlainObject(value)) {
256:     return fail("NonPlainObject", path, "only arrays and plain objects canonicalize; encode domain values to plain JSON first");
257:   }
