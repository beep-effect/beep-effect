733:   static equals(a: string, b: string): boolean {
734:     const ra = parseValueInternal(a, toFlags());
735:     const rb = parseValueInternal(b, toFlags());
736:     return A.isReadonlyArrayEmpty(ra.errors) && A.isReadonlyArrayEmpty(rb.errors) && deepEqual(ra.value, rb.value, 0);
737:   }
