690:   static stripComments(text: string, replaceCh?: string): string {
691:     const scanner = createScanner(text);
692:     let parts = A.empty<string>();
693:     let lastOffset = 0;
694:     let kind = scanner.scan();
695:     while (kind !== "EOF") {
696:       if (isComment(kind)) {
697:         const offset = scanner.getTokenOffset();
698:         const length = scanner.getTokenLength();
699:         parts = A.append(parts, text.substring(lastOffset, offset));
700:         if (P.isString(replaceCh)) {
701:           const comment = text.substring(offset, offset + length);
702:           parts = A.append(parts, Str.replace(/[^\n\r]/g, replaceCh)(comment));
703:         }
704:         lastOffset = offset + length;
705:       }
706:       kind = scanner.scan();
707:     }
708:     return A.join(A.append(parts, text.substring(lastOffset)), Str.empty);
709:   }
