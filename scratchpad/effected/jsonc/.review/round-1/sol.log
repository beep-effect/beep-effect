247: const emitArray = (value: ReadonlyArray<unknown>, path: string, depth: number): Emit =>
250:   emitMembers(value, A.fromIterable(value.keys()), path, depth, (_, item) => item).pipe(
251:     Result.map((items) => `[${A.join(items, ",")}]`)
252:   );
