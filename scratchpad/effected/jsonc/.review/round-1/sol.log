237:   Result.all(
238:     A.map(keys, (key) => {
239:       const memberPath = `${path}/${P.isString(key) ? escapePointerSegment(key) : key}`;
240:       return readProperty(container, key, memberPath).pipe(
241:         Result.flatMap((member) => emit(member, memberPath, depth + 1)),
242:         Result.map((item) => render(key, item))
243:       );
244:     })
245:   );
