+  Match.when(0x2f, () => O.some("/")),
+  Match.when(0x62, () => O.some("\b")),
+  Match.when(0x66, () => O.some("\f")),
+  Match.when(0x6e, () => O.some("\n")),
+  Match.when(0x72, () => O.some("\r")),
+  Match.when(0x74, () => O.some("\t")),
