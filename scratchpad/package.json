{
  "name": "@beep/scratchpad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/scratchpad",
  "exports": {
    "./beep": "./beep/index.ts",
    "./*": "./*.ts"
  },
  "scripts": {
    "audit:effect-ontology-arbitraries": "bun effect-ontology/scripts/audit-arbitraries.ts",
    "audit:effected": "bun effected/audit.ts",
    "check:effect-ontology": "tsc-rs -p effect-ontology/tsconfig.json --noEmit --pretty false && bun run migrations:check:effect-ontology && bun run --cwd .. beep laws native-runtime --check --include 'scratchpad/effect-ontology/**/*.ts'",
    "check:effected": "bun effected/audit.ts check",
    "coverage:effected": "bun effected/audit.ts test --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "docgen:effect-ontology": "bunx --bun --no-install docgen --config-file docgen.effect-ontology.json",
    "docgen:effected": "bun effected/audit.ts docgen",
    "generate:effect-ontology-migrations": "bun effect-ontology/scripts/generate-migrations.ts",
    "lint:effect-ontology": "biome check --config-path effect-ontology/biome.jsonc effect-ontology",
    "lint:effected": "bun effected/audit.ts lint",
    "migrations:check:effect-ontology": "bun effect-ontology/scripts/check-migrations-drift.ts",
    "test:effect-ontology": "bunx --bun vitest run --config effect-ontology/vitest.config.ts",
    "test:effected": "bun effected/audit.ts test"
  },
  "dependencies": {
