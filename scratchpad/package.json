{
  "name": "@beep/scratchpad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/beep-effect/beep-effect/tree/main/scratchpad",
  "exports": {
    "./beep": "./beep/index.ts",
    "./*": "./*.ts"
  },
  "scripts": {
    "audit:effect-ontology-arbitraries": "bun effect-ontology/scripts/audit-arbitraries.ts",
    "audit:effect-ontology-docs": "bun effect-ontology/scripts/audit-documentation.ts",
    "audit:effected": "bun effected/audit.ts",
    "check:effect-ontology": "tsgo -p effect-ontology/tsconfig.json --noEmit --pretty false && bun run migrations:check:effect-ontology && bun run --cwd .. beep laws native-runtime --check --include 'scratchpad/effect-ontology/**/*.ts'",
    "check:effected": "bun effected/audit.ts check",
    "coverage:effected": "bun effected/audit.ts test --coverage",
    "docgen": "bunx --bun --no-install docgen",
    "docgen:effect-ontology": "bunx --bun --no-install docgen --config-file docgen.effect-ontology.json",
    "docgen:effected": "bun effected/audit.ts docgen",
    "generate:effect-ontology-migrations": "bun effect-ontology/scripts/generate-migrations.ts",
    "lint:effect-ontology": "biome check --config-path effect-ontology/biome.jsonc effect-ontology",
    "lint:effected": "bun effected/audit.ts lint",
    "migrations:check:effect-ontology": "bun effect-ontology/scripts/check-migrations-drift.ts",
    "test:effect-ontology": "bunx --bun vitest run --config effect-ontology/vitest.config.ts",
    "test:effected": "bun effected/audit.ts test"
  },
  "dependencies": {
    "@beep/dock": "workspace:^",
    "@beep/dock-react": "workspace:^",
    "@beep/drizzle": "workspace:^",
    "@beep/effect-drizzle": "workspace:^",
    "@beep/epistemic-domain": "workspace:^",
    "@beep/file-processing": "workspace:^",
    "@beep/identity": "workspace:^",
    "@beep/md": "workspace:^",
    "@beep/n3": "workspace:^",
    "@beep/nlp": "workspace:^",
    "@beep/nlp-processing": "workspace:^",
    "@beep/ontology": "workspace:^",
    "@beep/oxigraph": "workspace:^",
    "@beep/postgres": "workspace:^",
    "@beep/pretext": "workspace:^",
    "@beep/provenance": "workspace:^",
    "@beep/rdf": "workspace:^",
    "@beep/repo-utils": "workspace:^",
    "@beep/schema": "workspace:^",
    "@beep/semantic-web": "workspace:^",
    "@beep/shacl": "workspace:^",
    "@beep/utils": "workspace:^",
    "@beep/wink": "workspace:^",
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@google-cloud/pubsub": "catalog:",
    "@google-cloud/storage": "catalog:",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-paginate-rest": "^16.0.0",
    "@octokit/types": "^18.0.0",
    "@xenova/transformers": "catalog:",
    "@zip.js/zip.js": "catalog:",
    "blakejs": "1.2.1",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "exifreader": "catalog:",
    "file-type": "catalog:",
    "gray-matter": "catalog:",
    "lexical": "catalog:",
    "mediabunny": "catalog:",
    "music-metadata": "catalog:",
    "n3": "catalog:",
    "officeparser": "catalog:",
    "pdfjs-dist": "catalog:",
    "tweetnacl": "1.0.3",
    "universal-github-app-jwt": "^2.2.2"
  },
  "devDependencies": {
    "@beep/fc-runs": "workspace:^",
    "@beep/pglite": "workspace:^",
    "@beep/repo-cli": "workspace:^",
    "@beep/test-utils": "workspace:^",
    "@effect/doctest": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/n3": "catalog:",
    "@types/node": "catalog:",
    "commonmark": "0.31.2",
    "drizzle-kit": "catalog:",
    "minimatch": "10.2.6",
    "oxc-parser": "^0.152.0",
    "smol-toml": "1.9.0",
    "spdx-exceptions": "2.5.0",
    "spdx-expression-parse": "5.0.0",
    "spdx-license-ids": "3.0.24",
    "ts-morph": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
