{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "include": ["Domain/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["docs", "node_modules"],
  "compilerOptions": {
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false
  }
}
