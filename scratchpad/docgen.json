{
  "$schema": "../packages/tooling/tool/docgen/schema.json",
  "srcLink": "https://github.com/beep-effect/beep-effect/tree/main/scratchpad/",
  "srcDir": ".",
  "outDir": ".jsdoc-loop/generated-docs",
  "include": ["**/*.ts"],
  "exclude": [
    "docs/**",
    ".jsdoc-loop/**",
    "**/test/**",
    "**/*.test.ts",
    "**/vitest.config.ts",
    "**/node_modules/**",
    "encode-keys-probe.ts",
    "identity-kit-probe.ts",
    "exec.ts",
    "effect-ontology/**",
    "beep/**"
  ],
  "enforceDescriptions": true,
  "enforceExamples": true,
  "enforceVersion": true,
  "parseCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2024",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "bun"],
    "paths": {
      "@beep/identity": [
        "../packages/foundation/modeling/identity/src/index.ts"
      ],
      "@beep/identity/*": ["../packages/foundation/modeling/identity/src/*.ts"],
      "@beep/identity/packages": [
        "../packages/foundation/modeling/identity/src/packages.ts"
      ],
      "@beep/schema": ["../packages/foundation/modeling/schema/src/index.ts"],
      "@beep/utils": ["../packages/foundation/modeling/utils/src/index.ts"],
      "@beep/utils/*": ["../packages/foundation/modeling/utils/src/*.ts"],
      "@beep/scratchpad/yaml": ["yaml/index.ts"],
      "@beep/scratchpad/jsonc": ["jsonc/index.ts"],
      "@beep/scratchpad/jsonl": ["jsonl/index.ts"],
      "@beep/scratchpad/toml": ["toml/index.ts"],
      "@beep/scratchpad/glob": ["glob/index.ts"],
      "@beep/scratchpad/semver": ["semver/index.ts"],
      "@beep/scratchpad/beep-docs": ["beep-docs/api-reference/index.ts"]
    }
  },
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "bun"],
    "allowJs": false,
    "erasableSyntaxOnly": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "stripInternal": false,
    "noErrorTruncation": true,
    "jsx": "react-jsx",
    "paths": {
      "@effect-ontology/index": ["../../../effect-ontology/index.ts"],
      "@effect-ontology/Identity": [
        "../../../effect-ontology/Domain/Identity.ts"
      ],
      "@effect-ontology/PathLayout": [
        "../../../effect-ontology/Domain/PathLayout.ts"
      ],
      "@effect-ontology/Schema/EntityFactory": [
        "../../../effect-ontology/Schema/EntityFactory.ts"
      ],
      "@effect-ontology/Schema/Errors": [
        "../../../effect-ontology/Schema/Errors.ts"
      ],
      "@effect-ontology/Schema/MentionFactory": [
        "../../../effect-ontology/Schema/MentionFactory.ts"
      ],
      "@effect-ontology/Schema/RelationFactory": [
        "../../../effect-ontology/Schema/RelationFactory.ts"
      ],
      "@effect-ontology/Error/*": [
        "../../../effect-ontology/Domain/Error/*.ts"
      ],
      "@effect-ontology/Model/*": [
        "../../../effect-ontology/Domain/Model/*.ts"
      ],
      "@effect-ontology/Rdf/*": ["../../../effect-ontology/Domain/Rdf/*.ts"],
      "@effect-ontology/Schema/*": [
        "../../../effect-ontology/Domain/Schema/*.ts"
      ],
      "@effect-ontology/*": ["../../../effect-ontology/*.ts"]
    }
  }
}
