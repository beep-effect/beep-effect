# Per-target docgen configs are generated by scratchpad/effected/audit.ts from
# docgen.effected.template.json; the template and the hand-kept configs stay tracked.
docgen.*.json
!docgen.effected.template.json
!docgen.effect-ontology.json
.tsgo-lanes/
# Raw reviewer seat logs (Codex/Grok streams) stay local; the seat reports, merged
# inventories and required.json under effected/<m>/.review/ are the committed evidence.
effected/*/.review/**/*.log
effected/*/.review/**/*.err
