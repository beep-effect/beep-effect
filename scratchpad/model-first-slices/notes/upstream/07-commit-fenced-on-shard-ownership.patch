+/**
+ * The commit fence (D45 in the prototype): a commit is acknowledged only if
+ * its runner held the instance's shard lock for the whole commit transaction.
+ *
+ * Effect Cluster's SQL runner storage holds each shard as a session-level
+ * PostgreSQL advisory lock, `pg_try_advisory_lock(namespace, groupBase +
+ * shard)`, on one reserved connection per runner (`SqlRunnerStorage.ts`). A
+ * commit runs on another connection, so it cannot take or share that lock;
+ * it can read it in `pg_locks`. The fence reads it twice:
+ *
+ * - first in the transaction, it finds the session holding the shard's lock
+ *   that is this runner's, and remembers its pid in a transaction-local
+ *   setting; no such session, and the commit is refused before it writes;
+ * - at `COMMIT`, a deferred constraint trigger checks that the same session
+ *   still holds the lock, after the last point at which the runner itself can
+ *   stall. A lock lost meanwhile (the session ended, the shard moved) aborts
+ *   the commit with SQLSTATE `AD001`, which the storage reports as
+ *   `ShardLost`.
+ *
+ * Which session is this runner's: the one named after the runner. The runner
+ * bootstrap names the Postgres pool Effect's runner storage reserves the lock
+ * session from (`runnerPoolName`, `effect-cluster:host:port`), from the same
+ * address the runner gives Effect, so the lock session carries the name and
+ * the fence computes it the same way. There is no fallback: a runner whose
+ * pool is not named (another bootstrap) has no session of its own, and every
+ * commit it makes is refused.
+ *
+ * A takeover cannot complete only in the server's own commit, between the
+ * trigger and the commit record; even then the new owner cannot commit to the
+ * instance before this commit is visible (the instance's advisory lock), and
+ * its own commit then fails the version check.
+ */
+interface CommitFence {
+  /** The shard, as `group:id`. */
+  readonly shard: string;
+  /** This runner's pool name, which its lock session carries (`runnerPoolName`); empty without an address. */
+  readonly named: string;
+  /** The lock's two keys as `pg_locks` shows them (`classid`, `objid`). */
+  readonly classid: number;
+  readonly objid: number;
+}
+
+/**
+ * The advisory-lock namespace of Effect Cluster's SQL runner storage for its
+ * default table prefix: FNV-1a of `effect-cluster:cluster`
+ * (`SqlRunnerStorage.ts`, `postgresLockNamespace`, a persistent wire format).
+ */
+const clusterLockNamespace = (prefix: string): number => {
+  const bytes = new TextEncoder().encode(`effect-cluster:${prefix}`);
+  let hash = 0x811c9dc5;
+  for (let i = 0; i < bytes.length; i++) hash = Math.imul(hash ^ bytes[i]!, 0x01000193);
+  return hash | 0;
+};
+
+/**
+ * The fence of an instance on `shardId`, as the runner storage numbers its
+ * lock (`(group index + 1) * 1000000 + shard`, groups sorted). None where the
+ * storage uses no advisory locks.
+ */
+const commitFence = (shardId: { readonly group: string; readonly id: number }) =>
+  Effect.map(Effect.serviceOption(ShardingConfig.ShardingConfig), (config): CommitFence | undefined => {
+    const service = Option.getOrElse(config, () => ShardingConfig.defaults);
+    if (service.shardLockDisableAdvisory) return undefined;
+    const index = Array.from(ShardingConfig.shardGroupConfig(service).available).indexOf(shardId.group);
+    if (index < 0) return undefined;
+    return {
+      shard: `${shardId.group}:${shardId.id}`,
+      named: Option.match(service.runnerAddress, {
+        onNone: () => "",
+        onSome: (address) => runnerPoolName(address.host, address.port),
+      }),
+      classid: clusterLockNamespace("cluster") >>> 0,
+      objid: (index + 1) * 1_000_000 + shardId.id,
+    };
+  });
