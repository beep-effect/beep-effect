+/**
+ * A call's arguments as JSON text, for a host whose transport carries them so
+ * (Effect Cluster's `Call` RPC). JSON writes an `undefined` array element
+ * as `null`, so an optional parameter the caller left out would reach the
+ * object as `null`, where a Durable Object call (structured clone) gives
+ * `undefined`: a `=== undefined` test or a default parameter then misreads
+ * it (the directory node's first-page cursor did). Trailing `undefined`
+ * arguments are therefore left out, and the object sees them as `undefined`.
+ * Every optional parameter is trailing; an `undefined` before a defined
+ * argument would still arrive as `null`.
+ */
+export const encodeCallArgs = (args: ReadonlyArray<unknown>): string => {
+  let end = args.length;
+  while (end > 0 && args[end - 1] === undefined) end--;
+  return JSON.stringify(args.slice(0, end));
+};
+
 /** What an instance runs with. */
 export type InstanceServices = ObjectState | RuntimeContext | Scope.Scope;
 
