+import { describe, expect, it } from "@alchemy.run/test";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import { twoRunnerHost } from "./two-runner-host.ts";
+import { Account, AccountId, Deposit, hosted, logOf, stallOf } from "./two-runner-model.ts";
+
+/**
+ * A host that fences commits on ownership (Effect Cluster's storage checks
+ * the shard lock inside each commit) refuses a commit whose runner lost the
+ * instance by dying with `ShardLost`. The library turns that into the call's
+ * failure, so the caller retries and the retry reaches the current owner.
+ * The fence itself needs Postgres; here the in-process host refuses a
+ * transaction whose runner no longer serves the instance when it commits.
+ */
+
+describe("Domain commit refused by a fencing host", { tags: ["unit"] }, () => {
+  it.live(
+    "a runner that lost the instance during its commit is refused; the retry commits on the owner",
+    () =>
+      Effect.gen(function* () {
+        const a = AccountId.make("fenced");
+        const sim = twoRunnerHost({ fenced: true });
+        yield* Effect.gen(function* () {
+          const accounts = yield* Account;
+          // Runner 0 decides a deposit on version 0 and stalls there.
+          const deposit = yield* Effect.forkChild(
+            accounts.send(new Deposit({ accountId: a, amount: 1, stall: true })),
+          );
+          yield* stallOf(a).reached.await;
+          // The instance moves to runner 1, which commits nothing. The version doesn't move,
+          // so only the fence can refuse runner 0's commit.
+          sim.serveFrom(1);
+          yield* stallOf(a).release.open;
+          const receipt = yield* Fiber.join(deposit);
+          expect(receipt.version).toBe(1);
+          expect(sim.committers(`VersionCheckBank.AccountAggregate/${a}`)).toEqual([1]);
+          expect(logOf(sim, a)).toEqual(["Deposited 1"]);
+        }).pipe(Effect.provide(hosted(sim)), Effect.ensuring(sim.close));
+      }),
