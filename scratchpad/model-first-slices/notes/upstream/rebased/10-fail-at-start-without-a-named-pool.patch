@@ -85,3 +94,56 @@ export const runnerPoolName = (host: string, port: number): string => {
     hash = Math.imul(hash ^ byte, 0x01000193);
   return `effect-cluster:#${(hash >>> 0).toString(16).padStart(8, "0")}`;
 };
+
+/**
+ * Why a runner's shard-lock session could never be told apart from another
+ * runner's: the runner has no address (`ShardingConfig.runnerAddress`), its
+ * bootstrap did not name its Postgres pool, or named it after another address.
+ */
+export class RunnerPoolUnnamed extends Data.TaggedError("Cluster.RunnerPoolUnnamed")<{
+  readonly reason: "no-runner-address" | "pool-not-named" | "pool-named-for-another-runner";
+  readonly message: string;
+}> {}
+
+/**
+ * The start check of a runner whose commits are fenced on its shard lock
+ * (`@alchemy.run/domain/EffectCluster`): fails unless the runner has an
+ * address and its pool carries the name that address gives
+ * (`runnerPoolName`). It reads the runner's configuration only, never the
+ * database: at start the lock session may not exist yet, or may hold no shard
+ * yet, so a query could not tell an unnamed pool from a session still opening.
+ * A storage that takes no advisory locks keeps no lock session, and passes.
+ */
+export const checkRunnerPool = (
+  poolName: string | undefined,
+): Effect.Effect<void, RunnerPoolUnnamed, ShardingConfig.ShardingConfig> =>
+  Effect.flatMap(Effect.service(ShardingConfig.ShardingConfig), (config) => {
+    if (config.shardLockDisableAdvisory) return Effect.void;
+    if (Option.isNone(config.runnerAddress))
+      return Effect.fail(
+        new RunnerPoolUnnamed({
+          reason: "no-runner-address",
+          message:
+            "This runner has no address (ShardingConfig.runnerAddress), so no session can be named after it.",
+        }),
+      );
+    const expected = runnerPoolName(
+      config.runnerAddress.value.host,
+      config.runnerAddress.value.port,
+    );
+    if (poolName === undefined)
+      return Effect.fail(
+        new RunnerPoolUnnamed({
+          reason: "pool-not-named",
+          message: `This runner's Postgres pool is not named. Build it with applicationName ${expected} (runnerPoolName), as the runner bootstrap does, so its shard-lock session can be told apart.`,
+        }),
+      );
+    if (poolName !== expected)
+      return Effect.fail(
+        new RunnerPoolUnnamed({
+          reason: "pool-named-for-another-runner",
+          message: `This runner's Postgres pool is named ${poolName}, not ${expected}, the name its address gives.`,
+        }),
+      );
+    return Effect.void;
+  });
