diff --git a/packages/effect-cluster/src/Host.ts b/packages/effect-cluster/src/Host.ts
index f19a5426c..02a0f6c6c 100644
--- a/packages/effect-cluster/src/Host.ts
+++ b/packages/effect-cluster/src/Host.ts
@@ -66,3 +66,22 @@ export class InstanceStorage extends Context.Service<
     transaction<A, E, R>(effect: Effect.Effect<A, E, R>): Effect.Effect<A, E, R>;
   }
 >()("Cluster.InstanceStorage") {}
+
+/**
+ * The `application_name` a runner's Postgres pool carries: `effect-cluster:<host>:<port>`,
+ * from the address the runner gives Effect Cluster. Effect's SQL runner storage reserves the
+ * session that holds the runner's shard locks from this pool, so the lock session carries it
+ * too, and any connection can tell which runner holds a shard (`pg_locks` joined to
+ * `pg_stat_activity`). PostgreSQL keeps 63 bytes of the name and replaces characters outside
+ * printable ASCII; a name that would be cut or changed is replaced by `effect-cluster:#` and
+ * an FNV-1a hash of `host:port`, so no two runners share a cut name.
+ */
+export const runnerPoolName = (host: string, port: number): string => {
+  const full = `effect-cluster:${host}:${port}`;
+  const bytes = new TextEncoder().encode(full);
+  if (bytes.length <= 63 && /^[\x20-\x7e]*$/.test(full)) return full;
+  let hash = 0x811c9dc5;
+  for (const byte of new TextEncoder().encode(`${host}:${port}`))
+    hash = Math.imul(hash ^ byte, 0x01000193);
+  return `effect-cluster:#${(hash >>> 0).toString(16).padStart(8, "0")}`;
+};
