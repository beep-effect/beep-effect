new file mode 100644
index 000000000..a18998575
--- /dev/null
+++ b/packages/integration-tests/test/Domain/ClusterRunnerPool.test.ts
@@ -0,0 +1,21 @@
+import { runnerPoolName } from "@alchemy.run/effect-cluster/Host";
+import { describe, expect, it } from "@alchemy.run/test";
+
+/**
+ * A runner's Postgres pool is named after the runner (`runnerPoolName`), so
+ * the session that holds its shard locks can be told from another runner's.
+ */
+
+describe("Effect Cluster runner pool name", { tags: ["unit"] }, () => {
+  it("is the runner's address, as Effect Cluster is given it", () => {
+    expect(runnerPoolName("10.0.1.6", 34431)).toBe("effect-cluster:10.0.1.6:34431");
+  });
+
+  it("is a hash when PostgreSQL would cut or change it, the same on both sides", () => {
+    const long = runnerPoolName("h".repeat(70), 34431);
+    expect(long).toMatch(/^effect-cluster:#[0-9a-f]{8}$/);
+    expect(runnerPoolName("h".repeat(70), 34431)).toBe(long);
+    expect(runnerPoolName("h".repeat(71), 34431)).not.toBe(long);
+    expect(runnerPoolName("rünner", 34431)).toMatch(/^effect-cluster:#[0-9a-f]{8}$/);
+  });
+});
