@@ -0,0 +1,108 @@
+import { describe, expect, it } from "@alchemy.run/test";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Latch from "effect/Latch";
+import { twoRunnerHost } from "./two-runner-host.ts";
+import {
+  Account,
+  AccountId,
+  Deposit,
+  hosted,
+  InsufficientFunds,
+  logOf,
+  stallOf,
+  Transfer,
+  TransferMoney,
+  Withdraw,
+} from "./two-runner-model.ts";
+
+/**
+ * A commit applies only to the version its `decide` was given, on an
+ * instance no decision holds. Two runners serve one instance here, as on
+ * Effect Cluster while a shard moves: runner 0 decides and stalls, runner 1
+ * commits meanwhile, then runner 0's commit goes on.
+ */
+
+describe("Domain commit version check, two runners on one instance", { tags: ["unit"] }, () => {
+  it.live(
+    "a commit on a version that moved since its decide is retried, and no write is lost",
+    () =>
+      Effect.gen(function* () {
+        const a = AccountId.make("lost");
+        const sim = twoRunnerHost();
+        yield* Effect.gen(function* () {
+          const accounts = yield* Account;
+          // Runner 0 decides a deposit of 1 on version 0 and stalls there.
+          const first = yield* Effect.forkChild(
+            accounts.send(new Deposit({ accountId: a, amount: 1, stall: true })),
+          );
+          yield* stallOf(a).reached.await;
+          // The shard moves: runner 1 commits a deposit of 2 as version 1.
+          sim.serveFrom(1);
+          const second = yield* accounts.send(
+            new Deposit({ accountId: a, amount: 2, stall: false }),
+          );
+          expect(second.version).toBe(1);
+          // Runner 0 goes on. Its commit is refused; the retry decides again on runner 1.
+          yield* stallOf(a).release.open;
+          const retried = yield* Fiber.join(first);
+          expect(retried.version).toBe(2);
+          expect(logOf(sim, a)).toEqual(["Deposited 2", "Deposited 1"]);
+          expect(yield* accounts.get(a)).toEqual({ balance: 3, amounts: [2, 1] });
+        }).pipe(Effect.provide(hosted(sim)), Effect.ensuring(sim.close));
+      }),
+  );
+
+  it.live(
+    "a commit on an instance a decision holds waits for the decision, then decides again",
+    () =>
+      Effect.gen(function* () {
+        const a = AccountId.make("held-from");
+        const b = AccountId.make("held-to");
+        let preparing: Latch.Latch | undefined;
+        const sim = twoRunnerHost({
+          // The decision stalls with `a` held: the call that prepares `b` waits.
+          intercept: (call, run) =>
+            call.method === "txPrepare" && preparing !== undefined
+              ? Effect.andThen(preparing.await, run)
+              : run,
+        });
+        yield* Effect.gen(function* () {
+          const accounts = yield* Account;
+          const transfer = yield* Transfer;
+          yield* accounts.send(new Deposit({ accountId: a, amount: 100, stall: false }));
+          // Runner 0 decides to withdraw all 100 from `a` and stalls there.
+          const withdraw = yield* Effect.forkChild(
+            Effect.flip(accounts.send(new Withdraw({ accountId: a, amount: 100, stall: true }))),
+          );
+          yield* stallOf(a).reached.await;
+          // On runner 1, a transfer of all 100 from `a` holds `a` at the same version.
+          sim.serveFrom(1);
+          preparing = Latch.makeUnsafe(false);
+          const transferred = yield* Effect.forkChild(
+            transfer.send(new TransferMoney({ from: a, to: b, amount: 100 })),
+          );
+          yield* Effect.sleep("100 millis");
+          expect(sim.rowsOf(`VersionCheckBank.AccountAggregate/${a}`).get("meta")).toMatchObject({
+            held: true,
+            version: 1,
+          });
+          // Runner 0's withdrawal goes on while `a` is held: its commit must not land.
+          yield* stallOf(a).release.open;
+          yield* Effect.sleep("300 millis");
+          expect(logOf(sim, a)).toEqual(["Deposited 100"]);
+          // The transfer finishes; the withdrawal then decides again, on what is left.
+          yield* preparing.open;
+          const receipt = yield* Fiber.join(transferred);
+          expect(receipt.commits).toEqual([
+            { stream: `Account/${a}`, version: 2 },
+            { stream: `Account/${b}`, version: 1 },
+          ]);
+          expect(yield* Fiber.join(withdraw)).toEqual(new InsufficientFunds({ balance: 0 }));
+          expect(logOf(sim, a)).toEqual(["Deposited 100", "TransferSent 100"]);
+          expect(yield* accounts.get(a)).toEqual({ balance: 0, amounts: [100, -100] });
+        }).pipe(Effect.provide(hosted(sim)), Effect.ensuring(sim.close));
+      }),
+    { timeout: 30_000 },
+  );
+});
