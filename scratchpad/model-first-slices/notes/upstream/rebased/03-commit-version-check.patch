@@ -0,0 +1,231 @@
+import * as DurableObjects from "@alchemy.run/domain/DurableObjects";
+import { RuntimeContext } from "alchemy/RuntimeContext";
+import * as Clock from "effect/Clock";
+import * as Effect from "effect/Effect";
+import * as Exit from "effect/Exit";
+import * as Fiber from "effect/Fiber";
+import * as Scope from "effect/Scope";
+import * as Semaphore from "effect/Semaphore";
+
+// ------------------------------------- one instance's storage, served by two runners
+
+/**
+ * An in-process host whose instances can run on two runners at once, as on
+ * Effect Cluster while a shard moves: a runner that stalls past its shard
+ * lock keeps the instance it had while another runner takes the shard.
+ *
+ * Each runner builds its own copy of an instance, with its own exclusive
+ * section, over the instance's one storage. Calls go to the runner that
+ * `serveFrom` names when the call runs, so a retry reaches whichever runner
+ * serves the instance then; a call already running stays where it is.
+ * Transactions on one instance run one at a time across runners, as Effect
+ * Cluster's Postgres storage runs them under the instance's advisory lock.
+ */
+export const twoRunnerHost = (
+  options: {
+    /** Wrap a call between objects: the test decides when it runs. */
+    readonly intercept?: (
+      call: {
+        readonly cls: string;
+        readonly method: string;
+        readonly args: ReadonlyArray<unknown>;
+      },
+      run: Effect.Effect<unknown, unknown>,
+    ) => Effect.Effect<unknown, unknown>;
+  } = {},
+) => {
+  const classes = new Map<string, DurableObjects.ObjectImpl>();
+  const rows = new Map<string, Map<string, unknown>>();
+  const locks = new Map<string, Semaphore.Semaphore>();
+  const instances = new Map<string, Effect.Effect<Record<string, unknown>>>();
+  const scopes: Array<Scope.Closeable> = [];
+  const committers = new Map<string, Array<number>>();
+  let serving = 0;
+
+  const rowsOf = (id: string) => {
+    const held = rows.get(id) ?? new Map<string, unknown>();
+    rows.set(id, held);
+    return held;
+  };
+  const lockOf = (id: string) => {
+    const held = locks.get(id) ?? Semaphore.makeUnsafe(1);
+    locks.set(id, held);
+    return held;
+  };
+
+  /** The storage `runner` sees for instance `id`. */
+  const storageFor = (id: string, runner: number): DurableObjects.ObjectStorage => {
+    const data = rowsOf(id);
+    const clone = <T>(value: T): T => (value === undefined ? value : structuredClone(value));
+    return {
+      get: <T>(key: string) => Effect.sync(() => clone(data.get(key) as T | undefined)),
+      put: ((keyOrEntries: string | Record<string, unknown>, value?: unknown) =>
+        Effect.sync(() => {
+          if (typeof keyOrEntries === "string") data.set(keyOrEntries, clone(value));
+          else for (const [key, entry] of Object.entries(keyOrEntries)) data.set(key, clone(entry));
+        })) as DurableObjects.ObjectStorage["put"],
+      delete: ((keyOrKeys: string | ReadonlyArray<string>) =>
+        Effect.sync(() => {
+          if (typeof keyOrKeys === "string") return data.delete(keyOrKeys);
+          return keyOrKeys.filter((key) => data.delete(key)).length;
+        })) as DurableObjects.ObjectStorage["delete"],
+      list: <T>(options: DurableObjects.ListOptions = {}) =>
+        Effect.sync(() => {
+          let keys = [...data.keys()]
+            .sort()
+            .filter(
+              (key) =>
+                (options.prefix === undefined || key.startsWith(options.prefix)) &&
+                (options.start === undefined || key >= options.start) &&
+                (options.startAfter === undefined || key > options.startAfter) &&
+                (options.end === undefined || key < options.end),
+            );
+          if (options.reverse) keys.reverse();
+          if (options.limit !== undefined) keys = keys.slice(0, options.limit);
+          return new Map(keys.map((key) => [key, clone(data.get(key) as T)]));
+        }),
+      // One at a time per instance, across runners; a failure restores what was there.
+      transaction: (effect) =>
+        lockOf(id).withPermits(1)(
+          Effect.suspend(() => {
+            const before = new Map(data);
+            return effect.pipe(
+              Effect.onExit((exit) =>
+                Exit.isFailure(exit)
+                  ? Effect.sync(() => {
+                      data.clear();
+                      for (const [key, value] of before) data.set(key, value);
+                    })
+                  : Effect.sync(() => {
+                      committers.set(id, [...(committers.get(id) ?? []), runner]);
+                    }),
+              ),
+            );
+          }),
+        ),
+    };
+  };
+
+  const build = (cls: string, id: string, runner: number) => {
+    const storage = storageFor(id, runner);
+    const gate = Semaphore.makeUnsafe(1);
+    const scope = Scope.makeUnsafe();
+    scopes.push(scope);
+    return Effect.gen(function* () {
+      let timer: { readonly at: number; readonly fiber: Fiber.Fiber<void> } | undefined;
+      const set = (at: number) =>
+        Effect.gen(function* () {
+          const previous = timer;
+          const now = yield* Clock.currentTimeMillis;
+          const fiber = yield* Effect.sleep(Math.max(0, at - now)).pipe(
+            Effect.andThen(
+              Effect.suspend(() => {
+                timer = undefined;
+                return callbacks.fire;
+              }),
+            ),
+            Effect.forkIn(scope),
+          );
+          timer = { at, fiber };
+          if (previous) yield* Fiber.interrupt(previous.fiber);
+        });
+      const callbacks = DurableObjects.alarmCallbacks(storage, {
+        get: Effect.sync(() => timer?.at ?? null),
+        set,
+      });
+      const runtime = {
+        Type: "Sim",
+        id,
+        env: {},
+        get: () => Effect.undefined,
+        set: (key: string) => Effect.succeed(key),
+      } as RuntimeContext["Service"];
+      const record = yield* classes.get(cls)!.pipe(
+        Effect.provideService(DurableObjects.ObjectState, {
+          storage,
+          exclusive: (effect) => gate.withPermits(1)(effect),
+          waitUntil: (effect) => Effect.asVoid(Effect.forkIn(effect, scope)),
+        }),
+        Effect.provideService(RuntimeContext, runtime),
+        Effect.provideService(Scope.Scope, scope),
+        Effect.provide(callbacks.callbacks),
+      );
+      // Each call runs as its own event, with the instance's runtime.
+      const methods: Record<string, unknown> = {};
+      for (const [method, value] of Object.entries(record)) {
+        methods[method] =
+          typeof value === "function"
+            ? (...args: ReadonlyArray<unknown>) => {
+                const result = (value as (...args: ReadonlyArray<unknown>) => unknown)(...args);
+                return Effect.isEffect(result)
+                  ? Effect.scoped(
+                      (result as Effect.Effect<unknown, unknown, RuntimeContext>).pipe(
+                        Effect.provideService(RuntimeContext, runtime),
+                      ),
+                    )
+                  : result;
+              }
+            : value;
+      }
+      return methods;
+    }).pipe(Effect.cached, Effect.runSync);
+  };
+
+  const instance = (cls: string, name: string) => {
+    const id = `${cls}/${name}`;
+    const key = `${serving}|${id}`;
+    const built = instances.get(key) ?? build(cls, id, serving);
+    instances.set(key, built);
+    return built;
+  };
+
+  const namespace = (cls: string): DurableObjects.Namespace => ({
+    getByName: (name) =>
+      new Proxy({} as DurableObjects.Stub, {
+        get:
+          (_, method: string) =>
+          (...args: ReadonlyArray<unknown>) => {
+            // Routed when the call runs: a retry reaches the runner that serves the instance then.
+            const run = Effect.flatMap(
+              Effect.suspend(() => instance(cls, name)),
+              (methods) =>
+                (methods[method] as (...args: ReadonlyArray<unknown>) => Effect.Effect<unknown>)(
+                  ...structuredClone(args),
+                ).pipe(
+                  Effect.map((result) => (result === undefined ? result : structuredClone(result))),
+                ),
+            );
+            return options.intercept === undefined
+              ? run
+              : options.intercept({ cls, method, args }, run);
+          },
+      }),
+  });
+
+  const host: DurableObjects.Host = {
+    declare: (model, cls, impl) =>
+      Effect.sync(() => {
+        const name = DurableObjects.className(model.modelName, cls);
+        classes.set(name, impl);
+        return namespace(name);
+      }),
+    lookup: (model, cls) => namespace(DurableObjects.className(model.modelName, cls)),
+    claimKey: Effect.sync(() => ({})),
+  };
+
+  return {
+    host,
+    /** Which runner serves the calls made from now on (0 at first). */
+    serveFrom: (runner: number) => {
+      serving = runner;
+    },
+    /** An instance's stored rows, by key. */
+    rowsOf,
+    /** The runner of each transaction on instance `id` that completed, in order. */
+    committers: (id: string): ReadonlyArray<number> => committers.get(id) ?? [],
+    /** Stop every instance's background work and alarm. */
+    close: Effect.suspend(() =>
+      Effect.forEach(scopes, (scope) => Scope.close(scope, Exit.void), { discard: true }),
+    ),
+  };
+};
