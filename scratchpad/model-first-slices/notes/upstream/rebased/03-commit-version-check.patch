@@ -0,0 +1,128 @@
+import * as Domain from "@alchemy.run/domain";
+import * as DurableObjects from "@alchemy.run/domain/DurableObjects";
+import * as SecureRandom from "effect/crypto/SecureRandom";
+import * as Effect from "effect/Effect";
+import * as Latch from "effect/Latch";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import type { twoRunnerHost } from "./two-runner-host.ts";
+
+/**
+ * A bank for the two-runner cases: deposits and withdrawals on one account,
+ * and transfers decided across two. A command with `stall` set stops in its
+ * `decide`, as a runner frozen inside its call does, until the test lets it
+ * go on.
+ */
+
+const gates = new Map<string, { readonly reached: Latch.Latch; readonly release: Latch.Latch }>();
+
+/**
+ * The stall of account `id`'s commands: `reached` opens when a stalled
+ * `decide` is reached, and it goes on once `release` opens. Each case uses
+ * accounts of its own, so cases running together don't share a stall.
+ */
+export const stallOf = (id: string) => {
+  const gate = gates.get(id) ?? {
+    reached: Latch.makeUnsafe(false),
+    release: Latch.makeUnsafe(false),
+  };
+  gates.set(id, gate);
+  return gate;
+};
+const stall = (id: string) =>
+  Effect.suspend(() => Effect.andThen(stallOf(id).reached.open, stallOf(id).release.await));
+
+export const AccountId = Schema.String.pipe(Schema.brand("AccountId"));
+
+export class Deposited extends Domain.Event("Deposited", { amount: Schema.Int }) {}
+export class Withdrawn extends Domain.Event("Withdrawn", { amount: Schema.Int }) {}
+export class TransferSent extends Domain.Event("TransferSent", {
+  to: AccountId,
+  amount: Schema.Int,
+}) {}
+export class TransferReceived extends Domain.Event("TransferReceived", {
+  from: AccountId,
+  amount: Schema.Int,
+}) {}
+export class InsufficientFunds extends Domain.Rejection("InsufficientFunds", {
+  balance: Schema.Int,
+}) {}
+
+export class Deposit extends Domain.Command("Deposit", {
+  input: { accountId: AccountId, amount: Schema.Int, stall: Schema.Boolean },
+  events: [Deposited],
+}) {}
+export class Withdraw extends Domain.Command("Withdraw", {
+  input: { accountId: AccountId, amount: Schema.Int, stall: Schema.Boolean },
+  events: [Withdrawn],
+  rejects: [InsufficientFunds],
+}) {}
+export class TransferMoney extends Domain.Command("TransferMoney", {
+  input: { from: AccountId, to: AccountId, amount: Schema.Int },
+  events: [TransferSent, TransferReceived],
+  rejects: [InsufficientFunds],
+}) {}
+
+export class Account extends Domain.Aggregate("Account", {
+  id: AccountId,
+  state: Schema.Struct({ balance: Schema.Int, amounts: Schema.Array(Schema.Int) }),
+  initial: { balance: 0, amounts: [] },
+  commands: [Deposit, Withdraw],
+  keyOf: (command) => command.accountId,
+  events: [TransferSent, TransferReceived],
+  decide: {
+    Deposit: Effect.fn(function* (_, cmd) {
+      if (cmd.stall) yield* stall(cmd.accountId);
+      return [new Deposited({ amount: cmd.amount })];
+    }),
+    Withdraw: Effect.fn(function* (account, cmd) {
+      if (cmd.stall) yield* stall(cmd.accountId);
+      if (cmd.amount > account.balance)
+        return yield* new InsufficientFunds({ balance: account.balance });
+      return [new Withdrawn({ amount: cmd.amount })];
+    }),
+  },
+  evolve: {
+    Deposited: (s, e) => ({ balance: s.balance + e.amount, amounts: [...s.amounts, e.amount] }),
+    Withdrawn: (s, e) => ({ balance: s.balance - e.amount, amounts: [...s.amounts, -e.amount] }),
+    TransferSent: (s, e) => ({ balance: s.balance - e.amount, amounts: [...s.amounts, -e.amount] }),
+    TransferReceived: (s, e) => ({
+      balance: s.balance + e.amount,
+      amounts: [...s.amounts, e.amount],
+    }),
+  },
+}) {}
+
+export class Transfer extends Domain.Decision(TransferMoney, {
+  reads: { from: Account, to: Account },
+  keyOf: (cmd) => ({ from: cmd.from, to: cmd.to }),
+  decide: ({ from, to }, cmd) =>
+    cmd.amount > from.state.balance
+      ? new InsufficientFunds({ balance: from.state.balance })
+      : [
+          from.record(new TransferSent({ to: to.id, amount: cmd.amount })),
+          to.record(new TransferReceived({ from: from.id, amount: cmd.amount })),
+        ],
+}) {}
+
+export class Bank extends Domain.Model("VersionCheckBank", {
+  aggregates: [Account],
+  decisions: [Transfer],
+}) {}
+
+export const hosted = (sim: ReturnType<typeof twoRunnerHost>) =>
+  Bank.layer(Layer.empty).pipe(
+    Layer.provideMerge(DurableObjects.makePlatform(sim.host)),
+    Layer.provideMerge(SecureRandom.layerWebCrypto),
+  );
+
+/** An account's stored events, in order, as `<tag> <amount>`. */
+export const logOf = (sim: ReturnType<typeof twoRunnerHost>, id: string) =>
+  [...sim.rowsOf(`VersionCheckBank.AccountAggregate/${id}`).entries()]
+    .filter(([key]) => key.startsWith("event:"))
+    .map(([, row]) => {
+      const { event } = row as {
+        readonly event: { readonly _tag: string; readonly amount: number };
+      };
+      return `${event._tag} ${event.amount}`;
+    });
